@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SistemBeritaAcara.Core.Entities
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider ServiceProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inherits LayoutComponentBase

@if (isLoginPage)
{
    @Body
}
else
{


    <div class="app-layout">
        <header class="topbar">
            <!-- Brand Logo -->
            <div class="brand-logo-container" style="display:flex;align-items:center;gap:12px;">
                <button type="button" class="hamburger-menu" onclick="toggleSidebar()" title="Menu" style="background:none;border:none;color:var(--text-primary);font-size:24px;cursor:pointer;">
                    <i class="bi bi-list"></i>
                </button>
                <NavLink href="/dashboard" style="display:block;line-height:0;">
                    <img src="/images/PT_Pertamina_Patra_Niaga.svg.png" style="height: 54px; width: auto;" alt="Pertamina Patra Niaga" />
                </NavLink>
            </div>

            <div class="topbar-actions" style="position:relative;">
                <button class="btn-icon" id="theme-toggle" onclick="toggleTheme()" title="Toggle Dark Mode" style="margin-right: 8px;">
                    <i class="bi bi-moon" style="font-size:18px;"></i>
                </button>
                <div class="topbar-profile-container" onclick="toggleProfileDropdown(event)">
                    <div class="topbar-user" style="cursor:pointer;display:flex;align-items:center;gap:12px;">
                        <div class="topbar-avatar">
                            @if (!string.IsNullOrEmpty(profilePicPath))
                            {
                                <img src="/@profilePicPath" alt="Foto Profil" />
                            }
                            else
                            {
                                @initials
                            }
                        </div>
                        <div style="text-align:left;">
                            <div class="topbar-username">@currentUserName</div>
                        </div>
                        <i class="bi bi-chevron-down" style="font-size:12px;color:var(--text-muted);margin-left:4px;"></i>
                    </div>

                    <div id="profile-dropdown" class="profile-dropdown-menu">
                        <NavLink href="/profil" style="display:flex;align-items:center;gap:10px;padding:12px 16px;color:var(--text-primary);text-decoration:none;border-bottom:1px solid var(--border-light);">
                            <i class="bi bi-person" style="font-size:16px;"></i> Profile
                        </NavLink>
                        <form method="post" action="/account/logout" style="margin:0;">
                            <AntiforgeryToken />
                            <button type="submit" style="width:100%;text-align:left;background:none;border:none;padding:12px 16px;color:var(--danger);display:flex;align-items:center;gap:10px;cursor:pointer;font-family:inherit;font-size:14px;">
                                <i class="bi bi-box-arrow-right" style="font-size:16px;"></i> Log Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleSidebar()"></div>

        <aside id="main-sidebar" class="sidebar">

            <!-- CTA Buat BA (hanya AdminGudangBarang) -->
            @if (currentRole == "AdminGudangBarang")
            {
                <div class="sidebar-cta">
                    <NavLink class="btn-create-ba" href="/buat-ba">
                        <i class="bi bi-plus-lg"></i>
                        Buat Berita Acara
                    </NavLink>
                </div>
            }

            <!-- Navigation -->
            <div class="sidebar-nav-card">
            <nav class="sidebar-nav">
                @if (currentRole == "AdminGudangBarang")
                {
                    <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </NavLink>
                    <NavLink class="nav-link" href="/notifikasi">
                        <i class="bi bi-bell"></i>
                        <span>Inbox</span>
                        @if (unreadCount > 0)
                        {
                            <span class="nav-badge">@unreadCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="/draft">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Draft</span>
                        @if (draftCount > 0)
                        {
                            <span class="nav-badge">@draftCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="/progress">
                        <i class="bi bi-hourglass-split"></i>
                        <span>Progress</span>
                        @if (progressCount > 0)
                        {
                            <span class="nav-badge">@progressCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="/rejected">
                        <i class="bi bi-x-circle"></i>
                        <span>Rejected</span>
                    </NavLink>
                    <NavLink class="nav-link" href="/archive">
                        <i class="bi bi-archive"></i>
                        <span>Archive</span>
                    </NavLink>
                }
                else if (currentRole == "Approver")
                {
                    <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </NavLink>
                    <NavLink class="nav-link" href="/notifikasi">
                        <i class="bi bi-bell"></i>
                        <span>Inbox</span>
                        @if (unreadCount > 0)
                        {
                            <span class="nav-badge">@unreadCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="/progress">
                        <i class="bi bi-hourglass-split"></i>
                        <span>Progress</span>
                        @if (progressCount > 0)
                        {
                            <span class="nav-badge">@progressCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="/archive">
                        <i class="bi bi-archive"></i>
                        <span>Archive</span>
                    </NavLink>
                }
                else if (currentRole == "AdminIT")
                {
                    <NavLink class="nav-link" href="/pengguna">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </NavLink>
                    <NavLink class="nav-link" href="/data-pegawai">
                        <i class="bi bi-person-badge"></i>
                        <span>Data Pekerja</span>
                    </NavLink>
                    <NavLink class="nav-link" href="/data-barang">
                        <i class="bi bi-box-seam"></i>
                        <span>Data Barang</span>
                    </NavLink>
                }
            </nav>
            </div>

        </aside>

        <div class="main-content">

            <style>
                .topbar-profile-container {
                    position: relative;
                }
                .profile-dropdown-menu {
                    display: none;
                    position: absolute;
                    top: 100%;
                    right: 0;
                    margin-top: 8px;
                    background: var(--surface, #fff);
                    border: 1px solid var(--border, #e5e7eb);
                    border-radius: var(--radius, 8px);
                    box-shadow: var(--shadow-md, 0 4px 6px -1px rgba(0,0,0,0.1));
                    min-width: 180px;
                    z-index: 100;
                    overflow: visible; /* Changed from hidden to visible so ::before is active */
                }
                /* Bridge the gap so hover state isn't lost */
                .profile-dropdown-menu::before {
                    content: "";
                    position: absolute;
                    top: -10px;
                    left: 0;
                    right: 0;
                    height: 10px;
                    background: transparent;
                }
                .profile-dropdown-menu > a:first-of-type {
                    border-top-left-radius: var(--radius, 8px);
                    border-top-right-radius: var(--radius, 8px);
                }
                .profile-dropdown-menu > form:last-of-type > button {
                    border-bottom-left-radius: var(--radius, 8px);
                    border-bottom-right-radius: var(--radius, 8px);
                }
                .profile-dropdown-menu.show {
                    display: block;
                }
                .profile-dropdown-menu a:hover,
                .profile-dropdown-menu button:hover {
                    background: var(--primary-light, #f0fdf4);
                }
            </style>

            <!-- Content -->
            <div class="content-area">
                @Body
            </div>
        </div>
    </div>

    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById('main-sidebar');
            var overlay = document.getElementById('sidebar-overlay');
            if (sidebar) sidebar.classList.toggle('open');
            if (overlay) overlay.classList.toggle('open');
        }

        function toggleProfileDropdown(e) {
            e.stopPropagation();
            var dropdown = document.getElementById('profile-dropdown');
            if (dropdown) {
                dropdown.classList.toggle('show');
            }
        }

        document.addEventListener('click', function(e) {
            var dropdown = document.getElementById('profile-dropdown');
            if (dropdown && dropdown.classList.contains('show')) {
                var container = document.querySelector('.topbar-profile-container');
                
                // Close if clicked outside, OR if clicked on a link inside the dropdown
                var isClickInsideDropdownLink = dropdown.contains(e.target) && (e.target.tagName === 'A' || e.target.closest('a'));
                
                if (!container || !container.contains(e.target) || isClickInsideDropdownLink) {
                    dropdown.classList.remove('show');
                }
            }
        });
    </script>
}

<div id="blazor-error-ui" data-nosnippet>
    Terjadi kesalahan. <a href="." class="reload">Muat ulang</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string currentRole = string.Empty;
    private string currentRoleLabel = string.Empty;
    private string currentUserName = string.Empty;
    private string initials = string.Empty;
    private string? profilePicPath;
    private string pageTitle = string.Empty;
    private int unreadCount;
    private int draftCount;
    private int progressCount;
    private bool isLoginPage;
    private int _currentUserId;

    [Inject] private AppDbContext DbContext { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.Uri;
        isLoginPage = uri.Contains("/login") || uri.Contains("/logout") || uri.Contains("/pj/sign");

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = auth.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            currentUserName = principal.FindFirst("nama")?.Value
                           ?? principal.Identity.Name
                           ?? string.Empty;

            currentRole = principal.FindFirst("app_role")?.Value
                       ?? principal.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                       ?? string.Empty;

            var userIdStr = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdStr, out _currentUserId))
            {
                using var scope = ServiceProvider.CreateScope();
                var dbContext = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                var appUser = await dbContext.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == _currentUserId);
                if (appUser is not null)
                {
                    profilePicPath = appUser.ProfilePicPath;
                }
            }

            initials = GetInitials(currentUserName);
            currentRoleLabel = currentRole switch
            {
                "AdminIT"            => "Admin IT",
                "AdminGudangBarang"  => "Admin Gudang & Barang",
                "Approver"           => "Approver",
                _                    => currentRole
            };

            pageTitle = GetPageTitle(Navigation.Uri);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || isLoginPage || _currentUserId == 0) return;

        unreadCount = await DbContext.Notification
            .CountAsync(n => n.UserId == _currentUserId && !n.IsRead);

        if (currentRole == "AdminGudangBarang")
        {
            draftCount = await DbContext.Set<SistemBeritaAcara.Core.Entities.BeritaAcara>()
                .CountAsync(ba => ba.CreatedBy == _currentUserId && ba.Status == "Draft");
            progressCount = await DbContext.Set<SistemBeritaAcara.Core.Entities.BeritaAcara>()
                .CountAsync(ba => ba.CreatedBy == _currentUserId &&
                    (ba.Status == "WaitingPJSign" || ba.Status == "WaitingApproval"));
        }
        else if (currentRole == "Approver")
        {
            progressCount = await DbContext.Set<SistemBeritaAcara.Core.Entities.BeritaAcara>()
                .CountAsync(ba => ba.MengetahuiId == _currentUserId && ba.Status == "WaitingApproval");
        }

        StateHasChanged();
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private static string GetPageTitle(string uri)
    {
        return uri switch
        {
            var u when u.Contains("/dashboard") => "Dashboard",
            var u when u.Contains("/notifikasi") => "Inbox",
            var u when u.Contains("/draft") => "Draft",
            var u when u.Contains("/progress") => "Progress",
            var u when u.Contains("/rejected") => "Ditolak",
            var u when u.Contains("/archive") => "Arsip",
            var u when u.Contains("/profil") => "Profil",
            var u when u.Contains("/buat-ba") => "Buat Berita Acara",
            var u when u.Contains("/editor") => "Editor Dokumen",
            var u when u.Contains("/pengguna") => "Dashboard",
            var u when u.Contains("/data-pegawai") => "Data Pekerja",
            var u when u.Contains("/data-barang") => "Data Barang",
            _ => "Sistem Berita Acara"
        };
    }
}
