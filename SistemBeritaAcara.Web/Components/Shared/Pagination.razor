@if (TotalPages > 1)
{
    <div class="pagination-container" style="gap:6px;">
        <button class="page-btn" disabled="@(!HasPreviousPage)" @onclick="OnPreviousPage">
            <i class="bi bi-chevron-left" style="font-size:12px;"></i>
        </button>

        @foreach (var p in GetPageNumbers())
        {
            <button class="page-btn @(p == CurrentPage ? "active" : "")" @onclick="() => OnPageClicked(p)">
                @p
            </button>
        }

        <button class="page-btn" disabled="@(!HasNextPage)" @onclick="OnNextPage">
            <i class="bi bi-chevron-right" style="font-size:12px;"></i>
        </button>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }

    public int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalItems / PageSize));
    public bool HasPreviousPage => CurrentPage > 1;
    public bool HasNextPage => CurrentPage < TotalPages;

    private IEnumerable<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var startPage = Math.Max(1, CurrentPage - 1);
        var endPage = Math.Min(TotalPages, startPage + 3);

        // Adjust if we hit the end
        if (endPage - startPage < 3 && TotalPages >= 4)
        {
            startPage = Math.Max(1, endPage - 3);
        }

        for (int i = startPage; i <= endPage; i++)
        {
            pages.Add(i);
        }
        return pages;
    }

    private async Task OnPageClicked(int page)
    {
        if (page != CurrentPage)
        {
            await CurrentPageChanged.InvokeAsync(page);
        }
    }

    private async Task OnPreviousPage()
    {
        if (HasPreviousPage)
        {
            await CurrentPageChanged.InvokeAsync(CurrentPage - 1);
        }
    }

    private async Task OnNextPage()
    {
        if (HasNextPage)
        {
            await CurrentPageChanged.InvokeAsync(CurrentPage + 1);
        }
    }
}
