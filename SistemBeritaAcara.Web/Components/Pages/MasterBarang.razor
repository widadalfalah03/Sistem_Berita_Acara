@page "/data-barang"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MasterBarangEntity = SistemBeritaAcara.Core.Entities.MasterBarang
@inject AppDbContext DbContext
@inject IExcelService ExcelService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminIT")]

<PageTitle>Data Barang — Sistem Berita Acara</PageTitle>

<div class="page-header d-flex align-center justify-between">
    <div></div>
    <div style="display:flex;gap:8px;">
        <button @onclick="ExportExcelAsync" disabled="@isExporting"
                style="display:inline-flex;align-items:center;padding:8px 16px;border-radius:var(--radius);border:none;background:#16A34A;color:#fff;font-size:13px;font-weight:600;cursor:pointer;transition:opacity .15s;"
                onmouseover="if(!this.disabled)this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
            @(isExporting ? "Mengexport..." : "Export Excel")
        </button>
        <button @onclick="() => showUpload = true"
                style="display:inline-flex;align-items:center;padding:8px 16px;border-radius:var(--radius);border:1.5px solid var(--border);background:var(--surface);color:var(--text-secondary);font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;"
                onmouseover="this.style.borderColor='var(--primary)';this.style.color='var(--primary)';this.style.background='var(--primary-light)'"
                onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-secondary)';this.style.background='var(--surface)'">
            Import Excel
        </button>
    </div>
</div>

<div class="stat-cards" style="grid-template-columns:repeat(1,1fr);max-width:220px;margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-card-icon total"><i class="bi bi-box-seam"></i></div>
        <div class="stat-card-info">
            <div class="stat-card-label">Total Barang</div>
            <div class="stat-card-value">@allBarang.Count(b => b.IsAktif)</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div style="background:@(alertIsError ? "var(--danger-light)" : "#F0FDF4");border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;color:@(alertIsError ? "var(--danger)" : "#16A34A");font-size:14px;display:flex;align-items:center;gap:8px;">
        <i class="bi @(alertIsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i>
        @alertMessage
    </div>
}

<div class="search-bar" style="justify-content:space-between;">
    <div style="display:flex;align-items:center;gap:12px;">
        <div class="search-input" style="max-width:320px;">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Cari nama barang..."
                   @bind="search" @bind:event="oninput" />
        </div>
    </div>
    <button @onclick="OpenTambah"
            style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:var(--radius);border:none;background:var(--primary);color:#fff;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all .15s;"
            onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'">
        <i class="bi bi-plus-lg" style="font-size:14px;"></i> Tambah Barang
    </button>
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nama Barang</th>
                        <th style="width:80px;text-align:center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in FilteredBarang)
                    {
                        <tr>
                            <td class="fw-semibold">@b.NamaBarang</td>
                            <td style="text-align:center;">
                                <div style="display:flex;gap:6px;justify-content:center;">
                                    <button @onclick="() => OpenEdit(b)" title="Edit"
                                            style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;border:none;background:var(--primary-light);color:var(--primary);cursor:pointer;transition:all .15s;"
                                            onmouseover="this.style.background='var(--primary)';this.style.color='#fff'"
                                            onmouseout="this.style.background='var(--primary-light)';this.style.color='var(--primary)'">
                                        <i class="bi bi-pencil-fill" style="font-size:12px;"></i>
                                    </button>
                                    <button @onclick="() => OpenHapus(b)" title="Hapus"
                                            style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;border:none;background:#FEE2E2;color:var(--danger);cursor:pointer;transition:all .15s;"
                                            onmouseover="this.style.background='var(--danger)';this.style.color='#fff'"
                                            onmouseout="this.style.background='#FEE2E2';this.style.color='var(--danger)'">
                                        <i class="bi bi-trash-fill" style="font-size:12px;"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!FilteredBarang.Any())
                    {
                        <tr>
                            <td colspan="2" style="text-align:center;padding:40px;color:var(--text-muted);">
                                Tidak ada data barang yang sesuai filter
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    @if (TotalFilteredItems > 0)
    {
        <SistemBeritaAcara.Web.Components.Shared.Pagination
            CurrentPage="@currentPage"
            TotalItems="@TotalFilteredItems"
            PageSize="@pageSize"
            CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
    }
}

@if (showForm)
{
    <div class="modal-overlay" @onclick="CloseForm">
        <div class="modal-content" style="max-width:420px;" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
            <div style="font-size:18px;font-weight:700;margin-bottom:20px;">
                @(isEditMode ? "Edit Barang" : "Tambah Barang")
            </div>

            @if (!string.IsNullOrEmpty(formError))
            {
                <div style="background:var(--danger-light);border-radius:var(--radius);padding:10px 14px;margin-bottom:16px;color:var(--danger);font-size:13px;">
                    @formError
                </div>
            }

            <div class="form-group">
                <label class="form-label">Nama Barang <span style="color:var(--danger)">*</span></label>
                <input class="form-control" @bind="formNamaBarang" placeholder="Contoh: Laptop, Mouse, Router..." />
            </div>

            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:24px;">
                <button class="btn btn-outline" @onclick="CloseForm">Batal</button>
                <button class="btn btn-primary" @onclick="SaveFormAsync" disabled="@isSaving">
                    @(isSaving ? "Menyimpan..." : (isEditMode ? "Simpan Perubahan" : "Tambah"))
                </button>
            </div>
        </div>
    </div>
}

@if (showHapus && hapusTarget != null)
{
    <div class="modal-overlay" @onclick="() => showHapus = false">
        <div class="modal-content" style="max-width:400px;" @onclick:stopPropagation>
            <div style="text-align:center;padding:8px 0 16px;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size:40px;color:var(--warning);"></i>
                <div style="font-size:17px;font-weight:700;margin-top:12px;">Hapus Barang?</div>
                <div style="font-size:14px;color:var(--text-secondary);margin-top:8px;">
                    <strong>@hapusTarget.NamaBarang</strong> akan dihapus dari daftar barang aktif.
                </div>
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px;">
                <button class="btn btn-outline" @onclick="() => showHapus = false">Batal</button>
                <button class="btn" style="background:var(--danger);color:#fff;" @onclick="HapusAsync" disabled="@isSaving">
                    @(isSaving ? "Menghapus..." : "Ya, Hapus")
                </button>
            </div>
        </div>
    </div>
}

@if (showUpload)
{
    <div class="modal-overlay" @onclick="() => showUpload = false">
        <div class="modal-content" style="max-width:500px;" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => showUpload = false"><i class="bi bi-x-lg"></i></button>
            <div style="font-size:18px;font-weight:700;margin-bottom:4px;">Import Data Barang</div>
            <div style="font-size:14px;color:var(--text-secondary);margin-bottom:20px;">
                Upload file Excel (.xlsx) dengan kolom baris pertama: Nama Barang
            </div>
            <div style="display:flex;justify-content:center;margin:24px 0;">
                <label for="barang-upload-input" style="cursor:pointer;display:inline-block;">
                    <div class="upload-btn-styled">
                        <i class="bi bi-cloud-arrow-up-fill" style="font-size:28px;"></i>
                        <span style="font-weight:600;font-size:15px;">Pilih File Excel</span>
                        <span style="font-size:12px;color:var(--text-muted);margin-top:2px;">.xlsx · Maksimal 10MB</span>
                    </div>
                </label>
                <InputFile id="barang-upload-input" OnChange="OnImportFileChanged" accept=".xlsx" style="display:none;" />
            </div>
            @if (isImporting)
            {
                <div class="loading-spinner" style="padding:20px;">
                    <div class="spinner"></div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<MasterBarangEntity> allBarang = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isExporting = false;
    private bool showUpload = false;
    private bool isImporting = false;
    private bool showForm = false;
    private bool isEditMode = false;
    private bool showHapus = false;
    private MasterBarangEntity? hapusTarget;
    private MasterBarangEntity? editTarget;

    private string alertMessage = string.Empty;
    private bool alertIsError = false;
    private string formError = string.Empty;
    private string formNamaBarang = string.Empty;

    private int currentPage = 1;
    private int pageSize = 10;
    private string _search = string.Empty;
    private string search
    {
        get => _search;
        set { _search = value; currentPage = 1; }
    }

    private int TotalFilteredItems => allBarang
        .Where(b => b.IsAktif)
        .Count(b => string.IsNullOrEmpty(search) ||
                    b.NamaBarang.Contains(search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MasterBarangEntity> FilteredBarang
    {
        get
        {
            var query = allBarang
                .Where(b => b.IsAktif)
                .Where(b => string.IsNullOrEmpty(search) ||
                            b.NamaBarang.Contains(search, StringComparison.OrdinalIgnoreCase));

            return query.OrderBy(b => b.NamaBarang).Skip((currentPage - 1) * pageSize).Take(pageSize);
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        allBarang = await DbContext.MasterBarang.OrderBy(b => b.NamaBarang).ToListAsync();
        isLoading = false;
    }

    private void OpenTambah()
    {
        isEditMode = false;
        editTarget = null;
        formNamaBarang = string.Empty;
        formError = string.Empty;
        showForm = true;
    }

    private void OpenEdit(MasterBarangEntity b)
    {
        isEditMode = true;
        editTarget = b;
        formNamaBarang = b.NamaBarang;
        formError = string.Empty;
        showForm = true;
    }

    private void OpenHapus(MasterBarangEntity b)
    {
        hapusTarget = b;
        showHapus = true;
    }

    private void CloseForm()
    {
        showForm = false;
        formError = string.Empty;
    }

    private async Task SaveFormAsync()
    {
        formError = string.Empty;
        if (string.IsNullOrWhiteSpace(formNamaBarang)) { formError = "Nama Barang wajib diisi."; return; }

        var duplicate = allBarang.FirstOrDefault(b =>
            b.NamaBarang.Equals(formNamaBarang.Trim(), StringComparison.OrdinalIgnoreCase) &&
            b.Id != (editTarget?.Id ?? 0) && b.IsAktif);
        if (duplicate != null) { formError = $"Barang '{formNamaBarang}' sudah ada dalam daftar."; return; }

        isSaving = true;
        try
        {
            if (isEditMode && editTarget != null)
            {
                var entity = await DbContext.MasterBarang.FindAsync(editTarget.Id);
                if (entity == null) return;
                entity.NamaBarang = formNamaBarang.Trim();
            }
            else
            {
                DbContext.MasterBarang.Add(new MasterBarangEntity
                {
                    NamaBarang = formNamaBarang.Trim(),
                    IsAktif = true
                });
            }

            await DbContext.SaveChangesAsync();
            showForm = false;
            SetAlert(isEditMode ? "Barang berhasil diperbarui." : "Barang berhasil ditambahkan.", false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            formError = $"Gagal menyimpan: {ex.Message}";
        }
        finally { isSaving = false; }
    }

    private async Task HapusAsync()
    {
        if (hapusTarget == null) return;
        isSaving = true;
        try
        {
            var entity = await DbContext.MasterBarang.FindAsync(hapusTarget.Id);
            if (entity != null)
            {
                entity.IsAktif = false;
                await DbContext.SaveChangesAsync();
            }
            showHapus = false;
            SetAlert($"Barang '{hapusTarget.NamaBarang}' berhasil dihapus.", false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetAlert($"Gagal menghapus: {ex.Message}", true);
        }
        finally { isSaving = false; hapusTarget = null; }
    }

    private async Task ExportExcelAsync()
    {
        isExporting = true;
        try
        {
            var data = allBarang.Where(b => b.IsAktif).OrderBy(b => b.NamaBarang);
            var bytes = await ExcelService.ExportBarangAsync(data);
            await JS.InvokeVoidAsync("downloadFileFromBytes", "DataBarang.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        finally { isExporting = false; }
    }

    private async Task OnImportFileChanged(InputFileChangeEventArgs e)
    {
        isImporting = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
            using var stream = e.File.OpenReadStream(10_000_000);
            var (added, updated, deactivated, errors) = await ExcelService.ImportBarangAsync(stream, currentUser!.Id, e.File.Name);
            showUpload = false;
            if (errors.Any() && added == 0 && updated == 0 && deactivated == 0)
            {
                SetAlert(errors[0], true);
            }
            else
            {
                SetAlert($"Berhasil: {added} ditambahkan, {updated} diperbarui, {deactivated} dinonaktifkan." +
                         (errors.Any() ? $" Peringatan: {string.Join("; ", errors)}" : ""), false);
                await LoadAsync();
            }
        }
        catch (Exception ex) { SetAlert($"Gagal impor: {ex.Message}", true); }
        finally { isImporting = false; }
    }

    private void SetAlert(string msg, bool isError)
    {
        alertMessage = msg;
        alertIsError = isError;
    }
}
