@page "/progress"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

<PageTitle>Progress Berita Acara — Sistem Berita Acara</PageTitle>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat data...</span></div>
}
else if (currentRole == "AdminGudangBarang")
{
    @if (!baList.Any())
    {
        <div class="card" style="text-align:center;padding:60px;">
            <i class="bi bi-hourglass" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
            <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Tidak ada Berita Acara dalam proses</div>
            <div style="font-size:14px;color:var(--text-secondary);">Semua Berita Acara sudah selesai atau belum diajukan</div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Jenis Berita Acara</th>
                        <th>Penanggung Jawab</th>
                        <th>Reviewer</th>
                        <th>Waktu Pengajuan</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ba in PaginatedBaList)
                    {
                        <tr style="cursor:pointer; transition: background 0.2s;" class="hover-row" @onclick="@(() => ViewBA(ba.Id))">
                            <td>
                                <span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span>
                            </td>
                            <td>
                                <div class="cell-main">@ba.Pj?.Nama</div>
                            </td>
                            <td>
                                <div class="cell-main">@ba.Mengetahui?.Nama</div>
                            </td>
                            <td>
                                <div>@ba.SubmittedAt?.ToString("dd MMM yyyy")</div>
                                <div style="font-size:11px;color:var(--text-muted);">@ba.SubmittedAt?.ToString("HH:mm") WIB</div>
                            </td>
                            <td>
                                @if (ba.Status == "WaitingPJSign")
                                {
                                    <span class="pill pill-waiting-pj">
                                        <i class="bi bi-pen" style="margin-right:4px;"></i> Menunggu TTD Pj
                                    </span>
                                }
                                else
                                {
                                    <span class="pill pill-waiting-approval">
                                        <i class="bi bi-hourglass-split" style="margin-right:4px;"></i> Menunggu Persetujuan
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        
        @if (baList.Count > 0)
        {
            <SistemBeritaAcara.Web.Components.Shared.Pagination
                CurrentPage="@currentPage"
                TotalItems="@baList.Count"
                PageSize="@pageSize"
                CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
        }
    }
}
else if (currentRole == "Reviewer")
{
    @if (!baList.Any())
    {
        <div class="card" style="text-align:center;padding:60px;">
            <i class="bi bi-inbox" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
            <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Antrian kosong</div>
            <div style="font-size:14px;color:var(--text-secondary);">Tidak ada Berita Acara yang menunggu persetujuan Anda saat ini</div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Jenis Berita Acara</th>
                        <th>Penanggung Jawab</th>
                        <th>Jenis Perangkat</th>
                        <th>Waktu Pengajuan</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ba in PaginatedBaList)
                    {
                        var perangkatNames = ba.Perangkat?.Select(p => p.Barang?.NamaBarang).Where(n => n != null).ToList() ?? new();
                        var perangkatDisplay = perangkatNames.Any()
                            ? string.Join(", ", perangkatNames.Take(2)) + (perangkatNames.Count > 2 ? $" +{perangkatNames.Count - 2} lainnya" : "")
                            : "—";

                        <tr style="cursor:pointer;" class="hover-row" @onclick="@(() => Navigation.NavigateTo($"/berita-acara/{ba.Id}?from=progress"))">
                            <td>
                                <span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span>
                            </td>
                            <td>
                                <div class="cell-main">@ba.Pj?.Nama</div>
                            </td>
                            <td>
                                <div class="cell-main">@perangkatDisplay</div>
                            </td>
                            <td>
                                <div>@ba.SubmittedAt?.ToString("dd MMM yyyy")</div>
                                <div style="font-size:11px;color:var(--text-muted);">@ba.SubmittedAt?.ToString("HH:mm") WIB</div>
                            </td>
                            <td>
                                <span class="pill pill-waiting-approval">
                                    <i class="bi bi-hourglass-split" style="margin-right:4px;"></i> Menunggu Persetujuan
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>

        @if (baList.Count > 0)
        {
            <SistemBeritaAcara.Web.Components.Shared.Pagination
                CurrentPage="@currentPage"
                TotalItems="@baList.Count"
                PageSize="@pageSize"
                CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
        }
    }
}

@code {
    private List<BeritaAcaraEntity> baList = new();
    private bool isLoading = true;
    private string currentRole = string.Empty;
    private int currentUserId;

    private int currentPage = 1;
    private int pageSize = 10;

    private void ViewBA(int id)
    {
        Navigation.NavigateTo($"/berita-acara/{id}?from=progress");
    }

    private IEnumerable<BeritaAcaraEntity> PaginatedBaList
    {
        get
        {
            return baList.Skip((currentPage - 1) * pageSize).Take(pageSize);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        currentRole = appUser!.Role;
        currentUserId = appUser.Id;

        if (currentRole == "AdminGudangBarang")
        {
            baList = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj).Include(b => b.Mengetahui)
                .Where(b => b.CreatedBy == currentUserId &&
                            (b.Status == "WaitingPJSign" || b.Status == "WaitingApproval"))
                .OrderByDescending(b => b.SubmittedAt)
                .ToListAsync();
        }
        else if (currentRole == "Reviewer")
        {
            baList = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj)
                .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                .Where(b => b.MengetahuiId == currentUserId && b.Status == "WaitingApproval")
                .OrderByDescending(b => b.SubmittedAt)
                .ToListAsync();
        }
        isLoading = false;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Fire-and-forget: koneksi SignalR di latar belakang, tidak memblokir render
            _ = ConnectSignalRAsync();
        }
        return Task.CompletedTask;
    }

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/ba"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("BaListUpdated", async () =>
            {
                await InvokeAsync(async () =>
                {
                    await ReloadListAsync();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
        }
        catch
        {
            // SignalR gagal connect — page tetap berjalan normal tanpa real-time
        }
    }

    private async Task ReloadListAsync()
    {
        if (currentRole == "AdminGudangBarang")
        {
            baList = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj).Include(b => b.Mengetahui)
                .Where(b => b.CreatedBy == currentUserId &&
                            (b.Status == "WaitingPJSign" || b.Status == "WaitingApproval"))
                .OrderByDescending(b => b.SubmittedAt)
                .ToListAsync();
        }
        else if (currentRole == "Reviewer")
        {
            baList = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj)
                .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                .Where(b => b.MengetahuiId == currentUserId && b.Status == "WaitingApproval")
                .OrderByDescending(b => b.SubmittedAt)
                .ToListAsync();
        }
    }

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        "Penarikan" => "pill-penarikan",
        _ => "pill-lainnya"
    };

    private static string GetJenisAccentColor(string jenis) => jenis switch
    {
        "Alokasi" => "var(--primary)",
        "Peminjaman" => "var(--success)",
        "Penarikan" => "#F59E0B",
        _ => "#64748B"
    };

    private static string GetRelativeTime(DateTime? dt)
    {
        if (dt is null) return "-";
        var diff = DateTime.Now - dt.Value;
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes} menit lalu";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours} jam lalu";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} hari lalu";
        return dt.Value.ToString("dd MMM yyyy");
    }

    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hubConnection;

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.StopAsync();
            await _hubConnection.DisposeAsync();
        }
    }
}
