@page "/progress"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Progress Berita Acara — Sistem Berita Acara</PageTitle>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat data...</span></div>
}
else if (currentRole == "AdminGudangBarang")
{
    @if (!baList.Any())
    {
        <div class="card" style="text-align:center;padding:60px;">
            <i class="bi bi-hourglass" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
            <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Tidak ada BA dalam proses</div>
            <div style="font-size:14px;color:var(--text-secondary);">Semua BA sudah selesai atau belum diajukan</div>
        </div>
    }
    else
    {
        <div style="font-size:13px; color:var(--text-secondary); margin-bottom:12px;">
            Menampilkan @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, baList.Count) dari @baList.Count dokumen
        </div>
        <div class="card">
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="cursor:pointer;" @onclick="@(() => SortTable("Tanggal Submit"))">Dokumen <i class="bi @GetSortIcon("Tanggal Submit")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortTable("Jenis BA"))">Jenis Berita Acara <i class="bi @GetSortIcon("Jenis BA")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortTable("Tanggal Submit"))">Waktu Submit <i class="bi @GetSortIcon("Tanggal Submit")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortTable("Approver"))">Approver <i class="bi @GetSortIcon("Approver")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortTable("Status"))">Status <i class="bi @GetSortIcon("Status")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ba in SortedBaList)
                    {
                        <tr style="cursor:pointer; transition: background 0.2s;" class="hover-row" @onclick="@(() => ViewBA(ba.Id))">
                            <td>
                                <div class="cell-main">Berita Acara @ba.Jenis</div>
                                <div class="cell-sub">Penanggung Jawab: @ba.Pj?.Nama</div>
                            </td>
                            <td><span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span></td>
                            <td>
                                <div>@ba.SubmittedAt?.ToString("dd MMM yyyy")</div>
                                <div style="font-size:11px;color:var(--text-muted);">@ba.SubmittedAt?.ToString("HH:mm") WIB</div>
                            </td>
                            <td>
                                <div class="cell-main">@ba.Mengetahui?.Nama</div>
                                <div class="cell-sub">Approver</div>
                            </td>
                            <td>
                                @if (ba.Status == "WaitingPJSign")
                                {
                                    <span class="pill pill-waiting-pj">
                                        <i class="bi bi-pen" style="margin-right:4px;"></i> Menunggu TTD Penanggung Jawab
                                    </span>
                                }
                                else
                                {
                                    <span class="pill pill-waiting-approval">
                                        <i class="bi bi-hourglass-split" style="margin-right:4px;"></i> Menunggu Approval
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            
            @if (baList.Count > 0)
            {
                <SistemBeritaAcara.Web.Components.Shared.Pagination
                    CurrentPage="@currentPage"
                    TotalItems="@baList.Count"
                    PageSize="@pageSize"
                    CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
            }
        </div>
    }
}
else if (currentRole == "Approver")
{
    @if (!baList.Any())
    {
        <div class="card" style="text-align:center;padding:60px;">
            <i class="bi bi-inbox" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
            <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Antrian kosong</div>
            <div style="font-size:14px;color:var(--text-secondary);">Tidak ada BA yang menunggu persetujuan Anda saat ini</div>
        </div>
    }
    else
    {
        <div style="font-size:13px; color:var(--text-secondary); margin-bottom:12px;">
            Menampilkan @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, baList.Count) dari @baList.Count dokumen
        </div>
        <div class="card">
            @foreach (var ba in SortedBaList)
            {
                <NavLink class="queue-item" href="@($"/berita-acara/{ba.Id}?from=progress")">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;">
                        <div style="flex:1;">
                            <div class="queue-number">@ba.NomorSurat</div>
                            <div class="queue-desc">
                                <span class="pill @GetJenisPill(ba.Jenis)" style="font-size:11px;">@ba.Jenis</span>
                                <span style="margin-left:8px;font-size:14px;">@(ba.Perangkat?.FirstOrDefault()?.Barang?.NamaBarang ?? "—")</span>
                            </div>
                            <div class="queue-person" style="margin-top:6px;">
                                <i class="bi bi-person"></i>
                                <span>@ba.Pj?.Nama</span>
                                <span style="color:var(--text-muted);">•</span>
                                <span style="color:var(--text-muted);">@ba.Pj?.FungsiDirektorat</span>
                            </div>
                        </div>
                        <div style="text-align:right;flex-shrink:0;">
                            <div style="font-size:13px;color:var(--text-muted);">@GetRelativeTime(ba.SubmittedAt)</div>
                        </div>
                    </div>
                </NavLink>
            }
            
            @if (baList.Count > 0)
            {
                <SistemBeritaAcara.Web.Components.Shared.Pagination
                    CurrentPage="@currentPage"
                    TotalItems="@baList.Count"
                    PageSize="@pageSize"
                    CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
            }
        </div>
    }
}

@code {
    private List<BeritaAcaraEntity> baList = new();
    private bool isLoading = true;
    private string currentRole = string.Empty;
    private int currentUserId;

    private string sortColumn = "Tanggal Submit";
    private bool sortAscending = false;
    
    private int currentPage = 1;
    private int pageSize = 10;

    private void SortTable(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
    }

    private void ViewBA(int id)
    {
        Navigation.NavigateTo($"/berita-acara/{id}?from=progress");
    }

    private string GetSortIcon(string column) => sortColumn != column ? "bi-arrow-down-up" : sortAscending ? "bi-arrow-up text-primary" : "bi-arrow-down text-primary";

    private IEnumerable<BeritaAcaraEntity> SortedBaList
    {
        get
        {
            var query = sortColumn switch
            {
                "Jenis BA" => sortAscending ? baList.OrderBy(b => b.Jenis) : baList.OrderByDescending(b => b.Jenis),
                "Tanggal Submit" => sortAscending ? baList.OrderBy(b => b.SubmittedAt) : baList.OrderByDescending(b => b.SubmittedAt),
                "Approver" => sortAscending ? baList.OrderBy(b => b.Mengetahui?.Nama) : baList.OrderByDescending(b => b.Mengetahui?.Nama),
                "Status" => sortAscending ? baList.OrderBy(b => b.Status) : baList.OrderByDescending(b => b.Status),
                _ => baList.AsEnumerable()
            };
            return query.Skip((currentPage - 1) * pageSize).Take(pageSize);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        currentRole = appUser!.Role;
        currentUserId = appUser.Id;

        if (currentRole == "AdminGudangBarang")
        {
            baList = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj).Include(b => b.Mengetahui)
                .Where(b => b.CreatedBy == currentUserId &&
                            (b.Status == "WaitingPJSign" || b.Status == "WaitingApproval"))
                .OrderByDescending(b => b.SubmittedAt)
                .ToListAsync();
        }
        else if (currentRole == "Approver")
        {
            baList = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj)
                .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                .Where(b => b.MengetahuiId == currentUserId && b.Status == "WaitingApproval")
                .OrderByDescending(b => b.SubmittedAt)
                .ToListAsync();
        }
        isLoading = false;
    }

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        _ => "pill-lainnya"
    };

    private static string GetRelativeTime(DateTime? dt)
    {
        if (dt is null) return "-";
        var diff = DateTime.Now - dt.Value;
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes} menit lalu";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours} jam lalu";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} hari lalu";
        return dt.Value.ToString("dd MMM yyyy");
    }
}
