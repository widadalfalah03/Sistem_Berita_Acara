@page "/berita-acara/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject IEmailService EmailService
@inject INotificationService NotificationService
@inject IExcelService ExcelService
@inject IBACounterService BACounterService
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Detail Berita Acara — Sistem Berita Acara</PageTitle>


@* ── Fullscreen overlay saat approver memproses Setuju / Tolak ── *@
@if (isProcessing && isApproverAction)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(255,255,255,0.93);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
        <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-top:4px;">@approverActionLabel</div>
        <div style="font-size:13px;color:var(--text-muted);">@approverActionSubLabel</div>
    </div>
}

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat detail...</span></div>
}
else if (notFound || ba is null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-file-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;">Berita Acara tidak ditemukan</div>
    </div>
}
else
{
    <!-- Breadcrumb -->
    <button class="breadcrumb-back" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i>
        Kembali
    </button>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        var isError = actionMessage.StartsWith("Gagal");
        <div style="background:@(isError ? "var(--danger-light)" : "#F0FDF4");border:1px solid @(isError ? "var(--danger)" : "#22C55E");border-radius:var(--radius);padding:14px 20px;margin-bottom:20px;display:flex;align-items:center;gap:10px;color:@(isError ? "var(--danger)" : "#16A34A");">
            <i class="bi @(isError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i>
            @actionMessage
        </div>
    }

    @if (isApprover && ba.Status == "WaitingApproval")
    {
        <!-- ════ REVIEW LAYOUT (Approver) ════ -->
        <div class="review-layout">
            <!-- Preview area -->
            <div class="review-preview">
                @if (!string.IsNullOrEmpty(ba.DocxPath) || !string.IsNullOrEmpty(ba.DocxFinalPath))
                {
                    var docPath = !string.IsNullOrEmpty(ba.DocxFinalPath) ? ba.DocxFinalPath : ba.DocxPath;
                    <div style="background:#E8EAF0;border-radius:var(--radius);height:80vh;min-height:800px;width:100%;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;box-shadow:inset 0 2px 10px rgba(0,0,0,.05);">
                        <iframe @key="DateTime.Now.Ticks" src="/@docPath!.Replace(".docx", ".pdf")?v=@(DateTime.Now.Ticks)#toolbar=1&navpanes=0" style="width:100%;height:100%;border:none;border-radius:var(--radius);" title="Pratinjau Dokumen"></iframe>
                    </div>
                }
                else
                {
                    <div style="text-align:center;">
                        <i class="bi bi-file-earmark-text" style="font-size:48px;display:block;margin-bottom:12px;"></i>
                        <div>Dokumen belum tersedia</div>
                    </div>
                }
            </div>

            <!-- Review Panel -->
            <div class="review-panel">
                <h3>Review & Status</h3>

                <div class="review-info">
                    <div class="review-info-item">
                        <span class="review-info-label">No. Surat</span>
                        <span class="review-info-value text-primary">@ba.NomorSurat</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Jenis</span>
                        <span class="review-info-value">@ba.Jenis</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Penanggung Jawab</span>
                        <span class="review-info-value">@ba.Pj?.Nama</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Fungsi</span>
                        <span class="review-info-value">@ba.Pj?.FungsiDirektorat</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Tanggal</span>
                        <span class="review-info-value">@ba.Tanggal.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot completed"></div>
                        <div class="timeline-content">
                            <div class="timeline-title">Dokumen Dibuat</div>
                            <div class="timeline-desc">@ba.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot completed"></div>
                        <div class="timeline-content">
                            <div class="timeline-title">PJ Menandatangani</div>
                            <div class="timeline-desc">@(ba.PjSignedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</div>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot pending"></div>
                        <div class="timeline-content">
                            <div class="timeline-title pending">Menunggu Persetujuan Anda</div>
                            <div class="timeline-desc">Harap review dokumen dan berikan keputusan</div>
                        </div>
                    </div>
                </div>

                <!-- Action buttons -->
                <div style="display:flex;gap:12px;margin-top:20px;">
                    <button class="btn btn-success @(isProcessing ? "btn-loading" : "")" style="flex:1;" @onclick="ApproveAsync" disabled="@isProcessing">
                        <i class="bi bi-check-lg"></i> Setujui
                    </button>
                    <button class="btn btn-outline-danger @(isProcessing ? "btn-loading" : "")" style="flex:1;" @onclick="() => showRejectModal = true" disabled="@isProcessing">
                        <i class="bi bi-x-lg"></i> Tolak
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ════ STANDARD DETAIL VIEW ════ -->
        <div class="page-header d-flex align-center justify-between">
            <div>
                <h1 class="page-title">@(ba.NomorSurat ?? "Draft BA")</h1>
                <div style="display:flex;align-items:center;gap:12px;margin-top:4px;">
                    <span class="pill @GetStatusPill(ba.Status)">@GetStatusLabel(ba.Status)</span>
                    <span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span>
                </div>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px;">
            <!-- Info Dokumen -->
            <div class="card">
                <div class="card-header"><h3>Informasi Dokumen</h3></div>
                <div class="card-body">
                    <table style="width:100%;border-collapse:collapse;">
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;width:40%;">No. Surat</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@(ba.NomorSurat ?? "Belum dibuat")</td></tr>
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tanggal</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Tanggal.ToString("dd MMMM yyyy")</td></tr>
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tiket SSC</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@(ba.TiketSscNo ?? "-")</td></tr>
                        @if (ba.Jenis == "Peminjaman")
                        {
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tgl Kembali</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@(ba.TanggalKembali?.ToString("dd MMMM yyyy") ?? "-")</td></tr>
                        }
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Dibuat Oleh</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Creator?.Nama</td></tr>
                    </table>
                </div>
            </div>

            <!-- Pihak Terkait -->
            <div class="card">
                <div class="card-header"><h3>Pihak Terkait</h3></div>
                <div class="card-body">
                    <table style="width:100%;border-collapse:collapse;">
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;width:40%;">PJ (Menerima)</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Pj?.Nama</td></tr>
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Menyerahkan</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Menyerahkan?.Nama</td></tr>
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Approver</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Mengetahui?.Nama</td></tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Perangkat -->
        @if (ba.Perangkat?.Any() == true)
        {
            <div class="card" style="margin-bottom:24px;">
                <div class="card-header"><h3>Daftar Perangkat</h3></div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th style="cursor:pointer;" @onclick="@(() => SortTable("Perangkat"))">Perangkat <i class="bi @GetSortIcon("Perangkat")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                            <th style="cursor:pointer;" @onclick="@(() => SortTable("Jumlah"))">Jumlah <i class="bi @GetSortIcon("Jumlah")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                            <th style="cursor:pointer;" @onclick="@(() => SortTable("Satuan"))">Satuan <i class="bi @GetSortIcon("Satuan")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                            <th style="cursor:pointer;" @onclick="@(() => SortTable("No. Serial"))">No. Serial <i class="bi @GetSortIcon("No. Serial")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                            <th style="cursor:pointer;" @onclick="@(() => SortTable("Keterangan"))">Keterangan <i class="bi @GetSortIcon("Keterangan")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in SortedPerangkat)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Barang?.NamaBarang</td>
                                <td>@p.Jumlah</td>
                                <td>@p.Satuan</td>
                                <td>@(p.NoSerial ?? "-")</td>
                                <td>@(p.Keterangan ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Action buttons for AdminGudang -->
        @if (currentRole == "AdminGudangBarang")
        {
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                @if (ba.Status == "Draft")
                {
                    <button class="btn btn-primary @(isProcessing ? "btn-loading" : "")" @onclick="SendMagicLinkAsync" disabled="@isProcessing">
                        <i class="bi bi-send"></i> Kirim Notifikasi ke PJ
                    </button>
                }
                else if (ba.Status == "WaitingPJSign")
                {
                    <div style="background:var(--primary-light);border-radius:var(--radius);padding:14px 20px;display:flex;align-items:center;gap:10px;color:var(--primary);">
                        <i class="bi bi-hourglass-split"></i>
                        Menunggu PJ menandatangani dokumen
                    </div>
                }
                else if (ba.Status == "Rejected")
                {
                    <div style="background:var(--danger-light);border-radius:var(--radius);padding:14px 20px;flex:1;">
                        <div style="color:var(--danger);font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px;">
                            <i class="bi bi-x-circle-fill"></i> Ditolak
                        </div>
                        <div style="font-size:14px;color:var(--text-secondary);">@ba.AlasanReject</div>
                    </div>
                }
            </div>
        }
    }
}

<!-- Reject Modal -->
@if (showRejectModal)
{
    <div class="modal-overlay" @onclick="() => showRejectModal = false">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => showRejectModal = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="margin-bottom:20px;">
                <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Tolak Berita Acara</div>
                <div style="font-size:14px;color:var(--text-secondary);">Berikan alasan penolakan yang jelas</div>
            </div>
            <div class="form-group">
                <label class="form-label">Alasan Penolakan <span style="color:var(--danger)">*</span></label>
                <textarea class="form-control" rows="4" @bind="rejectReason" style="resize:none;"
                          placeholder="Contoh: Dokumen tidak lengkap, nomor serial tidak sesuai..."></textarea>
            </div>
            @if (!string.IsNullOrEmpty(rejectError))
            {
                <div class="login-error" style="margin-bottom:12px;">@rejectError</div>
            }
            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
                <button class="btn btn-danger @(isProcessing ? "btn-loading" : "")" @onclick="RejectAsync" disabled="@isProcessing">
                    <i class="bi bi-x-lg"></i> Tolak
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private BeritaAcaraEntity? ba;
    private bool isLoading = true;
    private bool notFound;
    private bool isApprover;
    private bool showRejectModal = false;
    private string rejectReason = string.Empty;
    private string rejectError = string.Empty;
    private string actionMessage = string.Empty;
    private string currentRole = string.Empty;
    private bool isProcessing = false;
    private bool isApproverAction = false;
    private string approverActionLabel = string.Empty;
    private string approverActionSubLabel = string.Empty;

    private string sortColumn = "Perangkat";
    private bool sortAscending = true;

    private void SortTable(string column)
    {
        if (sortColumn == column) sortAscending = !sortAscending;
        else { sortColumn = column; sortAscending = true; }
    }

    private string GetSortIcon(string column) => sortColumn != column ? "bi-arrow-down-up" : sortAscending ? "bi-arrow-up text-primary" : "bi-arrow-down text-primary";

    private IEnumerable<PerangkatBA> SortedPerangkat
    {
        get
        {
            if (ba?.Perangkat == null) return Enumerable.Empty<PerangkatBA>();
            return sortColumn switch
            {
                "Perangkat" => sortAscending ? ba.Perangkat.OrderBy(p => p.Barang?.NamaBarang) : ba.Perangkat.OrderByDescending(p => p.Barang?.NamaBarang),
                "Jumlah" => sortAscending ? ba.Perangkat.OrderBy(p => p.Jumlah) : ba.Perangkat.OrderByDescending(p => p.Jumlah),
                "Satuan" => sortAscending ? ba.Perangkat.OrderBy(p => p.Satuan) : ba.Perangkat.OrderByDescending(p => p.Satuan),
                "No. Serial" => sortAscending ? ba.Perangkat.OrderBy(p => p.NoSerial) : ba.Perangkat.OrderByDescending(p => p.NoSerial),
                "Keterangan" => sortAscending ? ba.Perangkat.OrderBy(p => p.Keterangan) : ba.Perangkat.OrderByDescending(p => p.Keterangan),
                _ => ba.Perangkat
            };
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        if (appUser is null) { Navigation.NavigateTo("/login", true); return; }
        currentRole = appUser.Role;

        ba = await DbContext.Set<BeritaAcaraEntity>()
            .Include(x => x.Pj)
            .Include(x => x.Menyerahkan)
            .Include(x => x.Mengetahui)
            .Include(x => x.Creator)
            .Include(x => x.Perangkat).ThenInclude(p => p.Barang)
            .Include(x => x.BuktiFotos)
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (ba is null) { notFound = true; isLoading = false; return; }

        isApprover = currentRole == "Approver" && appUser.Id == ba.MengetahuiId;

        // Embed signature of Approver for preview purposes if they are viewing it
        if (isApprover && ba.Status == "WaitingApproval" && !string.IsNullOrEmpty(appUser.TtdPath))
        {
            var ttdPhysicalPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", appUser.TtdPath.Replace("/", Path.DirectorySeparatorChar.ToString()));
            try
            {
                await DocumentService.EmbedTtdPreviewApproverAsync(ba.Id, ttdPhysicalPath);
            }
            catch { /* Ignore if it's already embedded or fails */ }
        }

        isLoading = false;
    }

    private async Task SendMagicLinkAsync()
    {
        isProcessing = true;
        try
        {
            var tokenValue = Guid.NewGuid().ToString("N");
            DbContext.ApprovalToken.Add(new ApprovalToken { BaId = ba!.Id, Token = tokenValue, ExpiresAt = DateTime.Now.AddDays(7) });
            ba!.Status = "WaitingPJSign";
            ba.SubmittedAt = DateTime.Now;
            await DbContext.SaveChangesAsync();
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            await EmailService.SendMagicLinkAsync(ba.Pj!.Email ?? string.Empty, ba.Pj.Nama, ba.Id, tokenValue, baseUrl);
            await NotificationService.SendToRoleAsync("AdminGudangBarang", "WAITING_PJ_SIGN", $"BA {ba.NomorSurat} dikirim ke PJ untuk ditandatangani.", ba.Id);
            actionMessage = "Magic link berhasil dikirim ke email PJ.";
            await LoadAsync();
        }
        catch (Exception ex) { actionMessage = $"Gagal: {ex.Message}"; }
        finally { isProcessing = false; }
    }

    private async Task ApproveAsync()
    {
        isProcessing = true;
        isApproverAction = true;
        approverActionLabel = "Menyetujui dokumen...";
        approverActionSubLabel = "Menyematkan tanda tangan dan membuat dokumen final";
        await InvokeAsync(StateHasChanged);
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
            var approverTtdPhysical = string.IsNullOrWhiteSpace(currentUser?.TtdPath)
                ? null
                : Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", currentUser.TtdPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
            if (currentUser is null || approverTtdPhysical is null || !File.Exists(approverTtdPhysical))
            {
                actionMessage = "Gagal: Approver belum memiliki file TTD yang valid. Silakan setup TTD di halaman Profil terlebih dahulu.";
                isProcessing = false;
                return;
            }

            // Generate nomor surat saat approve
            if (string.IsNullOrEmpty(ba!.NomorSurat))
            {
                var next = await BACounterService.GetNextNomorSuratAsync(ba.Tanggal);
                ba.CounterValue = next.counterValue;
                ba.NomorSurat = next.nomorSurat;
            }

            // Regenerate dokumen final dengan nomor surat yang sudah ada
            ba.DocxPath = await DocumentService.GenerateDocxAsync(ba);

            // Re-embed TTD Yang Menyerahkan (Admin Gudang yang membuat BA)
            var creatorForTtd = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            if (!string.IsNullOrWhiteSpace(creatorForTtd?.TtdPath))
            {
                var menyerahkanTtdPhysical = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                    creatorForTtd.TtdPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(menyerahkanTtdPhysical))
                    await DocumentService.EmbedTtdMenyerahkanAsync(ba.Id, menyerahkanTtdPhysical);
            }

            // Re-embed TTD PJ (Yang Menerima) — file masih ada, dihapus setelah ini
            if (!string.IsNullOrWhiteSpace(ba.TtdPjPath))
            {
                var pjTtdPhysical = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                    ba.TtdPjPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(pjTtdPhysical))
                {
                    await DocumentService.EmbedTtdPjAsync(ba.Id, pjTtdPhysical);
                    // Hapus file TTD PJ sekarang — sudah di-embed ke dokumen final
                    try { File.Delete(pjTtdPhysical); } catch { }
                }
            }

            // Embed TTD Yang Mengetahui (Approver)
            await DocumentService.EmbedTtdMengetahuiAsync(ba.Id, approverTtdPhysical);
            ba.Status = "Approved";
            ba.ApprovedAt = DateTime.Now;
            await DbContext.SaveChangesAsync();
            await ExcelService.AppendBeritaAcaraToArsipAsync(ba);
            await NotificationService.SendAsync(ba.CreatedBy, "BA_APPROVED", $"BA {ba.NomorSurat} telah disetujui.", ba.Id);

            // Email ke Admin Gudang & Barang (creator)
            var creatorUser = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            if (!string.IsNullOrEmpty(creatorUser?.Email))
                await EmailService.SendApprovalResultAsync(creatorUser.Email, creatorUser.Nama ?? creatorUser.Email, ba.NomorSurat!, true);

            // Email ke PJ
            if (!string.IsNullOrEmpty(ba.Pj?.Email))
                await EmailService.SendApprovalResultAsync(ba.Pj.Email, ba.Pj.Nama, ba.NomorSurat!, true);

            actionMessage = "Berita Acara berhasil disetujui!";
            await LoadAsync();
        }
        catch (Exception ex) { actionMessage = $"Gagal: {ex.Message}"; }
        finally { isProcessing = false; isApproverAction = false; }
    }

    private async Task RejectAsync()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)) { rejectError = "Alasan penolakan wajib diisi."; return; }
        isProcessing = true;
        isApproverAction = true;
        approverActionLabel = "Menolak dokumen...";
        approverActionSubLabel = "Menyimpan alasan penolakan dan mengirim notifikasi";
        await InvokeAsync(StateHasChanged);
        try
        {
            ba!.Status = "Rejected";
            ba.AlasanReject = rejectReason;
            ba.ApprovedAt = DateTime.Now;
            await DbContext.SaveChangesAsync();
            var label = ba.NomorSurat ?? "Draft";
            await NotificationService.SendAsync(ba.CreatedBy, "BA_REJECTED", $"BA {label} ditolak: {rejectReason}", ba.Id);

            // Email ke Admin Gudang & Barang (creator)
            var creatorUser = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            if (!string.IsNullOrEmpty(creatorUser?.Email))
                await EmailService.SendApprovalResultAsync(creatorUser.Email, creatorUser.Nama ?? creatorUser.Email, label, false, rejectReason);

            // Email ke PJ
            if (!string.IsNullOrEmpty(ba.Pj?.Email))
                await EmailService.SendApprovalResultAsync(ba.Pj.Email, ba.Pj.Nama, label, false, rejectReason);

            showRejectModal = false;
            rejectReason = string.Empty;
            actionMessage = "Berita Acara telah ditolak.";
            await LoadAsync();
        }
        catch (Exception ex) { rejectError = $"Gagal: {ex.Message}"; }
        finally { isProcessing = false; isApproverAction = false; }
    }

    private static string GetStatusPill(string s) => s switch
    {
        "Draft" => "pill-draft",
        "WaitingPJSign" => "pill-waiting-pj",
        "WaitingApproval" => "pill-waiting-approval",
        "Approved" => "pill-approved",
        "Rejected" => "pill-rejected",
        _ => "pill-draft"
    };

    private static string GetStatusLabel(string s) => s switch
    {
        "Draft" => "Draft",
        "WaitingPJSign" => "Menunggu TTD PJ",
        "WaitingApproval" => "Menunggu Approval",
        "Approved" => "Disetujui",
        "Rejected" => "Ditolak",
        _ => s
    };

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private void GoBack()
    {
        var dest = From == "progress" ? "/progress"
                 : From == "archive" ? "/archive"
                 : From == "dashboard" ? "/dashboard"
                 : From == "notifikasi" ? "/notifikasi"
                 : "/draft";
                 
        if (currentRole == "Approver" && string.IsNullOrEmpty(From))
            dest = "/dashboard";

        Navigation.NavigateTo(dest);
    }

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        _ => "pill-lainnya"
    };
}

