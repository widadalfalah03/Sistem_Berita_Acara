@page "/berita-acara/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject IEmailService EmailService
@inject INotificationService NotificationService
@inject IExcelService ExcelService
@inject IBACounterService BACounterService
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject SistemBeritaAcara.Web.Services.BaUpdateService BaUpdateService

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

<PageTitle>Detail Berita Acara — Sistem Berita Acara</PageTitle>



@if (isProcessing && isReviewerAction)
{
    <div
        style="position:fixed;inset:0;z-index:10000;background:var(--bg-overlay);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner"
             style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
    </div>
}

@if (isLoading)
{
    <div class="loading-spinner">
        <div class="spinner"></div>
    </div>
}
else if (loadError is not null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-exclamation-triangle"
           style="font-size:48px;display:block;margin-bottom:16px;color:var(--danger);"></i>
        <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Gagal memuat halaman</div>
        <div style="font-size:13px;color:var(--text-secondary);margin-bottom:20px;">@loadError</div>
        <button class="btn btn-primary" @onclick="() => Navigation.NavigateTo(Navigation.Uri, true)">Muat Ulang</button>
    </div>
}
else if (notFound || ba is null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-file-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;">Berita Acara tidak ditemukan</div>
    </div>
}
else if (reviewerLinkInvalid)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 24px;text-align:center;">
        <div style="width:72px;height:72px;border-radius:50%;background:var(--danger-light,#FEE2E2);display:flex;align-items:center;justify-content:center;margin-bottom:24px;">
            <i class="bi bi-file-x" style="font-size:34px;color:var(--danger);"></i>
        </div>
        <div style="font-size:22px;font-weight:700;margin-bottom:10px;">Pengajuan Dibatalkan</div>
        <div style="font-size:14px;color:var(--text-secondary);max-width:400px;line-height:1.7;margin-bottom:28px;">
            Berita Acara yang ditujukan kepada Anda sudah <strong>dibatalkan oleh Admin BA</strong>
            sebelum Anda sempat memprosesnya.
        </div>
        <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/dashboard"))">
            Kembali ke Dashboard
        </button>
    </div>
}
else
{
    <button class="breadcrumb-back" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i>
        Kembali
    </button>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div
            style="background:@(actionIsError ? "var(--danger-light)" : "#F0FDF4");border:1px solid @(actionIsError ? "var(--danger)" : "#22C55E");border-radius:var(--radius);padding:14px 20px;margin-bottom:20px;display:flex;align-items:center;gap:10px;color:@(actionIsError ? "var(--danger)" : "#16A34A");">
            <i class="bi @(actionIsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i>
            @actionMessage
        </div>
    }

    @if (isReviewer && ba.Status == "WaitingApproval")
    {
        <div class="review-layout">
            <div class="review-preview">
                @if (!string.IsNullOrEmpty(ba.DocxPath) || !string.IsNullOrEmpty(ba.DocxFinalPath))
                {
                    <div class="pdf-preview-container"
                         style="background:#E8EAF0;border-radius:var(--radius);width:100%;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;box-shadow:inset 0 2px 10px rgba(0,0,0,.05);">
                        <iframe class="hide-on-mobile" @key="pdfVersion" src="/api/preview/pdf/@ba.Id?v=@pdfVersion#toolbar=1&navpanes=0"
                                style="width:100%;height:100%;border:none;border-radius:var(--radius);"
                                title="Pratinjau Dokumen"></iframe>
                        <div id="pdf-render-container-detail" class="show-on-mobile"
                             style="width:100%;height:100%;overflow-y:auto;"></div>
                    </div>
                }
                else
                {
                    <div style="text-align:center;">
                        <i class="bi bi-file-earmark-text" style="font-size:48px;display:block;margin-bottom:12px;"></i>
                        <div>Dokumen belum tersedia</div>
                    </div>
                }
            </div>

            <div class="review-panel">
                <h3>Review & Status</h3>

                <div class="review-info">
                    <div class="review-info-item">
                        <span class="review-info-label">No. Surat</span>
                        <span class="review-info-value" style="color:var(--text-muted);font-style:italic;font-size:12px;">dibuat
                            saat PJ tanda tangan</span>
                        </div>
                        <div class="review-info-item">
                            <span class="review-info-label">Jenis Berita Acara</span>
                            <span class="review-info-value">@ba.Jenis</span>
                        </div>
                        <div class="review-info-item">
                            <span class="review-info-label">Penanggung Jawab</span>
                            <span class="review-info-value">@ba.Pj?.Nama</span>
                        </div>
                        <div class="review-info-item">
                            <span class="review-info-label">Fungsi</span>
                            <span class="review-info-value">@ba.Pj?.FungsiDirektorat</span>
                        </div>
                        <div class="review-info-item">
                            <span class="review-info-label">Tanggal</span>
                            <span class="review-info-value">@ba.Tanggal.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-dot completed"></div>
                            <div class="timeline-content">
                                <div class="timeline-title">Dokumen Dibuat</div>
                                <div class="timeline-desc">@ba.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-dot pending"></div>
                            <div class="timeline-content">
                                <div class="timeline-title pending">Menunggu Tanda Tangan Anda</div>
                                <div class="timeline-desc">Harap review dokumen dan berikan keputusan</div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-dot" style="background-color: var(--border);"></div>
                            <div class="timeline-content">
                                <div class="timeline-title" style="color:var(--text-muted);">Tanda Tangan PJ</div>
                                <div class="timeline-desc" style="color:var(--text-muted);">Setelah Anda menandatangani dokumen ini
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="display:flex;gap:10px;margin-top:24px;">
                        <button class="btn btn-danger @(isProcessing ? "btn-loading" : "")"
                                style="flex:0 0 auto;"
                                @onclick="() => showRejectModal = true" disabled="@isProcessing">
                            Tolak
                        </button>
                        <button class="btn btn-primary @(isProcessing ? "btn-loading" : "")"
                                style="flex:1;"
                                @onclick="ApproveAsync" disabled="@isProcessing">
                            Tandatangani
                        </button>
                    </div>
                </div>
            </div>
        }
    else
        {
            <div class="page-header d-flex align-center justify-between" style="flex-wrap:wrap; gap:12px;">
                <div style="width:100%; display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h1 class="page-title" style="word-break:break-word;">@(ba.NomorSurat ?? "Draft Berita Acara")</h1>
                        <div style="display:flex;align-items:center;gap:12px;margin-top:4px;flex-wrap:wrap;">
                            @if (_initialFrom != "archive" && ba.Status != "Archived" && ba.Status != "Approved")
                            {
                                <span class="pill @GetStatusPill(ba.Status)">@GetStatusLabel(ba.Status)</span>
                            }
                            <span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span>
                        </div>
                    </div>
                    @if (ba.Status == "Rejected" && currentRole == "AdminBA")
                    {
                        <button class="btn btn-primary" @onclick="NavigateToRevisi">
                            Revisi
                        </button>
                    }
                </div>
            </div>

        
        @if (currentRole == "AdminBA")
        {
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                @if (ba.Status == "Draft")
                {
                    <button class="btn btn-primary @(isProcessing ? "btn-loading" : "")" @onclick="SubmitToReviewerAsync" disabled="@isProcessing">
                        <i class="bi bi-person-check"></i> Ajukan ke Reviewer
                    </button>
                }
                else if (ba.Status == "WaitingPJSign")
                {
                    <div style="background:var(--primary-light);border-radius:var(--radius);padding:14px 20px;display:flex;align-items:center;gap:10px;color:var(--primary);">
                        <i class="bi bi-hourglass-split"></i>
                        Menunggu PJ menandatangani dokumen
                    </div>
                }
                else if (ba.Status == "Rejected")
                {
                    <div style="background:var(--danger-light);border-radius:var(--radius);padding:14px 20px;flex:1;">
                        <div style="color:var(--danger);font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px;">
                            <i class="bi bi-x-circle-fill"></i> Ditolak
                        </div>                        <div style="font-size:14px;color:var(--text-secondary);">@ba.AlasanReject</div>
                    </div>
                }
            </div>
        }

        <div class="info-grid-2">
                <div class="card">
                    <div class="card-header">
                        <h3>Informasi Dokumen</h3>
                    </div>
                    <div class="card-body">
                        <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                            <tr>
                                <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;width:40%;">No. Surat</td>
                                <td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@(ba.NomorSurat ??
                                                                                                "Belum dibuat")</td>
                                </tr>
                                <tr>
                                    <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tanggal</td>
                                    <td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">
                                        @ba.Tanggal.ToString("dd MMMM yyyy")</td>
                                    </tr>
                                    @if (ba.Jenis == "Lainnya")
                                    {
                                        <tr>
                                            <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Judul Berita Acara</td>
                                            <td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@(ba.JenisCustom ??
                                                                                                           "-")</td>
                                            </tr>
                                            <tr>
                                                <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Keterangan</td>
                                                <td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@(ba.Keterangan ??
                                                                                                               "-")</td>
                                                </tr>
                                            }
                                            @if (ba.Jenis != "Lainnya")
                                            {
                                                <tr>
                                                    <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">No. Tiket My SSC/Nota Dinas
                                                    </td>
                                                    <td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@(ba.TiketSscNo ??
                                                                                                                         "-")</td>
                                                    </tr>
                                                }
                                                @if (ba.Jenis == "Peminjaman")
                                                {
                                                    <tr>
                                                        <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tanggal Kembali</td>
                                                        <td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">
                                                            @(ba.TanggalKembali?.ToString("dd MMMM yyyy") ?? "-")</td>
                                                        </tr>
                                                    }
                                                </table>
                                            </div>
                                        </div>

                                        @if (ba.Jenis != "Lainnya")
                                        {
                                            <div class="card">
                                                <div class="card-header">
                                                    <h3>Pihak Terkait</h3>
                                                </div>
                                                <div class="card-body">
                                                    <table style="width:100%;border-collapse:collapse;">
                                                        <tr>
                                                            <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;width:40%;">Yang Menerima</td>
                                                            <td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Pj?.Nama</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Yang Menyerahkan</td>
                                                            <td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Menyerahkan?.Nama</td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Yang Mengetahui</td>
                                                            <td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Mengetahui?.Nama</td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @if (ba.Jenis != "Lainnya" && ba.Perangkat?.Any() == true)
                                    {
                                        <div class="card" style="margin-bottom:24px;">
                                            <div class="card-header">
                                                <h3>Daftar Perangkat</h3>
                                            </div>
                                            <div class="table-responsive perangkat-table">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Perangkat</th>
                                                            <th>Jumlah</th>
                                                            <th>Satuan</th>
                                                            <th>No. Serial</th>
                                                            <th>Keterangan</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var p in ba.Perangkat)
                                                        {
                                                            <tr>
                                                                <td class="fw-semibold">@p.Barang?.NamaBarang</td>
                                                                <td>@p.Jumlah</td>
                                                                <td>@p.Satuan</td>
                                                                <td>@(p.NoSerial ?? "-")</td>
                                                                <td>@(p.Keterangan ?? "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="perangkat-mobile-list" style="padding:16px;">
                                                @foreach (var p in ba.Perangkat)
                                                {
                                                    <div
                                                        style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--border-light);font-size:13px;">
                                                        <div>
                                                            <div style="font-weight:700;color:var(--text-primary);margin-bottom:4px;font-size:14px;">
                                                                @p.Barang?.NamaBarang</div>
                                                                @if (!string.IsNullOrEmpty(p.NoSerial))
                                                                {
                                                                    <div style="color:var(--text-secondary);margin-bottom:2px;">SN: @p.NoSerial</div>
                                                                }
                                                                @if (!string.IsNullOrEmpty(p.Keterangan))
                                                                {
                                                                    <div style="color:var(--text-muted);">@p.Keterangan</div>
                                                                }
                                                            </div>
                                                            <div style="text-align:right;">
                                                                <div style="font-size:18px;font-weight:800;color:var(--primary);">@p.Jumlah</div>
                                                                <div style="font-size:12px;color:var(--text-secondary);text-transform:uppercase;">@p.Satuan</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                    }
                                }

                                @if (showRejectModal)
                                {
                                    <div class="modal-overlay" @onclick="() => showRejectModal = false">
                                        <div class="modal-content" @onclick:stopPropagation>
                                            <button class="modal-close" @onclick="() => showRejectModal = false">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                            <div style="margin-bottom:20px;">
                                                <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Tolak Berita Acara
                                                </div>
                                                <div style="font-size:14px;color:var(--text-secondary);">Berikan alasan penolakan yang jelas</div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Alasan Penolakan <span style="color:var(--danger)">*</span></label>
                                                <textarea class="form-control" rows="4" @bind="rejectReason" style="resize:none;"
                                                          placeholder="Contoh: Dokumen tidak lengkap, nomor serial tidak sesuai..."></textarea>
                                            </div>
                                            @if (!string.IsNullOrEmpty(rejectError))
                                            {
                                                <div class="login-error" style="margin-bottom:12px;">@rejectError</div>
                                            }
                                            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
                                                <button class="btn btn-danger @(isProcessing ? "btn-loading" : "")" @onclick="RejectAsync"
                                                        disabled="@isProcessing">
                                                    Tolak
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }

@code {
    [Parameter] public int Id { get; set; }

    private BeritaAcaraEntity? ba;
    private bool isLoading = true;
    private bool notFound;
    private bool reviewerLinkInvalid;
    private string? _initialFrom;
    private bool isReviewer;
    private bool showRejectModal = false;
    private string rejectReason = string.Empty;
    private string rejectError = string.Empty;
    private string actionMessage = string.Empty;
    private bool actionIsError = false;
    private string currentRole = string.Empty;
    private int currentUserId;
    private bool isProcessing = false;
    private bool isReviewerAction = false;
    private string reviewerActionLabel = string.Empty;
    private string reviewerActionSubLabel = string.Empty;
    private long pdfVersion = DateTime.UtcNow.Ticks;



    protected override async Task OnInitializedAsync()
    {
        _initialFrom = From;
        await LoadAsync();
    }

    private string? loadError;
    private bool _loadingInProgress = false;

    private async Task LoadAsync()
    {
        if (_loadingInProgress) return;
        _loadingInProgress = true;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = auth.User.Identity?.Name;
            if (string.IsNullOrEmpty(userName))
            {
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}", true);
                return;
            }

            var appUser = await UserManager.FindByEmailAsync(userName);
            if (appUser is null)
            {
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}", true);
                return;
            }
            currentRole = appUser.Role;
            currentUserId = appUser.Id;

            DbContext.ChangeTracker.Clear();
            ba = await DbContext.Set<BeritaAcaraEntity>()
                .Include(x => x.Pj)
                .Include(x => x.Menyerahkan)
                .Include(x => x.Mengetahui)
                .Include(x => x.Creator)
                .Include(x => x.Perangkat).ThenInclude(p => p.Barang)
                .Include(x => x.BuktiFotos)
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (ba is null) { notFound = true; isLoading = false; return; }

            isReviewer = currentRole == "Reviewer" && appUser.Id == ba.MengetahuiId;

            
            if (From == "review" && !isReviewer)
            {
                Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)}", true);
                return;
            }

            
            if (From == "rejected" && currentRole != "AdminBA")
            {
                Navigation.NavigateTo("/akses-ditolak", true);
                return;
            }

            
            
            if (isReviewer && ba.Status == "Draft")
            {
                reviewerLinkInvalid = true;
                isLoading = false;
                return;
            }



            
            bool isCreator = appUser.Id == ba.CreatedBy;
            bool isRelatedParty = appUser.Id == ba.MengetahuiId || appUser.Id == ba.MenyerahkanId;
            
            if (!isCreator && !isRelatedParty && currentRole != "AdminIT" && currentRole != "AdminBA")
            {
                Navigation.NavigateTo("/akses-ditolak", true);
                return;
            }

            pdfVersion = DateTime.UtcNow.Ticks;
            isLoading = false;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            isLoading = false;
        }
        finally
        {
            _loadingInProgress = false;
        }
    }

    private async Task SubmitToReviewerAsync()
    {
        isProcessing = true;
        try
        {
            ba!.Status = "WaitingApproval";            ba.SubmittedAt = DateTime.Now;
            ba.AlasanReject = null; 
            await DbContext.SaveChangesAsync();

            await NotificationService.SendAsync(
                ba.MengetahuiId ?? 0,
                "WAITING_APPROVAL",
                $"Berita Acara {ba.Jenis} {(ba.NomorSurat ?? "")} telah diajukan dan membutuhkan persetujuan Anda.".Replace("  ", " ").Trim(),
                ba.Id
            );

            await NotificationService.SendAsync(
                ba.CreatedBy,
                "WAITING_APPROVAL",
                $"Berita Acara {ba.Jenis} telah diajukan. Menunggu persetujuan Reviewer.",
                ba.Id
            );

            var baseUrlReviewer = (Configuration["App:BaseUrl"] ?? Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');
            var barangListReviewer = ba.Perangkat
                .Select(p => {                    string nama = p.Barang?.NamaBarang ?? "Perangkat";
                    string detail = $"{p.Jumlah} {p.Satuan}";
                    if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                    if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                    return $"{nama} — {detail}";
                }).ToList();

            if (!string.IsNullOrEmpty(ba.Mengetahui?.Email))
            {
                await EmailService.SendApprovalRequestAsync(
                    ba.Mengetahui.Email,
                    ba.Mengetahui.Nama ?? "Reviewer",
                    baseUrlReviewer,
                    ba.Id,
                    ba.Jenis ?? "Berita Acara",
                    barangListReviewer
                );
            }

            actionIsError = false; actionMessage = "Berita Acara berhasil diajukan ke Reviewer.";            await LoadAsync();
        }
        catch (Exception ex)
        {
            actionIsError = true; actionMessage = $"Gagal: {ex.Message}{(ex.InnerException != null ? " — " +
ex.InnerException.Message : "")}";
        }
        finally { isProcessing = false; }
    }

    private async Task ApproveAsync()
    {
        isProcessing = true;
        isReviewerAction = true;
        reviewerActionLabel = "Menyetujui dokumen...";
        reviewerActionSubLabel = "Menyematkan tanda tangan dan membuat dokumen final";
        await InvokeAsync(StateHasChanged);
        try
        {
            await DbContext.Entry(ba!).ReloadAsync();
            if (ba!.Status != "WaitingApproval")
            {
                actionIsError = true; actionMessage = "Gagal: Status BA sudah berubah (mungkin sudah diproses). Refresh halaman dan coba lagi.";
                isProcessing = false; isReviewerAction = false; return;
            }

            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
            var reviewerTtdPhysical = string.IsNullOrWhiteSpace(currentUser?.TtdPath)
                ? null
                : Path.Combine(Directory.GetCurrentDirectory(), "AppFiles", currentUser.TtdPath.TrimStart('/').Replace("files/", "").Replace('/', Path.DirectorySeparatorChar));
            if (currentUser is null || reviewerTtdPhysical is null || !File.Exists(reviewerTtdPhysical))
            {
                actionIsError = true; actionMessage = "Gagal: Reviewer belum memiliki file TTD yang valid. Silakan setup TTD di halaman Profil terlebih dahulu.";
                isProcessing = false;
                return;
            }

            await DocumentService.EmbedTtdMengetahuiAsync(ba.Id, reviewerTtdPhysical);

            var oldTokens = await DbContext.ApprovalToken
                .Where(t => t.BaId == ba!.Id && t.TokenType == "PJ_SIGNATURE" && t.UsedAt == null)
                .ToListAsync();
            foreach (var old in oldTokens)
                old.UsedAt = DateTime.Now;

            var tokenValue = Guid.NewGuid().ToString("N");
            var newToken = new ApprovalToken
            {
                BaId = ba!.Id,
                Token = tokenValue,
                TokenType = "PJ_SIGNATURE",
                ExpiresAt =
DateTime.Now.AddDays(7)
            };
            DbContext.ApprovalToken.Add(newToken);

            ba.Status = "WaitingPJSign";
            await DbContext.SaveChangesAsync();

            
            Hangfire.BackgroundJob.Schedule<SistemBeritaAcara.Infrastructure.Jobs.AutoApproveJob>(
                job => job.ProcessSingleAutoApproveAsync(ba.Id),
                TimeSpan.FromHours(24)
            );

            var baseUrl = (Configuration["App:BaseUrl"] ??
Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');
            var barangList = ba.Perangkat
                .Select(p =>
                {
                    string nama = p.Barang?.NamaBarang ?? "Perangkat";
                    string detail = $"{p.Jumlah} {p.Satuan}";
                    if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                    if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                    return $"{nama} — {detail}";
                }).ToList();

            await EmailService.SendMagicLinkAsync(ba.Pj!.Email ?? string.Empty, ba.Pj.Nama, ba.Id, tokenValue, baseUrl, ba.Jenis,
            barangList);

            await NotificationService.SendAsync(ba.CreatedBy, "WAITING_PJ_SIGN", $"Berita Acara {ba.Jenis} telah disetujui Reviewer dan diteruskan ke PJ.", ba.Id);

            actionIsError = false; actionMessage = "Berita Acara disetujui. Menunggu TTD PJ.";
            await BaUpdateService.NotifyBaDetailUpdated(ba.Id); 
            await LoadAsync();
        }
        catch (Exception ex)
        {
            actionIsError = true; actionMessage = $"Gagal: {ex.Message}{(ex.InnerException != null ? " — " +
ex.InnerException.Message : "")}";
        }
        finally { isProcessing = false; isReviewerAction = false; }
    }

    private async Task RejectAsync()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)) { rejectError = "Alasan penolakan wajib diisi."; return; }
        isProcessing = true;
        isReviewerAction = true;
        reviewerActionLabel = "Menolak dokumen...";
        reviewerActionSubLabel = "Menyimpan alasan penolakan dan mengirim notifikasi";
        await InvokeAsync(StateHasChanged);
        try
        {
            await DbContext.Entry(ba!).ReloadAsync();
            if (ba!.Status != "WaitingApproval")
            {
                rejectError = "Status BA sudah berubah (mungkin sudah diproses). Refresh halaman dan coba lagi.";
                isProcessing = false; isReviewerAction = false; return;
            }

            await using var txReject = await DbContext.Database.BeginTransactionAsync();
            ba!.Status = "Rejected";
            ba.AlasanReject = rejectReason;
            ba.WasRejected = true;
            ba.ApprovedAt = DateTime.Now;
            await DbContext.SaveChangesAsync();

            var history = new SistemBeritaAcara.Core.Entities.BeritaAcaraHistory
            {
                BaId = ba.Id,
                RejectedByUserId = currentUserId,
                AlasanReject = rejectReason,
                RejectedAt = DateTime.Now,
                BaJenis = ba.Jenis,
                BaNomorSurat = ba.NomorSurat,
                BaCreatedBy = ba.CreatedBy,
                BaMengetahuiId = ba.MengetahuiId,
            };
            DbContext.BeritaAcaraHistory.Add(history);
            await DbContext.SaveChangesAsync();
            await txReject.CommitAsync();

            var label = ba.NomorSurat ?? "";
            var text = $"Berita Acara {ba.Jenis} {label} ditolak: {rejectReason}".Replace("  ", " ").Trim();
            await NotificationService.SendAsync(ba.CreatedBy, "BA_REJECTED", text, ba.Id);

            var baseUrlReject = (Configuration["App:BaseUrl"] ??
Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');
            var barangListReject = ba.Perangkat
                .Select(p =>
                {
                    string nama = p.Barang?.NamaBarang ?? "Perangkat";
                    string detail = $"{p.Jumlah} {p.Satuan}";
                    if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                    if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                    return $"{nama} — {detail}";
                }).ToList();

            var creatorUserReject = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            if (!string.IsNullOrEmpty(creatorUserReject?.Email))
                await EmailService.SendApprovalResultAsync(creatorUserReject.Email, creatorUserReject.Nama ?? creatorUserReject.Email,
ba.Jenis, false, ba.Id, baseUrlReject, isForPj: false, nomorSurat: ba.NomorSurat, alasan: rejectReason, barangList:
barangListReject);

            showRejectModal = false;
            rejectReason = string.Empty;
            actionIsError = false; actionMessage = "Berita Acara telah ditolak.";
            await BaUpdateService.NotifyBaDetailUpdated(ba.Id); 
            await LoadAsync();
        }
        catch (Exception ex) { rejectError = $"Gagal: {ex.Message}"; }
        finally { isProcessing = false; isReviewerAction = false; }
    }

