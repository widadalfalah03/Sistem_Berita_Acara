@page "/berita-acara/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject IEmailService EmailService
@inject INotificationService NotificationService
@inject IExcelService ExcelService
@inject IBACounterService BACounterService
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Detail Berita Acara — Sistem Berita Acara</PageTitle>


@* ── Fullscreen overlay saat reviewer memproses Setuju / Tolak ── *@
@if (isProcessing && isReviewerAction)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(255,255,255,0.93);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
        <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-top:4px;">@reviewerActionLabel</div>
        <div style="font-size:13px;color:var(--text-muted);">@reviewerActionSubLabel</div>
    </div>
}

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat detail...</span></div>
}
else if (notFound || ba is null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-file-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;">Berita Acara tidak ditemukan</div>
    </div>
}
else
{
    <!-- Breadcrumb -->
    <button class="breadcrumb-back" @onclick="GoBack">
        <i class="bi bi-arrow-left"></i>
        Kembali
    </button>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div style="background:@(actionIsError ? "var(--danger-light)" : "#F0FDF4");border:1px solid @(actionIsError ? "var(--danger)" : "#22C55E");border-radius:var(--radius);padding:14px 20px;margin-bottom:20px;display:flex;align-items:center;gap:10px;color:@(actionIsError ? "var(--danger)" : "#16A34A");">
            <i class="bi @(actionIsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i>
            @actionMessage
        </div>
    }

    @if (isReviewer && ba.Status == "WaitingApproval")
    {
        <!-- ════ REVIEW LAYOUT (Reviewer) ════ -->
        <div class="review-layout">
            <!-- Preview area -->
            <div class="review-preview">
                @if (!string.IsNullOrEmpty(ba.DocxPath) || !string.IsNullOrEmpty(ba.DocxFinalPath))
                {
                    var docPath = !string.IsNullOrEmpty(ba.DocxFinalPath) ? ba.DocxFinalPath : ba.DocxPath;
                    var pdfPath = "/" + docPath!.Replace(".docx", ".pdf") + "?v=" + pdfVersion;
                    <div class="pdf-preview-container" style="background:#E8EAF0;border-radius:var(--radius);width:100%;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;box-shadow:inset 0 2px 10px rgba(0,0,0,.05);">
                        <iframe class="hide-on-mobile" @key="pdfVersion" src="@pdfPath#toolbar=1&navpanes=0" style="width:100%;height:100%;border:none;border-radius:var(--radius);" title="Pratinjau Dokumen"></iframe>
                        <div id="pdf-render-container-detail" class="show-on-mobile" style="width:100%;height:100%;overflow-y:auto;"></div>
                    </div>
                }
                else
                {
                    <div style="text-align:center;">
                        <i class="bi bi-file-earmark-text" style="font-size:48px;display:block;margin-bottom:12px;"></i>
                        <div>Dokumen belum tersedia</div>
                    </div>
                }
            </div>

            <!-- Review Panel -->
            <div class="review-panel">
                <h3>Review & Status</h3>

                <div class="review-info">
                    <div class="review-info-item">
                        <span class="review-info-label">No. Surat</span>
                        <span class="review-info-value text-primary">@ba.NomorSurat</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Jenis</span>
                        <span class="review-info-value">@ba.Jenis</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Penanggung Jawab</span>
                        <span class="review-info-value">@ba.Pj?.Nama</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Fungsi</span>
                        <span class="review-info-value">@ba.Pj?.FungsiDirektorat</span>
                    </div>
                    <div class="review-info-item">
                        <span class="review-info-label">Tanggal</span>
                        <span class="review-info-value">@ba.Tanggal.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot completed"></div>
                        <div class="timeline-content">
                            <div class="timeline-title">Dokumen Dibuat</div>
                            <div class="timeline-desc">@ba.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot completed"></div>
                        <div class="timeline-content">
                            <div class="timeline-title">PJ Menandatangani</div>
                            <div class="timeline-desc">@(ba.PjSignedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</div>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot pending"></div>
                        <div class="timeline-content">
                            <div class="timeline-title pending">Menunggu Persetujuan Anda</div>
                            <div class="timeline-desc">Harap review dokumen dan berikan keputusan</div>
                        </div>
                    </div>
                </div>

                <!-- Action buttons -->
                <div style="display:flex;gap:12px;margin-top:20px;">
                    <button class="btn btn-success @(isProcessing ? "btn-loading" : "")" style="flex:1;" @onclick="ApproveAsync" disabled="@isProcessing">
                        <i class="bi bi-check-lg"></i> Setujui
                    </button>
                    <button class="btn btn-outline-danger @(isProcessing ? "btn-loading" : "")" style="flex:1;" @onclick="() => showRejectModal = true" disabled="@isProcessing">
                        <i class="bi bi-x-lg"></i> Tolak
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ════ STANDARD DETAIL VIEW ════ -->
        <div class="page-header d-flex align-center justify-between" style="flex-wrap:wrap; gap:12px;">
            <div style="width:100%; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h1 class="page-title" style="word-break:break-word;">@(ba.NomorSurat ?? "Draft BA")</h1>
                    <div style="display:flex;align-items:center;gap:12px;margin-top:4px;flex-wrap:wrap;">
                        @if (From != "archive" && ba.Status != "Archived")
                        {
                            <span class="pill @GetStatusPill(ba.Status)">@GetStatusLabel(ba.Status)</span>
                        }
                        <span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="info-grid-2">
            <!-- Info Dokumen -->
            <div class="card">
                <div class="card-header"><h3>Informasi Dokumen</h3></div>
                <div class="card-body">
                    <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;width:40%;">No. Surat</td><td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@(ba.NomorSurat ?? "Belum dibuat")</td></tr>
                        @if (ba.Jenis == "Lainnya")
                        {
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Jenis Berita Acara</td><td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@ba.JenisCustom</td></tr>
                        }
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tanggal</td><td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@ba.Tanggal.ToString("dd MMMM yyyy")</td></tr>
                        <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tiket SSC</td><td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@(ba.TiketSscNo ?? "-")</td></tr>
                        @if (ba.Jenis == "Peminjaman")
                        {
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Tanggal Kembali</td><td style="padding:8px 0;font-weight:600;font-size:14px;word-break:break-word;">@(ba.TanggalKembali?.ToString("dd MMMM yyyy") ?? "-")</td></tr>
                        }
                    </table>
                </div>
            </div>

            <!-- Pihak Terkait -->
            @if (ba.Jenis != "Lainnya")
            {
                <div class="card">
                    <div class="card-header"><h3>Pihak Terkait</h3></div>
                    <div class="card-body">
                        <table style="width:100%;border-collapse:collapse;">
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;width:40%;">PJ (Menerima)</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Pj?.Nama</td></tr>
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Menyerahkan</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Menyerahkan?.Nama</td></tr>
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:14px;">Reviewer</td><td style="padding:8px 0;font-weight:600;font-size:14px;">@ba.Mengetahui?.Nama</td></tr>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- Perangkat -->
        @if (ba.Jenis != "Lainnya" && ba.Perangkat?.Any() == true)
        {
            <div class="card" style="margin-bottom:24px;">
                <div class="card-header"><h3>Daftar Perangkat</h3></div>
                <div class="table-responsive perangkat-table">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Perangkat</th>
                            <th>Jumlah</th>
                            <th>Satuan</th>
                            <th>No. Serial</th>
                            <th>Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ba.Perangkat)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Barang?.NamaBarang</td>
                                <td>@p.Jumlah</td>
                                <td>@p.Satuan</td>
                                <td>@(p.NoSerial ?? "-")</td>
                                <td>@(p.Keterangan ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                
                <!-- MOBILE LIST -->
                <div class="perangkat-mobile-list" style="padding:16px;">
                    @foreach (var p in ba.Perangkat)
                    {
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--border-light);font-size:13px;">
                            <div>
                                <div style="font-weight:700;color:var(--text-primary);margin-bottom:4px;font-size:14px;">@p.Barang?.NamaBarang</div>
                                @if (!string.IsNullOrEmpty(p.NoSerial))
                                {
                                    <div style="color:var(--text-secondary);margin-bottom:2px;">SN: @p.NoSerial</div>
                                }
                                @if (!string.IsNullOrEmpty(p.Keterangan))
                                {
                                    <div style="color:var(--text-muted);">@p.Keterangan</div>
                                }
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:18px;font-weight:800;color:var(--primary);">@p.Jumlah</div>
                                <div style="font-size:12px;color:var(--text-secondary);text-transform:uppercase;">@p.Satuan</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Action buttons for AdminGudang -->
        @if (currentRole == "AdminGudangBarang")
        {
            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                @if (ba.Status == "Draft")
                {
                    <button class="btn btn-primary @(isProcessing ? "btn-loading" : "")" @onclick="SendMagicLinkAsync" disabled="@isProcessing">
                        <i class="bi bi-send"></i> Kirim Notifikasi ke PJ
                    </button>
                }
                else if (ba.Status == "WaitingPJSign")
                {
                    <div style="background:var(--primary-light);border-radius:var(--radius);padding:14px 20px;display:flex;align-items:center;gap:10px;color:var(--primary);">
                        <i class="bi bi-hourglass-split"></i>
                        Menunggu PJ menandatangani dokumen
                    </div>
                }
                else if (ba.Status == "Rejected")
                {
                    <div style="background:var(--danger-light);border-radius:var(--radius);padding:14px 20px;flex:1;">
                        <div style="color:var(--danger);font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:8px;">
                            <i class="bi bi-x-circle-fill"></i> Ditolak
                        </div>
                        <div style="font-size:14px;color:var(--text-secondary);">@ba.AlasanReject</div>
                    </div>
                }
            </div>
        }
    }
}

<!-- Reject Modal -->
@if (showRejectModal)
{
    <div class="modal-overlay" @onclick="() => showRejectModal = false">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => showRejectModal = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="margin-bottom:20px;">
                <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Tolak Berita Acara</div>
                <div style="font-size:14px;color:var(--text-secondary);">Berikan alasan penolakan yang jelas</div>
            </div>
            <div class="form-group">
                <label class="form-label">Alasan Penolakan <span style="color:var(--danger)">*</span></label>
                <textarea class="form-control" rows="4" @bind="rejectReason" style="resize:none;"
                          placeholder="Contoh: Dokumen tidak lengkap, nomor serial tidak sesuai..."></textarea>
            </div>
            @if (!string.IsNullOrEmpty(rejectError))
            {
                <div class="login-error" style="margin-bottom:12px;">@rejectError</div>
            }
            <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
                <button class="btn btn-danger @(isProcessing ? "btn-loading" : "")" @onclick="RejectAsync" disabled="@isProcessing">
                    <i class="bi bi-x-lg"></i> Tolak
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private BeritaAcaraEntity? ba;
    private bool isLoading = true;
    private bool notFound;
    private bool isReviewer;
    private bool showRejectModal = false;
    private string rejectReason = string.Empty;
    private string rejectError = string.Empty;
    private string actionMessage = string.Empty;
    private bool actionIsError = false;
    private string currentRole = string.Empty;
    private bool isProcessing = false;
    private bool isReviewerAction = false;
    private string reviewerActionLabel = string.Empty;
    private string reviewerActionSubLabel = string.Empty;
    private long pdfVersion = DateTime.UtcNow.Ticks;



    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        if (appUser is null) { Navigation.NavigateTo("/login", true); return; }
        currentRole = appUser.Role;

        ba = await DbContext.Set<BeritaAcaraEntity>()
            .Include(x => x.Pj)
            .Include(x => x.Menyerahkan)
            .Include(x => x.Mengetahui)
            .Include(x => x.Creator)
            .Include(x => x.Perangkat).ThenInclude(p => p.Barang)
            .Include(x => x.BuktiFotos)
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (ba is null) { notFound = true; isLoading = false; return; }

        isReviewer = currentRole == "Reviewer" && appUser.Id == ba.MengetahuiId;



        pdfVersion = DateTime.UtcNow.Ticks;
        isLoading = false;
    }

    private async Task SendMagicLinkAsync()
    {
        isProcessing = true;
        try
        {
            var tokenValue = Guid.NewGuid().ToString("N");
            DbContext.ApprovalToken.Add(new ApprovalToken { BaId = ba!.Id, Token = tokenValue, ExpiresAt = DateTime.Now.AddDays(7) });
            ba!.Status = "WaitingPJSign";
            ba.SubmittedAt = DateTime.Now;
            await DbContext.SaveChangesAsync();
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var barangListMagic = ba.Perangkat
                .Select(p => {
                    string nama = p.Barang?.NamaBarang ?? "Perangkat";
                    string detail = $"{p.Jumlah} {p.Satuan}";
                    if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                    if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                    return $"{nama} — {detail}";
                }).ToList();
            await EmailService.SendMagicLinkAsync(ba.Pj!.Email ?? string.Empty, ba.Pj.Nama, ba.Id, tokenValue, baseUrl, ba.Jenis, barangListMagic);
            await NotificationService.SendToRoleAsync("AdminGudangBarang", "WAITING_PJ_SIGN", $"Berita Acara {ba.Jenis} {ba.NomorSurat} dikirim ke PJ untuk ditandatangani.", ba.Id);
            actionIsError = false; actionMessage = "Magic link berhasil dikirim ke email PJ.";
            await LoadAsync();
        }
        catch (Exception ex) { actionIsError = true; actionMessage = $"Gagal: {ex.Message}"; }
        finally { isProcessing = false; }
    }

    private async Task ApproveAsync()
    {
        isProcessing = true;
        isReviewerAction = true;
        reviewerActionLabel = "Menyetujui dokumen...";
        reviewerActionSubLabel = "Menyematkan tanda tangan dan membuat dokumen final";
        await InvokeAsync(StateHasChanged);
        try
        {
            // Server-side guard: cegah approval jika status sudah berubah
            if (ba!.Status != "WaitingApproval")
            {
                actionIsError = true; actionMessage = "Gagal: Status BA sudah berubah. Refresh halaman dan coba lagi.";
                isProcessing = false; isReviewerAction = false; return;
            }

            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
            var reviewerTtdPhysical = string.IsNullOrWhiteSpace(currentUser?.TtdPath)
                ? null
                : Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", currentUser.TtdPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
            if (currentUser is null || reviewerTtdPhysical is null || !File.Exists(reviewerTtdPhysical))
            {
                actionIsError = true; actionMessage = "Gagal: Reviewer belum memiliki file TTD yang valid. Silakan setup TTD di halaman Profil terlebih dahulu.";
                isProcessing = false;
                return;
            }

            // Generate nomor surat saat approve
            if (string.IsNullOrEmpty(ba!.NomorSurat))
            {
                var next = await BACounterService.GetNextNomorSuratAsync(ba.Tanggal, ba.Jenis);
                ba.CounterValue = next.counterValue;
                ba.NomorSurat = next.nomorSurat;
            }

            // ── Perbarui dokumen untuk versi final ─────────────────────────────────
            // JANGAN regenerasi dari template jika DOCX sudah ada di disk —
            // itu akan menghapus semua hasil edit ONLYOFFICE.
            // Cukup patch nomor surat di file yang sudah ada.
            // Jika file belum ada (kasus langka: BA belum pernah melewati editor), baru generate.
            var docxPhysicalPath = string.IsNullOrEmpty(ba!.DocxPath)
                ? null
                : Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                      ba.DocxPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));

            if (docxPhysicalPath != null && File.Exists(docxPhysicalPath))
            {
                // File sudah ada → hanya patch NomorSurat
                await DocumentService.PatchNomorSuratAsync(ba.Id, ba.NomorSurat!);
            }
            else
            {
                // File belum ada → generate dari template (fallback)
                ba.DocxPath = await DocumentService.GenerateDocxAsync(ba);
            }

            // Re-embed TTD Yang Menyerahkan (Admin Gudang yang membuat BA)
            var creatorForTtd = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            if (!string.IsNullOrWhiteSpace(creatorForTtd?.TtdPath))
            {
                var menyerahkanTtdPhysical = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                    creatorForTtd.TtdPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(menyerahkanTtdPhysical))
                    await DocumentService.EmbedTtdMenyerahkanAsync(ba.Id, menyerahkanTtdPhysical);
            }

            // Re-embed TTD PJ (Yang Menerima) — file masih ada, dihapus setelah ini
            // PENGECUALIAN: jika TTD PJ adalah stempel sistem auto-approve, JANGAN dihapus
            // (itu aset bersama di wwwroot/images/, bukan file personal PJ)
            if (!string.IsNullOrWhiteSpace(ba.TtdPjPath))
            {
                var pjTtdPhysical = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                    ba.TtdPjPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(pjTtdPhysical))
                {
                    await DocumentService.EmbedTtdPjAsync(ba.Id, pjTtdPhysical);
                    // Hapus file TTD PJ personal setelah di-embed ke dokumen final
                    // JANGAN hapus jika ini adalah stempel sistem auto-approve
                    bool isAutoApproveStamp = ba.TtdPjPath.Contains("auto_approve_stamp");
                    if (!isAutoApproveStamp)
                    {
                        try { File.Delete(pjTtdPhysical); } catch { }
                    }
                }
            }

            // Embed TTD Yang Mengetahui (Reviewer)
            await DocumentService.EmbedTtdMengetahuiAsync(ba.Id, reviewerTtdPhysical);
            ba.Status = "Approved";
            ba.ApprovedAt = DateTime.Now;
            ba.ExcelExported = false; // akan di-set true setelah berhasil export
            await DbContext.SaveChangesAsync();
            if (!ba.ExcelExported)
            {
                await ExcelService.AppendBeritaAcaraToArsipAsync(ba);
                ba.ExcelExported = true;
                await DbContext.SaveChangesAsync();
            }
            await NotificationService.SendAsync(ba.CreatedBy, "BA_APPROVED", $"Berita Acara {ba.Jenis} {ba.NomorSurat} telah disetujui.", ba.Id);

            // Email ke Admin Gudang & Barang (creator)
            var creatorUser = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            var baseUrl = (Configuration["App:PublicUrl"] ?? Configuration["App:BaseUrl"] ?? Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');
            var barangList = ba.Perangkat
                .Select(p => {
                    string nama = p.Barang?.NamaBarang ?? "Perangkat";
                    string detail = $"{p.Jumlah} {p.Satuan}";
                    if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                    if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                    return $"{nama} — {detail}";
                }).ToList();
            if (!string.IsNullOrEmpty(creatorUser?.Email))
                await EmailService.SendApprovalResultAsync(creatorUser.Email, creatorUser.Nama ?? creatorUser.Email, ba.Jenis, true, ba.Id, baseUrl, isForPj: false, nomorSurat: ba.NomorSurat, barangList: barangList);

            // Email ke PJ
            if (!string.IsNullOrEmpty(ba.Pj?.Email))
                await EmailService.SendApprovalResultAsync(ba.Pj.Email, ba.Pj.Nama, ba.Jenis, true, ba.Id, baseUrl, isForPj: true, nomorSurat: ba.NomorSurat, barangList: barangList);

            actionIsError = false; actionMessage = "Berita Acara berhasil disetujui!";
            await LoadAsync();
        }
        catch (Exception ex) { actionIsError = true; actionMessage = $"Gagal: {ex.Message}"; }
        finally { isProcessing = false; isReviewerAction = false; }
    }

    private async Task RejectAsync()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)) { rejectError = "Alasan penolakan wajib diisi."; return; }
        isProcessing = true;
        isReviewerAction = true;
        reviewerActionLabel = "Menolak dokumen...";
        reviewerActionSubLabel = "Menyimpan alasan penolakan dan mengirim notifikasi";
        await InvokeAsync(StateHasChanged);
        try
        {
            // Server-side guard: cegah reject jika status sudah berubah
            if (ba!.Status != "WaitingApproval")
            {
                rejectError = "Status BA sudah berubah. Refresh halaman dan coba lagi.";
                isProcessing = false; isReviewerAction = false; return;
            }

            ba!.Status = "Rejected";
            ba.AlasanReject = rejectReason;
            ba.WasRejected = true;
            ba.ApprovedAt = DateTime.Now;
            await DbContext.SaveChangesAsync();
            var label = ba.NomorSurat ?? "";
            var text = $"Berita Acara {ba.Jenis} {label} ditolak: {rejectReason}".Replace("  ", " ").Trim();
            await NotificationService.SendAsync(ba.CreatedBy, "BA_REJECTED", text, ba.Id);

            var baseUrlReject = (Configuration["App:PublicUrl"] ?? Configuration["App:BaseUrl"] ?? Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');
            var barangListReject = ba.Perangkat
                .Select(p => {
                    string nama = p.Barang?.NamaBarang ?? "Perangkat";
                    string detail = $"{p.Jumlah} {p.Satuan}";
                    if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                    if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                    return $"{nama} — {detail}";
                }).ToList();

            // Email ke Admin Gudang & Barang (creator)
            var creatorUserReject = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            if (!string.IsNullOrEmpty(creatorUserReject?.Email))
                await EmailService.SendApprovalResultAsync(creatorUserReject.Email, creatorUserReject.Nama ?? creatorUserReject.Email, ba.Jenis, false, ba.Id, baseUrlReject, isForPj: false, nomorSurat: ba.NomorSurat, alasan: rejectReason, barangList: barangListReject);

            // Email ke PJ
            if (!string.IsNullOrEmpty(ba.Pj?.Email))
                await EmailService.SendApprovalResultAsync(ba.Pj.Email, ba.Pj.Nama, ba.Jenis, false, ba.Id, baseUrlReject, isForPj: true, nomorSurat: ba.NomorSurat, alasan: rejectReason, barangList: barangListReject);

            showRejectModal = false;
            rejectReason = string.Empty;
            actionIsError = false; actionMessage = "Berita Acara telah ditolak.";
            await LoadAsync();
        }
        catch (Exception ex) { rejectError = $"Gagal: {ex.Message}"; }
        finally { isProcessing = false; isReviewerAction = false; }
    }

    private static string GetStatusPill(string s) => s switch
    {
        "Draft" => "pill-draft",
        "WaitingPJSign" => "pill-waiting-pj",
        "WaitingApproval" => "pill-waiting-approval",
        "Approved" => "pill-approved",
        "Archived" => "pill-approved",
        "Rejected" => "pill-rejected",
        _ => "pill-draft"
    };

    private static string GetStatusLabel(string s) => s switch
    {
        "Draft" => "Draft",
        "WaitingPJSign" => "Menunggu TTD PJ",
        "WaitingApproval" => "Menunggu Approval",
        "Approved" => "Disetujui",
        "Archived" => "Disetujui",
        "Rejected" => "Ditolak",
        _ => s
    };

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private void GoBack()
    {
        var dest = From == "progress" ? "/progress"
                 : From == "archive" ? "/archive"
                 : From == "dashboard" ? "/dashboard"
                 : From == "notifikasi_all" ? "/notifikasi?tab=all"
                 : From == "notifikasi_unread" ? "/notifikasi?tab=unread"
                 : From == "notifikasi" ? "/notifikasi"
                 : "/draft";
                 
        if (currentRole == "Reviewer" && string.IsNullOrEmpty(From))
            dest = "/dashboard";

        Navigation.NavigateTo(dest);
    }

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        "Penarikan" => "pill-penarikan",
        _ => "pill-lainnya"
    };

    private string _lastRenderedPdfUrl = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("appLoading.hide");

        var docPath = !string.IsNullOrEmpty(ba?.DocxFinalPath) ? ba.DocxFinalPath : ba?.DocxPath;
        if (!string.IsNullOrEmpty(docPath))
        {
            var pdfPath = "/" + docPath.Replace(".docx", ".pdf") + "?v=" + pdfVersion;
            if (pdfPath != _lastRenderedPdfUrl)
            {
                _lastRenderedPdfUrl = pdfPath;
                try 
                {
                    await JSRuntime.InvokeVoidAsync("pdfViewer.renderPdf", "pdf-render-container-detail", pdfPath);
                } 
                catch (Exception ex)
                {
                    Console.Error.WriteLine("Error invoking pdfViewer: " + ex.Message);
                }
            }
        }
    }
