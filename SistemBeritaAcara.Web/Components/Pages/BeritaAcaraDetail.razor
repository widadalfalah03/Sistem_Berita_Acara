    {
        "Draft" => "pill-draft",
        "WaitingPJSign" => "pill-waiting-pj",
        "WaitingApproval" => "pill-waiting-approval",
        "Approved" => "pill-approved",
        "Archived" => "pill-approved",
        "Rejected" => "pill-rejected",
        _ => "pill-draft"
    };

    private static string GetStatusLabel(string s) => s switch
    {
        "Draft" => "Draft",
        "WaitingPJSign" => "Menunggu TTD PJ",
        "WaitingApproval" => "Menunggu TTD Reviewer",
        "Approved" => "Disetujui",
        "Archived" => "Disetujui",
        "Rejected" => "Ditolak",
        _ => s
    };

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private void NavigateToRevisi()
    {
        Navigation.NavigateTo("/buat-ba?edit=" + ba!.Id);
    }

    private void GoBack()
    {
        var dest = From == "progress" ? "/progress"
                 : From == "archive" ? "/archive"
                 : From == "dashboard" ? "/dashboard"
                 : From == "notifikasi_all" ? "/notifikasi?tab=all"
                 : From == "notifikasi_unread" ? "/notifikasi?tab=unread"
                 : From == "notifikasi" ? "/notifikasi"
                 : From == "rejected" ? "/rejected"
                 : "/draft";

        if (currentRole == "Reviewer" && string.IsNullOrEmpty(From))
            dest = "/dashboard";

        Navigation.NavigateTo(dest);
    }

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        "Penarikan" => "pill-penarikan",
        _ => "pill-lainnya"
    };

    private string _lastRenderedPdfUrl = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JSRuntime.InvokeVoidAsync("appLoading.hide"); }
            catch (Exception ex) { Console.Error.WriteLine("[BADetail] appLoading.hide: " + ex.Message); }
            _ = ConnectSignalRAsync();
        }

        if (ba != null && (!string.IsNullOrEmpty(ba.DocxPath) || !string.IsNullOrEmpty(ba.DocxFinalPath)))
        {
            var pdfUrl = $"/api/preview/pdf/{ba.Id}?v={pdfVersion}";
            if (pdfUrl != _lastRenderedPdfUrl)
            {
                _lastRenderedPdfUrl = pdfUrl;
                try
                {
                    await JSRuntime.InvokeVoidAsync("pdfViewer.renderPdf", "pdf-render-container-detail", pdfUrl);
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine("Error invoking pdfViewer: " + ex.Message);
                }
            }
        }
    }

    private HubConnection? _hubConnection;

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/ba"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("BaDetailUpdated", async () =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
            if (ba is not null)
                await _hubConnection.InvokeAsync("JoinBaGroup", ba.Id);
        }
        catch
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.StopAsync();
            await _hubConnection.DisposeAsync();
        }
    }
}
