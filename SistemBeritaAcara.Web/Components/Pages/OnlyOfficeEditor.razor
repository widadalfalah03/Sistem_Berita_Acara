@page "/onlyoffice-editor/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Microsoft.Extensions.Configuration
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminGudangBarang")]
@implements IAsyncDisposable

<PageTitle>Edit Manual Dokumen — Sistem Berita Acara</PageTitle>

@if (isSaving)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(255,255,255,0.93);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
        <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-top:4px;">Menyimpan dokumen...</div>
        <div style="font-size:13px;color:var(--text-muted);">Mengkonversi ke PDF, harap tunggu</div>
    </div>
}

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat Editor ONLYOFFICE...</span></div>
}
else if (ba is null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-file-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;">Berita Acara tidak ditemukan</div>
        <NavLink href="/draft" class="btn btn-outline" style="margin-top:16px;">← Kembali ke Draft</NavLink>
    </div>
}
else
{
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;margin-bottom:16px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:16px;">
            <button class="btn btn-outline btn-sm" @onclick="GoBack" style="display:flex;align-items:center;gap:6px;">
                <i class="bi bi-arrow-left"></i> Kembali ke Pratinjau
            </button>
            <div>
                <div style="font-weight:700;font-size:16px;">Edit Dokumen: @(ba.NomorSurat ?? "Draft")</div>
            </div>
        </div>
        <button class="btn btn-primary" @onclick="SaveAndGoBackAsync" disabled="@isSaving"
                style="display:flex;align-items:center;gap:8px;">
            @if (isSaving)
            {
                <span class="spinner" style="width:16px;height:16px;border-width:2px;border-color:white;border-top-color:transparent;"></span>
                <span>Menyimpan...</span>
            }
            else
            {
                <i class="bi bi-save-fill"></i>
                <span>Simpan & Pratinjau</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background:var(--danger-light);border:1px solid var(--danger);border-radius:var(--radius);padding:14px 20px;margin-bottom:16px;color:var(--danger);">
            <i class="bi bi-exclamation-circle-fill"></i> @errorMessage
        </div>
    }
    else if (string.IsNullOrEmpty(ba.DocxPath))
    {
        <div style="text-align:center;padding:60px;color:var(--text-muted);">
            <i class="bi bi-file-earmark-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
            <div>Dokumen belum dibuat. Buka halaman <strong>Pratinjau</strong> terlebih dahulu.</div>
        </div>
    }
    else
    {
        <!-- Container untuk ONLYOFFICE Editor -->
        <div style="height: 800px; width: 100%; border: 1px solid var(--border); border-radius: var(--radius);">
            <div id="onlyoffice-placeholder"></div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private BeritaAcaraEntity? ba;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private int _currentUserId;
    private string _currentUserName = "";
    private bool _editorInitialized = false;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _currentUserName = auth.User.Identity?.Name ?? "User";
        int.TryParse(userIdStr, out _currentUserId);

        ba = await DbContext.Set<BeritaAcaraEntity>()
            .Include(b => b.Pj).Include(b => b.Menyerahkan).Include(b => b.Mengetahui)
            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
            .FirstOrDefaultAsync(b => b.Id == Id && b.Status == "Draft" && b.CreatedBy == _currentUserId);

        if (ba != null && string.IsNullOrEmpty(ba.DocxPath))
        {
            try
            {
                ba.DocxPath = await DocumentService.GenerateDocxAsync(ba);
                await DbContext.SaveChangesAsync();

                // Embed TTD dan generate PDF agar pratinjau di EditorBA langsung tersedia
                // (konsisten dengan perilaku EditorBA sebelumnya)
                var currentUser = await DbContext.Users.FindAsync(_currentUserId);
                if (currentUser != null && !string.IsNullOrEmpty(currentUser.TtdPath))
                {
                    var ttdPhysicalPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                        currentUser.TtdPath.Replace("/", Path.DirectorySeparatorChar.ToString()));
                    await DocumentService.EmbedTtdMenyerahkanAsync(ba.Id, ttdPhysicalPath);
                }
                else
                {
                    var docxPhysical = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                        ba.DocxPath.TrimStart('/').Replace("/", Path.DirectorySeparatorChar.ToString()));
                    await DocumentService.ConvertDocxToPdfAsync(docxPhysical);
                }
            }
            catch (Exception ex)
            {
                errorMessage = "Gagal generate dokumen: " + ex.Message;
            }
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Sembunyikan overlay global (mungkin ditampilkan oleh BeritaAcara "Simpan & Lanjutkan")
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("appLoading.hide");

        if (!_editorInitialized && ba != null && !string.IsNullOrEmpty(ba.DocxPath) && string.IsNullOrEmpty(errorMessage))
        {
            _editorInitialized = true;
            var onlyOfficeServerUrl = Configuration["OnlyOffice:ServerUrl"] ?? "http://localhost:8081";
            var apiScriptUrl = $"{onlyOfficeServerUrl}/web-apps/apps/api/documents/api.js";

            // Gunakan App:BaseUrl dari config agar ONLYOFFICE di Docker bisa mengakses file
            // App:BaseUrl menggunakan IP LAN (bukan localhost) sehingga bisa dijangkau dari dalam container
            var appBaseUrl = (Configuration["App:BaseUrl"] ?? Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');

            var docUrl = $"{appBaseUrl}/{ba.DocxPath}";
            var callbackUrl = $"{appBaseUrl}/api/onlyoffice/callback/{ba.Id}";
            var key = $"{ba.Id}-{DateTime.Now.Ticks}"; // Key unik untuk memaksa reload/edit baru

            var config = new
            {
                document = new
                {
                    fileType = "docx",
                    key = key,
                    title = $"Berita Acara - {(ba.NomorSurat ?? ba.Id.ToString())}.docx",
                    url = docUrl
                },
                documentType = "word",
                editorConfig = new
                {
                    callbackUrl = callbackUrl,
                    user = new
                    {
                        id = _currentUserId.ToString(),
                        name = _currentUserName
                    },
                    mode = "edit",
                    lang = "id-ID",
                    customization = new
                    {
                        forcesave = true
                    }
                }
            };

            await JSRuntime.InvokeVoidAsync("onlyoffice.init", apiScriptUrl, config);
        }
    }

    private void GoBack() => Navigation.NavigateTo($"/editor/{Id}");

    private async Task SaveAndGoBackAsync()
    {
        isSaving = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Tampilkan overlay yang akan bertahan melewati navigasi ke EditorBA
            await JSRuntime.InvokeVoidAsync("appLoading.show", "Menyimpan dokumen...", "Sedang mengkonversi ke PDF, harap tunggu");

            // Snapshot timestamp SEBELUM forceSave sebagai baseline perbandingan
            string docxPhysical = string.Empty, pdfPhysical = string.Empty;
            DateTime beforeDocx = DateTime.MinValue, beforePdf = DateTime.MinValue;
            if (ba?.DocxPath is not null)
            {
                var rel = ba.DocxPath.TrimStart('/').Replace("/", Path.DirectorySeparatorChar.ToString());
                docxPhysical = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", rel);
                pdfPhysical  = docxPhysical.Replace(".docx", ".pdf");
                if (File.Exists(docxPhysical)) beforeDocx = File.GetLastWriteTimeUtc(docxPhysical);
                if (File.Exists(pdfPhysical))  beforePdf  = File.GetLastWriteTimeUtc(pdfPhysical);
            }

            // Trigger save — page tetap hidup (Blazor circuit aktif) sehingga ONLYOFFICE
            // dapat menyelesaikan proses simpan & mengirim callback ke server.
            await JSRuntime.InvokeVoidAsync("onlyoffice.forceSave");

            // Poll di sini (bukan di EditorBA) karena halaman masih aktif.
            // Dengan circuit tetap terhubung, ONLYOFFICE tidak di-interrupt oleh page unload.
            if (!string.IsNullOrEmpty(docxPhysical) && beforeDocx > DateTime.MinValue)
            {
                // Tahap 1: tunggu DOCX diperbarui oleh ONLYOFFICE callback (max 60 detik)
                var docxDeadline = DateTime.UtcNow.AddSeconds(60);
                bool docxUpdated = false;
                while (DateTime.UtcNow < docxDeadline)
                {
                    await Task.Delay(500);
                    if (File.Exists(docxPhysical) && File.GetLastWriteTimeUtc(docxPhysical) > beforeDocx)
                    { docxUpdated = true; break; }
                }

                if (docxUpdated)
                {
                    // Tahap 2: tunggu PDF diperbarui (dibandingkan ke beforePdf, bukan docxTime)
                    var pdfDeadline = DateTime.UtcNow.AddSeconds(30);
                    while (DateTime.UtcNow < pdfDeadline)
                    {
                        await Task.Delay(500);
                        if (File.Exists(pdfPhysical) && File.GetLastWriteTimeUtc(pdfPhysical) > beforePdf)
                        { await Task.Delay(1500); break; } // 1500ms agar Spire.Doc benar-benar flush ke disk
                    }
                }
            }

            // PDF sudah siap di disk — navigasi ke EditorBA (in-app agar overlay bertahan)
            Navigation.NavigateTo($"/editor/{Id}");
        }
        catch { Navigation.NavigateTo($"/editor/{Id}"); }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("onlyoffice.destroy");
        }
        catch { /* ignored if disposed */ }
    }
}
