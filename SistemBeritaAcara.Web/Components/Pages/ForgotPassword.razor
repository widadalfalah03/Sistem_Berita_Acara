@page "/forgot-password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Identity
@using SistemBeritaAcara.Core.Entities
@inject UserManager<ApplicationUser> UserManager
@inject SistemBeritaAcara.Core.Interfaces.IEmailService EmailService
@inject IConfiguration Config
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]


<PageTitle>Lupa Password — Sistem Berita Acara</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-card-body">
            <!-- Logo only, no text heading -->
            <div class="login-logo">
                <img src="/images/PT_Pertamina_Patra_Niaga.svg.png" style="height:88px;width:auto;" alt="Pertamina Patra Niaga" />
            </div>

            @if (isSuccess)
            {
                <div style="text-align:center;padding:12px 0;">
                    <i class="bi bi-envelope-check-fill" style="font-size:48px;color:#10b981;margin-bottom:16px;"></i>
                    <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;">Periksa Email Anda</h3>
                    <p style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                        Jika email <strong>@email</strong> terdaftar di sistem, tautan untuk mengatur ulang password telah dikirimkan. Tautan hanya berlaku selama 24 jam.
                    </p>
                    <a href="/login" class="btn btn-outline" style="width:100%;">Kembali ke Login</a>
                </div>
            }
            else
            {
                <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;text-align:center;">Lupa Password?</h3>
                <p style="font-size:13px;color:var(--text-secondary);text-align:center;margin-bottom:24px;">
                    Masukkan alamat email yang terdaftar. Kami akan mengirimkan tautan untuk mengatur ulang password Anda.
                </p>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="login-error" style="margin-bottom:16px;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        @errorMessage
                    </div>
                }

                <div class="form-group" style="margin-bottom:24px;">
                    <input class="login-input" type="email" @bind="email" placeholder="Email Address" autocomplete="email" />
                </div>

                <button class="login-btn" style="margin-bottom:16px;" @onclick="SendResetLink" disabled="@isProcessing">
                    <span>Kirim Link Reset</span>
                </button>
                
                <div style="text-align:center;">
                    <a href="/login" style="font-size:13px;color:var(--text-muted);text-decoration:none;">
                        <i class="bi bi-arrow-left"></i> Kembali ke Login
                    </a>
                </div>
            }

        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private bool isProcessing = false;
    private bool isSuccess = false;
    private string errorMessage = string.Empty;

    private async Task SendResetLink()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Silakan masukkan alamat email Anda.";
            return;
        }

        isProcessing = true;
        errorMessage = string.Empty;

        try
        {
            var user = await UserManager.FindByEmailAsync(email);

            // Jika email tidak ditemukan atau akun nonaktif — tampilkan error eksplisit
            if (user == null || user.IsDeleted)
            {
                errorMessage = "Email ini tidak terdaftar atau akun tidak aktif di sistem.";
                return;
            }

            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var baseUrl = Config["App:PublicUrl"] ?? Config["App:BaseUrl"] ?? "http://localhost:5000";
            await EmailService.SendPasswordResetLinkAsync(user.Email, user.Nama, token, baseUrl);

            isSuccess = true;
        }
        catch (Exception)
        {
            errorMessage = "Terjadi kesalahan sistem saat mencoba mengirim tautan. Silakan coba lagi.";
        }
        finally
        {
            isProcessing = false;
        }
    }
}
