@page "/profil"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Profil — Sistem Berita Acara</PageTitle>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat profil...</span></div>
}
else if (currentUser is null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">
        <i class="bi bi-person-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
        <div>Pengguna tidak ditemukan.</div>
    </div>
}
else
{


    @if (!string.IsNullOrEmpty(globalMessage))
    {
        var isErr = globalMessage.StartsWith("Gagal");
        <div style="background:@(isErr?"var(--danger-light)":"#F0FDF4");border:1px solid @(isErr?"var(--danger)":"#22C55E");border-radius:var(--radius);padding:14px 20px;margin-bottom:24px;display:flex;align-items:center;gap:10px;color:@(isErr?"var(--danger)":"#16A34A");">
            <i class="bi @(isErr?"bi-exclamation-circle-fill":"bi-check-circle-fill")"></i>
            @globalMessage
        </div>
    }

    <!-- First-login reminder banner -->
    @if (string.IsNullOrEmpty(currentUser.TtdPath) && currentUser.Role != "AdminIT")
    {
        <div style="background:#FFFBEB;border:1px solid #FCD34D;border-radius:var(--radius);padding:14px 20px;margin-bottom:24px;display:flex;align-items:center;gap:12px;">
            <i class="bi bi-exclamation-triangle-fill" style="color:#D97706;font-size:20px;flex-shrink:0;"></i>
            <div>
                <div style="font-weight:700;color:#92400E;">Tanda Tangan Belum Disetel</div>
                <div style="font-size:13px;color:#92400E;margin-top:2px;">Gambar tanda tangan Anda melalui tombol <strong>Ubah Tanda Tangan</strong> di kanan layar agar bisa memproses Berita Acara.</div>
            </div>
        </div>
    }

    <div class="edit-layout">

        <!-- ── Kolom Kiri ── -->
        <div style="display:flex;flex-direction:column;gap:20px;">

            <!-- Informasi Akun -->
            <div class="form-section" style="margin-bottom:0;">
                <!-- Profile pic + name row -->
                <div style="display:flex;align-items:center;gap:24px;margin-bottom:24px;padding:20px;background:var(--bg);border-radius:var(--radius);flex-wrap:wrap;">
                    <div style="position:relative;">
                        <div style="width:80px;height:80px;border-radius:50%;overflow:hidden;background:var(--primary);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:3px solid var(--primary-light);">
                            @if (!string.IsNullOrEmpty(currentUser.ProfilePicPath))
                            {
                                <img src="/@currentUser.ProfilePicPath" alt="Foto Profil" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <span style="font-size:28px;font-weight:800;color:white;">@GetInitials(currentUser.Nama)</span>
                            }
                        </div>
                        <label for="pic-upload" style="position:absolute;bottom:0;right:0;width:24px;height:24px;border-radius:50%;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;cursor:pointer;border:2px solid white;font-size:11px;">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                        <InputFile id="pic-upload" OnChange="OnProfilePicSelected" accept="image/*" style="display:none;" />
                    </div>
                    <div>
                        <div style="font-size:20px;font-weight:800;color:var(--text-primary);">@currentUser.Nama</div>
                        <div style="margin-top:4px;">
                            <span class="pill @GetRolePill(currentUser.Role)" style="font-size:12px;">@GetRoleLabel(currentUser.Role)</span>
                        </div>
                        @if (profilePicFile is not null)
                        {
                            <div style="margin-top:10px;display:flex;align-items:center;gap:8px;">
                                <span style="font-size:13px;color:var(--text-secondary);">
                                    <i class="bi bi-image"></i> @profilePicFile.Name
                                </span>
                                <button class="btn btn-primary btn-sm" @onclick="SaveProfilePicAsync" disabled="@isSavingPic" style="padding:5px 12px;font-size:12px;">
                                    @if (isSavingPic) { <span class="spinner" style="width:12px;height:12px;border-width:2px;"></span> }
                                    else { <span>Simpan Foto</span> }
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nama Lengkap</label>
                        <input class="form-control readonly" readonly value="@currentUser.Nama" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input class="form-control readonly" readonly value="@(currentUser.Email ?? "-")" />
                    </div>
                </div>

                @if (linkedPegawai is not null)
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">No. Pekerja</label>
                            <input class="form-control readonly" readonly value="@linkedPegawai.NoPekerja" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Jabatan</label>
                            <input class="form-control readonly" readonly value="@(linkedPegawai.Jabatan ?? "-")" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Fungsi / Direktorat</label>
                            <input class="form-control readonly" readonly value="@(linkedPegawai.FungsiDirektorat ?? "-")" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cost Center</label>
                            <input class="form-control readonly" readonly value="@(linkedPegawai.CostCenter ?? "-")" />
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(linkedPegawai.NoTelp))
                    {
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">No. Telp / HP</label>
                                <input class="form-control readonly" readonly value="@linkedPegawai.NoTelp" />
                            </div>
                            <div></div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ── Kolom Kanan ── -->
        <div class="side-cards">
            <div class="side-card" style="background:var(--bg);">
                <h4 style="font-size:14px;color:var(--text-secondary);">Info Akun</h4>
                <div style="font-size:13px;color:var(--text-muted);line-height:1.7;">
                    <div><strong>Role:</strong> @GetRoleLabel(currentUser.Role)</div>
                    <div style="margin-top:4px;"><strong>Status: </strong>
                        @if (currentUser.IsDeleted)
                        {
                            <span style="color:var(--danger);">Nonaktif</span>
                        }
                        else
                        {
                            <span style="color:#16A34A;">Aktif</span>
                        }
                    </div>
                </div>
            </div>


            @if (currentUser.Role != "AdminIT")
            {
                @if (!string.IsNullOrEmpty(currentUser.TtdPath))
                {
                    <div style="background:white;border:1px solid var(--border);border-radius:var(--radius);padding:16px;display:flex;justify-content:center;margin-bottom:8px;">
                        <img src="/@currentUser.TtdPath?v=@ttdCacheBuster" alt="Tanda Tangan" style="max-height:60px;max-width:100%;object-fit:contain;" />
                    </div>
                }
                <button class="btn btn-outline" style="width:100%; margin-bottom: 32px;" @onclick="OpenTtdModal" disabled="@isOpeningModal">
                    @if (isOpeningModal)
                    {
                        <span class="spinner" style="width:16px;height:16px;border-width:2px;"></span>
                        <span style="margin-left: 8px;">Memproses...</span>
                    }
                    else
                    {
                        <i class="bi bi-pen"></i> <span>Ubah Tanda Tangan</span>
                    }
                </button>
            }
        </div>
    </div>
}


@if (showTtdModal && currentUser?.Role != "AdminIT")
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:1050;" @onclick="CloseTtdModal">
        <div style="background:var(--bg);width:600px;max-width:95%;border-radius:var(--radius);padding:24px;box-shadow:var(--shadow-lg);" @onclick:stopPropagation="true">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h4 style="margin:0;font-size:18px;"><i class="bi bi-pen" style="color:var(--primary);margin-right:6px;"></i> Ubah Tanda Tangan</h4>
                <button style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-muted);" @onclick="CloseTtdModal">&times;</button>
            </div>

            <!-- Tab bar -->
            <div style="display:flex;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:16px;">
                <button @onclick='() => SwitchTtdMode("draw")'
                        style="flex:1;padding:9px 12px;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:all .15s;background:@(ttdMode=="draw"?"var(--primary)":"transparent");color:@(ttdMode=="draw"?"white":"var(--text-secondary)");">
                    <i class="bi bi-pen-fill" style="margin-right:5px;"></i>Gambar
                </button>
                <button @onclick='() => SwitchTtdMode("upload")'
                        style="flex:1;padding:9px 12px;font-size:13px;font-weight:600;border:none;border-left:1px solid var(--border);cursor:pointer;transition:all .15s;background:@(ttdMode=="upload"?"var(--primary)":"transparent");color:@(ttdMode=="upload"?"white":"var(--text-secondary)");">
                    <i class="bi bi-cloud-upload-fill" style="margin-right:5px;"></i>Upload Gambar
                </button>
            </div>

            <!-- ── MODE: GAMBAR ── -->
            <div style="display:@(ttdMode == "draw" ? "block" : "none")">
                <div style="border:2px solid var(--border);border-radius:var(--radius);overflow:hidden;background:white;margin-bottom:12px;position:relative;">
                    <canvas id="ttd-canvas" width="600" height="200" style="width:100%;height:200px;cursor:crosshair;touch-action:none;display:block;"></canvas>
                    <div id="ttd-placeholder" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
                        <span style="font-size:14px;color:var(--text-muted);">Gambar tanda tangan Anda di sini</span>
                    </div>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <button class="btn btn-outline btn-sm" @onclick="ClearCanvasAsync">
                        <i class="bi bi-eraser"></i> Hapus
                    </button>
                    <button class="btn btn-primary" @onclick="SaveDrawnTtdAsync" disabled="@isSavingTtd">
                        @if (isSavingTtd) { <span class="spinner" style="width:16px;height:16px;border-width:2px;"></span> }
                        else { <i class="bi bi-save"></i> <span>Simpan</span> }
                    </button>
                </div>
            </div>

            <!-- ── MODE: UPLOAD ── -->
            <div style="display:@(ttdMode == "upload" ? "block" : "none")">
                <label for="ttd-ul-input" style="cursor:pointer;display:block;">
                    <div style="border:2px dashed var(--border);border-radius:var(--radius);background:var(--surface);padding:20px;text-align:center;transition:border-color .15s;"
                         onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
                        <i class="bi bi-image" style="font-size:30px;color:var(--primary);display:block;margin-bottom:8px;"></i>
                        <div style="font-weight:600;font-size:14px;margin-bottom:3px;">Klik untuk pilih gambar</div>
                        <div style="font-size:12px;color:var(--text-muted);">JPG, PNG, JPEG · Maks. 5MB</div>
                    </div>
                    <input type="file" id="ttd-ul-input" accept="image/*" style="display:none"
                           onchange="ttdUpload.onFileChange('ttd-ul-input', 'ttd-ul-canvas', 'ttd-ul-wrap')" />
                </label>

                <div id="ttd-ul-wrap" style="display:none;margin-top:14px;">
                    <div style="background:white;border-radius:var(--radius);border:2px solid var(--border);padding:8px;min-height:80px;display:flex;align-items:center;justify-content:center;">
                        <canvas id="ttd-ul-canvas" style="display:block;max-width:100%;height:auto;"></canvas>
                    </div>
                </div>

                <div style="display:flex;justify-content:flex-end;margin-top:16px;">
                    <button class="btn btn-primary" @onclick="SaveDrawnTtdAsync" disabled="@isSavingTtd">
                        @if (isSavingTtd) { <span class="spinner" style="width:16px;height:16px;border-width:2px;"></span> }
                        else { <i class="bi bi-save"></i> <span>Simpan</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private ApplicationUser? currentUser;
    private SistemBeritaAcara.Core.Entities.Pegawai? linkedPegawai;
    private bool isLoading = true;
    private string globalMessage = string.Empty;

    // Modals
    private bool showTtdModal = false;
    private bool isOpeningModal = false;

    // Profile pic
    private IBrowserFile? profilePicFile;
    private bool isSavingPic;

    // TTD
    private string ttdCacheBuster = Guid.NewGuid().ToString();
    private bool isSavingTtd;
    private bool isCanvasEmpty = true;
    private bool isDrawingActive = false;
    private string ttdMode = "draw"; // "draw" | "upload"



    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = auth.User.Identity?.Name;
        if (email is null) { Navigation.NavigateTo("/login", true); return; }

        currentUser = await UserManager.FindByEmailAsync(email);
        if (currentUser?.PegawaiId is not null)
            linkedPegawai = await DbContext.Pegawai.FindAsync(currentUser.PegawaiId);

        isLoading = false;
    }

    private async Task OpenTtdModal()
    {
        isOpeningModal = true;
        
        showTtdModal = true;
        ttdMode = "draw";
        isCanvasEmpty = true;
        isDrawingActive = false;
        await Task.Delay(100);
        await JS.InvokeVoidAsync("ttdCanvas.init");
        try { await JS.InvokeVoidAsync("ttdUpload.reset"); } catch { }
        
        isOpeningModal = false;
    }

    private async Task SwitchTtdMode(string mode)
    {
        ttdMode = mode;
        await Task.Delay(50);
        if (mode == "draw")
            await JS.InvokeVoidAsync("ttdCanvas.init");
        else
            try { await JS.InvokeVoidAsync("ttdUpload.reset"); } catch { }
    }

    private void CloseTtdModal()
    {
        showTtdModal = false;
        ttdMode = "draw";
    }

    // ── Canvas drawing events ──
    // Event listener sekarang ditangani sepenuhnya oleh JavaScript (ttdCanvas) untuk mencegah lag di HP.

    private async Task ClearCanvasAsync()
    {
        await JS.InvokeVoidAsync("ttdCanvas.clear");
        isCanvasEmpty = true;
    }

    // ── Save drawn TTD ──

    private async Task SaveDrawnTtdAsync()
    {
        isSavingTtd = true;
        globalMessage = string.Empty;
        try
        {
            string? dataUrl;
            if (ttdMode == "upload")
            {
                bool hasImg = await JS.InvokeAsync<bool>("ttdUpload.hasImage");
                if (!hasImg) { globalMessage = "Gagal: Silakan upload gambar tanda tangan terlebih dahulu."; return; }
                dataUrl = await JS.InvokeAsync<string>("ttdUpload.getDataUrl");
            }
            else
            {
                bool isEmpty = await JS.InvokeAsync<bool>("ttdCanvas.isEmpty_check");
                if (isEmpty) { globalMessage = "Gagal: Silakan gambar tanda tangan Anda terlebih dahulu."; return; }
                dataUrl = await JS.InvokeAsync<string>("ttdCanvas.getDataUrl");
            }
            if (string.IsNullOrEmpty(dataUrl)) { globalMessage = "Gagal membaca data TTD."; return; }

            // dataUrl format: "data:image/png;base64,XXXXX"
            var base64 = dataUrl.Split(',')[1];
            var bytes = Convert.FromBase64String(base64);

            var folder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "signatures");
            Directory.CreateDirectory(folder);
            var fname = $"ttd-user-{currentUser!.Id}.png";
            var fpath = Path.Combine(folder, fname);
            await File.WriteAllBytesAsync(fpath, bytes);

            currentUser.TtdPath = $"files/signatures/{fname}";
            await UserManager.UpdateAsync(currentUser);
            globalMessage = "Tanda tangan berhasil disimpan!";
            ttdCacheBuster = Guid.NewGuid().ToString();
            showTtdModal = false;
        }
        catch (Exception ex) { globalMessage = $"Gagal menyimpan TTD: {ex.Message}"; }
        finally { isSavingTtd = false; }
    }

    // ── Profile Picture ──

    private void OnProfilePicSelected(InputFileChangeEventArgs e) => profilePicFile = e.File;

    private async Task SaveProfilePicAsync()
    {
        if (profilePicFile is null) return;
        isSavingPic = true;
        globalMessage = string.Empty;
        try
        {
            var ext = Path.GetExtension(profilePicFile.Name);
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "profiles");
            Directory.CreateDirectory(folder);

            // Delete old picture if exists to prevent accumulating files
            if (!string.IsNullOrEmpty(currentUser!.ProfilePicPath))
            {
                var oldPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", currentUser.ProfilePicPath.Replace("/", "\\"));
                if (File.Exists(oldPath)) File.Delete(oldPath);
            }

            var fname = $"profile-{currentUser.Id}-{DateTime.UtcNow.Ticks}{ext}";
            var fpath = Path.Combine(folder, fname);
            await using (var fs = File.Create(fpath))
            {
                await profilePicFile.OpenReadStream(5_000_000).CopyToAsync(fs);
            }
            currentUser.ProfilePicPath = $"files/profiles/{fname}";
            await UserManager.UpdateAsync(currentUser);
            globalMessage = "Foto profil berhasil disimpan!";
            profilePicFile = null;
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (Exception ex) { globalMessage = $"Gagal menyimpan foto profil: {ex.Message}"; }
        finally { isSavingPic = false; }
    }



    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][0].ToString().ToUpper() : (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private static string GetRoleLabel(string role) => role switch
    {
        "AdminIT" => "Admin IT",
        "AdminGudangBarang" => "Admin Gudang & Barang",
        "Approver" => "Approver",
        _ => role
    };

    private static string GetRolePill(string role) => role switch
    {
        "AdminIT" => "pill-admin-it",
        "AdminGudangBarang" => "pill-admin-gudang",
        "Approver" => "pill-approver",
        _ => "pill-draft"
    };
}
