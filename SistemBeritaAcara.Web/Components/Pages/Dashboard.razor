@page "/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SistemBeritaAcara.Core.Entities
@using BAEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<style>
    .jenis-item {
        position: relative;
    }
    .custom-chart-tooltip {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: 8px;
        background: rgba(0, 0, 0, 0.85);
        color: white;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease-in-out;
        display: flex;
        align-items: center;
        gap: 6px;
        z-index: 100;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    .custom-chart-tooltip::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border-width: 5px;
        border-style: solid;
        border-color: rgba(0, 0, 0, 0.85) transparent transparent transparent;
    }
    .jenis-item:hover .custom-chart-tooltip {
        opacity: 1;
    }
    .tooltip-color-box {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        display: inline-block;
    }
</style>

<PageTitle>Dashboard — Sistem Berita Acara</PageTitle>

@if (isLoading)
{
    <div class="loading-spinner">
        <div class="spinner"></div>
    </div>
}
else if (currentRole == "AdminGudangBarang")
{
    <!-- ════ DASHBOARD ADMIN GUDANG ════ -->
    <div class="dashboard-fill">
    <!-- Stat Cards -->
    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card-icon draft"><i class="bi bi-file-earmark-text"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total Draft</div>
                <div class="stat-card-value">@stat.Draft</div>
                <div class="stat-card-desc">Belum diajukan</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon progress"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Sedang Diproses</div>
                <div class="stat-card-value blue">@stat.Progress</div>
                <div class="stat-card-desc">Menunggu persetujuan</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-check-circle"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Disetujui</div>
                <div class="stat-card-value green">@stat.Approved</div>
                <div class="stat-card-desc">Telah disetujui</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon rejected"><i class="bi bi-x-circle"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Ditolak</div>
                <div class="stat-card-value red">@stat.Rejected</div>
                <div class="stat-card-desc">Dikembalikan reviewer</div>
            </div>
        </div>
    </div>

    <!-- Charts row -->
    <div class="dashboard-grid">
        <!-- Line chart -->
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">Tren Pembuatan Berita Acara</span>
                <span class="chart-period">6 Bulan Terakhir</span>
            </div>
            <div class="chart-container" style="flex:1;position:relative;min-height:0;">
                <canvas id="trendChart"></canvas>
            </div>
        </div>

        <!-- Donut chart -->
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">Status Berita Acara Saat Ini</span>
            </div>
            <div class="chart-container" style="flex:1;position:relative;min-height:0;">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Jenis BA + Due Date row -->
    <div class="dashboard-grid">
        <!-- Jenis BA progress bars -->
        <div class="jenis-card">
            <div class="jenis-title">Jenis Berita Acara</div>
            @{
                var total = jenisData.Alokasi + jenisData.Peminjaman + jenisData.Penarikan + jenisData.Lainnya;
                var pctAlokasi = total > 0 ? (int)Math.Round((double)jenisData.Alokasi / total * 100) : 0;
                var pctPeminjaman = total > 0 ? (int)Math.Round((double)jenisData.Peminjaman / total * 100) : 0;
                var pctPenarikan = total > 0 ? (int)Math.Round((double)jenisData.Penarikan / total * 100) : 0;
                var pctLainnya = total > 0 ? (int)Math.Round((double)jenisData.Lainnya / total * 100) : 0;
            }
              <div class="jenis-item">
                  <div class="jenis-label">
                      <span class="jenis-name">Alokasi</span>
                      <span class="jenis-pct">@pctAlokasi%</span>
                  </div>
                  <div class="jenis-bar"><div class="jenis-fill alokasi" style="width:@pctAlokasi%"></div></div>
                  <div class="custom-chart-tooltip">
                      <span class="tooltip-color-box" style="background:var(--primary);"></span>
                      Alokasi: @jenisData.Alokasi
                  </div>
              </div>
              <div class="jenis-item">
                  <div class="jenis-label">
                      <span class="jenis-name">Peminjaman</span>
                      <span class="jenis-pct">@pctPeminjaman%</span>
                  </div>
                  <div class="jenis-bar"><div class="jenis-fill peminjaman" style="width:@pctPeminjaman%"></div></div>
                  <div class="custom-chart-tooltip">
                      <span class="tooltip-color-box" style="background:var(--success);"></span>
                      Peminjaman: @jenisData.Peminjaman
                  </div>
              </div>
              <div class="jenis-item">
                  <div class="jenis-label">
                      <span class="jenis-name">Penarikan</span>
                      <span class="jenis-pct">@pctPenarikan%</span>
                  </div>
                  <div class="jenis-bar"><div class="jenis-fill penarikan" style="width:@pctPenarikan%; background: #F59E0B"></div></div>
                  <div class="custom-chart-tooltip">
                      <span class="tooltip-color-box" style="background:#F59E0B;"></span>
                      Penarikan: @jenisData.Penarikan
                  </div>
              </div>
              <div class="jenis-item">
                  <div class="jenis-label">
                      <span class="jenis-name">Lainnya</span>
                      <span class="jenis-pct">@pctLainnya%</span>
                  </div>
                  <div class="jenis-bar"><div class="jenis-fill lainnya" style="width:@pctLainnya%; background: #64748B"></div></div>
                  <div class="custom-chart-tooltip">
                      <span class="tooltip-color-box" style="background:#64748B;"></span>
                      Lainnya: @jenisData.Lainnya
                  </div>
              </div>
        </div>

        <!-- Peminjaman card -->
        <div class="due-section">
            <div class="due-header">
                <div class="due-title">
                    <i class="bi bi-alarm"></i>
                    Peminjaman Aktif
                </div>
                @if (activePeminjaman.Any(b => (b.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days < 0))
                {
                    <span class="pill" style="background:var(--danger-light);color:var(--danger);font-size:11px;">@activePeminjaman.Count(b => (b.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days < 0) Overdue</span>
                }
            </div>
            @if (!activePeminjaman.Any())
            {
                <div style="text-align:center;padding:24px;color:var(--text-muted);">
                    <i class="bi bi-check-circle" style="font-size:24px;"></i>
                    <div style="margin-top:8px;font-size:14px;">Tidak ada peminjaman aktif</div>
                </div>
            }
            else
            {
                <div class="due-list">
                    @foreach (var d in activePeminjaman)
                    {
                        var daysLeft = (d.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
                        var badgeClass = daysLeft < 0 ? "due-badge overdue" : daysLeft == 0 ? "due-badge today" : daysLeft <= 2 ? "due-badge h1" : "due-badge h2";
                        var badgeText = daysLeft < 0 ? $"Lewat {Math.Abs(daysLeft)}h" : daysLeft == 0 ? "Hari Ini" : $"H-{daysLeft}";
                        <div class="due-item" @onclick="@(async () => await OpenDetailModal(d.Id))">
                            <div class="due-item-info">
                                <div class="due-item-surat">@d.NomorSurat</div>
                                <div class="due-item-pj"><i class="bi bi-person" style="font-size:11px;"></i> @d.Pj?.Nama</div>
                                <div class="due-item-tgl"><i class="bi bi-calendar-event" style="font-size:11px;"></i> @d.TanggalKembali?.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="due-item-right">
                                <span class="@badgeClass">@badgeText</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    </div>
}

<!-- ═══ MODAL DETAIL PEMINJAMAN ═══ -->
@if (modalBA is not null)
{
    <div class="loan-modal-overlay" @onclick="CloseModal">
        <div class="loan-modal" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="loan-modal-header">
                <div style="flex:1;">
                    <div class="loan-modal-label">Detail Peminjaman</div>
                    <div class="loan-modal-title" style="margin-bottom:8px;">@modalBA.NomorSurat</div>
                    @{
                        var mDaysLeft = (modalBA.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
                        var mBadgeClass = mDaysLeft < 0 ? "due-badge overdue" : mDaysLeft == 0 ? "due-badge today" : mDaysLeft <= 2 ? "due-badge h1" : "due-badge h2";
                        var mBadgeText = mDaysLeft < 0 ? $"Lewat {Math.Abs(mDaysLeft)} Hari" : mDaysLeft == 0 ? "Jatuh Tempo Hari Ini" : $"H-{mDaysLeft}";
                    }
                    <span class="@mBadgeClass" style="font-size:13px;padding:6px 14px;display:inline-block;">@mBadgeText</span>
                </div>
                <button class="loan-modal-close" style="align-self:flex-start;" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
            </div>

            <!-- Modal Body -->
            <div class="loan-modal-body" style="overflow-y:auto;max-height:calc(100vh - 200px);display:block;">
                <!-- Info Dokumen -->
                <div class="card" style="margin-bottom:16px;box-shadow:none;border:1px solid #cbd5e1;">
                    <div class="card-header" style="padding:16px;border-bottom:1px solid #cbd5e1;">
                        <h3 style="margin:0;font-size:15px;color:var(--text-primary);font-weight:700;">Informasi Dokumen</h3>
                    </div>
                    <div class="card-body" style="padding:16px;">
                        <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:13px;width:35%;">No. Surat</td><td style="padding:8px 0;font-weight:600;font-size:13px;word-break:break-word;">@(modalBA.NomorSurat ?? "Belum dibuat")</td></tr>
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:13px;">Tanggal Terbit</td><td style="padding:8px 0;font-weight:600;font-size:13px;word-break:break-word;">@modalBA.Tanggal.ToString("dd MMMM yyyy")</td></tr>
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:13px;">Tanggal Kembali</td><td style="padding:8px 0;font-weight:600;font-size:13px;word-break:break-word;color:@(mDaysLeft < 0 ? "var(--danger)" : "var(--text-primary)");">@(modalBA.TanggalKembali?.ToString("dd MMMM yyyy") ?? "-")</td></tr>
                            <tr><td style="padding:8px 0;color:var(--text-secondary);font-size:13px;">No. Tiket My SSC</td><td style="padding:8px 0;font-weight:600;font-size:13px;word-break:break-word;">@(modalBA.TiketSscNo ?? "-")</td></tr>
                            <tr>
                                <td style="padding:8px 0;color:var(--text-secondary);font-size:13px;">Penanggung Jawab</td>
                                <td style="padding:8px 0;font-weight:600;font-size:13px;word-break:break-word;">@modalBA.Pj?.Nama</td>
                            </tr>
                            <tr>
                                <td style="padding:8px 0;color:var(--text-secondary);font-size:13px;">No. Telp</td>
                                <td style="padding:8px 0;font-weight:600;font-size:13px;word-break:break-word;">@(string.IsNullOrEmpty(modalBA.PjNoTelp) ? "-" : modalBA.PjNoTelp)</td>
                            </tr>
                        </table>
                    </div>
                </div>



                <!-- Perpanjangan Waktu -->
                <div class="card" style="margin-bottom:16px;box-shadow:none;border:1px solid #cbd5e1;">
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid #cbd5e1;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <h3 style="margin:0;font-size:15px;color:var(--text-primary);font-weight:700;">Perpanjangan Waktu</h3>
                            @if (riwayatPerpanjangan.Count > 0)
                            {
                                <span style="background:var(--primary-light);color:var(--primary);font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;">@riwayatPerpanjangan.Count× diperpanjang</span>
                            }
                        </div>
                        @if (!showPerpanjanganForm)
                        {
                            <button @onclick="@(() => { showPerpanjanganForm = true; perpanjanganError = null; })"
                                    style="display:flex;align-items:center;gap:6px;background:var(--primary);color:white;border:none;border-radius:var(--radius);padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer;">
                                <i class="bi bi-calendar-plus"></i> Perpanjang
                            </button>
                        }
                    </div>

                    @if (showPerpanjanganForm)
                    {
                        <div style="padding:14px 16px;border-bottom:1px solid #f1f5f9;background:#f8fafc;">
                            <div style="font-size:12px;font-weight:600;color:var(--text-secondary);margin-bottom:10px;">Tanggal Kembali Saat Ini: <span style="color:var(--text-primary);">@modalBA.TanggalKembali?.ToString("dd MMMM yyyy")</span></div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
                                <div>
                                    <label style="font-size:12px;color:var(--text-secondary);font-weight:600;display:block;margin-bottom:4px;">Tanggal Kembali Baru <span style="color:var(--danger)">*</span></label>
                                    <input type="date"
                                           style="width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:var(--radius);padding:7px 10px;font-size:13px;outline:none;background:white;color:var(--text-primary);font-family:inherit;"
                                           @bind="inputTanggalPerpanjangan" />
                                </div>
                                <div>
                                    <label style="font-size:12px;color:var(--text-secondary);font-weight:600;display:block;margin-bottom:4px;">Catatan (opsional)</label>
                                    <input type="text" placeholder="Alasan perpanjangan..."
                                           style="width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:var(--radius);padding:7px 10px;font-size:13px;outline:none;background:white;color:var(--text-primary);font-family:inherit;"
                                           @bind="inputCatatanPerpanjangan" />
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(perpanjanganError))
                            {
                                <div style="font-size:12px;color:var(--danger);margin-bottom:8px;">@perpanjanganError</div>
                            }
                            <div style="display:flex;gap:8px;justify-content:flex-end;">
                                <button @onclick="@(() => { showPerpanjanganForm = false; perpanjanganError = null; })"
                                        style="background:none;border:1px solid var(--border);border-radius:var(--radius);padding:6px 14px;font-size:12px;cursor:pointer;color:var(--text-secondary);">
                                    Batal
                                </button>
                                <button @onclick="SavePerpanjangan" disabled="@isSavingPerpanjangan"
                                        style="background:var(--primary);color:white;border:none;border-radius:var(--radius);padding:6px 14px;font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
                                    @if (isSavingPerpanjangan)
                                    {
                                        <div class="spinner" style="width:12px;height:12px;border-width:2px;border-color:white;border-top-color:transparent;"></div>
                                    }
                                    Simpan Perpanjangan
                                </button>
                            </div>
                        </div>
                    }

                    @if (riwayatPerpanjangan.Count == 0 && !showPerpanjanganForm)
                    {
                        <div style="padding:16px;text-align:center;color:var(--text-muted);font-size:13px;">
                            <i class="bi bi-calendar-check" style="font-size:20px;display:block;margin-bottom:6px;"></i>
                            Belum ada perpanjangan
                        </div>
                    }
                    else if (riwayatPerpanjangan.Count > 0)
                    {
                        <div style="padding:0;">
                            @foreach (var (p, idx) in riwayatPerpanjangan.Select((p, i) => (p, i)))
                            {
                                <div style="display:grid;grid-template-columns:auto 1fr auto;align-items:start;gap:12px;padding:12px 16px;@(idx < riwayatPerpanjangan.Count - 1 ? "border-bottom:1px solid #f1f5f9;" : "")">
                                    <div style="width:28px;height:28px;border-radius:50%;background:var(--primary-light);color:var(--primary);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                        @(riwayatPerpanjangan.Count - idx)
                                    </div>
                                    <div>
                                        <div style="font-size:13px;font-weight:600;color:var(--text-primary);margin-bottom:2px;">
                                            @p.TanggalKembalisebelumnya.ToString("dd MMM yyyy")
                                            <i class="bi bi-arrow-right" style="font-size:11px;color:var(--text-muted);margin:0 4px;"></i>
                                            @p.TanggalKembaliBaru.ToString("dd MMM yyyy")
                                        </div>
                                        @if (!string.IsNullOrEmpty(p.Catatan))
                                        {
                                            <div style="font-size:12px;color:var(--text-secondary);">@p.Catatan</div>
                                        }
                                    </div>
                                    <div style="font-size:11px;color:var(--text-muted);white-space:nowrap;margin-top:3px;">@p.DiperpanjangPada.ToString("dd MMM yyyy")</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Daftar Perangkat -->
                @if (modalBA.Perangkat.Any())
                {
                    <div class="card" style="margin-bottom:16px;box-shadow:none;border:1px solid #cbd5e1;">
                        <div class="card-header" style="padding:16px;border-bottom:1px solid #cbd5e1;">
                            <h3 style="margin:0;font-size:15px;color:var(--text-primary);font-weight:700;">Daftar Perangkat</h3>
                        </div>
                        <div style="width:100%;overflow-x:auto;">
                            <table class="data-table" style="margin-top:0;min-width:500px;">
                                <thead>
                                    <tr>
                                        <th>Perangkat</th>
                                        <th>Jumlah</th>
                                        <th>Satuan</th>
                                        <th>No. Serial</th>
                                        <th>Keterangan</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in modalBA.Perangkat)
                                    {
                                        <tr>
                                            <td><span style="font-weight:600;font-size:13px;">@p.Barang?.NamaBarang</span></td>
                                            <td style="font-size:13px;">@p.Jumlah</td>
                                            <td style="color:var(--text-secondary);font-size:13px;">@p.Satuan</td>
                                            <td style="font-size:13px;">@(p.NoSerial ?? "-")</td>
                                            <td style="color:var(--text-secondary);font-size:13px;">@(p.Keterangan ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;border:1px solid var(--border-light);border-radius:var(--radius);">
                        <i class="bi bi-box"></i> Tidak ada data perangkat
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="loan-modal-footer">
                @if (isReturning)
                {
                    <div style="display:flex;align-items:center;gap:10px;background:var(--warning-light);padding:10px 16px;border-radius:var(--radius);border:1px solid var(--warning);flex:1;">
                        <i class="bi bi-exclamation-triangle-fill" style="color:var(--warning);"></i>
                        <div class="spinner" style="width:16px;height:16px;border-width:2px;margin-left:auto;"></div>
                    </div>
                }
                else if (confirmReturnId == modalBA.Id)
                {
                    <div style="display:flex;align-items:center;gap:10px;background:transparent;padding:10px 0;flex:1;">
                        <span style="font-size:13px;font-weight:600;color:var(--text-primary);">Konfirmasi: semua perangkat di atas sudah dikembalikan?</span>
                        <div style="display:flex;gap:8px;margin-left:auto;">
                            <button class="btn btn-sm btn-success" @onclick="ConfirmReturn">Ya, Dikembalikan</button>
                            <button class="btn btn-sm btn-outline" @onclick="CancelReturn">Batal</button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-success" @onclick="@(() => InitiateReturn(modalBA.Id, modalBA.NomorSurat ?? $"BA-{modalBA.Id}"))">
                        <i class="bi bi-box-arrow-in-down"></i> Tandai Sudah Dikembalikan
                    </button>
                }
            </div>
        </div>
    </div>
}
else if (currentRole == "Reviewer")
{
    <!-- ════ DASHBOARD REVIEWER ════ -->
    <div class="dashboard-fill">
    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card-icon progress"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Menunggu Persetujuan</div>
                <div class="stat-card-value blue">@reviewerStat.Pending</div>
                <div class="stat-card-desc">Perlu diproses</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-check-circle"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Disetujui Bulan Ini</div>
                <div class="stat-card-value green">@reviewerStat.ApprovedThisMonth</div>
                <div class="stat-card-desc">Telah disetujui</div>
            </div>
        </div>
        <div class="stat-card">
