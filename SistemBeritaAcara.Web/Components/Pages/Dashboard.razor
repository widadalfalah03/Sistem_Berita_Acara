                <div class="due-list">
                    @foreach (var ba in SortedReviewerQueue)
                    {
                        var isToday = ba.SubmittedAt?.Date == DateTime.Today;
                        var badgeClass = isToday ? "due-badge today" : "due-badge h2";
                        var badgeText = isToday ? "Hari Ini" : "Menunggu";
                        <div class="due-item" @onclick="@(() => Navigation.NavigateTo($"/berita-acara/{ba.Id}?from=dashboard"))">
