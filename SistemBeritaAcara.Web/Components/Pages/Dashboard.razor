    <div class="dashboard-grid">
        <!-- Jenis BA Progress (Left Column) -->
        <div class="jenis-card">
            <div class="jenis-title">Berita Acara Direview</div>
            @{
                var totalRev = reviewerStat.Total;
                var pctRevAlokasi = totalRev > 0 ? (int)Math.Round((double)reviewerStat.ApprovedAlokasi / totalRev * 100) : 0;
                var pctRevPeminjaman = totalRev > 0 ? (int)Math.Round((double)reviewerStat.ApprovedPeminjaman / totalRev * 100) : 0;
                var pctRevPenarikan = totalRev > 0 ? (int)Math.Round((double)reviewerStat.ApprovedPenarikan / totalRev * 100) : 0;
                var pctRevLainnya = totalRev > 0 ? (int)Math.Round((double)reviewerStat.ApprovedLainnya / totalRev * 100) : 0;
