@page "/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SistemBeritaAcara.Core.Entities
@using BAEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Dashboard — Sistem Berita Acara</PageTitle>

@if (isLoading)
{
    <div class="loading-spinner">
        <div class="spinner"></div>
        <span>Memuat dashboard...</span>
    </div>
}
else if (currentRole == "AdminGudangBarang")
{
    <!-- ════ DASHBOARD ADMIN GUDANG ════ -->
    <div class="dashboard-fill">
    <!-- Stat Cards -->
    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card-icon draft"><i class="bi bi-file-earmark-text"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total Draft</div>
                <div class="stat-card-value">@stat.Draft</div>
                <div class="stat-card-desc">Belum diajukan</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon progress"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Sedang Diproses</div>
                <div class="stat-card-value blue">@stat.Progress</div>
                <div class="stat-card-desc">Menunggu persetujuan</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-check-circle"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Disetujui</div>
                <div class="stat-card-value green">@stat.Approved</div>
                <div class="stat-card-desc">Telah disetujui</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon rejected"><i class="bi bi-x-circle"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Ditolak</div>
                <div class="stat-card-value red">@stat.Rejected</div>
                <div class="stat-card-desc">Dikembalikan approver</div>
            </div>
        </div>
    </div>

    <!-- Charts row -->
    <div class="dashboard-grid">
        <!-- Line chart -->
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">Tren Pembuatan Berita Acara</span>
                <span class="chart-period">6 Bulan Terakhir</span>
            </div>
            <div class="chart-container" style="height:200px;">
                <canvas id="trendChart"></canvas>
            </div>
        </div>

        <!-- Donut chart -->
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">Status BA Saat Ini</span>
            </div>
            <div class="chart-container" style="height:170px;position:relative;">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Jenis BA + Due Date row -->
    <div class="dashboard-grid">
        <!-- Jenis BA progress bars -->
        <div class="jenis-card">
            <div class="jenis-title">Jenis BA</div>
            @{
                var total = jenisData.Alokasi + jenisData.Peminjaman;
                var pctAlokasi = total > 0 ? (int)Math.Round((double)jenisData.Alokasi / total * 100) : 0;
                var pctPeminjaman = total > 0 ? (int)Math.Round((double)jenisData.Peminjaman / total * 100) : 0;
            }
              <div class="jenis-item">
                  <div class="jenis-label">
                      <span class="jenis-name">Alokasi</span>
                      <span class="jenis-pct">@pctAlokasi%</span>
                  </div>
                  <div class="jenis-bar"><div class="jenis-fill alokasi" style="width:@pctAlokasi%"></div></div>
              </div>
              <div class="jenis-item">
                  <div class="jenis-label">
                      <span class="jenis-name">Peminjaman</span>
                      <span class="jenis-pct">@pctPeminjaman%</span>
                  </div>
                  <div class="jenis-bar"><div class="jenis-fill peminjaman" style="width:@pctPeminjaman%"></div></div>
              </div>
        </div>

        <!-- Peminjaman card -->
        <div class="due-section">
            <div class="due-header">
                <div class="due-title">
                    <i class="bi bi-alarm"></i>
                    Peminjaman Aktif
                </div>
                @if (activePeminjaman.Any(b => (b.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days < 0))
                {
                    <span class="pill" style="background:var(--danger-light);color:var(--danger);font-size:11px;">@activePeminjaman.Count(b => (b.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days < 0) Overdue</span>
                }
            </div>
            @if (!activePeminjaman.Any())
            {
                <div style="text-align:center;padding:24px;color:var(--text-muted);">
                    <i class="bi bi-check-circle" style="font-size:24px;"></i>
                    <div style="margin-top:8px;font-size:14px;">Tidak ada peminjaman aktif</div>
                </div>
            }
            else
            {
                <div class="due-list">
                    @foreach (var d in activePeminjaman)
                    {
                        var daysLeft = (d.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
                        var badgeClass = daysLeft < 0 ? "due-badge overdue" : daysLeft == 0 ? "due-badge today" : daysLeft <= 2 ? "due-badge h1" : "due-badge h2";
                        var badgeText = daysLeft < 0 ? $"Lewat {Math.Abs(daysLeft)}h" : daysLeft == 0 ? "Hari Ini" : $"H-{daysLeft}";
                        <div class="due-item">
                            <div class="due-item-info">
                                <div class="due-item-surat">@d.NomorSurat</div>
                                <div class="due-item-pj"><i class="bi bi-person" style="font-size:11px;"></i> @d.Pj?.Nama</div>
                                <div class="due-item-tgl"><i class="bi bi-calendar-event" style="font-size:11px;"></i> @d.TanggalKembali?.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="due-item-right">
                                <span class="@badgeClass">@badgeText</span>
                                <button class="btn-detail-loan" @onclick="@(() => OpenDetailModal(d.Id))">
                                    <i class="bi bi-eye"></i> Detail
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    </div>
}

<!-- ═══ MODAL DETAIL PEMINJAMAN ═══ -->
@if (modalBA is not null)
{
    <div class="loan-modal-overlay" @onclick="CloseModal">
        <div class="loan-modal" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="loan-modal-header">
                <div>
                    <div class="loan-modal-label">Detail Peminjaman</div>
                    <div class="loan-modal-title">@modalBA.NomorSurat</div>
                </div>
                @{
                    var mDaysLeft = (modalBA.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
                    var mBadgeClass = mDaysLeft < 0 ? "due-badge overdue" : mDaysLeft == 0 ? "due-badge today" : mDaysLeft <= 2 ? "due-badge h1" : "due-badge h2";
                    var mBadgeText = mDaysLeft < 0 ? $"Lewat {Math.Abs(mDaysLeft)} Hari" : mDaysLeft == 0 ? "Jatuh Tempo Hari Ini" : $"H-{mDaysLeft}";
                }
                <div style="display:flex;align-items:center;gap:12px;">
                    <span class="@mBadgeClass" style="font-size:13px;padding:6px 14px;">@mBadgeText</span>
                    <button class="loan-modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="loan-modal-body">
                <!-- Info Grid -->
                <div class="loan-info-grid">
                    <div class="loan-info-block">
                        <div class="loan-info-label">Jenis BA</div>
                        <div class="loan-info-value"><span class="pill pill-peminjaman" style="font-size:12px;">@modalBA.Jenis</span></div>
                    </div>
                    <div class="loan-info-block">
                        <div class="loan-info-label">Tanggal BA</div>
                        <div class="loan-info-value">@modalBA.Tanggal.ToString("dd MMMM yyyy")</div>
                    </div>
                    <div class="loan-info-block">
                        <div class="loan-info-label">Tanggal Kembali</div>
                        <div class="loan-info-value" style="color:@(mDaysLeft < 0 ? "var(--danger)" : "var(--text-primary)");font-weight:700;">
                            @modalBA.TanggalKembali?.ToString("dd MMMM yyyy")
                        </div>
                    </div>
                    <div class="loan-info-block">
                        <div class="loan-info-label">No. Tiket SSC</div>
                        <div class="loan-info-value">@(modalBA.TiketSscNo ?? "—")</div>
                    </div>
                </div>

                <div class="loan-info-grid">
                    <div class="loan-info-block">
                        <div class="loan-info-label"><i class="bi bi-person-fill" style="color:var(--primary);"></i> Penanggung Jawab</div>
                        <div class="loan-info-value">@modalBA.Pj?.Nama</div>
                        <div class="loan-info-sub">@modalBA.Pj?.Jabatan · @modalBA.Pj?.FungsiDirektorat</div>
                    </div>
                    <div class="loan-info-block">
                        <div class="loan-info-label"><i class="bi bi-person-badge-fill" style="color:var(--warning);"></i> Yang Menyerahkan</div>
                        <div class="loan-info-value">@modalBA.Menyerahkan?.Nama</div>
                        <div class="loan-info-sub">@modalBA.Menyerahkan?.FungsiDirektorat</div>
                    </div>
                    <div class="loan-info-block">
                        <div class="loan-info-label"><i class="bi bi-person-check-fill" style="color:var(--success);"></i> Yang Mengetahui</div>
                        <div class="loan-info-value">@modalBA.Mengetahui?.Nama</div>
                        <div class="loan-info-sub">@modalBA.Mengetahui?.Jabatan</div>
                    </div>
                    @if (!string.IsNullOrEmpty(modalBA.PjNoTelp))
                    {
                        <div class="loan-info-block">
                            <div class="loan-info-label"><i class="bi bi-telephone-fill" style="color:var(--primary);"></i> No. Telp PJ</div>
                            <div class="loan-info-value">@modalBA.PjNoTelp</div>
                        </div>
                    }
                </div>

                <!-- Daftar Perangkat -->
                <div class="loan-section-title"><i class="bi bi-cpu"></i> Daftar Perangkat</div>
                @if (modalBA.Perangkat.Any())
                {
                    <table class="data-table" style="margin-top:0;">
                        <thead>
                            <tr>
                                <th>Nama Perangkat</th>
                                <th>Jumlah</th>
                                <th>Satuan</th>
                                <th>No. Serial</th>
                                <th>Keterangan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in modalBA.Perangkat)
                            {
                                <tr>
                                    <td><span style="font-weight:600;">@p.Barang?.NamaBarang</span></td>
                                    <td>@p.Jumlah</td>
                                    <td style="color:var(--text-secondary);">@p.Satuan</td>
                                    <td style="font-family:monospace;font-size:12px;">@(p.NoSerial ?? "—")</td>
                                    <td style="color:var(--text-secondary);">@(p.Keterangan ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align:center;padding:20px;color:var(--text-muted);font-size:13px;">
                        <i class="bi bi-box"></i> Tidak ada data perangkat
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="loan-modal-footer">
                @if (isReturning)
                {
                    <div style="display:flex;align-items:center;gap:10px;background:var(--warning-light);padding:10px 16px;border-radius:var(--radius);border:1px solid var(--warning);flex:1;">
                        <i class="bi bi-exclamation-triangle-fill" style="color:var(--warning);"></i>
                        <span style="font-size:13px;">Memproses pengembalian...</span>
                        <div class="spinner" style="width:16px;height:16px;border-width:2px;margin-left:auto;"></div>
                    </div>
                }
                else if (confirmReturnId == modalBA.Id)
                {
                    <div style="display:flex;align-items:center;gap:10px;background:var(--warning-light);padding:10px 16px;border-radius:var(--radius);border:1px solid var(--warning);flex:1;">
                        <i class="bi bi-exclamation-triangle-fill" style="color:var(--warning);"></i>
                        <span style="font-size:13px;font-weight:600;">Konfirmasi: semua perangkat di atas sudah dikembalikan?</span>
                        <div style="display:flex;gap:8px;margin-left:auto;">
                            <button class="btn btn-sm btn-success" @onclick="ConfirmReturn">Ya, Dikembalikan</button>
                            <button class="btn btn-sm btn-outline" @onclick="CancelReturn">Batal</button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-success" @onclick="@(() => InitiateReturn(modalBA.Id, modalBA.NomorSurat ?? $"BA-{modalBA.Id}"))">
                        <i class="bi bi-box-arrow-in-down"></i> Tandai Sudah Dikembalikan
                    </button>
                }
            </div>
        </div>
    </div>
}
else if (currentRole == "Approver")
{
    <!-- ════ DASHBOARD APPROVER ════ -->
    <div class="dashboard-fill">
    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-card-icon pending"><i class="bi bi-inbox"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Antrian Pending</div>
                <div class="stat-card-value red">@approverStat.Pending</div>
                <div class="stat-card-desc">Perlu diproses</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon total"><i class="bi bi-clipboard-data"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total Review</div>
                <div class="stat-card-value">@approverStat.Total</div>
                <div class="stat-card-desc">Semua waktu</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-check-circle"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Disetujui</div>
                <div class="stat-card-value green">@approverStat.Approved</div>
                <div class="stat-card-desc">@approverStat.ApprovedPct% dari total</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon rejected"><i class="bi bi-x-circle"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Ditolak</div>
                <div class="stat-card-value red">@approverStat.Rejected</div>
                <div class="stat-card-desc">@approverStat.RejectedPct% dari total</div>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">Tren Persetujuan Bulanan</span>
                <span class="chart-period">6 Bulan Terakhir</span>
            </div>
            <div class="chart-container" style="height:200px;">
                <canvas id="approverTrendChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title">Approval / Rejection</span>
            </div>
            <div class="chart-container" style="height:170px;position:relative;">
                <canvas id="approverDonut"></canvas>
            </div>
        </div>
    </div>

    <!-- Antrian -->
    <div class="card">
        <div class="card-header">
            <h3>Antrean Persetujuan</h3>
            @if (approverQueue.Any())
            {
                <span class="pill pill-waiting-approval">@approverQueue.Count Menunggu</span>
            }
        </div>
        @if (!approverQueue.Any())
        {
            <div style="text-align:center;padding:48px;color:var(--text-muted);">
                <i class="bi bi-inbox" style="font-size:32px;display:block;margin-bottom:12px;"></i>
                Tidak ada antrian persetujuan saat ini
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="cursor:pointer;" @onclick="@(() => SortApprover("No. Surat"))">No. Surat <i class="bi @GetApproverSortIcon("No. Surat")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortApprover("Jenis BA"))">Jenis Berita Acara <i class="bi @GetApproverSortIcon("Jenis BA")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortApprover("Penanggung Jawab"))">Penanggung Jawab <i class="bi @GetApproverSortIcon("Penanggung Jawab")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortApprover("Tanggal Submit"))">Tanggal Submit <i class="bi @GetApproverSortIcon("Tanggal Submit")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ba in SortedApproverQueue)
                    {
                        <tr>
                            <td><span class="fw-semibold text-primary">@ba.NomorSurat</span></td>
                            <td><span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span></td>
                            <td>
                                <div class="cell-main">@ba.Pj?.Nama</div>
                                <div class="cell-sub">@ba.Pj?.FungsiDirektorat</div>
                            </td>
                            <td>@ba.SubmittedAt?.ToString("dd MMM yyyy")</td>
                            <td>
                                <NavLink class="btn-review" href="@($"/berita-acara/{ba.Id}")">
                                    Review
                                </NavLink>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    </div>
}
else if (currentRole == "AdminIT")
{
    <!-- ════ DASHBOARD ADMIN IT ════ -->
    <!-- Stat Cards row 1: Pengguna -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:16px;">
        <div class="stat-card">
            <div class="stat-card-icon total"><i class="bi bi-people-fill"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total Pengguna Sistem</div>
                <div class="stat-card-value">@userStats.Total</div>
                <div class="stat-card-desc">Akun aktif</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon neutral"><i class="bi bi-shield-lock"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Admin IT</div>
                <div class="stat-card-value">@userStats.AdminIT</div>
                <div class="stat-card-desc">Superadmin sistem</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-box-seam"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Admin Gudang</div>
                <div class="stat-card-value green">@userStats.AdminGudang</div>
                <div class="stat-card-desc">Pembuat Berita Acara</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon progress"><i class="bi bi-person-check-fill"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Approver</div>
                <div class="stat-card-value blue">@userStats.Approver</div>
                <div class="stat-card-desc">Penanda tangan akhir</div>
            </div>
        </div>
    </div>

    <!-- Stat Cards row 2: Data Master -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;">
        <div class="stat-card">
            <div class="stat-card-icon draft"><i class="bi bi-person-badge-fill"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total Pegawai</div>
                <div class="stat-card-value">@itStats.TotalPegawai</div>
                <div class="stat-card-desc">Data master pegawai</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon neutral"><i class="bi bi-cpu-fill"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Jenis Perangkat</div>
                <div class="stat-card-value">@itStats.TotalBarang</div>
                <div class="stat-card-desc">Data master barang</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-file-earmark-check-fill"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total BA Disetujui</div>
                <div class="stat-card-value green">@itStats.TotalApproved</div>
                <div class="stat-card-desc">Seluruh sistem</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon progress"><i class="bi bi-hourglass-split"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">BA Sedang Diproses</div>
                <div class="stat-card-value blue">@itStats.TotalProgress</div>
                <div class="stat-card-desc">Menunggu persetujuan</div>
            </div>
        </div>
    </div>

    <!-- Quick Access Cards -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;">
        <NavLink href="/pengguna" class="stat-card" style="text-decoration:none;display:flex;cursor:pointer;transition:box-shadow 0.2s;"
                 onmouseover="this.style.boxShadow='var(--shadow-md)'" onmouseout="this.style.boxShadow=''">
            <div class="stat-card-icon total"><i class="bi bi-people"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label" style="font-size:14px;font-weight:700;color:var(--text-primary);">Kelola Pengguna</div>
                <div class="stat-card-desc">Tambah, edit, atau nonaktifkan akun pengguna sistem →</div>
            </div>
        </NavLink>
        <NavLink href="/data-pegawai" class="stat-card" style="text-decoration:none;display:flex;cursor:pointer;transition:box-shadow 0.2s;"
                 onmouseover="this.style.boxShadow='var(--shadow-md)'" onmouseout="this.style.boxShadow=''">
            <div class="stat-card-icon draft"><i class="bi bi-person-badge"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label" style="font-size:14px;font-weight:700;color:var(--text-primary);">Data Pegawai</div>
                <div class="stat-card-desc">Import & kelola data master pegawai dari Excel →</div>
            </div>
        </NavLink>
        <NavLink href="/data-barang" class="stat-card" style="text-decoration:none;display:flex;cursor:pointer;transition:box-shadow 0.2s;"
                 onmouseover="this.style.boxShadow='var(--shadow-md)'" onmouseout="this.style.boxShadow=''">
            <div class="stat-card-icon neutral"><i class="bi bi-box-seam"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label" style="font-size:14px;font-weight:700;color:var(--text-primary);">Data Barang</div>
                <div class="stat-card-desc">Import & kelola master perangkat keras →</div>
            </div>
        </NavLink>
    </div>

    <!-- Recent Activity -->
    <div class="card">
        <div class="card-header">
            <h3>Aktivitas Berita Acara Terbaru</h3>
            <span style="font-size:13px;color:var(--text-muted);">Seluruh sistem</span>
        </div>
        @if (!itStats.RecentBA.Any())
        {
            <div style="text-align:center;padding:40px;color:var(--text-muted);">
                <i class="bi bi-inbox" style="font-size:32px;display:block;margin-bottom:12px;"></i>
                Belum ada aktivitas Berita Acara
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="cursor:pointer;" @onclick="@(() => SortIT("No. Surat"))">No. Surat <i class="bi @GetITSortIcon("No. Surat")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortIT("Jenis"))">Jenis <i class="bi @GetITSortIcon("Jenis")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortIT("Penanggung Jawab"))">Penanggung Jawab <i class="bi @GetITSortIcon("Penanggung Jawab")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortIT("Dibuat Oleh"))">Dibuat Oleh <i class="bi @GetITSortIcon("Dibuat Oleh")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortIT("Tanggal"))">Tanggal <i class="bi @GetITSortIcon("Tanggal")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                        <th style="cursor:pointer;" @onclick="@(() => SortIT("Status"))">Status <i class="bi @GetITSortIcon("Status")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ba in SortedRecentBA)
                    {
                        <tr>
                            <td class="fw-semibold text-primary">@(ba.NomorSurat ?? "Draft")</td>
                            <td><span class="pill @GetJenisPill(ba.Jenis)" style="font-size:11px;">@ba.Jenis</span></td>
                            <td>@ba.Pj?.Nama</td>
                            <td>@ba.Creator?.Nama</td>
                            <td>@ba.Tanggal.ToString("dd MMM yyyy")</td>
                            <td><span class="pill @GetStatusPill(ba.Status)" style="font-size:11px;">@GetStatusLabel(ba.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private bool isLoading = true;
    private string currentRole = string.Empty;
    private int currentUserId;
    private bool chartsRendered = false;

    // Gudang stats
    private (int Draft, int Progress, int Approved, int Rejected) stat;
    private (int Alokasi, int Peminjaman, int Lainnya) jenisData;
    private List<BAEntity> activePeminjaman = new();
    private List<int[]> trendData = new(); // [month-6..month-0]

    // Return action state
    private int? confirmReturnId = null;
    private string confirmReturnNomorSurat = string.Empty;
    private bool isReturning = false;
    private BAEntity? modalBA = null;

    // Approver stats
    private (int Pending, int Total, int Approved, int Rejected, int ApprovedPct, int RejectedPct) approverStat;
    private List<BAEntity> approverQueue = new();

    // AdminIT stats
    private (int Total, int AdminIT, int AdminGudang, int Approver) userStats;
    private AdminITStats itStats = new();

    private sealed class AdminITStats
    {
        public int TotalPegawai { get; set; }
        public int TotalBarang { get; set; }
        public int TotalApproved { get; set; }
        public int TotalProgress { get; set; }
        public List<BAEntity> RecentBA { get; set; } = new();
    }

    [Inject] private AppDbContext DbCtx { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = auth.User.Identity?.Name;
        if (email is null) { Navigation.NavigateTo("/login", true); return; }

        var appUser = await UserManager.FindByEmailAsync(email);
        if (appUser is null) { Navigation.NavigateTo("/login", true); return; }

        currentRole = appUser.Role;
        currentUserId = appUser.Id;

        if (currentRole == "AdminGudangBarang")
            await LoadGudangDataAsync();
        else if (currentRole == "Approver")
            await LoadApproverDataAsync();
        else if (currentRole == "AdminIT")
            await LoadAdminITDataAsync();

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isLoading || chartsRendered) return;
        chartsRendered = true;

        if (currentRole == "AdminGudangBarang")
        {
            var months = GetLast6MonthLabels();
            var monthData = GetMonthlyData();
            await JS.InvokeVoidAsync("chartInterop.createLineChart", "trendChart",
                months,
                new[] { new { label = "Berita Acara Dibuat", data = monthData, color = "#1D4ED8" } });

            await JS.InvokeVoidAsync("chartInterop.createDonutChart", "statusChart",
                new[] { "Selesai", "Proses", "Ditolak", "Draft" },
                new[] { stat.Approved, stat.Progress, stat.Rejected, stat.Draft },
                new[] { "#22C55E", "#3B82F6", "#EF4444", "#94A3B8" });
        }
        else if (currentRole == "Approver")
        {
            var months = GetLast6MonthLabels();
            await JS.InvokeVoidAsync("chartInterop.createLineChart", "approverTrendChart",
                months,
                new[]
                {
                    new { label = "Disetujui", data = GetApproverMonthlyData(approved: true), color = "#22C55E" },
                    new { label = "Ditolak", data = GetApproverMonthlyData(approved: false), color = "#EF4444" }
                });

            await JS.InvokeVoidAsync("chartInterop.createDonutChart", "approverDonut",
                new[] { "Disetujui", "Ditolak" },
                new[] { approverStat.Approved, approverStat.Rejected },
                new[] { "#22C55E", "#EF4444" });
        }
    }

    private async Task LoadGudangDataAsync()
    {
        var myBA = await DbCtx.Set<BAEntity>()
            .Include(b => b.Pj)
            .Include(b => b.Menyerahkan)
            .Include(b => b.Mengetahui)
            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
            .Where(b => b.CreatedBy == currentUserId)
            .ToListAsync();

        stat.Draft = myBA.Count(b => b.Status == "Draft");
        stat.Progress = myBA.Count(b => b.Status is "WaitingPJSign" or "WaitingApproval");
        stat.Approved = myBA.Count(b => b.Status == "Approved");
        stat.Rejected = myBA.Count(b => b.Status == "Rejected");

        jenisData.Alokasi = myBA.Count(b => b.Jenis == "Alokasi");
        jenisData.Peminjaman = myBA.Count(b => b.Jenis == "Peminjaman");
        jenisData.Lainnya = myBA.Count(b => b.Jenis != "Alokasi" && b.Jenis != "Peminjaman");

        activePeminjaman = myBA
            .Where(b => b.Jenis == "Peminjaman" && b.TanggalKembali.HasValue
                        && b.Status == "Approved" && !b.IsReturned)
            .OrderBy(b => b.TanggalKembali)
            .ToList();
    }

    private async Task LoadApproverDataAsync()
    {
        var myQueue = await DbCtx.Set<BAEntity>()
            .Include(b => b.Pj)
            .Where(b => b.MengetahuiId == currentUserId)
            .ToListAsync();

        approverStat.Pending = myQueue.Count(b => b.Status == "WaitingApproval");
        approverStat.Approved = myQueue.Count(b => b.Status == "Approved");
        approverStat.Rejected = myQueue.Count(b => b.Status == "Rejected");
        approverStat.Total = approverStat.Approved + approverStat.Rejected;
        approverStat.ApprovedPct = approverStat.Total > 0 ? (int)Math.Round((double)approverStat.Approved / approverStat.Total * 100) : 0;
        approverStat.RejectedPct = approverStat.Total > 0 ? 100 - approverStat.ApprovedPct : 0;

        approverQueue = myQueue
            .Where(b => b.Status == "WaitingApproval")
            .OrderBy(b => b.SubmittedAt)
            .ToList();
    }

    private async Task LoadAdminITDataAsync()
    {
        var allUsers = await DbCtx.Users.ToListAsync();
        userStats.Total = allUsers.Count(u => !u.IsDeleted);
        userStats.AdminIT = allUsers.Count(u => u.Role == "AdminIT" && !u.IsDeleted);
        userStats.AdminGudang = allUsers.Count(u => u.Role == "AdminGudangBarang" && !u.IsDeleted);
        userStats.Approver = allUsers.Count(u => u.Role == "Approver" && !u.IsDeleted);

        itStats.TotalPegawai = await DbCtx.Pegawai.CountAsync();
        itStats.TotalBarang = await DbCtx.MasterBarang.CountAsync();
        itStats.TotalApproved = await DbCtx.Set<BAEntity>().CountAsync(b => b.Status == "Approved");
        itStats.TotalProgress = await DbCtx.Set<BAEntity>()
            .CountAsync(b => b.Status == "WaitingPJSign" || b.Status == "WaitingApproval");

        itStats.RecentBA = await DbCtx.Set<BAEntity>()
            .Include(b => b.Pj)
            .Include(b => b.Creator)
            .OrderByDescending(b => b.CreatedAt)
            .Take(10)
            .ToListAsync();
    }

    private string[] GetLast6MonthLabels()
    {
        return Enumerable.Range(0, 6)
            .Select(i => DateTime.Today.AddMonths(-5 + i).ToString("MMM", new System.Globalization.CultureInfo("id-ID")))
            .ToArray();
    }

    private int[] GetMonthlyData()
    {
        var result = new int[6];
        for (int i = 0; i < 6; i++)
        {
            var month = DateTime.Today.AddMonths(-5 + i);
            result[i] = DbCtx.Set<BAEntity>().Count(b =>
                b.CreatedBy == currentUserId &&
                b.CreatedAt.Month == month.Month &&
                b.CreatedAt.Year == month.Year);
        }
        return result;
    }

    private int[] GetApproverMonthlyData(bool approved)
    {
        var status = approved ? "Approved" : "Rejected";
        var result = new int[6];
        for (int i = 0; i < 6; i++)
        {
            var month = DateTime.Today.AddMonths(-5 + i);
            result[i] = DbCtx.Set<BAEntity>().Count(b =>
                b.MengetahuiId == currentUserId &&
                b.Status == status &&
                b.CreatedAt.Month == month.Month &&
                b.CreatedAt.Year == month.Year);
        }
        return result;
    }

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        _ => "pill-lainnya"
    };

    private static string GetStatusPill(string status) => status switch
    {
        "Approved" => "pill-approved",
        "Rejected" => "pill-rejected",
        "WaitingApproval" => "pill-waiting-approval",
        "WaitingPJSign" => "pill-waiting-pj",
        _ => "pill-draft"
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "Approved" => "Disetujui",
        "Rejected" => "Ditolak",
        "WaitingApproval" => "Menunggu Approval",
        "WaitingPJSign" => "Menunggu TTD Penanggung Jawab",
        "Draft" => "Draft",
        _ => status
    };

    // Modal actions
    private void OpenDetailModal(int baId)
    {
        modalBA = activePeminjaman.FirstOrDefault(b => b.Id == baId);
        confirmReturnId = null;
    }

    private void CloseModal()
    {
        if (isReturning) return;
        modalBA = null;
        confirmReturnId = null;
        confirmReturnNomorSurat = string.Empty;
    }

    // Return actions
    private void InitiateReturn(int baId, string nomorSurat)
    {
        confirmReturnId = baId;
        confirmReturnNomorSurat = nomorSurat;
    }

    private void CancelReturn()
    {
        confirmReturnId = null;
        confirmReturnNomorSurat = string.Empty;
    }

    private async Task ConfirmReturn()
    {
        if (confirmReturnId is null) return;
        isReturning = true;
        try
        {
            var ba = await DbCtx.Set<BAEntity>().FindAsync(confirmReturnId.Value);
            if (ba is not null)
            {
                ba.IsReturned = true;
                ba.ReturnedAt = DateTime.Now;
                await DbCtx.SaveChangesAsync();
                activePeminjaman.RemoveAll(b => b.Id == confirmReturnId.Value);
                modalBA = null;
            }
        }
        finally
        {
            isReturning = false;
            confirmReturnId = null;
            confirmReturnNomorSurat = string.Empty;
        }
    }

    // Approver sort
    private string sortAppCol = "Tanggal Submit";
    private bool sortAppAsc = true;
    private void SortApprover(string col) { if (sortAppCol == col) sortAppAsc = !sortAppAsc; else { sortAppCol = col; sortAppAsc = true; } }
    private string GetApproverSortIcon(string col) => sortAppCol != col ? "bi-arrow-down-up" : sortAppAsc ? "bi-arrow-up text-primary" : "bi-arrow-down text-primary";
    private IEnumerable<BAEntity> SortedApproverQueue => sortAppCol switch
    {
        "No. Surat" => sortAppAsc ? approverQueue.OrderBy(b => b.NomorSurat) : approverQueue.OrderByDescending(b => b.NomorSurat),
        "Jenis BA" => sortAppAsc ? approverQueue.OrderBy(b => b.Jenis) : approverQueue.OrderByDescending(b => b.Jenis),
        "Penanggung Jawab" => sortAppAsc ? approverQueue.OrderBy(b => b.Pj?.Nama) : approverQueue.OrderByDescending(b => b.Pj?.Nama),
        "Tanggal Submit" => sortAppAsc ? approverQueue.OrderBy(b => b.SubmittedAt) : approverQueue.OrderByDescending(b => b.SubmittedAt),
        _ => approverQueue
    };

    // Sort variables and logic for Admin IT
    private string sortITCol = "Tanggal";
    private bool sortITAsc = false; // Descending by default
    private void SortIT(string col) { if (sortITCol == col) sortITAsc = !sortITAsc; else { sortITCol = col; sortITAsc = true; } }
    private string GetITSortIcon(string col) => sortITCol != col ? "bi-arrow-down-up" : sortITAsc ? "bi-arrow-up text-primary" : "bi-arrow-down text-primary";
    private IEnumerable<BAEntity> SortedRecentBA => sortITCol switch
    {
        "No. Surat" => sortITAsc ? itStats.RecentBA.OrderBy(b => b.NomorSurat) : itStats.RecentBA.OrderByDescending(b => b.NomorSurat),
        "Jenis" => sortITAsc ? itStats.RecentBA.OrderBy(b => b.Jenis) : itStats.RecentBA.OrderByDescending(b => b.Jenis),
        "Penanggung Jawab" => sortITAsc ? itStats.RecentBA.OrderBy(b => b.Pj?.Nama) : itStats.RecentBA.OrderByDescending(b => b.Pj?.Nama),
        "Dibuat Oleh" => sortITAsc ? itStats.RecentBA.OrderBy(b => b.Creator?.Nama) : itStats.RecentBA.OrderByDescending(b => b.Creator?.Nama),
        "Tanggal" => sortITAsc ? itStats.RecentBA.OrderBy(b => b.Tanggal) : itStats.RecentBA.OrderByDescending(b => b.Tanggal),
        "Status" => sortITAsc ? itStats.RecentBA.OrderBy(b => b.Status) : itStats.RecentBA.OrderByDescending(b => b.Status),
        _ => itStats.RecentBA
    };
}