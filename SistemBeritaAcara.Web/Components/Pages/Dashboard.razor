    // Sort variables and logic for Admin Gudang (Due Dates)
    private string sortDueCol = "Tgl Kembali";
    private bool sortDueAsc = true;
    private void SortDue(string col) { if (sortDueCol == col) sortDueAsc = !sortDueAsc; else { sortDueCol = col; sortDueAsc = true; } }
    private string GetDueSortIcon(string col) => sortDueCol != col ? "bi-arrow-down-up" : sortDueAsc ? "bi-arrow-up text-primary" : "bi-arrow-down text-primary";
    private IEnumerable<BAEntity> SortedDueDates => sortDueCol switch
    {
        "No. Surat" => sortDueAsc ? dueDates.OrderBy(b => b.NomorSurat) : dueDates.OrderByDescending(b => b.NomorSurat),
        "PJ" => sortDueAsc ? dueDates.OrderBy(b => b.Pj?.Nama) : dueDates.OrderByDescending(b => b.Pj?.Nama),
        "Tgl Kembali" => sortDueAsc ? dueDates.OrderBy(b => b.TanggalKembali) : dueDates.OrderByDescending(b => b.TanggalKembali),
        "Status" => sortDueAsc ? dueDates.OrderBy(b => (b.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days) : dueDates.OrderByDescending(b => (b.TanggalKembali!.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days),
        _ => dueDates
    };

