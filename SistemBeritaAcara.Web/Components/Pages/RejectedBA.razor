@page "/rejected"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Rejected — Sistem Berita Acara</PageTitle>

<style>
    .folder-tabs-wrapper {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: -1px;
        position: relative;
        z-index: 10;
    }
    .folder-tabs {
        display: flex;
        gap: 4px;
    }
    .folder-tab {
        padding: 10px 22px;
        font-size: 14px;
        font-weight: 500;
        font-family: inherit;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid var(--border);
        background: var(--bg-secondary);
        color: var(--text-secondary);
        position: relative;
    }
    .folder-tab.active {
        background: var(--surface);
        color: var(--primary);
        font-weight: 700;
        border-bottom-color: var(--surface);
        z-index: 2;
    }
    .folder-tab.inactive {
        border-bottom-color: var(--border);
        z-index: 1;
    }
    .folder-tab:not(.active):hover {
        background: var(--border-light);
    }
</style>

<!-- Tab bar -->
<div class="folder-tabs-wrapper">
    <div class="folder-tabs">
        <button class="folder-tab @(activeTab == "revisi" ? "active" : "inactive")" @onclick='() => SwitchTab("revisi")'>
            Revisi @(revisiBA.Count > 0 ? $"({revisiBA.Count})" : "")
        </button>
        <button class="folder-tab @(activeTab == "riwayat" ? "active" : "inactive")" @onclick='() => SwitchTab("riwayat")'>
            Riwayat
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat data...</span></div>
}
else
{
    var currentList = activeTab == "revisi" ? revisiBA : riwayatBA;

    @if (!currentList.Any())
    {
        <div class="card" style="text-align:center;padding:60px;border-radius:0 var(--radius-lg) var(--radius-lg) var(--radius-lg);position:relative;z-index:1;">
            @if (activeTab == "revisi")
            {
                <i class="bi bi-check-circle" style="font-size:48px;color:var(--success,#22C55E);display:block;margin-bottom:16px;"></i>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Tidak ada dokumen yang perlu direvisi</div>
                <div style="font-size:14px;color:var(--text-secondary);">Semua Berita Acara yang ditolak sudah ditangani.</div>
            }
            else
            {
                <i class="bi bi-clock-history" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Belum ada riwayat penolakan</div>
                <div style="font-size:14px;color:var(--text-secondary);">BA yang pernah ditolak dan sudah direvisi akan muncul di sini.</div>
            }
        </div>
    }
    else
    {
        var paginated = currentList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

        <div style="background:var(--surface);border-radius:0 var(--radius-lg) var(--radius-lg) var(--radius-lg);border:1px solid var(--border);padding:16px;margin-bottom:24px;position:relative;z-index:1;">
            <div style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;">
                Menampilkan @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, currentList.Count) dari @currentList.Count dokumen
            </div>

            <div style="display:flex;flex-direction:column;gap:12px;">
                @foreach (var ba in paginated)
                {
                    <div class="rejected-item">
                        <div class="rejected-item-top">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <span class="pill pill-rejected" style="font-size:11px;letter-spacing:.03em;">Rejected</span>
                                <span style="font-size:15px;font-weight:600;color:var(--text-primary);">Berita Acara @ba.Jenis</span>
                            </div>
                            <span style="font-size:12px;color:var(--text-muted);white-space:nowrap;">
                                @(ba.ApprovedAt?.ToString("dd MMM yyyy, HH:mm") ?? ba.CreatedAt.ToString("dd MMM yyyy"))
                            </span>
                        </div>

                        <div class="rejected-item-meta">
                            <div class="rejected-meta-item">
                                <i class="bi bi-person"></i>
                                <div>
                                    <div style="font-size:11px;color:var(--text-muted);line-height:1.2;">Penanggung Jawab</div>
                                    <div style="font-size:13px;font-weight:600;color:var(--text-primary);">@(ba.Pj?.Nama ?? "—")</div>
                                </div>
                            </div>
                            <div class="rejected-meta-item">
                                <i class="bi bi-person-check"></i>
                                <div>
                                    <div style="font-size:11px;color:var(--text-muted);line-height:1.2;">Reviewer</div>
                                    <div style="font-size:13px;font-weight:600;color:var(--text-primary);">@(ba.Mengetahui?.Nama ?? "—")</div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(ba.AlasanReject))
                        {
                            <div class="rejected-item-reason">
                                <i class="bi bi-chat-square-text" style="flex-shrink:0;margin-top:1px;color:var(--danger);"></i>
                                <span>@ba.AlasanReject</span>
                            </div>
                        }

                        <div class="rejected-item-actions">
                            <NavLink href="@($"/berita-acara/{ba.Id}")" class="btn btn-sm btn-outline">
                                <i class="bi bi-eye"></i> Lihat Detail
                            </NavLink>
                            @if (activeTab == "revisi" && currentRole == "AdminGudangBarang")
                            {
                                <button class="btn btn-sm btn-primary" @onclick="() => ConvertToDraft(ba.Id)" disabled="@isConverting">
                                    <i class="bi bi-arrow-counterclockwise"></i> Revisi
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (currentList.Count > pageSize)
        {
            <SistemBeritaAcara.Web.Components.Shared.Pagination
                CurrentPage="@currentPage"
                TotalItems="@currentList.Count"
                PageSize="@pageSize"
                CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
        }
    }
}

@code {
    private List<BeritaAcaraEntity> revisiBA = new();
    private List<BeritaAcaraEntity> riwayatBA = new();
    private bool isLoading = true;
    private string currentRole = string.Empty;
    private int currentUserId;
    private string activeTab = "revisi";

    private int currentPage = 1;
    private int pageSize = 10;

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        currentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        currentRole = appUser!.Role;
        currentUserId = appUser.Id;

        var baseQuery = DbContext.Set<BeritaAcaraEntity>()
            .AsNoTracking()
            .Include(b => b.Mengetahui)
            .Include(b => b.Pj);

        // Revisi: BA yang masih Status == "Rejected" (belum direvisi)
        IQueryable<BeritaAcaraEntity> revisiQuery = baseQuery.Where(b => b.Status == "Rejected");
        if (currentRole == "AdminGudangBarang")
            revisiQuery = revisiQuery.Where(b => b.CreatedBy == currentUserId);
        else if (currentRole == "Reviewer")
            revisiQuery = revisiQuery.Where(b => b.MengetahuiId == currentUserId);

        revisiBA = await revisiQuery.OrderByDescending(b => b.ApprovedAt).ToListAsync();

        // Riwayat: Ambil dari tabel BeritaAcaraHistory (permanen, tidak terpengaruh penghapusan Inbox)
        IQueryable<SistemBeritaAcara.Core.Entities.BeritaAcaraHistory> historyQuery = DbContext.BeritaAcaraHistory
            .Include(h => h.BeritaAcara).ThenInclude(ba => ba.Pj)
            .Include(h => h.BeritaAcara).ThenInclude(ba => ba.Mengetahui)
            .Include(h => h.RejectedByUser);

        if (currentRole == "AdminGudangBarang")
            historyQuery = historyQuery.Where(h => h.BaCreatedBy == currentUserId);
        else if (currentRole == "Reviewer")
            historyQuery = historyQuery.Where(h => h.BaMengetahuiId == currentUserId);

        var historyList = await historyQuery.OrderByDescending(h => h.RejectedAt).ToListAsync();

        riwayatBA = historyList.Select(h => new BeritaAcaraEntity
        {
            Id = h.BaId,
            NomorSurat = h.BaNomorSurat,
            Jenis = h.BaJenis,
            AlasanReject = h.AlasanReject,
            ApprovedAt = h.RejectedAt,
            Status = "Rejected",
            CreatedBy = h.BaCreatedBy,
            MengetahuiId = h.BaMengetahuiId,
            Pj = h.BeritaAcara?.Pj,
            Mengetahui = h.BeritaAcara?.Mengetahui,
        }).ToList();

        isLoading = false;
    }

    private bool isConverting = false;

    private async Task ConvertToDraft(int baId)
    {
        if (isConverting) return;
        isConverting = true;
        
        var ba = await DbContext.Set<BeritaAcaraEntity>().FirstOrDefaultAsync(b => b.Id == baId);
        if (ba != null && ba.Status == "Rejected" && currentRole == "AdminGudangBarang")
        {
            ba.Status = "Draft";
            await DbContext.SaveChangesAsync();
            Navigation.NavigateTo("/draft");
        }
        
        isConverting = false;
    }
}
