@page "/rejected"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

<PageTitle>Rejected — Sistem Berita Acara</PageTitle>

<style>
    .segmented-control {
        display: inline-flex;
        background: transparent;
        gap: 8px;
        margin-bottom: 24px;
        position: relative;
        z-index: 10;
    }
    .segment-btn {
        padding: 8px 24px;
        font-size: 14px;
        font-weight: 500;
        border: none;
        background: transparent;
        color: var(--text-secondary);
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        z-index: 2;
    }
    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .tab-content-wrapper {
        animation: fadeSlideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .segment-btn.active {
        color: #ffffff;
        font-weight: 600;
        background: var(--primary);
        box-shadow: 0 4px 12px rgba(37,99,235,0.2);
    }
    .segment-btn:not(.active):hover {
        background: #f1f5f9;
        color: var(--text-primary);
    }
</style>

@if (currentRole == "AdminBA")
{
    <div class="segmented-control">
        <button class="segment-btn @(activeTab == "revisi" ? "active" : "")" @onclick='() => SwitchTab("revisi")'>
            Revisi @(revisiList.Count > 0 ? $"({revisiList.Count})" : "")
        </button>
        <button class="segment-btn @(activeTab == "riwayat" ? "active" : "")" @onclick='() => SwitchTab("riwayat")'>
            Riwayat
        </button>
    </div>
}

<div class="tab-content-wrapper" @key="activeTab">
@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else if (loadError is not null)
{
    <div class="card" style="text-align:center;padding:60px;border-radius:var(--radius-lg);">
        <i class="bi bi-exclamation-triangle" style="font-size:48px;color:var(--danger,#ef4444);display:block;margin-bottom:16px;"></i>
        <div style="font-size:16px;font-weight:600;margin-bottom:8px;">Gagal memuat halaman</div>
        <div style="font-size:14px;color:var(--text-secondary);margin-bottom:20px;">@loadError</div>
        <button class="btn btn-primary" @onclick="() => Navigation.NavigateTo(Navigation.Uri, true)">Muat Ulang</button>
    </div>
}
else
{
    var currentList = activeTab == "revisi" ? revisiList : riwayatList;

    @if (!currentList.Any())
    {
        <div class="card" style="text-align:center;padding:60px;border-radius:var(--radius-lg);position:relative;z-index:1;">
            @if (activeTab == "revisi")
            {
                <i class="bi bi-check-circle" style="font-size:48px;color:var(--success,#22C55E);display:block;margin-bottom:16px;"></i>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Tidak ada dokumen yang perlu direvisi</div>
                <div style="font-size:14px;color:var(--text-secondary);">Semua Berita Acara yang ditolak sudah ditangani.</div>
            }
            else
            {
                <i class="bi bi-clock-history" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Belum ada riwayat penolakan</div>
                <div style="font-size:14px;color:var(--text-secondary);">BA yang pernah ditolak akan muncul di sini.</div>
            }
        </div>
    }
    else
    {
        var paginated = currentList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

        <div class="card" style="margin-bottom:24px;">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Jenis Berita Acara</th>
                            @if (currentRole == "Reviewer")
                            {
                                <th>Admin BA</th>
                            }
                            else
                            {
                                <th>Reviewer</th>
                            }
                            <th>Alasan</th>
                            <th>Waktu</th>
                            @if (activeTab == "revisi" && currentRole == "AdminBA")
                            {
                                <th style="text-align:right;">Aksi</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in paginated)
                        {
                            <tr style="cursor:pointer; transition: background 0.2s;" class="hover-row" @onclick="@(() => Navigation.NavigateTo($"/berita-acara/{entry.BaId}?from=rejected"))">
                                <td>
                                    <span style="font-weight:600;">@entry.Jenis</span>
                                </td>
                                <td>
                                    <div class="cell-main">
                                        @if (currentRole == "Reviewer")
                                        {
                                            @(entry.AdminGbNama ?? "-")
                                        }
                                        else
                                        {
                                            @(entry.ReviewerNama ?? "-")
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span style="color:var(--danger);font-size:13px;">
                                        @(string.IsNullOrEmpty(entry.Alasan) ? "Menunggu revisi" : entry.Alasan)
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size:13px;color:var(--text-secondary);">
                                        @(entry.WaktuTolak == default ? "-" : entry.WaktuTolak.ToString("dd MMM yyyy, HH:mm"))
                                    </span>
                                </td>
                                @if (activeTab == "revisi" && currentRole == "AdminBA")
                                {
                                    <td style="text-align:right;" @onclick:stopPropagation>
                                        <button class="btn btn-primary" style="padding:6px 16px;font-size:13px;" @onclick="() => ReviseBA(entry.BaId)">
                                            Revisi
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (currentList.Count > 0)
        {
            <SistemBeritaAcara.Web.Components.Shared.Pagination
                CurrentPage="@currentPage"
                TotalItems="@currentList.Count"
                PageSize="@pageSize"
                CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
        }
    }
}
</div>

@code {
    private class RejectedEntry
    {
        public int BaId { get; set; }
        public string Jenis { get; set; } = "";
        public string? ReviewerNama { get; set; }
        public string? AdminGbNama { get; set; }
        public string? Alasan { get; set; }
        public DateTime WaktuTolak { get; set; }
    }

    private List<RejectedEntry> revisiList = new();
    private List<RejectedEntry> riwayatList = new();
    private bool isLoading = true;
    private string currentRole = string.Empty;
    private int currentUserId;
    private string activeTab = "revisi";
    private int currentPage = 1;
    private int pageSize = 10;
    private string? loadError;

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        currentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var appUser = await UserManager.FindByEmailAsync(auth.User.Identity?.Name ?? "");
            if (appUser is null) { isLoading = false; return; }
            currentRole = appUser.Role;
            currentUserId = appUser.Id;

            if (currentRole == "AdminBA")
                await LoadAdminGbAsync();
            else if (currentRole == "Reviewer")
            {
                await LoadReviewerAsync();
                activeTab = "riwayat";
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            isLoading = false;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = ConnectSignalRAsync();
        }
        return Task.CompletedTask;
    }

    private async Task LoadAdminGbAsync()
    {
        
        var rejectedBAs = await DbContext.BeritaAcara
            .AsNoTracking()
            .Where(b => b.Status == "Rejected" && b.CreatedBy == currentUserId)
            .Include(b => b.Mengetahui)
            .ToListAsync();

        if (rejectedBAs.Count > 0)
        {
            var rejectedBaIds = rejectedBAs.Select(b => b.Id).ToList();
            var historyList = await DbContext.BeritaAcaraHistory
                .AsNoTracking()
                .Where(h => rejectedBaIds.Contains(h.BaId))
                .ToListAsync();

            var latestHistoryMap = historyList
                .GroupBy(h => h.BaId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(h => h.RejectedAt).First());

            revisiList = rejectedBAs.Select(ba =>
            {
                latestHistoryMap.TryGetValue(ba.Id, out var hist);
                return new RejectedEntry
                {
                    BaId = ba.Id,
                    Jenis = ba.Jenis,
                    ReviewerNama = ba.Mengetahui?.Nama,
                    Alasan = hist?.AlasanReject ?? ba.AlasanReject,
                    WaktuTolak = hist?.RejectedAt ?? default
                };
            }).OrderByDescending(e => e.WaktuTolak).ToList();
        }

        
        var riwayatHistory = await DbContext.BeritaAcaraHistory
            .AsNoTracking()
            .Where(h => h.BaCreatedBy == currentUserId)
            .Include(h => h.BeritaAcara).ThenInclude(ba => ba.Mengetahui)
            .OrderByDescending(h => h.RejectedAt)
            .ToListAsync();

        riwayatList = riwayatHistory.Select(h => new RejectedEntry
        {
            BaId = h.BaId,
            Jenis = h.BaJenis,
            ReviewerNama = h.BeritaAcara?.Mengetahui?.Nama,
            Alasan = h.AlasanReject,
            WaktuTolak = h.RejectedAt
        }).ToList();
    }

    private async Task LoadReviewerAsync()
    {
        
        var history = await DbContext.BeritaAcaraHistory
            .AsNoTracking()
            .Where(h => h.RejectedByUserId == currentUserId)
            .Include(h => h.BeritaAcara).ThenInclude(ba => ba.Creator)
            .OrderByDescending(h => h.RejectedAt)
            .ToListAsync();

        riwayatList = history.Select(h => new RejectedEntry
        {
            BaId = h.BaId,
            Jenis = h.BaJenis,
            AdminGbNama = h.BeritaAcara?.Creator?.Nama,
            Alasan = h.AlasanReject,
            WaktuTolak = h.RejectedAt
        }).ToList();
    }

    private void ReviseBA(int baId)
    {
        Navigation.NavigateTo($"/buat-ba?edit={baId}");
    }

    private HubConnection? _hubConnection;

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/ba"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("BaListUpdated", async () =>
            {
                await InvokeAsync(async () =>
                {
                    DbContext.ChangeTracker.Clear();
                    if (currentRole == "AdminBA")
                        await LoadAdminGbAsync();
                    else if (currentRole == "Reviewer")
                        await LoadReviewerAsync();
                    
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
        }
        catch
        {
            
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.StopAsync();
            await _hubConnection.DisposeAsync();
        }
    }
}
