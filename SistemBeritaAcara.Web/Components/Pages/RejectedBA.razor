@page "/rejected"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Rejected — Sistem Berita Acara</PageTitle>

<style>
    .segmented-control {
        display: inline-flex;
        background: transparent;
        gap: 8px;
        margin-bottom: 24px;
        position: relative;
        z-index: 10;
    }
    .segment-btn {
        padding: 8px 24px;
        font-size: 14px;
        font-weight: 500;
        border: none;
        background: transparent;
        color: var(--text-secondary);
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        z-index: 2;
    }
    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .tab-content-wrapper {
        animation: fadeSlideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .segment-btn.active {
        color: #ffffff;
        font-weight: 600;
        background: var(--primary);
        box-shadow: 0 4px 12px rgba(37,99,235,0.2);
    }
    .segment-btn:not(.active):hover {
        background: #f1f5f9;
        color: var(--text-primary);
    }
</style>

<!-- Tab bar -->
<div class="segmented-control">
    <button class="segment-btn @(activeTab == "revisi" ? "active" : "")" @onclick='() => SwitchTab("revisi")'>
        Revisi @(revisiBA.Count > 0 ? $"({revisiBA.Count})" : "")
    </button>
    <button class="segment-btn @(activeTab == "riwayat" ? "active" : "")" @onclick='() => SwitchTab("riwayat")'>
        Riwayat
    </button>
</div>

<div class="tab-content-wrapper" @key="activeTab">
@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat data...</span></div>
}
else if (loadError is not null)
{
    <div class="card" style="text-align:center;padding:60px;border-radius:var(--radius-lg);">
        <i class="bi bi-exclamation-triangle" style="font-size:48px;color:var(--danger,#ef4444);display:block;margin-bottom:16px;"></i>
        <div style="font-size:16px;font-weight:600;margin-bottom:8px;">Gagal memuat halaman</div>
        <div style="font-size:14px;color:var(--text-secondary);margin-bottom:20px;">@loadError</div>
        <button class="btn btn-primary" @onclick="() => Navigation.NavigateTo(Navigation.Uri, true)">Muat Ulang</button>
    </div>
}
else
{
    var currentList = activeTab == "revisi" ? revisiBA : riwayatBA;

    @if (!currentList.Any())
    {
        <div class="card" style="text-align:center;padding:60px;border-radius:var(--radius-lg);position:relative;z-index:1;">
            @if (activeTab == "revisi")
            {
                <i class="bi bi-check-circle" style="font-size:48px;color:var(--success,#22C55E);display:block;margin-bottom:16px;"></i>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Tidak ada dokumen yang perlu direvisi</div>
                <div style="font-size:14px;color:var(--text-secondary);">Semua Berita Acara yang ditolak sudah ditangani.</div>
            }
            else
            {
                <i class="bi bi-clock-history" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Belum ada riwayat penolakan</div>
                <div style="font-size:14px;color:var(--text-secondary);">BA yang pernah ditolak dan sudah direvisi akan muncul di sini.</div>
            }
        </div>
    }
    else
    {
        var paginated = currentList.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

        <div class="card" style="margin-bottom:24px;">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Jenis Berita Acara</th>
                            <th>Reviewer</th>
                            <th>Alasan</th>
                            <th style="text-align:right;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ba in paginated)
                        {
                            <tr style="cursor:pointer; transition: background 0.2s;" class="hover-row" @onclick="@(() => Navigation.NavigateTo($"/berita-acara/{ba.Id}"))">
                                <td>
                                    <span style="font-weight:600;">@ba.Jenis</span>
                                </td>
                                <td>
                                    <div class="cell-main">@(ba.Mengetahui?.Nama ?? "-")</div>
                                </td>
                                <td>
                                    <span style="color:var(--danger);font-size:13px;">
                                        @(string.IsNullOrEmpty(ba.AlasanReject) ? "Menunggu revisi" : ba.AlasanReject)
                                    </span>
                                </td>
                                <td style="text-align:right;" @onclick:stopPropagation>
                                    @if (activeTab == "revisi" && currentRole == "AdminGudangBarang")
                                    {
                                        <button class="btn btn-sm btn-primary" style="padding:4px 12px;font-size:12px;display:inline-flex;align-items:center;gap:4px;" @onclick="() => ReviseBA(ba.Id)" title="Revisi">
                                            <i class="bi bi-arrow-counterclockwise"></i> Revisi
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

        @if (currentList.Count > 0)
        {
            <SistemBeritaAcara.Web.Components.Shared.Pagination
                CurrentPage="@currentPage"
                TotalItems="@currentList.Count"
                PageSize="@pageSize"
                CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
        }
    }
}
</div>

@code {
    private List<BeritaAcaraEntity> revisiBA = new();
    private List<BeritaAcaraEntity> riwayatBA = new();
    private bool isLoading = true;
    private string currentRole = string.Empty;
    private int currentUserId;
    private string activeTab = "revisi";

    private int currentPage = 1;
    private int pageSize = 10;
    private string? loadError;

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        currentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var appUser = await UserManager.FindByEmailAsync(auth.User.Identity?.Name ?? "");
            if (appUser is null) { isLoading = false; return; }
            currentRole = appUser.Role;
            currentUserId = appUser.Id;

            var baseQuery = DbContext.Set<BeritaAcaraEntity>()
                .AsNoTracking()
                .Include(b => b.Mengetahui)
                .Include(b => b.Pj);

            // Revisi: BA yang masih Status == "Rejected" (belum direvisi)
            IQueryable<BeritaAcaraEntity> revisiQuery = baseQuery.Where(b => b.Status == "Rejected");
            if (currentRole == "AdminGudangBarang")
                revisiQuery = revisiQuery.Where(b => b.CreatedBy == currentUserId);
            else if (currentRole == "Reviewer")
                revisiQuery = revisiQuery.Where(b => b.MengetahuiId == currentUserId);

            revisiBA = await revisiQuery.OrderByDescending(b => b.ApprovedAt).ToListAsync();

            // Riwayat: Ambil dari tabel BeritaAcaraHistory (permanen, tidak terpengaruh penghapusan Inbox)
            IQueryable<SistemBeritaAcara.Core.Entities.BeritaAcaraHistory> historyQuery = DbContext.BeritaAcaraHistory
                .Include(h => h.BeritaAcara).ThenInclude(ba => ba.Pj)
                .Include(h => h.BeritaAcara).ThenInclude(ba => ba.Mengetahui)
                .Include(h => h.RejectedByUser);

            if (currentRole == "AdminGudangBarang")
                historyQuery = historyQuery.Where(h => h.BaCreatedBy == currentUserId);
            else if (currentRole == "Reviewer")
                historyQuery = historyQuery.Where(h => h.BaMengetahuiId == currentUserId);

            var historyList = await historyQuery.OrderByDescending(h => h.RejectedAt).ToListAsync();

            riwayatBA = historyList.Select(h => new BeritaAcaraEntity
            {
                Id = h.BaId,
                NomorSurat = h.BaNomorSurat,
                Jenis = h.BaJenis,
                AlasanReject = h.AlasanReject,
                ApprovedAt = h.RejectedAt,
                Status = "Rejected",
                CreatedBy = h.BaCreatedBy,
                MengetahuiId = h.BaMengetahuiId,
                Pj = h.BeritaAcara?.Pj,
                Mengetahui = h.BeritaAcara?.Mengetahui,
            }).ToList();

            isLoading = false;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            isLoading = false;
        }
    }

    private void ReviseBA(int baId)
    {
        Navigation.NavigateTo($"/buat-ba?edit={baId}");
    }
}
