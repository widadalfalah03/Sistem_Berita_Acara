@page "/login"
@inject NavigationManager Navigation
@layout EmptyLayout

<PageTitle>Login — Sistem Berita Acara</PageTitle>

@{
    var uri = new Uri(Navigation.Uri);
    var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
    var errorParam = query["error"] ?? string.Empty;
    var errorMessage = errorParam == "invalid" ? "Email atau password tidak valid." :
                      errorParam == "locked" ? "Akun terkunci sementara karena terlalu banyak percobaan gagal. Coba lagi dalam 5 menit." :
                      string.Empty;
    var returnUrl = query["returnUrl"] ?? "/dashboard";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-card-body">

            <!-- Logo only, no text heading -->
            <div class="login-logo">
                <img src="/images/PT_Pertamina_Patra_Niaga.svg.png" style="height:88px;width:auto;" alt="Pertamina Patra Niaga" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="login-error">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @errorMessage
                </div>
            }

            <form method="post" action="/account/login" onsubmit="handleLoginSubmit(this)">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="form-group">
                    <input class="login-input" type="email" id="login-email" name="email"
                           placeholder="Email Address" autocomplete="email" required />
                </div>

                <div class="form-group">
                    <div class="login-pw-wrap">
                        <input class="login-input" type="password" id="login-password" name="password"
                               placeholder="Password" autocomplete="current-password" required />
                        <button type="button" class="login-pw-toggle" onclick="togglePw(this)" tabindex="-1">
                            <i class="bi bi-eye" id="pw-toggle-icon"></i>
                        </button>
                    </div>
                </div>

                <div class="login-row">
                    <a href="/forgot-password" class="login-forgot">Forgot Password?</a>
                </div>

                <button type="submit" class="login-btn" id="login-submit-btn">Login</button>
            </form>

        </div>
    </div>
</div>

<script>
    function togglePw(btn) {
        var inp = document.getElementById('login-password');
        var icon = document.getElementById('pw-toggle-icon');
        if (!inp) return;
        inp.type = inp.type === 'password' ? 'text' : 'password';
        icon.className = inp.type === 'text' ? 'bi bi-eye-slash' : 'bi bi-eye';
    }

    function handleLoginSubmit(form) {
        var btn = document.getElementById('login-submit-btn');
        if (btn) {
            btn.disabled = true;
        }

        var overlay = document.createElement('div');
        overlay.style.position = 'fixed';
        overlay.style.inset = '0';
        overlay.style.zIndex = '10000';
        overlay.style.background = 'rgba(255,255,255,0.93)';
        overlay.style.backdropFilter = 'blur(6px)';
        overlay.style.display = 'flex';
        overlay.style.flexDirection = 'column';
        overlay.style.alignItems = 'center';
        overlay.style.justifyContent = 'center';
        overlay.style.gap = '16px';
        
        overlay.innerHTML = `
            <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
            <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-top:4px;">Memproses login...</div>
            <div style="font-size:13px;color:var(--text-muted);">Sedang mengautentikasi akun, harap tunggu</div>
        `;
        
        document.body.appendChild(overlay);
    }
</script>
