@page "/data-pegawai"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PegawaiEntity = SistemBeritaAcara.Core.Entities.Pegawai
@inject AppDbContext DbContext
@inject IExcelService ExcelService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminIT")]

<PageTitle>Data Pegawai — Sistem Berita Acara</PageTitle>

<div class="page-header d-flex align-center justify-between">
    <div>
        <h1 class="page-title">Daftar Pegawai</h1>
    </div>
    <button class="btn btn-primary" @onclick="() => showUpload = true">
        <i class="bi bi-arrow-up-circle"></i> Update Data Pegawai
    </button>
</div>

<!-- Stat Card -->
<div class="stat-cards" style="grid-template-columns:repeat(1,1fr);max-width:220px;margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-card-icon total"><i class="bi bi-person-badge"></i></div>
        <div class="stat-card-info">
            <div class="stat-card-label">Total Pegawai</div>
            <div class="stat-card-value">@allPegawai.Count</div>
        </div>
    </div>
</div>

<!-- Search + Toggle -->
<div class="search-bar">
    <div class="search-input" style="max-width:320px;">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Cari nama, NIP, atau jabatan..."
               @bind="search" @bind:event="oninput" />
    </div>
    <div style="font-size:13px; color:var(--text-secondary); margin-left:12px;">
        Menampilkan @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, TotalFilteredItems) dari @TotalFilteredItems pegawai
    </div>
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat data pegawai...</span></div>
}
else
{
    @if (!string.IsNullOrEmpty(importResult))
    {
        var isErr = importResult.StartsWith("Gagal");
        <div style="background:@(isErr ? "var(--danger-light)" : "#F0FDF4");border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;color:@(isErr ? "var(--danger)" : "#16A34A");font-size:14px;">
            @importResult
        </div>
    }

    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Nama / NIP"))">Nama / NIP <i class="bi @GetSortIcon("Nama / NIP")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Jabatan"))">Jabatan <i class="bi @GetSortIcon("Jabatan")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Fungsi/Direktorat"))">Fungsi/Direktorat <i class="bi @GetSortIcon("Fungsi/Direktorat")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Email"))">Email <i class="bi @GetSortIcon("Email")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Cost Center"))">Cost Center <i class="bi @GetSortIcon("Cost Center")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in FilteredPegawai)
                {
                    <tr>
                        <td>
                            <div class="cell-main">@p.Nama</div>
                            <div class="cell-sub">NIP: @p.NoPekerja</div>
                        </td>
                        <td>@p.Jabatan</td>
                        <td>@p.FungsiDirektorat</td>
                        <td>@p.Email</td>
                        <td>@p.CostCenter</td>
                    </tr>
                }
                @if (!FilteredPegawai.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:40px;color:var(--text-muted);">
                            Tidak ada data pegawai yang sesuai filter
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        @if (TotalFilteredItems > 0)
        {
            <SistemBeritaAcara.Web.Components.Shared.Pagination
                CurrentPage="@currentPage"
                TotalItems="@TotalFilteredItems"
                PageSize="@pageSize"
                CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
        }
    </div>
}

<!-- Upload Modal -->
@if (showUpload)
{
    <div class="modal-overlay" @onclick="() => showUpload = false">
        <div class="modal-content" style="max-width:500px;" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => showUpload = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="font-size:18px;font-weight:700;margin-bottom:4px;">Import Data Pegawai</div>
            <div style="font-size:14px;color:var(--text-secondary);margin-bottom:20px;">
                Upload file Excel (.xlsx) dengan kolom: Nama, No Pekerja, Jabatan, Fungsi/Direktorat, Email, Cost Center
            </div>
            <div style="display:flex;justify-content:center;margin: 24px 0;">
                <label for="pegawai-upload-input" style="cursor:pointer;display:inline-block;">
                    <div class="upload-btn-styled">
                        <i class="bi bi-cloud-arrow-up-fill" style="font-size:28px;"></i>
                        <span style="font-weight:600;font-size:15px;">Pilih File Excel</span>
                        <span style="font-size:12px;color:var(--text-muted);margin-top:2px;">.xlsx · Maksimal 10MB</span>
                    </div>
                </label>
                <InputFile id="pegawai-upload-input" OnChange="OnImportFileChanged" accept=".xlsx" style="display:none;" />
            </div>
            @if (isImporting)
            {
                <div class="loading-spinner" style="padding:20px;">
                    <div class="spinner"></div><span>Mengimpor data...</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<PegawaiEntity> allPegawai = new();
    private bool isLoading = true;
    private bool showUpload = false;
    private bool isImporting = false;
    private bool showInactive = false;
    private string importResult = string.Empty;
    private string sortColumn = "Nama / NIP";
    private bool sortAscending = true;

    private int currentPage = 1;
    private int pageSize = 10;
    private string _search = string.Empty;
    private string search 
    {
        get => _search;
        set 
        {
            _search = value;
            currentPage = 1; // reset page saat pencarian berubah
        }
    }

    private void SortTable(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1; // reset page saat kolom sort berubah
    }

    private string GetSortIcon(string column)
    {
        if (sortColumn != column) return "bi-arrow-down-up";
        return sortAscending ? "bi-arrow-up text-primary" : "bi-arrow-down text-primary";
    }

    private int TotalFilteredItems => allPegawai
        .Where(p => p.IsAktif)
        .Count(p => string.IsNullOrEmpty(search) ||
                    p.Nama.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    p.NoPekerja.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (p.Jabatan ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<PegawaiEntity> FilteredPegawai
    {
        get
        {
            var query = allPegawai
                .Where(p => p.IsAktif)
                .Where(p => string.IsNullOrEmpty(search) ||
                            p.Nama.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                            p.NoPekerja.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                            (p.Jabatan ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));

            query = sortColumn switch
            {
                "Nama / NIP" => sortAscending ? query.OrderBy(p => p.Nama) : query.OrderByDescending(p => p.Nama),
                "Jabatan" => sortAscending ? query.OrderBy(p => p.Jabatan) : query.OrderByDescending(p => p.Jabatan),
                "Fungsi/Direktorat" => sortAscending ? query.OrderBy(p => p.FungsiDirektorat) : query.OrderByDescending(p => p.FungsiDirektorat),
                "Email" => sortAscending ? query.OrderBy(p => p.Email) : query.OrderByDescending(p => p.Email),
                "Cost Center" => sortAscending ? query.OrderBy(p => p.CostCenter) : query.OrderByDescending(p => p.CostCenter),
                "Status" => sortAscending ? query.OrderByDescending(p => p.IsAktif) : query.OrderBy(p => p.IsAktif),
                _ => query
            };

            return query.Skip((currentPage - 1) * pageSize).Take(pageSize);
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        allPegawai = await DbContext.Pegawai.OrderBy(p => p.Nama).ToListAsync();
        isLoading = false;
    }

    private async Task OnImportFileChanged(InputFileChangeEventArgs e)
    {
        isImporting = true;
        importResult = string.Empty;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
            using var stream = e.File.OpenReadStream(10_000_000);
            var (added, updated, deactivated, errors) = await ExcelService.ImportPegawaiAsync(stream, currentUser!.Id, e.File.Name);
            importResult = $"Berhasil: {added} ditambahkan, {updated} diperbarui, {deactivated} dinonaktifkan.";
            if (errors.Any()) importResult += $" Kesalahan: {string.Join("; ", errors)}";
            showUpload = false;
            await LoadAsync();
        }
        catch (Exception ex) { importResult = $"Gagal impor: {ex.Message}"; }
        finally { isImporting = false; }
    }
}
