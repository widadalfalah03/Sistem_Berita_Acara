    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdStr, out _currentUserId);

        allPegawai = await DbContext.Pegawai.Where(p => p.IsAktif).OrderBy(p => p.Nama).ToListAsync();
        approvers = await DbContext.Users.Where(u => u.Role == "Approver" && !u.IsDeleted).OrderBy(u => u.Nama).ToListAsync();
        adminGudangUsers = await DbContext.Users.Where(u => u.Role == "AdminGudangBarang" && !u.IsDeleted).OrderBy(u => u.Nama).ToListAsync();
        barangOptions = await DbContext.MasterBarang.Where(b => b.IsAktif).OrderBy(b => b.NamaBarang).ToListAsync();

        currentUserObj = adminGudangUsers.FirstOrDefault(u => u.Id == _currentUserId);
        if (currentUserObj != null && !editId.HasValue)
        {
            model.MenyerahkanId = currentUserObj.PegawaiId ?? 0;
        }

        // Mode Edit: load data BA yang sudah ada
        editId = EditIdParam;
        if (editId.HasValue)
        {
            DbContext.ChangeTracker.Clear();
            var existing = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Perangkat)
                .Include(b => b.BuktiFotos)
                .FirstOrDefaultAsync(b => b.Id == editId.Value && (b.Status == "Draft" || b.Status == "Rejected") && b.CreatedBy == _currentUserId);

            if (existing is not null)
            {
                model.Jenis = existing.Jenis;
                model.JenisCustom = existing.JenisCustom;
                model.Tanggal = existing.Tanggal.ToDateTime(TimeOnly.MinValue);
                model.TiketSscNo = existing.TiketSscNo;
                model.TanggalKembali = existing.TanggalKembali.HasValue
                    ? existing.TanggalKembali.Value.ToDateTime(TimeOnly.MinValue)
                    : null;
                model.PjId = existing.PjId;
                model.PjNoTelp = existing.PjNoTelp;
                // MenyerahkanId harus Pegawai.Id. Data lama mungkin salah simpan sebagai
                // ApplicationUser.Id — auto-konversi saat load agar dokumen baru langsung benar.
                if (adminGudangUsers.Any(u => u.PegawaiId == existing.MenyerahkanId))
                    model.MenyerahkanId = existing.MenyerahkanId; // sudah format benar
                else if (adminGudangUsers.FirstOrDefault(u => u.Id == existing.MenyerahkanId) is { } oldFormatUser)
                    model.MenyerahkanId = oldFormatUser.PegawaiId ?? 0; // konversi dari format lama
                else
                    model.MenyerahkanId = existing.MenyerahkanId;
                model.MengetahuiId = existing.MengetahuiId;

                // Pre-fill selected pegawai untuk display
                selectedPj = allPegawai.FirstOrDefault(p => p.Id == existing.PjId);
                if (selectedPj is not null) pjSearch = selectedPj.Nama;

                model.Perangkat = existing.Perangkat.Select(p => new PerangkatRow
                {
                    BarangId = p.BarangId,
                    Jumlah = p.Jumlah,
                    Satuan = p.Satuan ?? "Pcs",
                    NoSerial = p.NoSerial,
                    Keterangan = p.Keterangan
                }).ToList();

                if (!model.Perangkat.Any()) model.Perangkat.Add(new());

                // Load existing photos dari DB → tampilkan gambar asli (bukan thumbnail)
                if (existing.BuktiFotos != null)
                {
                    existingPhotoUrls = existing.BuktiFotos
                        .Select(f => (f.FilePath, Path.GetFileName(f.FilePath)))
                        .ToList();
                }
            }
            else
            {
                editId = null;
            }
        }
        // Untuk mode baru, draft dibuat otomatis saat autosave pertama (setelah PJ dipilih)
    }

    // Buat draft pertama kali — hanya dipanggil saat sudah ada PjId valid
    private async Task CreateInitialDraftAsync()
    {
        if (_currentUserId == 0 || model.PjId == 0 || model.MenyerahkanId == 0 || model.MengetahuiId == 0) return;
        try
        {
            var ba = new BeritaAcaraEntity
            {
                Tanggal = DateOnly.FromDateTime(model.Tanggal),
                Jenis = model.Jenis,
                PjId = model.PjId,
                PjNoTelp = model.PjNoTelp,
                MenyerahkanId = model.MenyerahkanId,
                MengetahuiId = model.MengetahuiId,
                TiketSscNo = model.TiketSscNo,
                Status = "Draft",
                CreatedBy = _currentUserId,
                CreatedAt = DateTime.Now,
            };
            DbContext.Set<BeritaAcaraEntity>().Add(ba);
            await DbContext.SaveChangesAsync();
            editId = ba.Id;
        }
        catch { /* gagal buat draft — akan dicoba lagi saat perubahan berikutnya */ }
    }

    // ── Autosave ──
    private void TriggerAutoSave()
    {
        // Debounce: batalkan pending save sebelumnya, tunggu 800ms idle
        _autoSaveCts?.Cancel();
        _autoSaveCts = new System.Threading.CancellationTokenSource();
        var token = _autoSaveCts.Token;
        _ = Task.Run(async () =>
        {
            await Task.Delay(800, token);
            if (!token.IsCancellationRequested)
                await InvokeAsync(AutoSaveAsync);
        }, token);
    }

    private async Task AutoSaveAsync()
    {
        if (_currentUserId == 0) return;

        // Jika belum ada draft dan data belum cukup untuk insert, diam saja (jangan tampilkan error)
        if (!editId.HasValue)
        {
            if (model.PjId == 0 || model.MenyerahkanId == 0 || model.MengetahuiId == 0)
                return; // Belum cukup data untuk buat draft, tunggu sampai semua FK terisi
            await CreateInitialDraftAsync();
            if (!editId.HasValue) return; // Masih gagal, diam saja
        }

        autoSaveStatus = AutoSaveState.Saving;
        StateHasChanged();
        try
        {
            if (!editId.HasValue) { autoSaveStatus = AutoSaveState.Error; StateHasChanged(); return; }

            DbContext.ChangeTracker.Clear();
            var existing = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Perangkat)
                .FirstOrDefaultAsync(b => b.Id == editId.Value);
            if (existing is null) { autoSaveStatus = AutoSaveState.Error; StateHasChanged(); return; }

            // ── Deteksi perubahan SEBELUM update ──────────────────────────────────
            // Cek apakah ada field yang mempengaruhi konten dokumen yang berubah.
            // Harus dilakukan sebelum existing.* diubah, karena SubmitAsync akan
            // membandingkan existing (sudah di-autosave) vs model — jika kita tidak
            // kosongkan DocxPath di sini, SubmitAsync akan melewati regenerasi dokumen.
            var validPerangkat = model.Perangkat.Where(p => p.BarangId > 0).ToList();
            bool perangkatBerubah = validPerangkat.Any() && (
                existing.Perangkat.Count != validPerangkat.Count ||
                validPerangkat.Any(p => !existing.Perangkat.Any(ep =>
                    ep.BarangId == p.BarangId && ep.Jumlah == p.Jumlah &&
                    ep.NoSerial == p.NoSerial && ep.Keterangan == p.Keterangan))
            );
            bool dokumenBerubah = !string.IsNullOrEmpty(existing.DocxPath) && (
                existing.Jenis != model.Jenis ||
                existing.JenisCustom != (model.Jenis == "Lainnya" ? model.JenisCustom : null) ||
                existing.Tanggal != DateOnly.FromDateTime(model.Tanggal) ||
                existing.PjId != model.PjId ||
                existing.PjNoTelp != model.PjNoTelp ||
                existing.MenyerahkanId != model.MenyerahkanId ||
                existing.MengetahuiId != model.MengetahuiId ||
                existing.TiketSscNo != model.TiketSscNo ||
                existing.TanggalKembali != (model.TanggalKembali.HasValue
                    ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null) ||
                perangkatBerubah
            );
            // ─────────────────────────────────────────────────────────────────────

            existing.Tanggal = DateOnly.FromDateTime(model.Tanggal);
            existing.Jenis = model.Jenis;
            existing.JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null;
            existing.PjId = model.PjId;
            existing.PjNoTelp = model.PjNoTelp;
            existing.MenyerahkanId = model.MenyerahkanId;
            existing.MengetahuiId = model.MengetahuiId;
            existing.TiketSscNo = model.TiketSscNo;
            existing.TanggalKembali = model.TanggalKembali.HasValue
                ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null;

            // Kosongkan DocxPath agar EditorBA tahu harus regenerasi dari template
            if (dokumenBerubah)
                existing.DocxPath = null;

            // Update perangkat hanya jika ada yang terisi minimal 1 barang
            if (validPerangkat.Any())
            {
                DbContext.PerangkatBA.RemoveRange(existing.Perangkat.ToList());
                existing.Perangkat = validPerangkat.Select(p => new PerangkatBA
                {
                    BaId = existing.Id,
                    BarangId = p.BarangId,
                    Jumlah = p.Jumlah > 0 ? p.Jumlah : 1,
                    Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                    NoSerial = p.NoSerial,
                    Keterangan = p.Keterangan
                }).ToList();
            }

            await DbContext.SaveChangesAsync();
            autoSaveStatus = AutoSaveState.Saved;
            StateHasChanged();

            // Reset ke Idle setelah 3 detik
            await Task.Delay(3000);
            if (autoSaveStatus == AutoSaveState.Saved)
            {
                autoSaveStatus = AutoSaveState.Idle;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AutoSaveAsync Error] {ex.Message} | Inner: {ex.InnerException?.Message}");
            autoSaveStatus = AutoSaveState.Error;
            StateHasChanged();
        }
    }

