    private async Task OnPhotosSelected(InputFileChangeEventArgs e)
    {
        photosChanged = true;
        photoFiles = e.GetMultipleFiles(10).ToList();
        photoDataUrls.Clear();

        // Segera simpan foto ke disk & DB + generate preview base64
        if (!editId.HasValue) await CreateInitialDraftAsync();
        if (editId.HasValue && _currentUserId > 0)
        {
            autoSaveStatus = AutoSaveState.Saving;
            StateHasChanged();
            try
            {
                var photoFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "photos");
                Directory.CreateDirectory(photoFolder);

                // Hapus foto lama
                var oldPhotos = await DbContext.BuktiFoto.Where(f => f.BaId == editId.Value).ToListAsync();
                foreach (var old in oldPhotos)
                {
                    var oldPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                        old.FilePath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                    if (File.Exists(oldPath)) File.Delete(oldPath);
                }
                DbContext.BuktiFoto.RemoveRange(oldPhotos);

                int idx = 1;
                existingPhotoUrls.Clear();
                foreach (var file in photoFiles)
                {
                    var ext = Path.GetExtension(file.Name);
                    var saveName = $"ba-{editId.Value}-photo-{idx}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}{ext}";
                    var fullPath = Path.Combine(photoFolder, saveName);
                    var relPath = $"files/photos/{saveName}";

                    // Generate preview base64
                    using var stream = file.OpenReadStream(5_000_000);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    var bytes = ms.ToArray();
                    var base64 = Convert.ToBase64String(bytes);
                    var mime = file.ContentType ?? "image/jpeg";
                    photoDataUrls.Add(($"data:{mime};base64,{base64}", file.Name));

                    // Simpan file ke disk
                    await File.WriteAllBytesAsync(fullPath, bytes);

                    // Retrieve existing entity to satisfy the EF Core shadow property (BeritaAcaraId) constraint
                    var existingBa = await DbContext.BeritaAcara.FindAsync(editId.Value);

                    DbContext.BuktiFoto.Add(new BuktiFoto
                    {
                        BaId = editId.Value,
                        BeritaAcara = existingBa!,
                        FilePath = relPath
                    });
                    existingPhotoUrls.Add((relPath, file.Name));
                    idx++;
                }
                await DbContext.SaveChangesAsync();
                autoSaveStatus = AutoSaveState.Saved;
                StateHasChanged();
                await Task.Delay(3000);
                if (autoSaveStatus == AutoSaveState.Saved) { autoSaveStatus = AutoSaveState.Idle; StateHasChanged(); }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[OnPhotosSelected Error] {ex.Message} | Inner: {ex.InnerException?.Message}");
                // Preview tetap tampil meski save gagal
                autoSaveStatus = AutoSaveState.Error;
                StateHasChanged();
            }
        }
        else
        {
            // Belum ada editId: hanya buat preview, foto akan disave di SubmitAsync
            foreach (var file in photoFiles)
            {
                try
                {
                    using var stream = file.OpenReadStream(5_000_000);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    var base64 = Convert.ToBase64String(ms.ToArray());
                    var mime = file.ContentType ?? "image/jpeg";
                    photoDataUrls.Add(($"data:{mime};base64,{base64}", file.Name));
                }
                catch { }
            }
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = string.Empty;

        // ── Validasi lengkap ──
        if (model.PjId == 0) { errorMessage = "Pilih Penanggung Jawab (PJ) terlebih dahulu."; return; }
        if (string.IsNullOrWhiteSpace(model.PjNoTelp)) { errorMessage = "No. Telp/HP PJ wajib diisi."; return; }
        if (model.MenyerahkanId == 0 || !adminGudangUsers.Any(u => u.PegawaiId == model.MenyerahkanId)) { errorMessage = "Pilih Admin (Yang Menyerahkan) yang valid (akun mungkin telah dinonaktifkan)."; return; }
        if (model.MengetahuiId == 0 || !approvers.Any(u => u.Id == model.MengetahuiId)) { errorMessage = "Pilih Yang Mengetahui yang valid (akun mungkin telah dinonaktifkan)."; return; }
        if (string.IsNullOrWhiteSpace(model.TiketSscNo)) { errorMessage = "No. Tiket My SSC wajib diisi."; return; }
        if (model.Jenis == "Peminjaman" && !model.TanggalKembali.HasValue) { errorMessage = "Tanggal Kembali wajib diisi untuk Peminjaman."; return; }

        // Validasi semua kolom perangkat
        if (!model.Perangkat.Any(p => p.BarangId > 0)) { errorMessage = "Tambahkan minimal satu perangkat."; return; }
        if (model.Jenis == "Peminjaman" && model.TanggalKembali.HasValue && model.TanggalKembali.Value.Date < model.Tanggal.Date) 
        { 
            errorMessage = "Tanggal Kembali tidak boleh sebelum Tanggal peminjaman."; 
            return; 
        }

        var invalidPerangkat = model.Perangkat.Where(p => p.BarangId > 0).FirstOrDefault(p =>
            p.Jumlah <= 0 ||
            string.IsNullOrWhiteSpace(p.Satuan) ||
            string.IsNullOrWhiteSpace(p.NoSerial) ||
            string.IsNullOrWhiteSpace(p.Keterangan));
        if (invalidPerangkat is not null)
        {
            errorMessage = "Semua kolom perangkat (Jumlah, Satuan, No. Serial, Keterangan) wajib diisi.";
            return;
        }

        // Validasi foto
        bool hasFoto = photoFiles.Any() || existingPhotoUrls.Any();
        if (!hasFoto) { errorMessage = "Bukti foto serah terima wajib dilampirkan."; return; }

        // Semua validasi lulus — tampilkan overlay via JS (instant, sebelum DB operations)
        await JSRuntime.InvokeVoidAsync("appLoading.show", "Menyiapkan dokumen...", "Sedang memproses, harap tunggu");
        isSaving = true;
        try
        {
            if (_currentUserId == 0)
            {
                var auth = await AuthStateProvider.GetAuthenticationStateAsync();
                var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                int.TryParse(userIdStr, out _currentUserId);
            }
            if (_currentUserId == 0) { errorMessage = "Sesi habis, silakan login kembali."; await JSRuntime.InvokeVoidAsync("appLoading.hide"); isSaving = false; return; }

            // Jika draft belum sempat terbuat (autosave belum jalan), buat sekarang
            if (!editId.HasValue)
            {
                await CreateInitialDraftAsync();
            }

            if (editId.HasValue)
            {
                DbContext.ChangeTracker.Clear();
                var existing = await DbContext.Set<BeritaAcaraEntity>()
                    .Include(b => b.Perangkat)
                    .Include(b => b.BuktiFotos)
                    .FirstOrDefaultAsync(b => b.Id == editId.Value);

                if (existing is null) { errorMessage = "Draft tidak ditemukan."; isSaving = false; return; }

                // Periksa apakah ada perubahan pada data form
                bool isChanged = existing.Jenis != model.Jenis ||
                                 existing.JenisCustom != (model.Jenis == "Lainnya" ? model.JenisCustom : null) ||
                                 existing.Tanggal != DateOnly.FromDateTime(model.Tanggal) ||
                                 existing.PjId != model.PjId ||
                                 existing.PjNoTelp != model.PjNoTelp ||
                                 existing.MenyerahkanId != model.MenyerahkanId ||
                                 existing.MengetahuiId != model.MengetahuiId ||
                                 existing.TiketSscNo != model.TiketSscNo ||
                                 existing.TanggalKembali != (model.TanggalKembali.HasValue ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null);

                if (!isChanged)
                {
                    var newPerangkatList = model.Perangkat.Where(p => p.BarangId > 0 && p.Jumlah > 0).ToList();
                    if (existing.Perangkat.Count != newPerangkatList.Count)
                    {
                        isChanged = true;
                    }
                    else
                    {
                        foreach (var ep in existing.Perangkat)
                        {
                            var match = newPerangkatList.FirstOrDefault(np => np.BarangId == ep.BarangId && np.Jumlah == ep.Jumlah && np.NoSerial == ep.NoSerial && np.Keterangan == ep.Keterangan);
                            if (match == null) { isChanged = true; break; }
                        }
                    }
                }

                // Jika data form berubah, ATAU status sebelumnya Rejected, ATAU foto diganti,
                // dokumen HARUS digenerate ulang dari template
                if (isChanged || existing.Status == "Rejected" || photosChanged || (photoFiles.Any() && !existingPhotoUrls.Any()))
                {
                    existing.DocxPath = null;
                }

                existing.Tanggal = DateOnly.FromDateTime(model.Tanggal);
                existing.Jenis = model.Jenis;
                existing.JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null;
                existing.PjId = model.PjId;
                existing.PjNoTelp = model.PjNoTelp;
                existing.MenyerahkanId = model.MenyerahkanId;
                existing.MengetahuiId = model.MengetahuiId;
                existing.TiketSscNo = model.TiketSscNo;
                existing.TanggalKembali = model.TanggalKembali.HasValue
                    ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null;

                // Reset rejected BA back to Draft so it re-enters the submission workflow
                if (existing.Status == "Rejected")
                {
                    existing.Status = "Draft";
                    existing.AlasanReject = null;
                    existing.TtdPjPath = null;
                    existing.SubmittedAt = null;
                    existing.PjSignedAt = null;
                    existing.ApprovedAt = null;
                }

                DbContext.PerangkatBA.RemoveRange(existing.Perangkat.ToList());
                existing.Perangkat = model.Perangkat
                    .Where(p => p.BarangId > 0 && p.Jumlah > 0)
                    .Select(p => new PerangkatBA
                    {
                        BaId = existing.Id,
                        BarangId = p.BarangId,
                        Jumlah = p.Jumlah,
                        Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                        NoSerial = p.NoSerial,
                        Keterangan = p.Keterangan
                    }).ToList();

                // Foto sudah disimpan on-change, tapi jika ada foto baru yang belum tersimpan (fallback)
                if (photoFiles.Any() && !existingPhotoUrls.Any())
                {
                    var oldPhotos = await DbContext.BuktiFoto.Where(f => f.BaId == existing.Id).ToListAsync();
                    foreach (var old in oldPhotos)
                    {
                        var oldPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                            old.FilePath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                        if (File.Exists(oldPath)) File.Delete(oldPath);
                    }
                    DbContext.BuktiFoto.RemoveRange(oldPhotos);

                    var photoFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "photos");
                    Directory.CreateDirectory(photoFolder);
                    int idx2 = 1;
                    foreach (var file in photoFiles)
                    {
                        var ext = Path.GetExtension(file.Name);
                        var saveName = $"ba-{existing.Id}-photo-{idx2}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}{ext}";
                        await using var fs = File.Create(Path.Combine(photoFolder, saveName));
                        await file.OpenReadStream(5_000_000).CopyToAsync(fs);
                        DbContext.BuktiFoto.Add(new BuktiFoto { BaId = existing.Id, BeritaAcara = existing, FilePath = $"files/photos/{saveName}" });
                        idx2++;
                    }
                }

                await DbContext.SaveChangesAsync();
                Navigation.NavigateTo($"/editor/{existing.Id}");
            }
            else
            {
                // Fallback: insert baru (sangat jarang terjadi)
                var ba = new BeritaAcaraEntity
                {
                    Tanggal = DateOnly.FromDateTime(model.Tanggal),
                    Jenis = model.Jenis,
                    JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null,
                    PjId = model.PjId,
                    PjNoTelp = model.PjNoTelp,
                    MenyerahkanId = model.MenyerahkanId,
                    MengetahuiId = model.MengetahuiId,
                    TiketSscNo = model.TiketSscNo,
                    TanggalKembali = model.TanggalKembali.HasValue ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null,
                    Status = "Draft",
                    CreatedBy = _currentUserId,
                    CreatedAt = DateTime.Now,
                    Perangkat = model.Perangkat
                        .Where(p => p.BarangId > 0 && p.Jumlah > 0)
                        .Select(p => new PerangkatBA
                        {
                            BarangId = p.BarangId,
                            Jumlah = p.Jumlah,
                            Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                            NoSerial = p.NoSerial,
                            Keterangan = p.Keterangan
                        }).ToList()
                };
                DbContext.Set<BeritaAcaraEntity>().Add(ba);
                await DbContext.SaveChangesAsync();

                if (photoFiles.Any())
                {
                    var photoFolder2 = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "photos");
                    Directory.CreateDirectory(photoFolder2);
                    int idx3 = 1;
                    foreach (var file in photoFiles)
                    {
                        var ext2 = Path.GetExtension(file.Name);
                        var saveName2 = $"ba-{ba.Id}-photo-{idx3}{ext2}";
                        await using var fs2 = File.Create(Path.Combine(photoFolder2, saveName2));
                        await file.OpenReadStream(5_000_000).CopyToAsync(fs2);
                        DbContext.BuktiFoto.Add(new BuktiFoto { BaId = ba.Id, BeritaAcara = ba, FilePath = $"files/photos/{saveName2}" });
                        idx3++;
                    }
                    await DbContext.SaveChangesAsync();
                }
                Navigation.NavigateTo($"/editor/{ba.Id}");
            }
        }
        catch (Exception ex)
        {
            var inner = ex.InnerException != null ? $"\nInner: {ex.InnerException.Message}" : "";
            errorMessage = $"Gagal menyimpan Berita Acara: {ex.Message}{inner}";
            await JSRuntime.InvokeVoidAsync("appLoading.hide");
        }
        finally { isSaving = false; }
    }

    // ── Search methods for Mengetahui ──
    private void OpenMengetahuiSearch()
    {
        mengetahuiSearchQuery = string.Empty;
        mengetahuiSearchResults = approvers.Take(8).ToList();
        showMengetahuiSearch = true;
    }
    
    private void CloseMengetahuiSearch() => showMengetahuiSearch = false;
    
    private void OnMengetahuiSearchInput(ChangeEventArgs e)
    {
        mengetahuiSearchQuery = e.Value?.ToString() ?? string.Empty;
        mengetahuiSearchResults = string.IsNullOrWhiteSpace(mengetahuiSearchQuery)
            ? approvers.Take(8).ToList()
            : approvers.Where(a => a.Nama.Contains(mengetahuiSearchQuery, StringComparison.OrdinalIgnoreCase)).Take(8).ToList();
    }
    
    private void SelectMengetahui(ApplicationUser u)
    {
        model.MengetahuiId = u.Id;
        showMengetahuiSearch = false;
        _ = AutoSaveAsync();
    }

    private class CreateBaModel
    {
        public string Jenis { get; set; } = "Alokasi";
        public string? JenisCustom { get; set; }
        public int PjId { get; set; }
        public string? PjNoTelp { get; set; }
        public int MenyerahkanId { get; set; }
        public int MengetahuiId { get; set; }
        public string? TiketSscNo { get; set; }
        public DateTime Tanggal { get; set; } = DateTime.Today;
        public DateTime? TanggalKembali { get; set; }
        public List<PerangkatRow> Perangkat { get; set; } = new();
    }

    private class PerangkatRow
    {
        public int BarangId { get; set; }
        public int Jumlah { get; set; } = 1;
        public string Satuan { get; set; } = "Pcs";
        public string? NoSerial { get; set; }
        public string? Keterangan { get; set; }
    }
