                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ── 5. Upload Foto ── -->
        <div class="form-section">
            <div class="form-section-title">5. Bukti Foto Serah Terima</div>

            @if (photoDataUrls.Any())
            {
                <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;align-items:center;">
                    @for (int i = 0; i < photoDataUrls.Count; i++)
                    {
                        var idx = i;
                        var url = photoDataUrls[i].Url;
                        var name = photoDataUrls[i].Name;
                        <div style="border-radius:var(--radius);overflow:hidden;border:2px solid var(--primary);box-shadow:var(--shadow-md);max-width:100%;display:flex;flex-direction:column;">
                            <div style="background:rgba(0,0,0,0.65);padding:6px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px;">
                                <div style="font-size:12px;color:white;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@name</div>
                                <i class="bi bi-x-lg" style="font-size:14px;color:white;cursor:pointer;flex-shrink:0;" @onclick="() => RemoveNewPhoto(idx)"></i>
                            </div>
                            <img src="@url" alt="@name"
                                 style="width:100%;max-width:320px;height:auto;display:block;object-fit:contain;" />
                        </div>
                    }
                </div>
            }
            @if (existingPhotoUrls.Any())
            {
                <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;align-items:center;">
                    @for (int i = 0; i < existingPhotoUrls.Count; i++)
                    {
                        var idx = i;
                        var url = existingPhotoUrls[i].RelPath;
                        var name = existingPhotoUrls[i].Name;
                        <div style="border-radius:var(--radius);overflow:hidden;border:2px solid var(--border);box-shadow:var(--shadow-md);max-width:100%;display:flex;flex-direction:column;">
                            <div style="background:rgba(0,0,0,0.55);padding:6px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px;">
                                <div style="font-size:12px;color:white;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@name</div>
                                <i class="bi bi-x-lg" style="font-size:14px;color:white;cursor:pointer;flex-shrink:0;" @onclick="() => RemoveExistingPhoto(idx)"></i>
                            </div>
                            <img src="/@url" alt="@name"
                                 style="width:100%;max-width:320px;height:auto;display:block;object-fit:contain;" />
                        </div>
                    }
                </div>
            }

            <div style="display:flex;justify-content:center;">
                <label for="photo-upload-input" style="cursor:pointer;display:inline-block;">
                    <div class="upload-btn-styled">
                        <i class="bi bi-cloud-arrow-up-fill" style="font-size:28px;"></i>
                        <span style="font-weight:600;font-size:15px;">
                            @if (photoFiles.Any() || existingPhotoUrls.Any())
                            {
                                @("Tambah Foto")
                            }
                            else
                            {
                                @("Pilih Foto")
                            }
                        </span>
                        <span style="font-size:12px;color:var(--text-muted);margin-top:2px;text-align:center;">JPG, PNG &middot; maks. 5 MB per file</span>
                    </div>
                </label>
            </div>
            <InputFile id="photo-upload-input" OnChange="OnPhotosSelected" multiple accept="image/jpeg,image/png,.jpg,.jpeg,.png"
                       style="display:none;" />
        </div>
    }

    <!-- Actions -->
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;padding:16px 0;">
        <button type="button" class="btn btn-outline" @onclick="ResetForm">
            <i class="bi bi-arrow-counterclockwise"></i> Reset
        </button>
        <button type="submit" class="btn btn-primary" disabled="@isSaving" style="min-width:160px;">
            @if (isSaving)
            {
                <span class="spinner" style="width:16px;height:16px;border-width:2px;"></span>
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan &amp; Lanjutkan</span>
                <i class="bi bi-arrow-right"></i>
            }
        </button>
    </div>

</EditForm>


@code {
    [SupplyParameterFromQuery(Name = "edit")]
    public int? EditIdParam { get; set; }

    private int? editId;
    private CreateBaModel model = new() { Tanggal = DateTime.Today, Perangkat = [new()] };
    private List<PegawaiEntity> allPegawai = new();
    private List<PegawaiEntity> pjResults = new();
    private List<ApplicationUser> reviewers = new();
    private List<ApplicationUser> adminGudangUsers = new();
    private List<MasterBarangEntity> barangOptions = new();

    private List<IBrowserFile> photoFiles = new();
    private List<(string Url, string Name)> photoDataUrls = new();
    private List<(string RelPath, string Name)> existingPhotoUrls = new();
    private List<string> photosToDelete = new();

    private PegawaiEntity? selectedPj;
    private string pjSearch = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSaving = false;
    private int _currentUserId;
    private bool photosChanged = false;

    private enum AutoSaveState { Idle, Saving, Saved, Error }
    private AutoSaveState autoSaveStatus = AutoSaveState.Idle;
    private System.Threading.CancellationTokenSource? _autoSaveCts;

    private bool showJenisDropdown = false;

    private bool showBarangSearch = false;
    private string barangSearchQuery = string.Empty;
    private List<MasterBarangEntity> barangSearchResults = new();
    private PerangkatRow? activeSearchRow = null;
    private ElementReference barangSearchRef;

    private bool showMenyerahkanSearch;
    private string menyerahkanSearchQuery = string.Empty;
    private List<ApplicationUser> menyerahkanSearchResults = new();

    private bool showMengetahuiSearch;
    private string mengetahuiSearchQuery = string.Empty;
    private List<ApplicationUser> mengetahuiSearchResults = new();
    private ApplicationUser? currentUserObj;

    // Track original signature to restore if PJ is changed back
    private int? originalSignedPjId;
    private string? originalTtdPjPath;
    private DateTime? originalPjSignedAt;
    private string? originalStatus;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdStr, out _currentUserId);

        allPegawai = await DbContext.Pegawai.Where(p => p.IsAktif).OrderBy(p => p.Nama).ToListAsync();
        reviewers = await DbContext.Users.Where(u => u.Role == "Reviewer" && !u.IsDeleted).OrderBy(u => u.Nama).ToListAsync();
        adminGudangUsers = await DbContext.Users.Where(u => u.Role == "AdminGudangBarang" && !u.IsDeleted).OrderBy(u => u.Nama).ToListAsync();
        barangOptions = await DbContext.MasterBarang.Where(b => b.IsAktif).OrderBy(b => b.NamaBarang).ToListAsync();

        currentUserObj = adminGudangUsers.FirstOrDefault(u => u.Id == _currentUserId);
        if (currentUserObj != null && !editId.HasValue)
            model.MenyerahkanId = currentUserObj.PegawaiId ?? 0;

        editId = EditIdParam;
        if (editId.HasValue)
        {
            DbContext.ChangeTracker.Clear();
            var existing = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Perangkat)
                .Include(b => b.BuktiFotos)
                .FirstOrDefaultAsync(b => b.Id == editId.Value && (b.Status == "Draft" || b.Status == "Rejected") && b.CreatedBy == _currentUserId);

            if (existing is not null)
            {
                originalSignedPjId = existing.PjId;
                originalTtdPjPath = existing.TtdPjPath;
                originalPjSignedAt = existing.PjSignedAt;
                originalStatus = existing.Status;

                model.Jenis = existing.Jenis;
                model.JenisCustom = existing.JenisCustom;
                model.Tanggal = existing.Tanggal.ToDateTime(TimeOnly.MinValue);
                model.TiketSscNo = existing.TiketSscNo;
                model.DasarAlokasi = existing.DasarAlokasi;
                model.TanggalKembali = existing.TanggalKembali.HasValue
                    ? existing.TanggalKembali.Value.ToDateTime(TimeOnly.MinValue)
                    : null;
                model.PjId = existing.PjId;
                model.PjNoTelp = existing.PjNoTelp;
                model.PengunaAlihDaya = existing.PengunaAlihDaya;
                model.TipePj = string.IsNullOrEmpty(existing.PengunaAlihDaya) ? "Pekerja" : "TenagaAlihDaya";

                if (adminGudangUsers.Any(u => u.PegawaiId == existing.MenyerahkanId))
                    model.MenyerahkanId = existing.MenyerahkanId;
                else if (adminGudangUsers.FirstOrDefault(u => u.Id == existing.MenyerahkanId) is { } oldFormatUser)
                    model.MenyerahkanId = oldFormatUser.PegawaiId ?? 0;
                else
                    model.MenyerahkanId = existing.MenyerahkanId;
                model.MengetahuiId = existing.MengetahuiId;

                selectedPj = allPegawai.FirstOrDefault(p => p.Id == existing.PjId);
                if (selectedPj is not null) pjSearch = selectedPj.Nama;

                model.Perangkat = existing.Perangkat.Select(p => new PerangkatRow
                {
                    BarangId = p.BarangId,
                    Jumlah = p.Jumlah,
                    Satuan = p.Satuan ?? "Pcs",
                    NoSerial = p.NoSerial,
                    Keterangan = p.Keterangan
                }).ToList();

                if (!model.Perangkat.Any()) model.Perangkat.Add(new());

                if (existing.BuktiFotos != null)
                    existingPhotoUrls = existing.BuktiFotos.Select(f => (f.FilePath, Path.GetFileName(f.FilePath))).ToList();
            }
            else
            {
                editId = null;
            }
        }
    }

    private async Task CreateInitialDraftAsync()
    {
        if (_currentUserId == 0) return;
        try
        {
            var ba = new BeritaAcaraEntity
            {
                Tanggal = DateOnly.FromDateTime(model.Tanggal),
                Jenis = model.Jenis,
                JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null,
                PjId = model.PjId,
                PjNoTelp = model.PjNoTelp,
                PengunaAlihDaya = model.PengunaAlihDaya,
                MenyerahkanId = model.MenyerahkanId,
                MengetahuiId = model.MengetahuiId,
                TiketSscNo = model.TiketSscNo,
                DasarAlokasi = model.DasarAlokasi,
                Status = "Draft",
                CreatedBy = _currentUserId,
                CreatedAt = DateTime.Now,
            };
            DbContext.Set<BeritaAcaraEntity>().Add(ba);
            await DbContext.SaveChangesAsync();
            editId = ba.Id;
        }
        catch { }
    }

    private void TriggerAutoSave()
    {
        _autoSaveCts?.Cancel();
        _autoSaveCts = new System.Threading.CancellationTokenSource();
        var token = _autoSaveCts.Token;
        _ = Task.Run(async () =>
        {
            await Task.Delay(800, token);
            if (!token.IsCancellationRequested)
                await InvokeAsync(AutoSaveAsync);
        }, token);
    }

    private async Task AutoSaveAsync()
    {
        if (_currentUserId == 0) return;
        if (!editId.HasValue)
        {
            await CreateInitialDraftAsync();
            if (!editId.HasValue) return;
        }

        autoSaveStatus = AutoSaveState.Saving;
        StateHasChanged();
        try
        {
            if (!editId.HasValue) { autoSaveStatus = AutoSaveState.Error; StateHasChanged(); return; }
            DbContext.ChangeTracker.Clear();
            var existing = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Perangkat)
                .FirstOrDefaultAsync(b => b.Id == editId.Value);
            if (existing is null) { autoSaveStatus = AutoSaveState.Error; StateHasChanged(); return; }

            existing.Tanggal = DateOnly.FromDateTime(model.Tanggal);
            existing.Jenis = model.Jenis;
            existing.JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null;
            existing.PjNoTelp = model.PjNoTelp;
            existing.PengunaAlihDaya = model.PengunaAlihDaya;
            existing.MenyerahkanId = model.MenyerahkanId;
            existing.MengetahuiId = model.MengetahuiId;
            existing.TiketSscNo = model.TiketSscNo;
            existing.DasarAlokasi = model.DasarAlokasi;
            existing.TanggalKembali = model.TanggalKembali.HasValue
                ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null;

            // Jika PJ diganti, hapus TTD PJ lama — orang baru harus TTD ulang
            bool pjBerubah = existing.PjId != model.PjId;
            existing.PjId = model.PjId;
            if (pjBerubah)
            {
                if (model.PjId == originalSignedPjId && !string.IsNullOrEmpty(originalTtdPjPath))
                {
                    // Kembalikan tanda tangan jika PJ dikembalikan ke orang yang sudah pernah tanda tangan
                    existing.TtdPjPath = originalTtdPjPath;
                    existing.PjSignedAt = originalPjSignedAt;
                    existing.Status = originalStatus == "Rejected" ? "Rejected" : existing.Status;
                }
                else
                {
                    existing.TtdPjPath = null;
                    existing.PjSignedAt = null;
                    existing.Status = existing.Status == "Rejected" ? "Draft" : existing.Status;
                }
            }

            // Kosongkan DocxPath agar EditorBA tahu harus regenerasi dari template.
            existing.DocxPath = null;

            // Update perangkat hanya jika ada yang terisi minimal 1 barang
            var validPerangkat = model.Perangkat.Where(p => p.BarangId > 0 && p.Jumlah > 0).ToList();
            if (validPerangkat.Any())
            {
                DbContext.PerangkatBA.RemoveRange(existing.Perangkat.ToList());
                existing.Perangkat = validPerangkat.Select(p => new PerangkatBA
                {
                    BaId = existing.Id,
                    BarangId = p.BarangId,
                    Jumlah = p.Jumlah > 0 ? p.Jumlah : 1,
                    Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                    NoSerial = p.NoSerial,
                    Keterangan = p.Keterangan
                }).ToList();
            }

            await DbContext.SaveChangesAsync();
            autoSaveStatus = AutoSaveState.Saved;
            StateHasChanged();
            await Task.Delay(3000);
            if (autoSaveStatus == AutoSaveState.Saved) { autoSaveStatus = AutoSaveState.Idle; StateHasChanged(); }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[AutoSaveAsync] Error");
            autoSaveStatus = AutoSaveState.Error;
            StateHasChanged();
        }
    }

    private void SelectJenis(string jenis)
    {
        model.Jenis = jenis;
        showJenisDropdown = false;
        if (model.Jenis != "Peminjaman") model.TanggalKembali = null;
        if (model.Jenis != "Lainnya") model.JenisCustom = null;
        
        if (model.Jenis == "Lainnya")
        {
            model.PjId = null;
            model.PjNoTelp = null;
            model.PengunaAlihDaya = null;
            model.MenyerahkanId = null;
            model.MengetahuiId = null;
            model.Perangkat.Clear();
            selectedPj = null;
            
            // Hapus foto jika beralih ke Lainnya
            photoDataUrls.Clear();
            photoFiles.Clear();
            var existingIds = existingPhotoUrls.Select(x => x.RelPath).ToList();
            existingPhotoUrls.Clear();
            
            // Delete existing photos from DB if editId is present
            if (editId.HasValue && existingIds.Any())
            {
                foreach (var relPath in existingIds)
                {
                    try
                    {
                        var bf = DbContext.BuktiFoto.FirstOrDefault(f => f.BaId == editId.Value && f.FilePath == relPath);
                        if (bf != null)
                        {
                            DbContext.BuktiFoto.Remove(bf);
                            var physPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", bf.FilePath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                            if (File.Exists(physPath)) File.Delete(physPath);
                        }
                    }
                    catch { }
                }
                DbContext.SaveChanges();
            }
        }
        else
        {
            // Restore MenyerahkanId ke default (Admin Gudang / current user) jika kosong
            if (model.MenyerahkanId == null || model.MenyerahkanId == 0)
            {
                model.MenyerahkanId = currentUserObj?.PegawaiId ?? 0;
            }
            if (model.Perangkat.Count == 0)
            {
                model.Perangkat.Add(new());
            }
        }

        TriggerAutoSave();
    }

    private void OnSelectPekerja(ChangeEventArgs e) => SelectTipePj("Pekerja");
    private void OnSelectTenagaAlihDaya(ChangeEventArgs e) => SelectTipePj("TenagaAlihDaya");

    private void SelectTipePj(string tipe)
    {
        model.TipePj = tipe;
        if (tipe == "Pekerja") model.PengunaAlihDaya = null;
        TriggerAutoSave();
    }

    private void OnPjSearchInput(ChangeEventArgs e)
    {
        pjSearch = e.Value?.ToString() ?? string.Empty;
        pjResults = string.IsNullOrWhiteSpace(pjSearch) ? new() :
            allPegawai.Where(p => p.Nama.Contains(pjSearch, StringComparison.OrdinalIgnoreCase) ||
                                  p.NoPekerja.Contains(pjSearch, StringComparison.OrdinalIgnoreCase))
                      .OrderByDescending(p => p.Nama.StartsWith(pjSearch, StringComparison.OrdinalIgnoreCase) ||
                                             p.NoPekerja.StartsWith(pjSearch, StringComparison.OrdinalIgnoreCase))
                      .ThenBy(p => p.Nama)
                      .Take(6).ToList();
    }

    private void OnNoTelpInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        model.PjNoTelp = new string(raw.Where(char.IsDigit).ToArray());
        TriggerAutoSave();
    }

    private void SelectPj(PegawaiEntity p)
    {
        selectedPj = p;
        model.PjId = p.Id;
        model.PjNoTelp = p.NoTelp;
        pjSearch = p.Nama;
        pjResults.Clear();
        TriggerAutoSave();
    }

    private void OpenBarangSearchForRow(PerangkatRow row)
    {
        activeSearchRow = row;
        barangSearchQuery = string.Empty;
        barangSearchResults = barangOptions.ToList();
        showBarangSearch = true;
    }

    private void ResetForm()
    {
        model = new CreateBaModel { Tanggal = DateTime.Today, Perangkat = [new()] };
        showJenisDropdown = false;
        selectedPj = null;
        pjSearch = string.Empty;
        pjResults = new();
        barangSearchQuery = string.Empty;
        barangSearchResults = new();
        showBarangSearch = false;
        activeSearchRow = null;
        showMenyerahkanSearch = false;
        menyerahkanSearchQuery = string.Empty;
        menyerahkanSearchResults = new();
        showMengetahuiSearch = false;
        mengetahuiSearchQuery = string.Empty;
        mengetahuiSearchResults = new();
        photoFiles = new();
        photoDataUrls = new();
        existingPhotoUrls = new();
        photosToDelete = new();
        errorMessage = string.Empty;
        editId = null;
        autoSaveStatus = AutoSaveState.Idle;
        photosChanged = false;
    }

    private void AddPerangkat() => model.Perangkat.Add(new());

    private void RemovePerangkat(PerangkatRow row)
    {
        model.Perangkat.Remove(row);
        TriggerAutoSave();
    }

    private void OnBarangSearchInput(ChangeEventArgs e)
    {
        barangSearchQuery = e.Value?.ToString() ?? string.Empty;
        barangSearchResults = string.IsNullOrWhiteSpace(barangSearchQuery)
            ? barangOptions.ToList()
            : barangOptions.Where(b => b.NamaBarang?.Contains(barangSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false).ToList();
    }

    private void SelectBarangForRow(MasterBarangEntity b)
    {
        if (activeSearchRow is not null)
        {
            activeSearchRow.BarangId = b.Id;
            activeSearchRow.Jumlah = activeSearchRow.Jumlah > 0 ? activeSearchRow.Jumlah : 1;
            activeSearchRow.Satuan = "Pcs";
        }
        showBarangSearch = false;
        activeSearchRow = null;
        TriggerAutoSave();
    }

    private void CloseBarangSearch()
    {
        showBarangSearch = false;
        barangSearchQuery = string.Empty;
        barangSearchResults.Clear();
        activeSearchRow = null;
    }

    private async Task OnPhotosSelected(InputFileChangeEventArgs e)
    {
        photosChanged = true;
        var newFiles = e.GetMultipleFiles(10).ToList();

        if (!editId.HasValue) await CreateInitialDraftAsync();
        if (editId.HasValue && _currentUserId > 0)
        {
            autoSaveStatus = AutoSaveState.Saving;
            StateHasChanged();
            try
            {
                var photoFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "photos");
                Directory.CreateDirectory(photoFolder);
                int idx = existingPhotoUrls.Count + 1;
                foreach (var file in newFiles)
                {
                    var ext = Path.GetExtension(file.Name);
                    var saveName = $"ba-{editId.Value}-photo-{idx}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}{ext}";
                    var fullPath = Path.Combine(photoFolder, saveName);
                    var relPath = $"files/photos/{saveName}";

                    using var stream = file.OpenReadStream(5_000_000);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    var bytes = ms.ToArray();

                    // H-5: Validasi magic bytes — pastikan file benar-benar PNG atau JPEG
                    if (!IsValidImageBytes(bytes))
                    {
                        autoSaveStatus = AutoSaveState.Error;
                        StateHasChanged();
                        return;
                    }
                    await File.WriteAllBytesAsync(fullPath, bytes);

                    var existingBa = await DbContext.BeritaAcara.FindAsync(editId.Value);
                    DbContext.BuktiFoto.Add(new BuktiFoto
                    {
                        BaId = editId.Value,
                        BeritaAcara = existingBa!,
                        FilePath = relPath
                    });
                    existingPhotoUrls.Add((relPath, file.Name));
                    idx++;
                }
                await DbContext.SaveChangesAsync();
                autoSaveStatus = AutoSaveState.Saved;
                StateHasChanged();
                await Task.Delay(3000);
                if (autoSaveStatus == AutoSaveState.Saved) { autoSaveStatus = AutoSaveState.Idle; StateHasChanged(); }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[OnPhotosSelected] Error saat upload foto");
                autoSaveStatus = AutoSaveState.Error;
                StateHasChanged();
            }
        }
        else
        {
            foreach (var file in newFiles)
            {
                photoFiles.Add(file);
                try
                {
                    using var stream = file.OpenReadStream(5_000_000);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    var base64 = Convert.ToBase64String(ms.ToArray());
                    var mime = file.ContentType ?? "image/jpeg";
                    photoDataUrls.Add(($"data:{mime};base64,{base64}", file.Name));
                }
                catch { }
            }
        }
    }

    // H-5/H-6: Validasi magic bytes — hanya izinkan PNG (89 50 4E 47) dan JPEG (FF D8 FF)
    private static bool IsValidImageBytes(byte[] bytes)
    {
        if (bytes.Length < 4) return false;
        if (bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47) return true; // PNG
        if (bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF) return true; // JPEG
        return false;
    }

    private void RemoveNewPhoto(int index)
    {
        if (index >= 0 && index < photoDataUrls.Count)
        {
            photoDataUrls.RemoveAt(index);
            if (index < photoFiles.Count) photoFiles.RemoveAt(index);
        }
    }

    private async Task RemoveExistingPhoto(int index)
    {
        if (index < 0 || index >= existingPhotoUrls.Count) return;
        var (relPath, _) = existingPhotoUrls[index];
        existingPhotoUrls.RemoveAt(index);
        photosChanged = true;
        if (editId.HasValue)
        {
            try
            {
                var foto = await DbContext.BuktiFoto.FirstOrDefaultAsync(f => f.BaId == editId.Value && f.FilePath == relPath);
                if (foto != null)
                {
                    DbContext.BuktiFoto.Remove(foto);
                    await DbContext.SaveChangesAsync();
                    var physPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", relPath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                    if (File.Exists(physPath)) File.Delete(physPath);
                }
            }
            catch (Exception ex) { Logger.LogError(ex, "RemoveExistingPhoto error"); }
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = string.Empty;

        // ── Validasi ──
        if (model.Jenis == "Lainnya")
        {
            if (string.IsNullOrWhiteSpace(model.JenisCustom)) { errorMessage = "Nama/Jenis Berita Acara wajib diisi."; return; }
        }
        else
        {
            if (model.PjId is null or 0) { errorMessage = "Pilih Penanggung Jawab (PJ) terlebih dahulu."; return; }
            if (model.TipePj == "TenagaAlihDaya" && string.IsNullOrWhiteSpace(model.PengunaAlihDaya)) { errorMessage = "Nama Pengguna wajib diisi."; return; }
            if (!string.IsNullOrWhiteSpace(model.PjNoTelp) && (model.PjNoTelp.Length < 9 || model.PjNoTelp.Length > 15)) { errorMessage = "No. Telp/HP PJ tidak valid (9–15 digit)."; return; }
            if (model.MengetahuiId == 0 || !reviewers.Any(u => u.Id == model.MengetahuiId)) { errorMessage = "Pilih Reviewer (Yang Mengetahui)"; return; }

            if (string.IsNullOrWhiteSpace(model.TiketSscNo)) { errorMessage = "No. Tiket My SSC/Nota Dinas wajib diisi."; return; }
            if (model.Jenis == "Peminjaman" && !model.TanggalKembali.HasValue) { errorMessage = "Tanggal Kembali wajib diisi untuk Peminjaman."; return; }
            if (!model.Perangkat.Any(p => p.BarangId > 0)) { errorMessage = "Tambahkan minimal satu perangkat."; return; }
            if (model.Jenis == "Peminjaman" && model.TanggalKembali.HasValue && model.TanggalKembali.Value.Date < model.Tanggal.Date)
            { errorMessage = "Tanggal Kembali tidak boleh sebelum Tanggal peminjaman."; return; }
        }

        // Validasi foto — opsional, tidak wajib dilampirkan

        isSaving = true;
        try
        {
            if (_currentUserId == 0)
            {
                var auth = await AuthStateProvider.GetAuthenticationStateAsync();
                var userIdStr = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                int.TryParse(userIdStr, out _currentUserId);
            }
            if (_currentUserId == 0) { errorMessage = "Sesi habis, silakan login kembali."; isSaving = false; return; }

            if (!editId.HasValue) await CreateInitialDraftAsync();

            if (editId.HasValue)
            {
                DbContext.ChangeTracker.Clear();
                var existing = await DbContext.Set<BeritaAcaraEntity>()
                    .Include(b => b.Perangkat)
                    .Include(b => b.BuktiFotos)
                    .FirstOrDefaultAsync(b => b.Id == editId.Value);

                if (existing is null) { errorMessage = "Draft tidak ditemukan."; isSaving = false; return; }

                // Periksa apakah ada perubahan pada data form
                bool isChanged = existing.Jenis != model.Jenis ||
                                 existing.JenisCustom != (model.Jenis == "Lainnya" ? model.JenisCustom : null) ||
                                 existing.Tanggal != DateOnly.FromDateTime(model.Tanggal) ||
                                 existing.PjId != model.PjId ||
                                 existing.PjNoTelp != model.PjNoTelp ||
                                 existing.DasarAlokasi != model.DasarAlokasi ||
                                 existing.MenyerahkanId != model.MenyerahkanId ||
                                 existing.MengetahuiId != model.MengetahuiId ||
                                 existing.TiketSscNo != model.TiketSscNo ||
                                 existing.TanggalKembali != (model.TanggalKembali.HasValue ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null);

                if (!isChanged)
                {
                    var newPerangkatList = model.Perangkat.Where(p => p.BarangId > 0 && p.Jumlah > 0).ToList();
                    if (existing.Perangkat.Count != newPerangkatList.Count)
                    {
                        isChanged = true;
                    }
                    else
                    {
                        foreach (var ep in existing.Perangkat)
                        {
                            var match = newPerangkatList.FirstOrDefault(np => np.BarangId == ep.BarangId && np.Jumlah == ep.Jumlah && np.NoSerial == ep.NoSerial && np.Keterangan == ep.Keterangan);
                            if (match == null) { isChanged = true; break; }
                        }
                    }
                }

                // Jika data form berubah ATAU foto diganti, dokumen perlu di-generate ulang.
                // Auto-save sudah mengurus reset TtdPjPath saat PJ diganti,
                // sehingga di sini cukup cek apakah TtdPjPath masih ada.
                bool pjSudahTtd = existing.Status == "Rejected" && !string.IsNullOrEmpty(existing.TtdPjPath) && existing.PjSignedAt.HasValue;
                if (isChanged || photosChanged || (photoFiles.Any() && !existingPhotoUrls.Any()))
                {
                    existing.DocxPath = null;
                }

                existing.Tanggal = DateOnly.FromDateTime(model.Tanggal);
                existing.Jenis = model.Jenis;
                existing.JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null;
                existing.PjNoTelp = model.PjNoTelp;
                existing.PengunaAlihDaya = model.PengunaAlihDaya;
                existing.MenyerahkanId = model.MenyerahkanId;
                existing.MengetahuiId = model.MengetahuiId;
                existing.TiketSscNo = model.TiketSscNo;
                existing.DasarAlokasi = model.DasarAlokasi;
                existing.TanggalKembali = model.TanggalKembali.HasValue
                    ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null;

                // Jika PJ diganti, hapus TTD PJ lama (auto-save biasanya sudah lakukan ini,
                // tapi sebagai fallback jika SubmitAsync dipanggil langsung tanpa auto-save)
                bool pjBerubahSubmit = existing.PjId != model.PjId;
                existing.PjId = model.PjId;
                if (pjBerubahSubmit)
                {
                    if (model.PjId == originalSignedPjId && !string.IsNullOrEmpty(originalTtdPjPath))
                    {
                        // Kembalikan tanda tangan original jika PJ dikembalikan ke orang yang sudah tanda tangan
                        existing.TtdPjPath = originalTtdPjPath;
                        existing.PjSignedAt = originalPjSignedAt;
                        pjSudahTtd = true;
                    }
                    else
                    {
                        existing.TtdPjPath = null;
                        existing.PjSignedAt = null;
                        pjSudahTtd = false;
                    }
                }

                // Untuk BA yang Rejected:
                // - Jika PJ BELUM TTD atau PJ DIGANTI: reset penuh ke Draft agar masuk alur normal
                // - Jika PJ SUDAH TTD & PJ TIDAK BERUBAH: pertahankan status Rejected + info TTD PJ;
                //   EditorBA yang akan mengurus regenerasi + re-embed + kirim ke Reviewer
                if (existing.Status == "Rejected")
                {
                    // AlasanReject DIPERTAHANKAN di sini — baru dihapus saat BA dikirim ke Reviewer
                    // (dilakukan di EditorBA.SubmitForApprovalAsync)
                    existing.SubmittedAt = null;
                    existing.ApprovedAt = null;
                    if (!pjSudahTtd)
                    {
                        // PJ belum TTD ATAU PJ diganti — reset ke Draft, masuk alur biasa
                        existing.Status = "Draft";
                        existing.TtdPjPath = null;
                        existing.PjSignedAt = null;
                    }
                    // Jika pjSudahTtd (PJ sama & sudah TTD): status tetap Rejected, TtdPjPath & PjSignedAt dipertahankan
                }

                DbContext.PerangkatBA.RemoveRange(existing.Perangkat.ToList());
                existing.Perangkat = model.Perangkat
                    .Where(p => p.BarangId > 0 && p.Jumlah > 0)
                    .Select(p => new PerangkatBA
                    {
                        BaId = existing.Id,
                        BarangId = p.BarangId,
                        Jumlah = p.Jumlah,
                        Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                        NoSerial = p.NoSerial,
                        Keterangan = p.Keterangan
                    }).ToList();

                if (photoFiles.Any() && !existingPhotoUrls.Any())
                {
                    var photoFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "photos");
                    Directory.CreateDirectory(photoFolder);
                    int idx2 = 1;
                    foreach (var file in photoFiles)
                    {
                        var ext = Path.GetExtension(file.Name);
                        var saveName = $"ba-{existing.Id}-photo-{idx2}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}{ext}";
                        await using var fs = File.Create(Path.Combine(photoFolder, saveName));
                        await file.OpenReadStream(5_000_000).CopyToAsync(fs);
                        DbContext.BuktiFoto.Add(new BuktiFoto { BaId = existing.Id, BeritaAcara = existing, FilePath = $"files/photos/{saveName}" });
                        idx2++;
                    }
                }

                await DbContext.SaveChangesAsync();
                Navigation.NavigateTo($"/editor/{existing.Id}");
            }
            else
            {
                var ba = new BeritaAcaraEntity
                {
                    Tanggal = DateOnly.FromDateTime(model.Tanggal),
                    Jenis = model.Jenis,
                    JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null,
                    PjId = model.PjId,
                    PjNoTelp = model.PjNoTelp,
                    PengunaAlihDaya = model.PengunaAlihDaya,
                    MenyerahkanId = model.MenyerahkanId,
                    MengetahuiId = model.MengetahuiId,
                    TiketSscNo = model.TiketSscNo,
                    DasarAlokasi = model.DasarAlokasi,
                    TanggalKembali = model.TanggalKembali.HasValue ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null,
                    Status = "Draft",
                    CreatedBy = _currentUserId,
                    CreatedAt = DateTime.Now,
                    Perangkat = model.Perangkat
                        .Where(p => p.BarangId > 0 && p.Jumlah > 0)
                        .Select(p => new PerangkatBA
                        {
                            BarangId = p.BarangId,
                            Jumlah = p.Jumlah,
                            Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                            NoSerial = p.NoSerial,
                            Keterangan = p.Keterangan
                        }).ToList()
                };
                DbContext.Set<BeritaAcaraEntity>().Add(ba);
                await DbContext.SaveChangesAsync();
                Navigation.NavigateTo($"/editor/{ba.Id}");
            }
        }
        catch (Exception ex)
        {
            var inner = ex.InnerException != null ? $"\nInner: {ex.InnerException.Message}" : "";
            errorMessage = $"Gagal menyimpan Berita Acara: {ex.Message}{inner}";
        }
        finally { isSaving = false; }
    }
