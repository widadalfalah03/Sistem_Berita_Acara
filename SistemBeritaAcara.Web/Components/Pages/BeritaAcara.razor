@page "/buat-ba"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@using PegawaiEntity = SistemBeritaAcara.Core.Entities.Pegawai
@using MasterBarangEntity = SistemBeritaAcara.Core.Entities.MasterBarang
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject IBACounterService BACounterService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<BeritaAcara> Logger

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminGudangBarang")]

<PageTitle>@(editId.HasValue ? "Edit Berita Acara" : "Buat Berita Acara") â€” Sistem Berita Acara</PageTitle>

<!-- â”€â”€ Floating toast: autosave status â”€â”€ -->
@if (autoSaveStatus != AutoSaveState.Idle)
{
    <div style="position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;align-items:center;gap:8px;padding:10px 18px;border-radius:var(--radius);box-shadow:0 4px 24px rgba(0,0,0,0.18);font-size:13px;font-weight:500;transition:opacity 0.3s;
        @(autoSaveStatus == AutoSaveState.Saved ? "background:#ECFDF5;border:1px solid #6EE7B7;color:#065F46;" :
          autoSaveStatus == AutoSaveState.Saving ? "background:var(--surface);border:1px solid var(--border);color:var(--text-secondary);" :
          "background:#FEF2F2;border:1px solid #FECACA;color:var(--danger);")">
        @if (autoSaveStatus == AutoSaveState.Saving)
        {
            <span class="spinner" style="width:13px;height:13px;border-width:2px;"></span>
            <span>Menyimpan draft...</span>
        }
        else if (autoSaveStatus == AutoSaveState.Saved)
        {
            <i class="bi bi-check-circle-fill" style="font-size:15px;"></i>
            <span>Draft tersimpan</span>
        }
        else
        {
            <i class="bi bi-exclamation-circle-fill" style="font-size:15px;"></i>
            <span>Gagal simpan otomatis</span>
        }
    </div>
}

<!-- â”€â”€ Floating toast: error submit â”€â”€ -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div style="position:fixed;top:80px;left:50%;transform:translateX(-50%);z-index:9999;max-width:520px;width:90%;background:#FEF2F2;border:1px solid #FECACA;border-radius:var(--radius);padding:14px 20px;display:flex;align-items:flex-start;gap:10px;color:var(--danger);box-shadow:0 6px 24px rgba(0,0,0,0.15);">
        <i class="bi bi-exclamation-circle-fill" style="font-size:18px;flex-shrink:0;margin-top:1px;"></i>
        <div style="flex:1;">@errorMessage</div>
        <button type="button" @onclick="() => errorMessage = string.Empty"
                style="background:none;border:none;cursor:pointer;color:var(--danger);font-size:16px;padding:0;line-height:1;flex-shrink:0;">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
}

<EditForm Model="model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <!-- â”€â”€ 1. Info Dokumen â”€â”€ -->
    <div class="form-section">
        <div class="form-section-title">1. Informasi Dokumen</div>
        <div class="form-row">
            <!-- Kiri: Jenis BA di atas, No. Tiket di bawah -->
            <div style="display:flex;flex-direction:column;gap:16px;flex:1;">
                <!-- Jenis Berita Acara -->
                <div class="form-group" style="position:relative;">
                    <label class="form-label">Jenis Berita Acara <span style="color:var(--danger)">*</span></label>
                    <div @onclick="() => showJenisDropdown = !showJenisDropdown"
                         style="padding:10px 14px;cursor:pointer;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);font-size:14px;display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;">
                        <span style="font-weight:500;">@model.Jenis</span>
                        <i class="bi bi-chevron-down" style="font-size:11px;color:var(--text-muted);transition:transform 0.2s;@(showJenisDropdown ? "transform:rotate(180deg);" : "")"></i>
                    </div>
                    @if (showJenisDropdown)
                    {
                        <div @onclick="() => showJenisDropdown = false"
                             style="position:fixed;inset:0;z-index:99;"></div>
                        <div style="position:absolute;top:100%;left:0;right:0;z-index:200;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-md);overflow:hidden;margin-top:4px;">
                            @foreach (var jenis in new[] { "Alokasi", "Peminjaman", "Penarikan", "Lainnya" })
                            {
                                <div @onclick="() => SelectJenis(jenis)"
                                     style="padding:10px 14px;cursor:pointer;font-size:14px;font-weight:@(model.Jenis == jenis ? "600" : "400");background:@(model.Jenis == jenis ? "var(--primary)" : "transparent");color:@(model.Jenis == jenis ? "white" : "var(--text-primary)");border-bottom:1px solid var(--border-light);"
                                     onmouseover="if(this.style.background !== 'var(--primary)') this.style.background='var(--primary-light)'"
                                     onmouseout="if(this.style.background !== 'var(--primary)') this.style.background='transparent'">
                                    @jenis
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Kanan: Tanggal Kembali (Peminjaman) atau Input Jenis Custom (Lainnya) -->
            @if (model.Jenis == "Peminjaman")
            {
                <div class="form-group" style="flex:1;">
                    <label class="form-label">Tanggal Kembali <span style="color:var(--danger)">*</span></label>
                    <InputDate class="form-control" @bind-Value="model.TanggalKembali" @bind-Value:after="TriggerAutoSave" />
                </div>
            }
            else if (model.Jenis == "Lainnya")
            {
                <div class="form-group" style="flex:1;">
                    <label class="form-label">Nama / Judul Berita Acara <span style="color:var(--danger)">*</span></label>
                    <InputText class="form-control" @bind-Value="model.JenisCustom" @bind-Value:after="TriggerAutoSave"
                               placeholder="Contoh: Serah Terima Jabatan" />
                    <div style="font-size:12px;color:var(--text-muted);margin-top:4px;">Teks ini akan tampil sebagai judul di dokumen</div>
                </div>
            }
        </div>

    </div>

    <!-- â”€â”€ Card 2â€“5 â”€â”€ -->
    @if (model.Jenis != "Lainnya")
    {
        <!-- â”€â”€ 2. Data Penanggung Jawab â”€â”€ -->
        <div class="form-section">
            <div class="form-section-title">2. Data Penanggung Jawab</div>

            <div class="form-row">
                <div style="display:flex;flex-direction:column;gap:16px;flex:1;">
                    <!-- Radio: Pekerja vs Tenaga Alih Daya -->
                    <div>
                        <label class="form-label" style="margin-bottom:8px;display:block;">Tipe Penanggung Jawab</label>
                        <div style="display:flex;gap:24px;align-items:center;">
                            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;font-weight:500;">
                                <input type="radio" name="tipePj" value="Pekerja"
                                       checked="@(model.TipePj == "Pekerja")"
                                       @onchange="OnSelectPekerja"
                                       style="width:16px;height:16px;accent-color:var(--primary);cursor:pointer;" />
                                Pekerja
                            </label>
                            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px;font-weight:500;">
                                <input type="radio" name="tipePj" value="TenagaAlihDaya"
                                       checked="@(model.TipePj == "TenagaAlihDaya")"
                                       @onchange="OnSelectTenagaAlihDaya"
                                       style="width:16px;height:16px;accent-color:var(--primary);cursor:pointer;" />
                                Tenaga Alih Daya
                            </label>
                        </div>
                    </div>
                    <!-- Field Pengguna: muncul jika TAD -->
                    @if (model.TipePj == "TenagaAlihDaya")
                    {
                        <div class="form-group">
                            <label class="form-label">Nama Pengguna <span style="color:var(--danger)">*</span></label>
                            <input type="text" class="form-control"
                                   placeholder="Masukkan nama pengguna"
                                   value="@model.PengunaAlihDaya"
                                   @oninput="@(e => { model.PengunaAlihDaya = e.Value?.ToString(); TriggerAutoSave(); })" />
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label">Penanggung Jawab <span style="color:var(--danger)">*</span></label>
                        <div class="search-input">
                            <i class="bi bi-search"></i>
                            <input type="text" placeholder="Ketik nama atau no. pekerja..."
                                   value="@pjSearch"
                                   @onchange="OnPjSearchInput" @oninput="OnPjSearchInput" />
                        </div>
                        @if (pjResults.Any())
                        {
                            <div style="border:1px solid var(--border);border-radius:var(--radius);margin-top:4px;max-height:200px;overflow-y:auto;background:var(--surface);box-shadow:var(--shadow-md);">
                                @foreach (var p in pjResults)
                                {
                                    <div @onclick="() => SelectPj(p)"
                                         style="padding:12px 16px;cursor:pointer;border-bottom:1px solid var(--border-light);display:flex;align-items:center;gap:12px;"
                                         onmouseover="this.style.background='var(--primary-light)'"
                                         onmouseout="this.style.background='transparent'">
                                        <div style="width:36px;height:36px;border-radius:50%;background:var(--primary);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex-shrink:0;">
                                            @p.Nama[0]
                                        </div>
                                        <div>
                                            <div style="font-weight:600;">@p.Nama</div>
                                            <div style="font-size:12px;color:var(--text-muted);">@p.NoPekerja - @p.FungsiDirektorat</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div style="flex:1;"></div>
            </div>
            @if (selectedPj is not null)
            {
                <div style="margin-top:20px;background:var(--primary-light);border:1px solid #BFDBFE;border-radius:var(--radius);padding:16px;">
                    <div class="pj-detail-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px;">Nama</div>
                            <div style="font-weight:600;">@selectedPj.Nama</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px;">Cost Center</div>
                            <div style="font-weight:600;">@(selectedPj.CostCenter ?? "-")</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px;">Jabatan</div>
                            <div style="font-weight:600;">@(selectedPj.Jabatan ?? "-")</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px;">Fungsi/Direktorat</div>
                            <div style="font-weight:600;">@(selectedPj.FungsiDirektorat ?? "-")</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px;">Alamat</div>
                            <div style="font-weight:600;">@(selectedPj.FungsiDirektorat ?? "-")</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px;">Email</div>
                            <div style="font-weight:600;">@(selectedPj.Email ?? "-")</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:2px;">No. Pekerja</div>
                            <div style="font-weight:600;">@selectedPj.NoPekerja</div>
                        </div>
                        <div>
                            <div style="font-size:12px;color:var(--text-muted);margin-bottom:4px;">No. Telp/HP</div>
                            <input type="tel" class="form-control" style="font-size:13px;padding:6px 10px;"
                                   placeholder="Contoh: 08123456789"
                                   inputmode="numeric" pattern="[0-9]*"
                                   value="@model.PjNoTelp"
                                   @oninput="OnNoTelpInput" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- â”€â”€ 3. Daftar Perangkat â”€â”€ -->
        <div class="form-section">
            <div class="form-section-title">3. Daftar Perangkat</div>

            @if (model.Jenis != "Lainnya")
            {
                <div class="form-row" style="margin-bottom:16px;">
                    <div class="form-group" style="flex:1;">
                        <label class="form-label">No. Tiket My SSC/Nota Dinas <span style="color:var(--danger)">*</span></label>
                        <InputText class="form-control" @bind-Value="model.TiketSscNo" @bind-Value:after="TriggerAutoSave" placeholder="Contoh: INC-20240001 atau No. Nota Dinas" />
                    </div>
                    <div style="flex:1;"></div>
                </div>
            }

            <table class="perangkat-table" style="margin-bottom:12px;table-layout:fixed;">
                <thead>
                    <tr>
                        <th style="width:28%">Jenis Perangkat <span style="color:var(--danger)">*</span></th>
                        <th style="width:10%">Jumlah <span style="color:var(--danger)">*</span></th>
                        <th style="width:12%">Satuan <span style="color:var(--danger)">*</span></th>
                        <th style="width:20%">No. Serial</th>
                        <th style="width:24%">Keterangan</th>
                        <th style="width:6%;padding:0 0 0 4px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in model.Perangkat)
                    {
                        <tr>
                            <td style="position:relative;">
                                <!-- Trigger search -->
                                <div @onclick="() => OpenBarangSearchForRow(p)"
                                     style="padding:6px 10px;cursor:pointer;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);font-size:13px;display:flex;align-items:center;justify-content:space-between;gap:8px;"
                                     onmouseover="this.style.background='var(--primary-light)'"
                                     onmouseout="this.style.background='var(--surface)'">
                                    <span style="@(p.BarangId == 0 ? "color:var(--text-muted);" : "")">
                                        @(p.BarangId > 0 ? (barangOptions.FirstOrDefault(b => b.Id == p.BarangId)?.NamaBarang ?? "Pilih...") : "Cari perangkat...")
                                    </span>
                                    <i class="bi bi-search" style="font-size:11px;color:var(--text-muted);flex-shrink:0;"></i>
                                </div>
                                <!-- Inline search dropdown -->
                                @if (showBarangSearch && activeSearchRow == p)
                                {
                                    <div @onclick="CloseBarangSearch"
                                         style="position:fixed;inset:0;z-index:99;"></div>
                                    <div style="position:absolute;top:100%;left:0;right:0;z-index:100;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-md);min-width:220px;">
                                        <div style="padding:6px 8px;border-bottom:1px solid var(--border-light);">
                                            <div style="display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:4px 10px;">
                                                <i class="bi bi-search" style="font-size:12px;color:var(--text-muted);"></i>
                                                <input type="text" placeholder="Cari perangkat..."
                                                       @ref="barangSearchRef"
                                                       value="@barangSearchQuery"
                                                       @onchange="OnBarangSearchInput" @oninput="OnBarangSearchInput"
                                                       style="border:none;outline:none;background:transparent;font-size:13px;width:100%;" />
                                            </div>
                                        </div>
                                        @if (barangSearchResults.Any())
                                        {
                                            <div style="max-height:320px;overflow-y:auto;">
                                                @foreach (var b in barangSearchResults)
                                                {
                                                    <div @onclick="() => SelectBarangForRow(b)"
                                                         style="padding:9px 14px;cursor:pointer;border-bottom:1px solid var(--border-light);font-size:13px;font-weight:500;"
                                                         onmouseover="this.style.background='var(--primary-light)'"
                                                         onmouseout="this.style.background='transparent'">
                                                        @b.NamaBarang
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="padding:12px 14px;font-size:13px;color:var(--text-muted);">Tidak ada hasil</div>
                                        }
                                    </div>
                                }
                            </td>
                            <td><input type="number" min="1" value="@p.Jumlah"
                                           @onchange="@(e => { p.Jumlah = int.TryParse(e.Value?.ToString(), out var v) ? v : 1; TriggerAutoSave(); })" /></td>
                            <td><input type="text" value="@p.Satuan"
                                           @onchange="@(e => { p.Satuan = e.Value?.ToString() ?? string.Empty; TriggerAutoSave(); })" /></td>
                            <td><input type="text" value="@p.NoSerial"
                                           @onchange="@(e => { p.NoSerial = e.Value?.ToString(); TriggerAutoSave(); })" /></td>
                            <td><input type="text" value="@p.Keterangan"
                                           @onchange="@(e => { p.Keterangan = e.Value?.ToString(); TriggerAutoSave(); })" /></td>
                            <td style="padding:0 0 0 4px;vertical-align:middle;">
                                <button type="button" class="perangkat-delete" @onclick="() => RemovePerangkat(p)"
                                        style="width:100%;border-radius:var(--radius-sm);">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Mobile Card View -->
            <div class="perangkat-mobile-list">
                @foreach (var p in model.Perangkat)
                {
                    <div class="perangkat-mobile-card">
                        <div style="position:relative;">
                            <div class="pm-label">Jenis Perangkat <span style="color:var(--danger)">*</span></div>
                            <div @onclick="() => OpenBarangSearchForRow(p)"
                                 style="padding:8px 12px;cursor:pointer;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);font-size:13px;display:flex;align-items:center;justify-content:space-between;gap:8px;">
                                <span style="@(p.BarangId == 0 ? "color:var(--text-muted);" : "")">@(p.BarangId > 0 ? (barangOptions.FirstOrDefault(b => b.Id == p.BarangId)?.NamaBarang ?? "Pilih...") : "Cari perangkat...")</span>
                                <i class="bi bi-search" style="font-size:11px;color:var(--text-muted);flex-shrink:0;"></i>
                            </div>
                            @if (showBarangSearch && activeSearchRow == p)
                            {
                                <div @onclick="CloseBarangSearch" style="position:fixed;inset:0;z-index:99;"></div>
                                <div style="position:absolute;top:100%;left:0;right:0;z-index:100;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-md);margin-top:4px;">
                                    <div style="padding:8px;border-bottom:1px solid var(--border-light);">
                                        <input type="text" placeholder="Cari perangkat..."
                                               value="@barangSearchQuery"
                                               @onchange="OnBarangSearchInput" @oninput="OnBarangSearchInput"
                                               style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:14px;box-sizing:border-box;" />
                                    </div>
                                    <div style="max-height:260px;overflow-y:auto;">
                                        @if (barangSearchResults.Any())
                                        {
                                            @foreach (var b in barangSearchResults)
                                            {
                                                <div @onclick="() => SelectBarangForRow(b)"
                                                     style="padding:12px 16px;cursor:pointer;border-bottom:1px solid var(--border-light);font-size:14px;font-weight:500;">
                                                    @b.NamaBarang
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div style="padding:12px 16px;font-size:13px;color:var(--text-muted);">Tidak ada hasil</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="pm-row">
                            <div class="pm-col">
                                <div class="pm-label">Jumlah <span style="color:var(--danger)">*</span></div>
                                <input type="number" min="1" class="form-control pm-input" value="@p.Jumlah"
                                       @onchange="@(e => { p.Jumlah = int.TryParse(e.Value?.ToString(), out var v) ? v : 1; TriggerAutoSave(); })" />
                            </div>
                            <div class="pm-col">
                                <div class="pm-label">Satuan <span style="color:var(--danger)">*</span></div>
                                <input type="text" class="form-control pm-input" value="@p.Satuan"
                                       @onchange="@(e => { p.Satuan = e.Value?.ToString() ?? string.Empty; TriggerAutoSave(); })" />
                            </div>
                        </div>
                        <div>
                            <div class="pm-label">No. Serial</div>
                            <input type="text" class="form-control" value="@p.NoSerial"
                                   @onchange="@(e => { p.NoSerial = e.Value?.ToString(); TriggerAutoSave(); })" />
                        </div>
                        <div>
                            <div class="pm-label">Keterangan</div>
                            <input type="text" class="form-control" value="@p.Keterangan"
                                   @onchange="@(e => { p.Keterangan = e.Value?.ToString(); TriggerAutoSave(); })" />
                        </div>
                        <div style="display:flex;justify-content:flex-end;">
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemovePerangkat(p)">
                                <i class="bi bi-trash3"></i> Hapus Item
                            </button>
                        </div>
                    </div>
                }
}
            </div>

            <!-- Tambah Perangkat -->
            <div style="display:flex;justify-content:flex-start;">
                <button type="button" class="btn btn-outline btn-sm" @onclick="AddPerangkat">
                    <i class="bi bi-plus-lg"></i> Tambah Perangkat
                </button>
            </div>

        </div>

        <!-- ── 4. Tanda Tangan ── -->
        <div class="form-section">
            <div class="form-section-title">4. Tanda Tangan</div>
            <div class="ttd-grid">
                <!-- Yang Menyerahkan: Admin Gudang (normal) atau PJ (Penarikan) -->
                <div class="ttd-col">
                    <div class="ttd-label">Yang Menyerahkan</div>
                    <div style="padding:10px 0;font-size:14px;color:var(--text-secondary);">
                        @if (model.Jenis == "Penarikan")
                        {
                            @if (selectedPj is not null)
                            {
                                <span style="font-weight:600;color:var(--text-primary);">
                                    <i class="bi bi-person-check" style="color:var(--success);"></i>
                                    @selectedPj.Nama
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--text-muted);">Otomatis dari PJ yang dipilih</span>
                            }
                        }
                        else
                        {
                            <span style="font-weight:600;color:var(--text-primary);">
                                <i class="bi bi-person-check" style="color:var(--success);"></i>
                                @(adminGudangUsers.FirstOrDefault(u => u.PegawaiId == model.MenyerahkanId)?.Nama ?? currentUserObj?.Nama ?? "Admin Gudang")
                            </span>
                        }
                    </div>
                </div>

                <!-- Yang Mengetahui (Reviewer) -->
                <div class="ttd-col">
                    <div class="ttd-label">Yang Mengetahui</div>
                    <div class="form-group" style="position:relative;">
                        <div @onclick="OpenMengetahuiSearch"
