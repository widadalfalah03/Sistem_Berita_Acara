    private void OnBarangSearchInput(ChangeEventArgs e)
    {
        barangSearchQuery = e.Value?.ToString() ?? string.Empty;
        if (barangSearchQuery.Length >= 1)
        {
            showBarangSearch = true;
            barangSearchResults = barangOptions
                .Where(b => b.NamaBarang?.StartsWith(barangSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                .ToList();
        }
        else
        {
            showBarangSearch = false;
            barangSearchResults.Clear();
        }
    }

    private void SelectBarangForRow(MasterBarangEntity b)
    {
        if (activeSearchRow is not null)
        {
            activeSearchRow.BarangId = b.Id;
            activeSearchRow.Jumlah = activeSearchRow.Jumlah > 0 ? activeSearchRow.Jumlah : 1;
            activeSearchRow.Satuan = "Pcs";
        }
        showBarangSearch = false;
        activeSearchRow = null;
        TriggerAutoSave();
    }

    private void CloseBarangSearch()
    {
        showBarangSearch = false;
        barangSearchQuery = string.Empty;
        barangSearchResults.Clear();
        activeSearchRow = null;
    }

    private async Task OnPhotosSelected(InputFileChangeEventArgs e)
    {
        photosChanged = true;
        var newFiles = e.GetMultipleFiles(10).ToList();

        if (!editId.HasValue) await CreateInitialDraftAsync();
        if (editId.HasValue && _currentUserId > 0)
        {
            autoSaveStatus = AutoSaveState.Saving;
            StateHasChanged();
            try
            {
                var photoFolder = Path.Combine(Directory.GetCurrentDirectory(), "AppFiles", "photos");
                Directory.CreateDirectory(photoFolder);
                int idx = existingPhotoUrls.Count + 1;
                foreach (var file in newFiles)
                {
                    var ext = Path.GetExtension(file.Name);
                    var saveName = $"ba-{editId.Value}-photo-{idx}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}{ext}";
                    var fullPath = Path.Combine(photoFolder, saveName);
                    var relPath = $"files/photos/{saveName}";

                    using var stream = file.OpenReadStream(5_000_000);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    var bytes = ms.ToArray();

                    if (!IsValidImageBytes(bytes))
                    {
                        autoSaveStatus = AutoSaveState.Error;
                        StateHasChanged();
                        return;
                    }
                    await File.WriteAllBytesAsync(fullPath, bytes);

                    var existingBa = await DbContext.BeritaAcara.FindAsync(editId.Value);
                    DbContext.BuktiFoto.Add(new BuktiFoto
                    {
                        BaId = editId.Value,
                        BeritaAcara = existingBa!,
                        FilePath = relPath
                    });
                    existingPhotoUrls.Add((relPath, file.Name));
                    idx++;
                }
                await DbContext.SaveChangesAsync();
                autoSaveStatus = AutoSaveState.Saved;
                StateHasChanged();
                await Task.Delay(3000);
                if (autoSaveStatus == AutoSaveState.Saved) { autoSaveStatus = AutoSaveState.Idle; StateHasChanged(); }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[OnPhotosSelected] Error saat upload foto");
                autoSaveStatus = AutoSaveState.Error;
                StateHasChanged();
            }
        }
        else
        {
            foreach (var file in newFiles)
            {
                photoFiles.Add(file);
                try
                {
                    using var stream = file.OpenReadStream(5_000_000);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    var base64 = Convert.ToBase64String(ms.ToArray());
                    var mime = file.ContentType ?? "image/jpeg";
                    photoDataUrls.Add(($"data:{mime};base64,{base64}", file.Name));
                }
                catch { }
            }
        }
    }

    private static bool IsValidImageBytes(byte[] bytes)
    {
        if (bytes.Length < 4) return false;
        if (bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47) return true; 
        if (bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF) return true; 
        return false;
    }

    private void RemoveNewPhoto(int index)
    {
        if (index >= 0 && index < photoDataUrls.Count)
        {
            photoDataUrls.RemoveAt(index);
            if (index < photoFiles.Count) photoFiles.RemoveAt(index);
        }
    }

    // Called by JS photoDragDrop when files are dropped onto the photo zone.
    [Microsoft.JSInterop.JSInvokable]
    public async Task ReceiveDroppedPhotos(List<DroppedFileDto> files)
    {
        if (files == null || files.Count == 0) return;
        photosChanged = true;

        if (!editId.HasValue) await CreateInitialDraftAsync();
        if (editId.HasValue && _currentUserId > 0)
        {
            autoSaveStatus = AutoSaveState.Saving;
            await InvokeAsync(StateHasChanged);
            try
            {
                var photoFolder = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "AppFiles", "photos");
                Directory.CreateDirectory(photoFolder);
                int idx = existingPhotoUrls.Count + 1;
                foreach (var f in files)
                {
                    var bytes = Convert.FromBase64String(f.Base64);
                    if (!IsValidImageBytes(bytes)) continue;
                    var ext = f.Mime == "image/png" ? ".png" : ".jpg";
                    var saveName = $"ba-{editId.Value}-photo-{idx}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}{ext}";
                    var fullPath = System.IO.Path.Combine(photoFolder, saveName);
                    var relPath = $"files/photos/{saveName}";
                    await File.WriteAllBytesAsync(fullPath, bytes);
                    var existingBa = await DbContext.BeritaAcara.FindAsync(editId.Value);
                    DbContext.BuktiFoto.Add(new BuktiFoto { BaId = editId.Value, BeritaAcara = existingBa!, FilePath = relPath });
                    existingPhotoUrls.Add((relPath, f.Name));
                    idx++;
                }
                await DbContext.SaveChangesAsync();
                autoSaveStatus = AutoSaveState.Saved;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(3000);
                if (autoSaveStatus == AutoSaveState.Saved) { autoSaveStatus = AutoSaveState.Idle; await InvokeAsync(StateHasChanged); }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[ReceiveDroppedPhotos] Error saat upload foto via drag-drop");
                autoSaveStatus = AutoSaveState.Error;
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            // No draft yet — keep in-memory as data URLs
            foreach (var f in files)
            {
                var bytes = Convert.FromBase64String(f.Base64);
                if (!IsValidImageBytes(bytes)) continue;
                var mime = f.Mime ?? "image/jpeg";
                photoDataUrls.Add(($"data:{mime};base64,{f.Base64}", f.Name));
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    public record DroppedFileDto(string Name, string Base64, string Mime);

    private async Task RemoveExistingPhoto(int index)
    {
        if (index < 0 || index >= existingPhotoUrls.Count) return;
        var (relPath, _) = existingPhotoUrls[index];
        existingPhotoUrls.RemoveAt(index);
        photosChanged = true;
        if (editId.HasValue)
        {
            try
            {
                var foto = await DbContext.BuktiFoto.FirstOrDefaultAsync(f => f.BaId == editId.Value && f.FilePath == relPath);
                if (foto != null)
                {
                    DbContext.BuktiFoto.Remove(foto);
                    await DbContext.SaveChangesAsync();
                    var physPath = Path.Combine(Directory.GetCurrentDirectory(), "AppFiles", relPath.TrimStart('/').Replace("files/", "").Replace('/',
Path.DirectorySeparatorChar));
                    if (File.Exists(physPath)) File.Delete(physPath);
                }
            }
            catch (Exception ex) { Logger.LogError(ex, "RemoveExistingPhoto error"); }
        }
    }

    private async Task SubmitAsync()
    {
        errorMessage = string.Empty;
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveCts = null;

        if (model.Jenis == "Lainnya")
        {
            if (string.IsNullOrWhiteSpace(model.JenisCustom)) { errorMessage = "Judul Berita Acara wajib diisi."; return; }
            if (string.IsNullOrWhiteSpace(model.Keterangan)) { errorMessage = "Keterangan wajib diisi."; return; }
        }
        else
        {
            if (model.PjId is null or 0) { errorMessage = "Pilih Penanggung Jawab (PJ) terlebih dahulu."; return; }
            if (model.TipePj == "TenagaAlihDaya" && string.IsNullOrWhiteSpace(model.PengunaAlihDaya)) { errorMessage = "Nama Pengguna wajib diisi."; return; }
            if (!string.IsNullOrWhiteSpace(model.PjNoTelp) && (model.PjNoTelp.Length < 9 || model.PjNoTelp.Length > 15))
            {
                errorMessage = "No. Telp/HP PJ tidak valid (9–15 digit)."; return;
            }
            if (model.MengetahuiId == 0 || !reviewers.Any(u => u.Id == model.MengetahuiId)) { errorMessage = "Pilih Reviewer (Yang Mengetahui)"; return; }

            if (string.IsNullOrWhiteSpace(model.TiketSscNo)) { errorMessage = "No. Tiket My SSC/Nota Dinas wajib diisi."; return; }
            if (model.Jenis == "Peminjaman" && !model.TanggalKembali.HasValue) { errorMessage = "Tanggal Kembali wajib diisi untuk Peminjaman."; return; }
            if (!model.Perangkat.Any(p => p.BarangId > 0)) { errorMessage = "Tambahkan minimal satu perangkat."; return; }
            if (model.Jenis == "Peminjaman" && model.TanggalKembali.HasValue && model.TanggalKembali.Value.Date <
model.Tanggal.Date)
            { errorMessage = "Tanggal Kembali tidak boleh sebelum Tanggal peminjaman."; return; }
        }


        await JSRuntime.InvokeVoidAsync("appLoading.show", "Menyiapkan dokumen...", "Sedang memproses, harap tunggu");
        isSaving = true;
        try
        {
            if (_currentUserId == 0)
            {
                var auth = await AuthStateProvider.GetAuthenticationStateAsync();
                var userIdStr = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                int.TryParse(userIdStr, out _currentUserId);
            }
            if (_currentUserId == 0)
            {
                errorMessage = "Sesi habis, silakan login kembali."; await
JSRuntime.InvokeVoidAsync("appLoading.hide"); isSaving = false; return;
            }

            if (!editId.HasValue) await CreateInitialDraftAsync();

            if (editId.HasValue)
            {
                DbContext.ChangeTracker.Clear();
                var existing = await DbContext.Set<BeritaAcaraEntity>()
                    .Include(b => b.Perangkat)
                    .Include(b => b.BuktiFotos)
                    .FirstOrDefaultAsync(b => b.Id == editId.Value);

                if (existing is null) { errorMessage = "Draft tidak ditemukan."; isSaving = false; return; }

                bool isChanged = existing.Jenis != model.Jenis ||
                                 existing.JenisCustom != (model.Jenis == "Lainnya" ? model.JenisCustom : null) ||
                                 existing.Keterangan != (model.Jenis == "Lainnya" ? model.Keterangan : null) ||
                                 existing.Tanggal != DateOnly.FromDateTime(model.Tanggal) ||
                                 existing.PjId != model.PjId ||
                                 existing.PjNoTelp != model.PjNoTelp ||
                                 existing.DasarAlokasi != model.DasarAlokasi ||
                                 existing.MenyerahkanId != model.MenyerahkanId ||
                                 existing.MengetahuiId != model.MengetahuiId ||
                                 existing.TiketSscNo != model.TiketSscNo ||
                                 existing.TanggalKembali != (model.TanggalKembali.HasValue ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null);

                if (!isChanged)
                {
                    var newPerangkatList = model.Perangkat.Where(p => p.BarangId > 0 && p.Jumlah > 0).ToList();
                    if (existing.Perangkat.Count != newPerangkatList.Count)
                    {
                        isChanged = true;
                    }
                    else
                    {
                        foreach (var ep in existing.Perangkat)
                        {
                            var match = newPerangkatList.FirstOrDefault(np => np.BarangId == ep.BarangId && np.Jumlah == ep.Jumlah && np.NoSerial ==
ep.NoSerial && np.Keterangan == ep.Keterangan);
                            if (match == null) { isChanged = true; break; }
                        }
                    }
                }

                bool pjSudahTtd = existing.Status == "Rejected" && !string.IsNullOrEmpty(existing.TtdPjPath) &&
existing.PjSignedAt.HasValue;
                if (isChanged || photosChanged || (photoFiles.Any() && !existingPhotoUrls.Any()))
                {
                    existing.DocxPath = null;
                    existing.DocxFinalPath = null;
                }

                existing.Tanggal = DateOnly.FromDateTime(model.Tanggal);
                existing.Jenis = model.Jenis;
                existing.JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null;
                existing.Keterangan = model.Jenis == "Lainnya" ? model.Keterangan : null;
                existing.PjNoTelp = model.PjNoTelp;
                existing.PengunaAlihDaya = model.PengunaAlihDaya;
                existing.MenyerahkanId = model.MenyerahkanId;
                existing.MengetahuiId = model.MengetahuiId;
                existing.TiketSscNo = model.TiketSscNo;
                existing.DasarAlokasi = model.DasarAlokasi;
                existing.TanggalKembali = model.TanggalKembali.HasValue
                    ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null;

                bool pjBerubahSubmit = existing.PjId != model.PjId;
                existing.PjId = model.PjId;
                if (pjBerubahSubmit)
                {
                    if (model.PjId == originalSignedPjId && !string.IsNullOrEmpty(originalTtdPjPath))
                    {
                        existing.TtdPjPath = originalTtdPjPath;
                        existing.PjSignedAt = originalPjSignedAt;
                        pjSudahTtd = true;
                    }
                    else
                    {
                        existing.TtdPjPath = null;
                        existing.PjSignedAt = null;
                        pjSudahTtd = false;
                    }
                }

                if (existing.Status == "Rejected")
                {
                    existing.SubmittedAt = null;
                    existing.ApprovedAt = null;
                    if (!pjSudahTtd)
                    {
                        existing.Status = "Draft";
                        existing.TtdPjPath = null;
                        existing.PjSignedAt = null;
                    }
                }

                DbContext.PerangkatBA.RemoveRange(existing.Perangkat.ToList());
                existing.Perangkat = model.Perangkat
                    .Where(p => p.BarangId > 0 && p.Jumlah > 0)
                    .Select(p => new PerangkatBA
                    {
                        BaId = existing.Id,
                        BarangId = p.BarangId,
                        Jumlah = p.Jumlah,
                        Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                        NoSerial = p.NoSerial,
                        Keterangan = p.Keterangan
                    }).ToList();

                if (photoFiles.Any() && !existingPhotoUrls.Any())
                {
                    var photoFolder = Path.Combine(Directory.GetCurrentDirectory(), "AppFiles", "photos");
                    Directory.CreateDirectory(photoFolder);
                    int idx2 = 1;
                    foreach (var file in photoFiles)
                    {
                        var ext = Path.GetExtension(file.Name);
                        var saveName = $"ba-{existing.Id}-photo-{idx2}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}{ext}";
                        await using var fs = File.Create(Path.Combine(photoFolder, saveName));
                        await file.OpenReadStream(5_000_000).CopyToAsync(fs);
                        DbContext.BuktiFoto.Add(new BuktiFoto
                        {
                            BaId = existing.Id,
                            BeritaAcara = existing,
                            FilePath =
$"files/photos/{saveName}"
                        });
                        idx2++;
                    }
                }

                await DbContext.SaveChangesAsync();
                Navigation.NavigateTo($"/editor/{existing.Id}");
            }
            else
            {
                var ba = new BeritaAcaraEntity
                {
                    Tanggal = DateOnly.FromDateTime(model.Tanggal),
                    Jenis = model.Jenis,
                    JenisCustom = model.Jenis == "Lainnya" ? model.JenisCustom : null,
                    Keterangan = model.Jenis == "Lainnya" ? model.Keterangan : null,
                    PjId = model.PjId,
                    PjNoTelp = model.PjNoTelp,
                    PengunaAlihDaya = model.PengunaAlihDaya,
                    MenyerahkanId = model.MenyerahkanId,
                    MengetahuiId = model.MengetahuiId,
                    TiketSscNo = model.TiketSscNo,
                    DasarAlokasi = model.DasarAlokasi,
                    TanggalKembali = model.TanggalKembali.HasValue ? DateOnly.FromDateTime(model.TanggalKembali.Value) : null,
                    Status = "Draft",
                    CreatedBy = _currentUserId,
                    CreatedAt = DateTime.Now,
                    Perangkat = model.Perangkat
                        .Where(p => p.BarangId > 0 && p.Jumlah > 0)
                        .Select(p => new PerangkatBA
                        {
                            BarangId = p.BarangId,
                            Jumlah = p.Jumlah,
                            Satuan = string.IsNullOrWhiteSpace(p.Satuan) ? "Pcs" : p.Satuan,
                            NoSerial = p.NoSerial,
                            Keterangan = p.Keterangan
                        }).ToList()
                };
                DbContext.Set<BeritaAcaraEntity>().Add(ba);
                await DbContext.SaveChangesAsync();
                Navigation.NavigateTo($"/editor/{ba.Id}");
            }
        }
        catch (Exception ex)
        {
            var inner = ex.InnerException != null ? $"\nInner: {ex.InnerException.Message}" : "";
            errorMessage = $"Gagal menyimpan Berita Acara: {ex.Message}{inner}";
            await JSRuntime.InvokeVoidAsync("appLoading.hide");
        }
        finally { isSaving = false; }
    }
    private void OpenMenyerahkanSearch()
    {
        menyerahkanSearchQuery = string.Empty;
        menyerahkanSearchResults = adminBAUsers.Take(8).ToList();
    }

    private void CloseMenyerahkanSearch() { }

    private void OnMenyerahkanSearchInput(ChangeEventArgs e)
    {
        menyerahkanSearchQuery = e.Value?.ToString() ?? string.Empty;
        menyerahkanSearchResults = string.IsNullOrWhiteSpace(menyerahkanSearchQuery)
            ? adminBAUsers.Take(8).ToList()
            : adminBAUsers.Where(u => u.Nama?.Contains(menyerahkanSearchQuery, StringComparison.OrdinalIgnoreCase) ??
false).Take(8).ToList();
    }

    private void SelectMenyerahkan(ApplicationUser u)
    {
        model.MenyerahkanId = u.Id;
        _ = AutoSaveAsync();
    }

    private void OnMengetahuiSearchFocus()
    {
        isMengetahuiActive = true;
        mengetahuiSearchQuery = string.Empty;
        mengetahuiSearchResults = reviewers.ToList();
        showMengetahuiSearch = true;
    }

    private void OnMengetahuiSearchBlur()
    {
        isMengetahuiActive = false;
        showMengetahuiSearch = false;
        mengetahuiSearchQuery = string.Empty;
        mengetahuiSearchResults.Clear();
    }

    private void OnMengetahuiSearchInput(ChangeEventArgs e)
    {
        mengetahuiSearchQuery = e.Value?.ToString() ?? string.Empty;
        showMengetahuiSearch = true;
        mengetahuiSearchResults = string.IsNullOrEmpty(mengetahuiSearchQuery)
            ? reviewers.ToList()
            : reviewers.Where(u => u.Nama?.StartsWith(mengetahuiSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false).ToList();
    }

    private void SelectMengetahui(ApplicationUser u)
    {
        model.MengetahuiId = u.Id;
        isMengetahuiActive = false;
        showMengetahuiSearch = false;
        mengetahuiSearchQuery = string.Empty;
        mengetahuiSearchResults.Clear();
        _ = AutoSaveAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveCts = null;
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

