    {
        menyerahkanSearchQuery = e.Value?.ToString() ?? string.Empty;
        menyerahkanSearchResults = string.IsNullOrWhiteSpace(menyerahkanSearchQuery)
            ? adminGudangUsers.Take(8).ToList()
            : adminGudangUsers.Where(u => u.Nama?.Contains(menyerahkanSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false).Take(8).ToList();
