@page "/notifikasi"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inbox — Sistem Berita Acara</PageTitle>

<!-- Tab bar -->
<div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
    <button @onclick="SetTabUnread"
            style="padding:8px 18px;border-radius:var(--radius-full);border:none;cursor:pointer;font-size:14px;font-weight:500;font-family:inherit;transition:all 0.15s;
                   @(activeTab == "unread" ? "background:var(--primary);color:white;" : "background:transparent;color:var(--text-secondary);")">
        Belum Dibaca @(UnreadCount > 0 ? $"({UnreadCount})" : "")
    </button>
    <button @onclick="SetTabAll"
            style="padding:8px 18px;border-radius:var(--radius-full);border:none;cursor:pointer;font-size:14px;font-weight:600;font-family:inherit;transition:all 0.15s;
                   @(activeTab == "all" ? "background:var(--primary);color:white;" : "background:transparent;color:var(--text-secondary);")">
        Semua
    </button>
    <div style="margin-left:auto;display:flex;align-items:center;gap:16px;">
        <button @onclick="MarkAllReadAsync"
                style="background:none;border:none;cursor:pointer;font-size:13px;font-weight:500;color:var(--primary);font-family:inherit;display:flex;align-items:center;gap:6px;padding:4px 0;">
            <i class="bi bi-check2-all"></i> Tandai sudah dibaca
        </button>
        <button class="btn btn-outline-danger btn-sm" @onclick="() => deleteAllConfirm = true"
                style="display:flex;align-items:center;gap:6px;">
            <i class="bi bi-trash3"></i> Hapus Semua
        </button>
    </div>
</div>

@if (deleteAllConfirm)
{
    <div class="modal-overlay" @onclick="() => deleteAllConfirm = false">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => deleteAllConfirm = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="text-align:center;padding:8px 0 20px;">
                <div style="width:56px;height:56px;border-radius:50%;background:var(--danger-light);color:var(--danger);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 16px;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Hapus Semua Notifikasi?</div>
                <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                    Seluruh notifikasi Anda akan dihapus permanen. Tindakan ini tidak bisa dibatalkan.
                </div>
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button class="btn btn-danger" @onclick="DeleteAllAsync">
                        <i class="bi bi-trash3"></i> Ya, Hapus Semua
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat notifikasi...</span></div>
}
else if (!DisplayedNotifications.Any())
{
    <div class="card" style="text-align:center;padding:60px;">
        <i class="bi bi-bell-slash" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;margin-bottom:8px;">
            @(activeTab == "unread" ? "Tidak ada notifikasi yang belum dibaca" : "Tidak ada notifikasi")
        </div>
        <div style="font-size:14px;color:var(--text-secondary);">Kamu sudah up-to-date!</div>
    </div>
}
else
{
    <div class="card" style="overflow:hidden;padding:0;">
        @foreach (var n in DisplayedNotifications)
        {
            <div class="notif-item @(n.IsRead ? "" : "unread")"
                 @onclick="async () => await MarkReadAndNavigate(n)">
                <div class="notif-icon @GetNotifIconClass(n.Tipe)">
                    <i class="bi @GetNotifIcon(n.Tipe)"></i>
                </div>
                <div class="notif-content">
                    <div class="notif-title">@GetNotifTitle(n.Tipe)</div>
                    <div class="notif-message">@n.Message</div>
                </div>
                <div class="notif-meta">
                    <div class="notif-time">@GetRelativeTime(n.CreatedAt)</div>
                    @if (!n.IsRead)
                    {
                        <div class="notif-dot"></div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Notification> notifications = new();
    private bool isLoading = true;
    private int currentUserId;
    private string activeTab = "unread";
    private bool deleteAllConfirm = false;

    private int UnreadCount => notifications.Count(n => !n.IsRead);

    private IEnumerable<Notification> DisplayedNotifications => activeTab == "unread"
        ? notifications.Where(n => !n.IsRead)
        : notifications;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        if (appUser is null) { Navigation.NavigateTo("/login", true); return; }
        currentUserId = appUser.Id;
        await LoadAsync();
    }

    private void SetTabAll() => activeTab = "all";
    private void SetTabUnread() => activeTab = "unread";

    private async Task LoadAsync()
    {
        // AsNoTracking() memastikan data selalu dibaca segar dari DB,
        // tidak terpengaruh oleh entity yang sudah di-cache di change tracker.
        notifications = await DbContext.Notification
            .AsNoTracking()
            .Where(n => n.UserId == currentUserId)
            .OrderByDescending(n => n.CreatedAt)
            .ToListAsync();
        isLoading = false;
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationService.MarkAllReadAsync(currentUserId);
        // Bersihkan change tracker agar LoadAsync membaca data segar dari DB,
        // bukan entity lama yang masih di-cache dengan IsRead = false.
        DbContext.ChangeTracker.Clear();
        await LoadAsync();
    }

    private async Task DeleteAllAsync()
    {
        deleteAllConfirm = false;
        isLoading = true;
        await DbContext.Notification.Where(n => n.UserId == currentUserId).ExecuteDeleteAsync();
        DbContext.ChangeTracker.Clear();
        await LoadAsync();
    }

    private async Task MarkReadAndNavigate(Notification n)
    {
        if (!n.IsRead)
        {
            // Gunakan ExecuteUpdateAsync karena entity di-load dengan AsNoTracking
            await DbContext.Notification
                .Where(x => x.Id == n.Id)
                .ExecuteUpdateAsync(s => s.SetProperty(x => x.IsRead, true));
            n.IsRead = true; // update in-memory agar UI langsung berubah
        }
        if (n.BaId.HasValue)
            Navigation.NavigateTo($"/berita-acara/{n.BaId.Value}?from=notifikasi");
    }

    private static string GetNotifIconClass(string tipe) => tipe switch
    {
        "BA_APPROVED" => "success",
        "BA_REJECTED" => "danger",
        "WAITING_APPROVAL" => "warning",
        "WAITING_PJ_SIGN" => "info",
        "PJ_SIGNED" => "info",
        "DUE_DATE_REMINDER" => "warning",
        _ => "info"
    };

    private static string GetNotifIcon(string tipe) => tipe switch
    {
        "BA_APPROVED" => "bi-check-circle-fill",
        "BA_REJECTED" => "bi-x-circle-fill",
        "WAITING_APPROVAL" => "bi-hourglass-split",
        "WAITING_PJ_SIGN" => "bi-pen",
        "PJ_SIGNED" => "bi-pen-fill",
        "DUE_DATE_REMINDER" => "bi-alarm-fill",
        _ => "bi-bell-fill"
    };

    private static string GetNotifTitle(string tipe) => tipe switch
    {
        "BA_APPROVED" => "Berita Acara Disetujui",
        "BA_REJECTED" => "Berita Acara Ditolak",
        "WAITING_APPROVAL" => "Menunggu Persetujuan",
        "WAITING_PJ_SIGN" => "Menunggu TTD PJ",
        "PJ_SIGNED" => "PJ Sudah Menandatangani",
        "DUE_DATE_REMINDER" => "Pengingat Jatuh Tempo",
        _ => "Notifikasi"
    };

    private static string GetRelativeTime(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 1) return "baru saja";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes} mnt lalu";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours} jam lalu";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} hari lalu";
        return dt.ToString("dd MMM yyyy");
    }
}
