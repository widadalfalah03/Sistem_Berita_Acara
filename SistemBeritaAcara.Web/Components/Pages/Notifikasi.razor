@page "/notifikasi"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inbox — Sistem Berita Acara</PageTitle>

<style>
    .notif-header-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        position: relative;
        z-index: 10;
        height: 48px;
    }
    .segmented-control {
        display: inline-flex;
        background: transparent;
        gap: 8px;
    }
    .segment-btn {
        padding: 8px 24px;
        font-size: 14px;
        font-weight: 500;
        border: none;
        background: transparent;
        color: var(--text-secondary);
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        z-index: 2;
    }
    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .tab-content-wrapper {
        animation: fadeSlideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .segment-btn.active {
        color: #ffffff;
        font-weight: 600;
        background: var(--primary);
        box-shadow: 0 4px 12px rgba(37,99,235,0.2);
    }
    .segment-btn:not(.active):hover {
        background: #f1f5f9;
        color: var(--text-primary);
    }
    
    .action-buttons {
        display: flex;
        gap: 10px;
        min-height: 38px;
        animation: fadeBtn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    @@keyframes fadeBtn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .action-btn-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        background: var(--surface);
        cursor: pointer;
        transition: all 0.2s;
        color: var(--text-secondary);
    }
    .action-btn-circle.btn-read { color: #10B981; }
    .action-btn-circle.btn-delete { color: var(--text-secondary); }
    .action-btn-circle.btn-read:hover {
        background: #ECFDF5;
        border-color: #10B981;
    }
    .action-btn-circle.btn-delete:hover {
        color: var(--danger);
        border-color: var(--danger);
        background: var(--danger-light);
    }
</style>

<div class="notif-header-wrapper">
    <div class="segmented-control">
        <button class="segment-btn @(activeTab == "unread" ? "active" : "")" @onclick="SetTabUnread">
            Belum dibaca @(UnreadCount > 0 ? $"({UnreadCount})" : "")
        </button>
        <button class="segment-btn @(activeTab == "all" ? "active" : "")" @onclick="SetTabAll">
            Semua
        </button>
    </div>
    
    <div class="action-buttons" @key="activeTab">
        @if (activeTab == "unread" && UnreadCount > 0)
        {
            <button class="action-btn-circle btn-read" @onclick="() => markAllReadConfirm = true" title="Tandai sudah dibaca">
                <i class="bi bi-check-lg" style="font-size:20px;"></i>
            </button>
        }
        @if (activeTab == "all")
        {
            <button class="action-btn-circle btn-read" @onclick="() => markAllReadConfirm = true" title="Tandai sudah dibaca">
                <i class="bi bi-check-lg" style="font-size:20px;"></i>
            </button>
            <button class="action-btn-circle btn-delete" @onclick="() => deleteAllConfirm = true" title="Hapus Semua">
                <i class="bi bi-trash3" style="font-size:17px;"></i>
            </button>
        }
    </div>
</div>

@if (deleteAllConfirm)
{
    <div class="modal-overlay" @onclick="() => deleteAllConfirm = false">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => deleteAllConfirm = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="text-align:center;padding:8px 0 20px;">
                <div style="width:56px;height:56px;border-radius:50%;background:var(--danger-light);color:var(--danger);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 16px;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Hapus Semua Notifikasi?</div>
                <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                    Seluruh notifikasi Anda akan dihapus permanen. Tindakan ini tidak bisa dibatalkan.
                </div>
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button class="btn btn-danger" @onclick="DeleteAllAsync">
                        <i class="bi bi-trash3"></i> Ya, Hapus Semua
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (markAllReadConfirm)
{
    <div class="modal-overlay" @onclick="() => markAllReadConfirm = false">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => markAllReadConfirm = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="text-align:center;padding:8px 0 20px;">
                <div style="width:56px;height:56px;border-radius:50%;background:#ECFDF5;color:#10B981;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 16px;">
                    <i class="bi bi-check2-all"></i>
                </div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Tandai Semua Sudah Dibaca?</div>
                <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                    Semua notifikasi akan ditandai sebagai sudah dibaca.
                </div>
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button class="btn btn-primary" style="background:#10B981;border-color:#10B981;" @onclick="MarkAllReadAsync">
                        <i class="bi bi-check-lg"></i> Ya, Tandai
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="tab-content-wrapper" @key="activeTab">
    @if (isLoading)
    {
        <div class="loading-spinner"><div class="spinner"></div></div>
}
else if (!DisplayedNotifications.Any())
{
    <div style="text-align:center;padding:60px;background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border);position:relative;z-index:1;">
        <i class="bi bi-bell-slash" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;margin-bottom:8px;">
            @(activeTab == "unread" ? "Tidak ada notifikasi yang belum dibaca" : "Tidak ada notifikasi")
        </div>
        <div style="font-size:14px;color:var(--text-secondary);">Kamu sudah up-to-date!</div>
    </div>
}
else
{
    <div class="notif-container-card" style="background:var(--surface);border-radius:var(--radius-lg);border:1px solid var(--border);padding:8px 0;margin-bottom:24px;position:relative;z-index:1;">
        @foreach (var n in DisplayedNotifications)
        {
            <div class="notif-item @(n.IsRead ? "" : "unread")"
                 @onclick="async () => await MarkReadAndNavigate(n)">
                <div class="notif-icon @GetNotifIconClass(n.Tipe)">
                    <i class="bi @GetNotifIcon(n.Tipe)"></i>
                </div>
                <div class="notif-content">
                    <div class="notif-title">@GetNotifTitle(n.Tipe)</div>
                    <div class="notif-message">@CleanMessage(n.Message)</div>
                </div>
                <div class="notif-meta">
                    <div class="notif-time">@GetRelativeTime(n.CreatedAt)</div>
                    @if (!n.IsRead)
                    {
                        <div class="notif-dot"></div>
                    }
                </div>
            </div>
        }
    </div>
    
    @if (TotalFilteredItems > 0)
    {
        <SistemBeritaAcara.Web.Components.Shared.Pagination
            CurrentPage="@currentPage"
            TotalItems="@TotalFilteredItems"
            PageSize="@pageSize"
            CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
    }
}
</div>

@code {
    private List<Notification> notifications = new();
    private bool isLoading = true;
    private int currentUserId;
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private string _activeTab = "unread";
    private string activeTab 
    {
        get => _activeTab;
        set 
        {
            _activeTab = value;
            currentPage = 1;
        }
    }
    private bool deleteAllConfirm = false;
    private bool markAllReadConfirm = false;
    private int currentPage = 1;
    private int pageSize = 10;

    private int UnreadCount => notifications.Count(n => !n.IsRead);

    private int TotalFilteredItems => activeTab == "unread"
        ? notifications.Count(n => !n.IsRead)
        : notifications.Count;

    private IEnumerable<Notification> DisplayedNotifications
    {
        get
        {
            var query = activeTab == "unread"
                ? notifications.Where(n => !n.IsRead)
                : notifications;
            
            return query.Skip((currentPage - 1) * pageSize).Take(pageSize);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        if (appUser is null) { Navigation.NavigateTo("/login", true); return; }
        currentUserId = appUser.Id;
        
        if (!string.IsNullOrEmpty(TabQuery))
        {
            _activeTab = TabQuery;
        }

        await LoadAsync();
    }

    private void SetTabAll() => activeTab = "all";
    private void SetTabUnread() => activeTab = "unread";

    private async Task LoadAsync()
    {
        // AsNoTracking() memastikan data selalu dibaca segar dari DB,
        // tidak terpengaruh oleh entity yang sudah di-cache di change tracker.
        notifications = await DbContext.Notification
            .AsNoTracking()
            .Where(n => n.UserId == currentUserId)
            .OrderByDescending(n => n.CreatedAt)
            .ToListAsync();
        isLoading = false;
    }

    private async Task MarkAllReadAsync()
    {
        markAllReadConfirm = false;
        isLoading = true;
        await NotificationService.MarkAllReadAsync(currentUserId);
        // Bersihkan change tracker agar LoadAsync membaca data segar dari DB,
        // bukan entity lama yang masih di-cache dengan IsRead = false.
        DbContext.ChangeTracker.Clear();
        await LoadAsync();
    }

    private async Task DeleteAllAsync()
    {
        deleteAllConfirm = false;
        isLoading = true;
        await DbContext.Notification.Where(n => n.UserId == currentUserId).ExecuteDeleteAsync();
        DbContext.ChangeTracker.Clear();
        await LoadAsync();
    }

    private async Task MarkReadAndNavigate(Notification n)
    {
        if (!n.IsRead)
        {
            // Gunakan ExecuteUpdateAsync karena entity di-load dengan AsNoTracking
            await DbContext.Notification
                .Where(x => x.Id == n.Id)
                .ExecuteUpdateAsync(s => s.SetProperty(x => x.IsRead, true));
            n.IsRead = true; // update in-memory agar UI langsung berubah
        }
        if (n.BaId.HasValue)
            Navigation.NavigateTo($"/berita-acara/{n.BaId.Value}?from=notifikasi_{activeTab}");
    }

    private static string GetNotifIconClass(string tipe) => tipe switch
    {
        "BA_APPROVED" => "success",
        "BA_REJECTED" => "danger",
        "WAITING_APPROVAL" => "warning",
        "WAITING_PJ_SIGN" => "info",
        "PJ_SIGNED" => "info",
        "DUE_TODAY" => "warning",
        "DUE_TOMORROW" => "info",
        "DUE_OVERDUE" => "danger",
        _ => "info"
    };

    private static string GetNotifIcon(string tipe) => tipe switch
    {
        "BA_APPROVED" => "bi-check-circle-fill",
        "BA_REJECTED" => "bi-x-circle-fill",
        "WAITING_APPROVAL" => "bi-hourglass-split",
        "WAITING_PJ_SIGN" => "bi-pen",
        "PJ_SIGNED" => "bi-pen-fill",
        "DUE_TODAY" => "bi-alarm-fill",
        "DUE_TOMORROW" => "bi-calendar-event-fill",
        "DUE_OVERDUE" => "bi-exclamation-octagon-fill",
        _ => "bi-bell-fill"
    };

    private static string GetNotifTitle(string tipe) => tipe switch
    {
        "BA_APPROVED" => "Berita Acara Disetujui",
        "BA_REJECTED" => "Berita Acara Ditolak",
        "WAITING_APPROVAL" => "Menunggu Persetujuan",
        "WAITING_PJ_SIGN" => "Menunggu Tanda Tangan PJ",
        "PJ_SIGNED" => "PJ Sudah Menandatangani",
        "DUE_TODAY" => "Jatuh Tempo Hari Ini",
        "DUE_TOMORROW" => "Jatuh Tempo Besok",
        "DUE_OVERDUE" => "Terlambat Pengembalian",
        _ => "Notifikasi"
    };

    private static string GetRelativeTime(DateTime dt)
    {
        if (dt.Date == DateTime.Today)
        {
            return dt.ToString("HH.mm");
        }
        else
        {
            return dt.ToString("dd MMM yyyy, HH.mm");
        }
    }

    private string CleanMessage(string msg)
    {
        if (string.IsNullOrEmpty(msg)) return msg;
        msg = msg.Replace("ℹ️ ", "").Replace("ℹ️", "");
        msg = msg.Replace("⏰ ", "").Replace("⏰", "");
        msg = msg.Replace("⚠️ ", "").Replace("⚠️", "");
        msg = msg.Replace("✅ ", "").Replace("✅", "");
        msg = msg.Replace("❌ ", "").Replace("❌", "");
        msg = msg.Replace("🚨 ", "").Replace("🚨", "");
        msg = System.Text.RegularExpressions.Regex.Replace(msg, @"\bDraft\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        msg = System.Text.RegularExpressions.Regex.Replace(msg, @"\bBA\b", "Berita Acara");
        msg = msg.Replace("Peminjaman Berita Acara", "Berita Acara Peminjaman");
        
        // Capitalize the first letter if the message starts with a lowercase letter after removing Draft
        if (msg.Length > 0)
        {
            msg = char.ToUpper(msg[0]) + msg.Substring(1);
        }
        
        return msg;
    }
}
