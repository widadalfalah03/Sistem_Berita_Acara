@page "/notifikasi"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Inbox — Sistem Berita Acara</PageTitle>

<div class="gmail-inbox" style="flex:1;display:flex;flex-direction:column;">
    <!-- Gmail-style toolbar -->
    <div class="gmail-toolbar">
        <div class="gmail-tabs">
            <button class="gmail-tab @(activeTab == "all" ? "active" : "")" @onclick="SetTabAll">
                <i class="bi bi-inbox"></i>
                Semua
                @if (notifications.Any())
                {
                    <span class="gmail-tab-count">@notifications.Count</span>
                }
            </button>
            <button class="gmail-tab @(activeTab == "unread" ? "active" : "")" @onclick="SetTabUnread">
                <i class="bi bi-circle-fill" style="font-size:8px;"></i>
                Belum Dibaca
                @if (notifications.Any(n => !n.IsRead))
                {
                    <span class="gmail-tab-count unread">@notifications.Count(n => !n.IsRead)</span>
                }
            </button>
        </div>
        <button class="gmail-mark-all" @onclick="MarkAllReadAsync">
            <i class="bi bi-check2-all"></i> Tandai semua dibaca
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-spinner"><div class="spinner"></div><span>Memuat notifikasi...</span></div>
    }
    else if (!DisplayedNotifications.Any())
    {
        <div class="gmail-empty">
            <div class="gmail-empty-icon">
                <i class="bi bi-inbox"></i>
            </div>
            <div class="gmail-empty-title">
                @(activeTab == "unread" ? "Tidak ada notifikasi yang belum dibaca" : "Kotak masuk kosong")
            </div>
            <div class="gmail-empty-sub">Semua notifikasi telah dibaca.</div>
        </div>
    }
    else
    {
        @foreach (var group in GroupedNotifications)
        {
            <div class="gmail-date-group">@group.Key</div>
            @foreach (var n in group)
            {
                <div class="gmail-row @(n.IsRead ? "read" : "unread")"
                     @onclick="async () => await MarkReadAndNavigate(n)">
                    <!-- Icon -->
                    <div class="gmail-row-icon @GetNotifIconClass(n.Tipe)">
                        <i class="bi @GetNotifIcon(n.Tipe)"></i>
                    </div>
                    <!-- Content -->
                    <div class="gmail-row-body">
                        <span class="gmail-row-title">@GetNotifTitle(n.Tipe)</span>
                        <span class="gmail-row-sep">–</span>
                        <span class="gmail-row-preview">@n.Message</span>
                    </div>
                    <!-- Time -->
                    <div class="gmail-row-time">
                        @n.CreatedAt.ToString("HH:mm")
                        <div class="gmail-row-date">@n.CreatedAt.ToString("dd MMM")</div>
                    </div>
                    @if (!n.IsRead)
                    {
                        <div class="gmail-unread-dot"></div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private List<Notification> notifications = new();
    private bool isLoading = true;
    private int currentUserId;
    private string activeTab = "all";

    private IEnumerable<Notification> DisplayedNotifications => activeTab == "unread"
        ? notifications.Where(n => !n.IsRead)
        : notifications;

    private IEnumerable<IGrouping<string, Notification>> GroupedNotifications =>
        DisplayedNotifications
            .GroupBy(n => GetDateGroup(n.CreatedAt))
            .OrderBy(g => GetDateGroupOrder(g.Key));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        if (appUser is null) { Navigation.NavigateTo("/login", true); return; }
        currentUserId = appUser.Id;
        await LoadAsync();
    }

    private void SetTabAll() => activeTab = "all";
    private void SetTabUnread() => activeTab = "unread";

    private async Task LoadAsync()
    {
        notifications = await DbContext.Notification
            .Where(n => n.UserId == currentUserId)
            .OrderByDescending(n => n.CreatedAt)
            .ToListAsync();
        isLoading = false;
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationService.MarkAllReadAsync(currentUserId);
        await LoadAsync();
    }

    private async Task MarkReadAndNavigate(Notification n)
    {
        if (!n.IsRead)
        {
            n.IsRead = true;
            await DbContext.SaveChangesAsync();
        }
        if (n.BaId.HasValue)
            Navigation.NavigateTo($"/berita-acara/{n.BaId.Value}");
    }

    private static string GetDateGroup(DateTime dt)
    {
        var today = DateTime.Today;
        if (dt.Date == today) return "Hari ini";
        if (dt.Date == today.AddDays(-1)) return "Kemarin";
        if ((today - dt.Date).TotalDays < 7) return "Minggu ini";
        if (dt.Month == today.Month && dt.Year == today.Year) return "Bulan ini";
        return dt.ToString("MMMM yyyy", new System.Globalization.CultureInfo("id-ID"));
    }

    private static int GetDateGroupOrder(string group) => group switch
    {
        "Hari ini" => 0,
        "Kemarin" => 1,
        "Minggu ini" => 2,
        "Bulan ini" => 3,
        _ => 4
    };

    private static string GetNotifIconClass(string tipe) => tipe switch
    {
        "BA_APPROVED" => "success",
        "BA_REJECTED" => "danger",
        "WAITING_APPROVAL" => "warning",
        "WAITING_PJ_SIGN" => "info",
        "PJ_SIGNED" => "info",
        "DUE_DATE_REMINDER" => "warning",
        _ => "info"
    };

    private static string GetNotifIcon(string tipe) => tipe switch
    {
        "BA_APPROVED" => "bi-check-circle-fill",
        "BA_REJECTED" => "bi-x-circle-fill",
        "WAITING_APPROVAL" => "bi-hourglass-split",
        "WAITING_PJ_SIGN" => "bi-pen",
        "PJ_SIGNED" => "bi-pen-fill",
        "DUE_DATE_REMINDER" => "bi-alarm-fill",
        _ => "bi-bell-fill"
    };

    private static string GetNotifTitle(string tipe) => tipe switch
    {
        "BA_APPROVED" => "Berita Acara Disetujui",
        "BA_REJECTED" => "Berita Acara Ditolak",
        "WAITING_APPROVAL" => "Menunggu Persetujuan",
        "WAITING_PJ_SIGN" => "Menunggu TTD Penanggung Jawab",
        "PJ_SIGNED" => "Penanggung Jawab Sudah Menandatangani",
        "DUE_DATE_REMINDER" => "Pengingat Jatuh Tempo",
        _ => "Notifikasi"
    };
}
