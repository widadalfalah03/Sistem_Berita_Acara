@page "/pj/sign/{Token}"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject IEmailService EmailService
@inject INotificationService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject SistemBeritaAcara.Web.Services.BaUpdateService BaUpdateService
@inject IBACounterService BACounterService
@inject IExcelService ExcelService
@using Microsoft.AspNetCore.Identity
@inject UserManager<SistemBeritaAcara.Core.Entities.ApplicationUser> UserManager
@layout EmptyLayout
@rendermode InteractiveServer

<PageTitle>Tanda Tangan Berita Acara — Pertamina Patra Niaga</PageTitle>

<style>
    .pj-layout { display:grid; grid-template-columns:1fr 420px; min-height:100vh; }
    .pj-preview { background:#E8EAF0; position:sticky; top:0; height:100vh; overflow:hidden; }
    .pj-preview iframe { width:100%; height:100%; border:none; display:block; }
    .pj-form-wrap { overflow-y:auto; padding:32px; background:var(--bg); min-height:100vh; display:flex; flex-direction:column; justify-content:center; }
    .pj-header { text-align:center; margin-bottom:32px; }
    .pj-header-title { font-size:24px; font-weight:800; color:var(--primary); }
    .tab-bar { display:flex; border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; margin-bottom:16px; }
    .tab-btn { flex:1; padding:10px 8px; font-size:13px; font-weight:600; border:none; background:none; cursor:pointer; color:var(--text-secondary); transition:all .15s; }
    .tab-btn.active { background:var(--primary); color:white; }
    .canvas-wrap { border:2px dashed var(--border); border-radius:var(--radius); background:white; overflow:hidden; margin-bottom:8px; }
    .canvas-wrap canvas { width:100%; height:160px; display:block; touch-action:none; cursor:crosshair; }
    .success-box { text-align:center; padding:40px 24px; }
    .success-icon { width:72px; height:72px; border-radius:50%; background:#F0FDF4; color:#22C55E; display:flex; align-items:center; justify-content:center; font-size:32px; margin:0 auto 20px; }
    .error-box { background:var(--danger-light); border:1px solid var(--danger); border-radius:var(--radius); padding:12px 16px; margin-bottom:16px; color:var(--danger); font-size:14px; }
    @@media (max-width: 900px) {
        .pj-layout { display: flex; flex-direction: column; height: 100vh; overflow-y: auto; padding-bottom: 40px; }
        .pj-preview { order: 2; height: 60vh; position: relative; border-bottom: none; border-top: 1px solid var(--border); overflow:hidden; flex-shrink: 0; }
        .pj-form-wrap { order: 1; min-height: auto; padding: 20px 20px 32px 20px; flex: none; }
    }
</style>

@if (isLoading)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;flex-direction:column;gap:16px;background:var(--bg);">
        <div class="spinner" style="width:40px;height:40px;border-width:4px;"></div>
    </div>
}
else if (!isValidToken)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:var(--bg);">
        <div style="text-align:center;max-width:400px;padding:40px;">
            <div style="width:72px;height:72px;border-radius:50%;background:var(--danger-light);color:var(--danger);display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 20px;">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div style="font-size:22px;font-weight:800;margin-bottom:12px;">Link Tidak Valid</div>
            <div style="font-size:14px;color:var(--text-secondary);line-height:1.6;">
                Link ini sudah kadaluarsa atau telah digunakan sebelumnya.
            </div>
        </div>
    </div>
}
else if (alreadySigned)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:var(--bg);">
        <div class="success-box" style="max-width:400px;">
            <div class="success-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div style="font-size:22px;font-weight:800;margin-bottom:12px;">Tanda Tangan Berhasil!</div>
            <div style="font-size:14px;color:var(--text-secondary);line-height:1.6;">
                Berita Acara <strong>@ba!.NomorSurat</strong> telah berhasil Anda tandatangani.
            </div>
            <div style="margin-top:24px;font-size:12px;color:var(--text-muted);">
                Anda dapat menutup halaman ini.
            </div>
        </div>
    </div>
}
else
{
    <div class="pj-layout">
        <div class="pj-preview">
            @if (!string.IsNullOrEmpty(pdfPath))
            {
                <iframe class="hide-on-mobile" @key="cacheBreaker" src="/@pdfPath?v=@cacheBreaker#toolbar=1&navpanes=0" title="Pratinjau Berita Acara"></iframe>
                <div id="pdf-render-container-pj" class="show-on-mobile" style="width:100%;height:100%;overflow-y:auto;"></div>
            }
            else
            {
                <div style="display:flex;align-items:center;justify-content:center;height:100%;flex-direction:column;gap:12px;color:var(--text-muted);">
                    <i class="bi bi-file-earmark-pdf" style="font-size:48px;"></i>
                    <div>Dokumen belum tersedia</div>
                </div>
            }
        </div>

        <div class="pj-form-wrap">
            <div class="pj-header">
                <img src="/images/simba_logo_final.png" style="height:auto;max-height:240px;width:auto;max-width:100%;object-fit:contain;margin-top:-24px;margin-bottom:-8px;" alt="SIMBA" />
                <div class="pj-header-title">Tanda Tangan Berita Acara</div>
            </div>



            @if (!string.IsNullOrEmpty(actionMessage))
            {
                <div class="error-box"><i class="bi bi-exclamation-circle-fill"></i> @actionMessage</div>
            }

            <div style="display:flex;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:14px;">
                <button @onclick='() => SwitchPjMode("draw")'
                        style="flex:1;padding:9px 10px;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:all .15s;background:@(pjTtdMode=="draw"?"var(--primary)":"transparent");color:@(pjTtdMode=="draw"?"white":"var(--text-secondary)");">
                    Gambar
                </button>
                <button @onclick='() => SwitchPjMode("upload")'
                        style="flex:1;padding:9px 10px;font-size:13px;font-weight:600;border:none;border-left:1px solid var(--border);cursor:pointer;transition:all .15s;background:@(pjTtdMode=="upload"?"var(--primary)":"transparent");color:@(pjTtdMode=="upload"?"white":"var(--text-secondary)");">
                    Upload TTD
                </button>
            </div>

            <div style="display:@(pjTtdMode == "draw" ? "block" : "none")">
                <div style="font-size:13px;color:var(--text-secondary);margin-bottom:8px;">Gambar tanda tangan Anda di kotak ini:</div>
                <div class="canvas-wrap">
                    <canvas id="pjSignCanvas" width="800" height="200"
                            style="height:160px;">
                    </canvas>
                </div>
                <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
                    <button type="button" class="btn btn-outline btn-sm" @onclick="ClearCanvasAsync">
                        Bersihkan
                    </button>
                </div>
            </div>

            <div style="display:@(pjTtdMode == "upload" ? "block" : "none");margin-bottom:16px;">
                <div id="pj-ul-dropzone" style="position:relative;border:2px dashed var(--border);border-radius:var(--radius);background:var(--bg);padding:18px;text-align:center;transition:border-color .2s,background .2s,transform .2s;">
                    <label for="pj-ul-input" style="position:absolute;inset:0;cursor:pointer;"></label>
                    <i class="bi bi-cloud-arrow-up" style="font-size:32px;color:var(--primary);display:block;margin-bottom:6px;"></i>
                    <div style="font-weight:600;font-size:13px;margin-bottom:2px;">Klik atau seret file ke sini</div>
                    <div style="font-size:11px;color:var(--text-muted);">JPG, PNG, JPEG · Maks. 5MB</div>
                    <input type="file" id="pj-ul-input" accept="image/*" style="display:none"
                           onchange="ttdUpload.onFileChange('pj-ul-input', 'pj-ul-canvas', 'pj-ul-wrap')" />
                </div>

                <div id="pj-ul-wrap" style="display:none;margin-top:12px;">
                    <div style="background:white;border-radius:var(--radius);border:2px solid var(--border);padding:6px;min-height:60px;display:flex;align-items:center;justify-content:center;">
                        <canvas id="pj-ul-canvas" style="display:block;max-width:100%;height:auto;"></canvas>
                    </div>
                </div>
            </div>

            <button class="btn btn-primary" style="width:100%;padding:14px;" @onclick="SubmitSignatureAsync" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner" style="width:18px;height:18px;border-width:2px;border-color:white;border-top-color:transparent;display:inline-block;margin-right:10px;"></span>
                }
                else
                {
                    <span>Kirim Tanda Tangan</span>
                }
            </button>

            <div style="text-align:center;margin-top:16px;font-size:12px;color:var(--text-muted);">
                Dengan mengirim tanda tangan, Anda menyatakan menyetujui isi Berita Acara ini.
            </div>
        </div>
    </div>
}

<script>
    window.pjCanvas = {
        _drawing: false,
        _abortCtrl: null,

        init: function (clearCanvas) {
            var c = document.getElementById('pjSignCanvas');
            if (!c) return;

            // Abort & remove all previous event listeners cleanly
            if (this._abortCtrl) this._abortCtrl.abort();
            this._abortCtrl = new AbortController();
            var signal = this._abortCtrl.signal;

            // Unified DPR-based sizing — identical to setupCanvas & ttdCanvas
            var dpr = window.devicePixelRatio || 1;
            var rect = c.getBoundingClientRect();
            c.width  = Math.round((rect.width  || 400) * dpr);
            c.height = Math.round((rect.height || 160) * dpr);

            // Reset context — only clear canvas when explicitly requested
            // (on Blazor re-renders we re-attach listeners only, preserving existing drawing)
            var ctx = c.getContext('2d');
            ctx.scale(dpr, dpr);
            if (clearCanvas !== false) ctx.clearRect(0, 0, c.width / dpr, c.height / dpr);
            ctx.strokeStyle = '#0f172a';
            ctx.lineWidth = 2;  // CSS pixel units — identical visual on all canvases
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            this._drawing = false;

            var self = this;
            self._prevX = 0; self._prevY = 0;

            // Coordinates in CSS pixel space (ctx.scale handles DPR conversion)
            var getPos = function (e) {
                var r = c.getBoundingClientRect();
                var src = e.touches ? e.touches[0] : e;
                return { x: src.clientX - r.left, y: src.clientY - r.top };
            };

            var startDraw = function (e) {
                self._drawing = true;
                var p = getPos(e);
                self._prevX = p.x;
                self._prevY = p.y;
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
            };

            var moveDraw = function (e) {
                if (!self._drawing) return;
                var p = getPos(e);
                // Quadratic Bezier midpoint smoothing — eliminates jagged corners
                var midX = (self._prevX + p.x) / 2;
                var midY = (self._prevY + p.y) / 2;
                ctx.quadraticCurveTo(self._prevX, self._prevY, midX, midY);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(midX, midY);
                self._prevX = p.x;
                self._prevY = p.y;
            };

            // Mouse events — pure JS, no Blazor round-trip
            c.addEventListener('mousedown', startDraw, { signal: signal });
            c.addEventListener('mousemove', moveDraw,  { signal: signal });
            c.addEventListener('mouseup',    function () { self._drawing = false; }, { signal: signal });
            c.addEventListener('mouseleave', function () { self._drawing = false; }, { signal: signal });

            // Touch events
            c.addEventListener('touchstart', function (e) { e.preventDefault(); startDraw(e); }, { passive: false, signal: signal });
            c.addEventListener('touchmove',  function (e) { e.preventDefault(); moveDraw(e);  }, { passive: false, signal: signal });
            c.addEventListener('touchend',   function (e) { e.preventDefault(); self._drawing = false; }, { passive: false, signal: signal });
        },

        clear: function () {
            var c = document.getElementById('pjSignCanvas');
            if (!c) return;
            c.getContext('2d').clearRect(0, 0, c.width, c.height);
        },

        isEmpty: function () {
            var c = document.getElementById('pjSignCanvas');
            if (!c) return true;
            var d = c.getContext('2d').getImageData(0, 0, c.width, c.height).data;
            for (var i = 3; i < d.length; i += 4) { if (d[i] > 0) return false; }
            return true;
        },

        getDataUrl: function () {
            var c = document.getElementById('pjSignCanvas');
            if (!c) return null;
            var ctx = c.getContext('2d');
            var data = ctx.getImageData(0, 0, c.width, c.height).data;
            var minX = c.width, maxX = 0, minY = c.height, maxY = 0;
            for (var y = 0; y < c.height; y++) {
                for (var x = 0; x < c.width; x++) {
                    if (data[(y * c.width + x) * 4 + 3] > 10) {
                        if (x < minX) minX = x;
                        if (x > maxX) maxX = x;
                        if (y < minY) minY = y;
                        if (y > maxY) maxY = y;
                    }
                }
            }
            if (maxX <= minX || maxY <= minY) return c.toDataURL('image/png');
            var pad = 4;
            minX = Math.max(0, minX - pad);
            minY = Math.max(0, minY - pad);
            maxX = Math.min(c.width - 1, maxX + pad);
            maxY = Math.min(c.height - 1, maxY + pad);
            var w = maxX - minX + 1;
            var h = maxY - minY + 1;
            var tmp = document.createElement('canvas');
            tmp.width = w; tmp.height = h;
            tmp.getContext('2d').drawImage(c, minX, minY, w, h, 0, 0, w, h);
            return tmp.toDataURL('image/png');
        }
    };
</script>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private BeritaAcaraEntity? ba;
    private SistemBeritaAcara.Core.Entities.ApplicationUser? reviewerUser;
    private ApprovalToken? approvalToken;
    private bool isLoading = true;
    private bool isValidToken;
    private bool alreadySigned;
    private bool isSubmitting;
    private string actionMessage = string.Empty;
    private string? pdfPath;
    private long cacheBreaker;

    private string pjTtdMode = "draw";
    private bool _needsClearOnInit = true;  // canvas should be cleared on next init

    protected override async Task OnInitializedAsync()
    {
        approvalToken = await DbContext.ApprovalToken
            .Include(t => t.BeritaAcara).ThenInclude(b => b.Pj)
            .Include(t => t.BeritaAcara).ThenInclude(b => b.Mengetahui)
            .Include(t => t.BeritaAcara).ThenInclude(b => b.Perangkat).ThenInclude(p => p.Barang)
            .FirstOrDefaultAsync(t => t.Token == Token && t.UsedAt == null && t.ExpiresAt > DateTime.Now);

        if (approvalToken is null) { isValidToken = false; isLoading = false; return; }

        ba = approvalToken.BeritaAcara;
        isValidToken = ba is not null && ba.Status == "WaitingPJSign";
        reviewerUser = ba?.Mengetahui;

        if (ba != null)
        {
            string targetDocx = !string.IsNullOrEmpty(ba.DocxFinalPath) ? ba.DocxFinalPath : ba.DocxPath;
            if (!string.IsNullOrEmpty(targetDocx))
            {
                var pdfRelative = targetDocx.Replace(".docx", ".pdf");
                var pdfPhysical = Path.Combine(Directory.GetCurrentDirectory(), "AppFiles",
                    pdfRelative.Replace("files/", "").Replace("/", Path.DirectorySeparatorChar.ToString()));
                if (File.Exists(pdfPhysical))
                {
                    pdfPath = pdfRelative;
                    cacheBreaker = DateTime.Now.Ticks;
                }
            }
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isValidToken && !alreadySigned && pjTtdMode == "draw")
        {
            // Always re-init on every render — Blazor may replace the canvas DOM element
            // on re-renders (auth revalidation, SignalR reconnect, etc.), killing our listeners.
            // _needsClearOnInit controls whether to wipe canvas content or just re-attach.
            bool clear = _needsClearOnInit;
            _needsClearOnInit = false;
            try { await JS.InvokeVoidAsync("pjCanvas.init", clear); } catch { }
        }

        if (firstRender && isValidToken && !alreadySigned && !string.IsNullOrEmpty(pdfPath))
        {
            var pdfUrl = $"/{pdfPath}?v={cacheBreaker}";
            try
            {
                await JS.InvokeVoidAsync("pdfViewer.renderPdf", "pdf-render-container-pj", pdfUrl);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine("Error invoking pdfViewer: " + ex.Message);
            }
        }
    }

    private async Task SwitchPjMode(string mode)
    {
        pjTtdMode = mode;
        if (mode == "draw")
        {
            // Mark that next init should clear canvas (fresh start after tab switch)
            _needsClearOnInit = true;
            // StateHasChanged triggers OnAfterRenderAsync which calls init
        }
        else
        {
            try { await JS.InvokeVoidAsync("ttdUpload.reset"); } catch { }
            await Task.Delay(60);
            try { await JS.InvokeVoidAsync("ttdUpload.initDragDrop", "pj-ul-dropzone", "pj-ul-input", "pj-ul-canvas", "pj-ul-wrap"); } catch { }
        }
    }

    private async Task ClearCanvasAsync()
        => await JS.InvokeVoidAsync("pjCanvas.clear");

    private async Task SubmitSignatureAsync()
    {
        isSubmitting = true;
        actionMessage = string.Empty;
        try
        {
            var folder = Path.Combine(Directory.GetCurrentDirectory(), "AppFiles", "signatures");
            Directory.CreateDirectory(folder);
            string fpath;
            string fname;

            string? dataUrl;
            if (pjTtdMode == "upload")
            {
                bool hasImg = await JS.InvokeAsync<bool>("ttdUpload.hasImage");
                if (!hasImg)
                {
                    actionMessage = "Silakan upload TTD terlebih dahulu.";
                    isSubmitting = false;
                    return;
                }
                dataUrl = await JS.InvokeAsync<string>("ttdUpload.getDataUrl");
            }
            else
            {
                bool isEmpty = await JS.InvokeAsync<bool>("pjCanvas.isEmpty");
                if (isEmpty)
                {
                    actionMessage = "Silakan gambar tanda tangan Anda terlebih dahulu.";
                    isSubmitting = false;
                    return;
                }
                dataUrl = await JS.InvokeAsync<string>("pjCanvas.getDataUrl");
            }
            if (string.IsNullOrEmpty(dataUrl)) { actionMessage = "Gagal membaca data tanda tangan."; isSubmitting = false; return; }
            var bytes = Convert.FromBase64String(dataUrl.Split(',')[1]);

            // Validate image format
            bool isPng = bytes.Length >= 4 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47;
            bool isJpeg = bytes.Length >= 3 && bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF;
            if (!isPng && !isJpeg)
            {
                actionMessage = "Gagal: File yang diupload bukan gambar yang valid (PNG/JPEG).";
                isSubmitting = false;
                return;
            }

            fname = $"ba-{ba!.Id}-pj.png";
            fpath = Path.Combine(folder, fname);
            await File.WriteAllBytesAsync(fpath, bytes);

            
            await DocumentService.EmbedTtdPjAsync(ba.Id, fpath);
            try { File.Delete(fpath); } catch { }

            
            if (string.IsNullOrEmpty(ba!.NomorSurat))
            {
                var next = await BACounterService.GetNextNomorSuratAsync(ba.Tanggal, ba.Jenis);
                ba.CounterValue = next.counterValue;
                ba.NomorSurat = next.nomorSurat;
            }

            
            var docxPhysicalPath = string.IsNullOrEmpty(ba!.DocxPath)
                ? null
                : Path.Combine(Directory.GetCurrentDirectory(), "AppFiles",
                      ba.DocxPath.TrimStart('/').Replace("files/", "").Replace('/', Path.DirectorySeparatorChar));
            if (docxPhysicalPath != null && File.Exists(docxPhysicalPath))
            {
                await DocumentService.PatchNomorSuratAsync(ba.Id, ba.NomorSurat!);
            }
            else
            {
                ba.DocxPath = await DocumentService.GenerateDocxAsync(ba);
            }

            
            var rowsAffected = await DbContext.ApprovalToken
                .Where(t => t.Id == approvalToken!.Id && t.UsedAt == null)
                .ExecuteUpdateAsync(s => s.SetProperty(t => t.UsedAt, DateTime.Now));
            
            if (rowsAffected == 0)
            {
                actionMessage = "Token tanda tangan sudah digunakan atau tidak valid (kemungkinan double-click).";
                isSubmitting = false;
                return;
            }

            
            await using var tx = await DbContext.Database.BeginTransactionAsync();
            ba.Status = "Approved";
            ba.PjSignedAt = DateTime.Now;
            ba.ApprovedAt = DateTime.Now;
            ba.ExcelExported = false;
            
            await DbContext.SaveChangesAsync();

            
            await tx.CommitAsync();

            
            await NotificationService.SendAsync(ba.CreatedBy, "BA_APPROVED", $"Berita Acara {ba.Jenis} {ba.NomorSurat} telah selesai dan disetujui sepenuhnya.", ba.Id);
            
            var creatorUser = await UserManager.FindByIdAsync(ba.CreatedBy.ToString());
            var baseUrl = (Configuration["App:BaseUrl"] ?? Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');
            var barangList = ba.Perangkat
                .Select(p => {
                    string nama = p.Barang?.NamaBarang ?? "Perangkat";
                    string detail = $"{p.Jumlah} {p.Satuan}";
                    if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                    if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                    return $"{nama} — {detail}";
                }).ToList();
                
            if (!string.IsNullOrEmpty(creatorUser?.Email))
                await EmailService.SendApprovalResultAsync(creatorUser.Email, creatorUser.Nama ?? creatorUser.Email, ba.Jenis, true, ba.Id, baseUrl, isForPj: false, nomorSurat: ba.NomorSurat, barangList: barangList);
            
            
            if (!string.IsNullOrEmpty(ba.Pj?.Email))
                await EmailService.SendApprovalResultAsync(ba.Pj.Email, ba.Pj.Nama, ba.Jenis, true, ba.Id, baseUrl, isForPj: true, nomorSurat: ba.NomorSurat, barangList: barangList);

            
            if (!string.IsNullOrEmpty(ba.Mengetahui?.Email))
                await EmailService.SendApprovalResultAsync(ba.Mengetahui.Email, ba.Mengetahui.Nama, ba.Jenis, true, ba.Id, baseUrl, isForPj: true, nomorSurat: ba.NomorSurat, barangList: barangList);

            await BaUpdateService.NotifyBaDetailUpdated(ba.Id); 

            alreadySigned = true;
        }
        catch (Exception ex) { actionMessage = $"Gagal: {ex.Message}"; }
        finally { isSubmitting = false; }
    }
}
