@page "/edit-pengguna/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminIT")]

<PageTitle>Edit Pengguna — Sistem Berita Acara</PageTitle>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else if (appUser is null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">Pengguna tidak ditemukan.</div>
}
else
{
    <NavLink class="breadcrumb-back" href="/dashboard" style="margin-bottom: 24px;">
        <i class="bi bi-arrow-left"></i> Kembali
    </NavLink>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div style="background:#F0FDF4;border:1px solid #22C55E;border-radius:var(--radius);padding:14px 20px;margin-bottom:24px;color:#16A34A;display:flex;align-items:center;gap:10px;">
            <i class="bi bi-check-circle-fill"></i> @successMsg
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="login-error" style="margin-bottom:24px;">@errorMsg</div>
    }

    <div class="edit-layout">
        <div>
            <div class="form-section" style="margin-bottom:24px;">
                <div style="display:flex;align-items:center;gap:24px;margin-bottom:24px;padding:20px;background:var(--bg);border-radius:var(--radius);flex-wrap:wrap;">
                    <div style="position:relative;">
                        <div style="width:80px;height:80px;border-radius:50%;overflow:hidden;background:var(--primary);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:3px solid var(--primary-light);">
                            @if (!string.IsNullOrEmpty(appUser.ProfilePicPath))
                            {
                                <img src="/@appUser.ProfilePicPath" alt="Foto Profil" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <span style="font-size:28px;font-weight:800;color:white;">@GetInitials(appUser.Nama)</span>
                            }
                        </div>
                    </div>
                    <div>
                        <div style="font-size:20px;font-weight:800;color:var(--text-primary);">@appUser.Nama</div>
                        <div style="margin-top:4px;display:flex;align-items:center;gap:6px;">
                            <span class="pill @GetRolePill(appUser.Role)" style="font-size:12px;">@GetRoleLabel(appUser.Role)</span>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nama Lengkap</label>
                        <input class="form-control readonly" readonly value="@appUser.Nama" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input class="form-control readonly" readonly value="@(appUser.Email ?? "-")" />
                    </div>
                </div>

                @if (pegawai is not null)
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">No. Pekerja</label>
                            <input class="form-control readonly" readonly value="@pegawai.NoPekerja" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Jabatan</label>
                            <input class="form-control readonly" readonly value="@(pegawai.Jabatan ?? "-")" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Fungsi/Direktorat</label>
                            <input class="form-control readonly" readonly value="@(pegawai.FungsiDirektorat ?? "-")" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cost Center</label>
                            <input class="form-control readonly" readonly value="@(pegawai.CostCenter ?? "-")" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="side-cards">

            <div class="side-card">
                <h4>Status Akun</h4>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                    <span class="status-dot @(appUser.IsDeleted ? "inactive" : "active")">
                        @(appUser.IsDeleted ? "Nonaktif" : "Aktif")
                    </span>
                    @if (appUser.Role == "AdminIT")
                    {
                        <div class="toggle-switch active" style="cursor:not-allowed;opacity:0.5;"></div>
                    }
                    else
                    {
                        <div class="toggle-switch @(appUser.IsDeleted ? "" : "active")"
                             @onclick="ToggleStatusAsync"
                             style="cursor:@(appUser.IsDeleted && pegawai is not null && !pegawai.IsAktif ? "not-allowed" : "pointer"); opacity:@(appUser.IsDeleted && pegawai is not null && !pegawai.IsAktif ? "0.5" : "1");"></div>
                    }
                </div>
                <div style="font-size:13px;color:var(--text-muted);">
                    @if (appUser.Role == "AdminIT")
                    {
                        <span><i class="bi bi-shield-lock-fill" style="color:#3b82f6;margin-right:4px;"></i>Akun Admin IT tidak dapat dinonaktifkan.</span>
                    }
                    else
                    {
                        @(appUser.IsDeleted ? "Pengguna tidak dapat login" : "Pengguna dapat mengakses sistem")
                    }
                </div>
            </div>
        </div>
    </div>

}

@code {
    [Parameter] public int Id { get; set; }

    private ApplicationUser? appUser;
    private SistemBeritaAcara.Core.Entities.Pegawai? pegawai;
    private bool isLoading = true;
    private string successMsg = string.Empty;
    private string errorMsg = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        appUser = await DbContext.Users.Include(u => u.Pegawai).FirstOrDefaultAsync(u => u.Id == Id);
        if (appUser is not null)
        {
            pegawai = appUser.Pegawai;
        }
        isLoading = false;
    }

    private async Task ToggleStatusAsync()
    {
        if (appUser is null) return;
        if (appUser.Role == "AdminIT") return;

        if (appUser.IsDeleted && pegawai is not null && !pegawai.IsAktif)
        {
            errorMsg = "Tidak dapat mengaktifkan akun karena status Pegawai sedang nonaktif. Silakan aktifkan Pegawai melalui Excel terlebih dahulu.";
            successMsg = string.Empty;
            return;
        }

        appUser.IsDeleted = !appUser.IsDeleted;
        if (appUser.IsDeleted)
        {
            appUser.DeletedAt = DateTime.Now;
            await UserManager.SetLockoutEnabledAsync(appUser, true);
            await UserManager.SetLockoutEndDateAsync(appUser, DateTimeOffset.MaxValue);
        }
        else
        {
            appUser.DeletedAt = null;
            await UserManager.SetLockoutEndDateAsync(appUser, null);
        }
        await UserManager.UpdateAsync(appUser);
        await UserManager.UpdateSecurityStampAsync(appUser);
        successMsg = appUser.IsDeleted ? "Akun dinonaktifkan." : "Akun diaktifkan kembali.";
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][0].ToString().ToUpper()
            : (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private static string GetRoleLabel(string role) => role switch
    {
        "AdminIT" => "Admin IT",
        "AdminBA" => "Admin BA",
        "Reviewer" => "Reviewer",
        _ => role
    };

    private static string GetRolePill(string role) => role switch
    {
        "AdminIT" => "pill-admin-it",
        "AdminBA" => "pill-admin-gudang",
        "Reviewer" => "pill-reviewer",
        _ => "pill-draft"
    };
}
