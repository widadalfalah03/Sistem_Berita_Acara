@page "/edit-pengguna/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject SistemBeritaAcara.Core.Interfaces.IEmailService EmailService
@inject IConfiguration Config
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminIT")]
@implements IDisposable

<PageTitle>Edit Pengguna — Sistem Berita Acara</PageTitle>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else if (appUser is null)
{
    <div style="text-align:center;padding:60px;color:var(--text-muted);">Pengguna tidak ditemukan.</div>
}
else
{
    <NavLink class="breadcrumb-back" href="/dashboard" style="margin-bottom: 24px;">
        <i class="bi bi-arrow-left"></i> Kembali
    </NavLink>

    @if (!string.IsNullOrEmpty(successMsg))
    {
        <div style="background:#F0FDF4;border:1px solid #22C55E;border-radius:var(--radius);padding:14px 20px;margin-bottom:24px;color:#16A34A;display:flex;align-items:center;gap:10px;">
            <i class="bi bi-check-circle-fill"></i> @successMsg
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="login-error" style="margin-bottom:24px;">@errorMsg</div>
    }

    <div class="edit-layout">
        <div>
            <div class="form-section" style="margin-bottom:24px;">
                <div style="display:flex;align-items:center;gap:24px;margin-bottom:24px;padding:20px;background:var(--bg);border-radius:var(--radius);flex-wrap:wrap;">
                    <div style="position:relative;">
                        <div style="width:80px;height:80px;border-radius:50%;overflow:hidden;background:var(--primary);display:flex;align-items:center;justify-content:center;flex-shrink:0;border:3px solid var(--primary-light);">
                            @if (!string.IsNullOrEmpty(appUser.ProfilePicPath))
                            {
                                <img src="/@appUser.ProfilePicPath" alt="Foto Profil" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <span style="font-size:28px;font-weight:800;color:white;">@GetInitials(appUser.Nama)</span>
                            }
                        </div>
                    </div>
                    <div>
                        <div style="font-size:20px;font-weight:800;color:var(--text-primary);">@appUser.Nama</div>
                        <div style="margin-top:4px;display:flex;align-items:center;gap:6px;">
                            <span class="pill @GetRolePill(appUser.Role)" style="font-size:12px;">@GetRoleLabel(appUser.Role)</span>
                        </div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nama Lengkap</label>
                        <input class="form-control readonly" readonly value="@appUser.Nama" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        <input class="form-control readonly" readonly value="@(appUser.Email ?? "-")" />
                    </div>
                </div>

                @if (pegawai is not null)
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">No. Pekerja</label>
                            <input class="form-control readonly" readonly value="@pegawai.NoPekerja" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Jabatan</label>
                            <input class="form-control readonly" readonly value="@(pegawai.Jabatan ?? "-")" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Fungsi/Direktorat</label>
                            <input class="form-control readonly" readonly value="@(pegawai.FungsiDirektorat ?? "-")" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cost Center</label>
                            <input class="form-control readonly" readonly value="@(pegawai.CostCenter ?? "-")" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="side-cards">

            <div class="side-card">
                <h4>Status Akun</h4>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                    <span class="status-dot @(appUser.IsDeleted ? "inactive" : "active")">
                        @(appUser.IsDeleted ? "Nonaktif" : "Aktif")
                    </span>
                    @if (appUser.Role == "AdminIT")
                    {
                        <div class="toggle-switch active" style="cursor:not-allowed;opacity:0.5;"></div>
                    }
                    else
                    {
                        <div class="toggle-switch @(appUser.IsDeleted ? "" : "active")"
                             @onclick="ToggleStatusAsync"
                             style="cursor:@(appUser.IsDeleted && pegawai is not null && !pegawai.IsAktif ? "not-allowed" : "pointer"); opacity:@(appUser.IsDeleted && pegawai is not null && !pegawai.IsAktif ? "0.5" : "1");"></div>
                    }
                </div>
                <div style="font-size:13px;color:var(--text-muted);">
                    @if (appUser.Role == "AdminIT")
                    {
                        <span><i class="bi bi-shield-lock-fill" style="color:#3b82f6;margin-right:4px;"></i>Akun Admin IT tidak dapat dinonaktifkan.</span>
                    }
                    else
                    {
                        @(appUser.IsDeleted ? "Pengguna tidak dapat login" : "Pengguna dapat mengakses sistem")
                    }
                </div>
            </div>

            @if (appUser.Role == "AdminIT")
            {
                <div class="side-card">
                    <h4>Ganti Admin IT</h4>

                    @if (!string.IsNullOrEmpty(transferSuccessMsg))
                    {
                        <div style="background:#F0FDF4;border:1px solid #22C55E;border-radius:var(--radius);padding:12px 14px;margin-bottom:14px;color:#16A34A;font-size:13px;display:flex;align-items:flex-start;gap:8px;">
                            <i class="bi bi-check-circle-fill" style="margin-top:1px;flex-shrink:0;"></i>
                            <span>@transferSuccessMsg</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(transferErrorMsg))
                    {
                        <div style="background:#FEF2F2;border:1px solid #FCA5A5;border-radius:var(--radius);padding:12px 14px;margin-bottom:14px;color:#DC2626;font-size:13px;display:flex;align-items:flex-start;gap:8px;">
                            <i class="bi bi-exclamation-circle-fill" style="margin-top:1px;flex-shrink:0;"></i>
                            <span>@transferErrorMsg</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(appUser.PendingEmail))
                    {
                        @* Status menunggu: tampilkan email + nama + tombol resend & batalkan *@
                        <div style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;line-height:1.5;">
                            Undangan dikirim ke <strong style="color:var(--text-primary);">@appUser.PendingEmail</strong>
                            <br/>atas nama <strong style="color:var(--text-primary);">@appUser.PendingNama</strong>.
                        </div>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <button title="@(resendCooldownSeconds > 0 ? $"Tunggu {resendCooldownSeconds}s" : "Kirim Ulang Undangan")"
                                    @onclick="ResendTransferAsync"
                                    disabled="@(isTransferring || resendCooldownSeconds > 0)"
                                    style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:@(resendCooldownSeconds > 0 ? "var(--bg)" : "var(--primary-light)");color:@(resendCooldownSeconds > 0 ? "var(--text-muted)" : "var(--primary)");border:none;cursor:@(resendCooldownSeconds > 0 ? "not-allowed" : "pointer");transition:all .15s;position:relative;"
                                    onmouseover="if(!this.disabled){this.style.background='var(--primary)';this.style.color='#fff'}"
                                    onmouseout="if(!this.disabled){this.style.background='var(--primary-light)';this.style.color='var(--primary)'}">
                                @if (isTransferring && isResending)
                                {
                                    <span class="spinner" style="width:13px;height:13px;border-width:2px;display:inline-block;"></span>
                                }
                                else if (resendCooldownSeconds > 0)
                                {
                                    <span style="font-size:11px;font-weight:700;line-height:1;">@resendCooldownSeconds</span>
                                }
                                else
                                {
                                    <i class="bi bi-envelope-fill" style="font-size:13px;"></i>
                                }
                            </button>
                            <button title="Batalkan Pergantian"
                                    @onclick="CancelTransferAsync"
                                    disabled="@isTransferring"
                                    style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:#fef2f2;color:#ef4444;border:none;cursor:pointer;transition:all .15s;"
                                    onmouseover="this.style.background='#ef4444';this.style.color='#fff'"
                                    onmouseout="this.style.background='#fef2f2';this.style.color='#ef4444'">
                                <i class="bi bi-trash-fill" style="font-size:13px;"></i>
                            </button>
                        </div>
                    }
                    else if (showTransferForm)
                    {
                        @* Form input nama + email *@
                        <div class="form-group" style="margin-bottom:12px;">
                            <label class="form-label" style="font-size:13px;">Nama Lengkap</label>
                            <input class="form-control" type="text" @bind="transferNama"
                                   placeholder="Masukkan nama lengkap" style="font-size:13px;" />
                        </div>
                        <div class="form-group" style="margin-bottom:16px;">
                            <label class="form-label" style="font-size:13px;">Email</label>
                            <input class="form-control" type="email" @bind="transferEmail"
                                   placeholder="Masukkan email" style="font-size:13px;" />
                        </div>
                        <div style="display:flex;gap:8px;">
                            <button class="btn btn-outline" style="font-size:13px;" @onclick="() => { showTransferForm = false; transferNama = string.Empty; transferEmail = string.Empty; transferErrorMsg = string.Empty; }" disabled="@isTransferring">
                                Batal
                            </button>
                            <button class="btn btn-primary" style="flex:1;font-size:13px;" @onclick="SendTransferAsync" disabled="@isTransferring">
                                @if (isTransferring)
                                {
                                    <span class="spinner" style="width:14px;height:14px;border-width:2px;margin-right:6px;display:inline-block;vertical-align:middle;"></span>
                                }
                                Kirim Undangan
                            </button>
                        </div>
                    }
                    else
                    {
                        @* Tombol awal — klik untuk tampilkan form *@
                        <button class="btn btn-outline" style="width:100%;font-size:13px;" @onclick="() => { showTransferForm = true; transferSuccessMsg = string.Empty; transferErrorMsg = string.Empty; }">
                            <i class="bi bi-person-gear" style="margin-right:6px;"></i>
                            Ganti Akun
                        </button>
                    }
                </div>
            }
        </div>
    </div>

}

@code {
    [Parameter] public int Id { get; set; }

    private ApplicationUser? appUser;
    private SistemBeritaAcara.Core.Entities.Pegawai? pegawai;
    private bool isLoading = true;
    private string successMsg = string.Empty;
    private string errorMsg = string.Empty;

    // Transfer Admin IT
    private string transferNama = string.Empty;
    private string transferEmail = string.Empty;
    private bool isTransferring = false;
    private bool isResending = false;
    private bool showTransferForm = false;
    private string transferSuccessMsg = string.Empty;
    private string transferErrorMsg = string.Empty;

    // Cooldown kirim ulang
    private int resendCooldownSeconds = 0;
    private System.Threading.Timer? _cooldownTimer;

    protected override async Task OnInitializedAsync()
    {
        appUser = await DbContext.Users.Include(u => u.Pegawai).FirstOrDefaultAsync(u => u.Id == Id);
        if (appUser is not null)
        {
            pegawai = appUser.Pegawai;
        }
        isLoading = false;
    }

    private async Task ToggleStatusAsync()
    {
        if (appUser is null) return;
        if (appUser.Role == "AdminIT") return;

        if (appUser.IsDeleted && pegawai is not null && !pegawai.IsAktif)
        {
            errorMsg = "Tidak dapat mengaktifkan akun karena status Pegawai sedang nonaktif. Silakan aktifkan Pegawai melalui Excel terlebih dahulu.";
            successMsg = string.Empty;
            return;
        }

        appUser.IsDeleted = !appUser.IsDeleted;
        if (appUser.IsDeleted)
        {
            appUser.DeletedAt = DateTime.Now;
            await UserManager.SetLockoutEnabledAsync(appUser, true);
            await UserManager.SetLockoutEndDateAsync(appUser, DateTimeOffset.MaxValue);
        }
        else
        {
            appUser.DeletedAt = null;
            await UserManager.SetLockoutEndDateAsync(appUser, null);
        }
        await UserManager.UpdateAsync(appUser);
        await UserManager.UpdateSecurityStampAsync(appUser);
        successMsg = appUser.IsDeleted ? "Akun dinonaktifkan." : "Akun diaktifkan kembali.";
    }

    private async Task SendTransferAsync()
    {
        transferSuccessMsg = string.Empty;
        transferErrorMsg = string.Empty;

        if (string.IsNullOrWhiteSpace(transferNama))
        {
            transferErrorMsg = "Nama lengkap tidak boleh kosong.";
            return;
        }
        if (string.IsNullOrWhiteSpace(transferEmail) || !transferEmail.Contains('@'))
        {
            transferErrorMsg = "Masukkan alamat email yang valid.";
            return;
        }

        // Cek apakah email sudah terdaftar di sistem (selain akun AdminIT sendiri)
        var emailLower = transferEmail.Trim().ToLower();
        var existing = await DbContext.Users
            .FirstOrDefaultAsync(u => u.NormalizedEmail == emailLower.ToUpper() && u.Id != appUser!.Id);
        if (existing != null)
        {
            transferErrorMsg = "Pengguna dengan email ini sudah terdaftar di sistem.";
            return;
        }

        isTransferring = true;
        isResending = false;
        try
        {
            if (appUser is null) return;

            appUser.PendingNama  = transferNama.Trim();
            appUser.PendingEmail = emailLower;

            var token   = await UserManager.GeneratePasswordResetTokenAsync(appUser);
            var baseUrl = Config["App:BaseUrl"] ?? "http://localhost:5000";

            await UserManager.UpdateAsync(appUser);

            _ = EmailService.SendAdminITTransferAsync(appUser.PendingEmail, appUser.PendingNama, token, baseUrl);

            transferSuccessMsg  = $"Undangan berhasil dikirim ke {appUser.PendingEmail}.";
            showTransferForm    = false;
            transferNama        = string.Empty;
            transferEmail       = string.Empty;

            // Mulai cooldown agar tombol kirim ulang tidak langsung bisa diklik
            StartCooldown();
        }
        catch (Exception ex)
        {
            transferErrorMsg = $"Gagal mengirim undangan: {ex.Message}";
        }
        finally
        {
            isTransferring = false;
        }
    }

    private async Task ResendTransferAsync()
    {
        if (appUser is null || string.IsNullOrEmpty(appUser.PendingEmail)) return;
        if (resendCooldownSeconds > 0) return;

        transferSuccessMsg = string.Empty;
        transferErrorMsg   = string.Empty;
        isTransferring = true;
        isResending    = true;
        try
        {
            var token   = await UserManager.GeneratePasswordResetTokenAsync(appUser);
            var baseUrl = Config["App:BaseUrl"] ?? "http://localhost:5000";
            _ = EmailService.SendAdminITTransferAsync(appUser.PendingEmail, appUser.PendingNama ?? appUser.PendingEmail, token, baseUrl);
            transferSuccessMsg = $"Undangan berhasil dikirim ulang ke {appUser.PendingEmail}.";

            // Mulai cooldown 60 detik
            StartCooldown();
        }
        catch (Exception ex)
        {
            transferErrorMsg = $"Gagal mengirim ulang: {ex.Message}";
        }
        finally
        {
            isTransferring = false;
            isResending    = false;
        }
    }

    private async Task CancelTransferAsync()
    {
        if (appUser is null) return;
        isTransferring = true;
        try
        {
            appUser.PendingNama  = null;
            appUser.PendingEmail = null;
            await UserManager.UpdateAsync(appUser);
            transferSuccessMsg = string.Empty;
            transferErrorMsg   = string.Empty;
        }
        catch (Exception ex)
        {
            transferErrorMsg = $"Gagal membatalkan: {ex.Message}";
        }
        finally
        {
            isTransferring = false;
        }
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][0].ToString().ToUpper()
            : (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    private static string GetRoleLabel(string role) => role switch
    {
        "AdminIT" => "Admin IT",
        "AdminBA" => "Admin BA",
        "Reviewer" => "Reviewer",
        _ => role
    };

    private static string GetRolePill(string role) => role switch
    {
        "AdminIT" => "pill-admin-it",
        "AdminBA" => "pill-admin-gudang",
        "Reviewer" => "pill-reviewer",
        _ => "pill-draft"
    };

    private void StartCooldown()
    {
        resendCooldownSeconds = 60;
        _cooldownTimer?.Dispose();
        _cooldownTimer = new System.Threading.Timer(_ =>
        {
            if (resendCooldownSeconds > 0)
                resendCooldownSeconds--;
            InvokeAsync(StateHasChanged);
            if (resendCooldownSeconds <= 0)
            {
                _cooldownTimer?.Dispose();
                _cooldownTimer = null;
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose() => _cooldownTimer?.Dispose();
}
