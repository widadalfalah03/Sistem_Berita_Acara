@page "/tambah-pengguna"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PegawaiEntity = SistemBeritaAcara.Core.Entities.Pegawai
@inject AppDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject SistemBeritaAcara.Core.Interfaces.IEmailService EmailService
@inject IConfiguration Config

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminIT")]

<PageTitle>Tambah Pengguna — Sistem Berita Acara</PageTitle>

<div class="add-user-card">
    <h2>Tambah Pengguna</h2>
    <p>Cari pegawai berdasarkan nama atau No. Pekerja untuk ditambahkan sebagai pengguna sistem.</p>

    <div class="form-group">
        <label class="form-label">Cari Pegawai</label>
        <div class="search-input">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Masukkan Nama atau No. Pekerja..."
                   value="@searchQuery"
                   @oninput="OnSearch" />
        </div>
    </div>

    @if (isSearching)
    {
        <div style="text-align:center;padding:32px;color:var(--text-muted);">
            <div class="spinner" style="margin:0 auto 12px;width:28px;height:28px;border-width:3px;"></div>
            <div style="font-size:14px;">Mencari pegawai...</div>
        </div>
    }
    else if (results.Any())
    {
        <div style="margin-top:16px;">
            @foreach (var p in results)
            {
                <div class="user-result">
                    <div class="user-result-avatar">@p.Nama[0]</div>
                    <div style="flex:1;">
                        <div class="user-result-name">@p.Nama</div>
                        <div class="user-result-nip">No. Pekerja: @p.NoPekerja · @p.FungsiDirektorat</div>
                    </div>
                    @if (existingUserIds.Contains(p.Id))
                    {
                        <span class="pill pill-draft">Sudah ada akun</span>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => SelectPegawai(p)">
                            <i class="bi bi-plus-lg"></i> Tambah
                        </button>
                    }
                </div>
            }
        </div>
    }
    else if (selectedPegawai is null && !string.IsNullOrEmpty(searchQuery))
    {
        <div style="text-align:center;padding:32px;color:var(--text-muted);">
            <i class="bi bi-search" style="font-size:32px;display:block;margin-bottom:12px;"></i>
            Pegawai tidak ditemukan
        </div>
    }

    <!-- Setup Role Form (after selecting) -->
    @if (selectedPegawai is not null && !formSaved)
    {
        <div style="border-top:1px solid var(--border);margin-top:24px;padding-top:24px;">

            <div class="form-group">
                <label class="form-label">Role <span style="color:var(--danger)">*</span></label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:4px;">
                    @{
                        var roles = new[] {
                            new { Value = "AdminGudangBarang", Text = "Admin Gudang & Barang", Icon = "bi-box-seam", Desc = "Kelola & buat Berita Acara" },
                            new { Value = "Reviewer", Text = "Reviewer", Icon = "bi-person-check", Desc = "Menyetujui Berita Acara" }
                        };
                        foreach (var r in roles)
                        {
                            var isSelected = selectedRole == r.Value;
                            <div @onclick="() => { selectedRole = r.Value; }"
                                 style="padding:14px 16px;cursor:pointer;border:2px solid @(isSelected ? "var(--primary)" : "var(--border)");border-radius:var(--radius);background:@(isSelected ? "color-mix(in srgb,var(--primary) 8%,transparent)" : "var(--surface)");transition:all 0.15s;">
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <div style="width:36px;height:36px;border-radius:50%;background:@(isSelected ? "var(--primary)" : "var(--bg)");display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.15s;">
                                        <i class="bi @r.Icon" style="font-size:16px;color:@(isSelected ? "white" : "var(--text-secondary)")"></i>
                                    </div>
                                    <div>
                                        <div style="font-size:13px;font-weight:600;color:@(isSelected ? "var(--primary)" : "var(--text-primary)")">@r.Text</div>
                                        <div style="font-size:11px;color:var(--text-muted);margin-top:1px;">@r.Desc</div>
                                    </div>
                                    @if (isSelected)
                                    {
                                        <i class="bi bi-check-circle-fill" style="margin-left:auto;color:var(--primary);font-size:16px;"></i>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="form-group" style="margin-top:16px; background:#eff6ff; padding:12px; border-radius:6px; border:1px solid #bfdbfe;">
                <div style="font-size:13px; color:#1e40af;">
                    <i class="bi bi-info-circle-fill" style="margin-right:6px;"></i>
                    Pengguna akan menerima email otomatis berisi tautan untuk Setup Akun (Password & Tanda Tangan).
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="login-error" style="margin-bottom:12px;">@errorMsg</div>
            }

            <div style="display:flex;gap:12px;">
                <button class="btn btn-outline" @onclick="() => { selectedPegawai = null; selectedRole = string.Empty; }">Batal</button>
                <button class="btn btn-primary" @onclick="CreateUserAsync" disabled="@isSaving">
                    <i class="bi bi-person-plus"></i> Buat Akun
                </button>
            </div>
        </div>
    }

    @if (formSaved)
    {
        <div style="text-align:center;padding:32px;">
            <div style="width:64px;height:64px;border-radius:50%;background:#F0FDF4;color:#22C55E;display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 16px;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div style="font-size:20px;font-weight:700;margin-bottom:8px;">Akun Berhasil Dibuat</div>
            <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                Email undangan telah berhasil dikirim ke <strong>@(selectedPegawai?.Email ?? "pengguna")</strong> untuk akun <strong>@savedName</strong> dengan role <strong>@savedRole</strong>
            </div>
            <div style="display:flex;gap:12px;justify-content:center;">
                <button class="btn btn-outline" @onclick="Reset">Tambah Pengguna Lain</button>
                <NavLink class="btn btn-primary" href="/dashboard">Kembali</NavLink>
            </div>
        </div>
    }
</div>

@code {
    private List<PegawaiEntity> allPegawai = new();
    private List<PegawaiEntity> results = new();
    private HashSet<int> existingUserIds = new();
    private PegawaiEntity? selectedPegawai;
    private string searchQuery = string.Empty;
    private string selectedRole = string.Empty;
    private string errorMsg = string.Empty;
    private bool isSaving = false;
    private bool isSearching = false;
    private bool formSaved = false;
    private string savedName = string.Empty;
    private string savedRole = string.Empty;
    private bool showRoleDropdown = false;
    private CancellationTokenSource? _searchCts;

    protected override async Task OnInitializedAsync()
    {
        allPegawai = await DbContext.Pegawai.Where(p => p.IsAktif).OrderBy(p => p.Nama).ToListAsync();
        var usersWithPegawai = await DbContext.Users.Where(u => u.PegawaiId != null).Select(u => u.PegawaiId!.Value).ToListAsync();
        existingUserIds = usersWithPegawai.ToHashSet();
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;

        // Batalkan debounce sebelumnya — JANGAN Dispose di sini karena
        // finally block dari search lama masih bisa berjalan dan akan throw
        // ObjectDisposedException saat mengakses cts.IsCancellationRequested.
        _searchCts?.Cancel();

        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            results = new();
            isSearching = false;
            return;
        }

        isSearching = true;
        StateHasChanged();

        var cts = new CancellationTokenSource();
        _searchCts = cts;

        try
        {
            await Task.Delay(300, cts.Token); // debounce 300ms

            // Hanya update state jika search ini tidak dibatalkan
            results = allPegawai
                .Where(p => p.Nama.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                            p.NoPekerja.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                .Take(8).ToList();

            isSearching = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Pencarian dibatalkan karena ada keystroke baru — biarkan OnSearch berikutnya
            // yang menangani state. Tidak perlu update apapun di sini.
        }
    }

    private void SelectPegawai(PegawaiEntity p)
    {
        selectedPegawai = p;
        searchQuery = p.Nama;
        results.Clear();
        errorMsg = string.Empty;
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrEmpty(selectedRole)) { errorMsg = "Pilih role terlebih dahulu."; return; }
        isSaving = true;
        errorMsg = string.Empty;
        try
        {
            var user = new ApplicationUser
            {
                UserName = selectedPegawai!.Email ?? $"user{selectedPegawai.Id}@pertamina.com",
                Email = selectedPegawai.Email ?? $"user{selectedPegawai.Id}@pertamina.com",
                Nama = selectedPegawai.Nama,
                Role = selectedRole,
                PegawaiId = selectedPegawai.Id,
                EmailConfirmed = false,  // Belum aktif sampai user setup via link undangan
                IsDeleted = false
            };
            
            // Generate a random temporary password
            var tempPw = Guid.NewGuid().ToString("N") + "X1!";
            var result = await UserManager.CreateAsync(user, tempPw);
            if (!result.Succeeded)
            {
                errorMsg = string.Join(", ", result.Errors.Select(e => e.Description));
                return;
            }

            await UserManager.AddToRoleAsync(user, selectedRole);

            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var baseUrl = Config["App:PublicUrl"] ?? Config["App:BaseUrl"] ?? "http://localhost:5000";
            _ = EmailService.SendUserInvitationAsync(user.Email, user.Nama, token, baseUrl);

            savedName = selectedPegawai.Nama;
            savedRole = selectedRole switch
            {
                "AdminGudangBarang" => "Admin Gudang & Barang",
                "Reviewer" => "Reviewer",
                _ => selectedRole
            };
            formSaved = true;
        }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { isSaving = false; }
    }

    private void Reset()
    {
        formSaved = false; selectedPegawai = null;
        searchQuery = string.Empty; selectedRole = string.Empty;
        savedName = string.Empty; savedRole = string.Empty;
    }
}
