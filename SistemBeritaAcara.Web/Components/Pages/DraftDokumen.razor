@page "/draft"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminGudangBarang")]

<PageTitle>Draft Dokumen — Sistem Berita Acara</PageTitle>

<div class="page-header d-flex align-center justify-between">
    <div>
        <h1 class="page-title">Draft Dokumen</h1>
        <p class="page-subtitle">Berita Acara yang belum diajukan untuk persetujuan</p>
    </div>
    <NavLink class="btn btn-primary" href="/buat-ba">
        <i class="bi bi-plus-lg"></i> Buat Baru
    </NavLink>
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat data...</span></div>
}
else if (!drafts.Any())
{
    <div class="card" style="text-align:center;padding:60px;">
        <i class="bi bi-file-earmark-text" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-bottom:8px;">Belum ada draft</div>
        <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">Buat Berita Acara baru untuk memulai</div>
        <NavLink class="btn btn-primary" href="/buat-ba">
            <i class="bi bi-plus-lg"></i> Buat Berita Acara
        </NavLink>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(deleteMsg))
    {
        <div style="background:var(--danger-light);border:1px solid var(--danger);border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;color:var(--danger);font-size:14px;">
            @deleteMsg
        </div>
    }
    <div class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("No. Surat"))">No. Surat <i class="bi @GetSortIcon("No. Surat")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Jenis Berita Acara"))">Jenis Berita Acara <i class="bi @GetSortIcon("Jenis Berita Acara")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Penanggung Jawab"))">Penanggung Jawab <i class="bi @GetSortIcon("Penanggung Jawab")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th style="cursor:pointer;" @onclick="@(() => SortTable("Terakhir Diupdate"))">Terakhir Diupdate <i class="bi @GetSortIcon("Terakhir Diupdate")" style="margin-left:4px;font-size:11px;color:var(--text-muted);"></i></th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ba in SortedDrafts)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <i class="bi bi-file-earmark-text" style="font-size:20px;color:var(--primary);"></i>
                                <div>
                                    <div class="cell-main">@(ba.NomorSurat ?? "(Draft)")</div>
                                    <div class="cell-sub">Dibuat @ba.CreatedAt.ToString("dd MMM yyyy")</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span>
                        </td>
                        <td>
                            <div class="cell-main">@ba.Pj?.Nama</div>
                            <div class="cell-sub">@ba.Pj?.FungsiDirektorat</div>
                        </td>
                        <td>@ba.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <div style="display:flex;gap:4px;">
                                <NavLink class="btn-icon" href="@($"/buat-ba?edit={ba.Id}")" title="Edit Draft">
                                    <i class="bi bi-pencil"></i>
                                </NavLink>
                                <button class="btn-icon" title="Hapus"
                                        style="color:var(--danger);"
                                        @onclick="() => ConfirmDelete(ba.Id)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Confirm delete modal -->
@if (deleteConfirmId.HasValue)
{
    <div class="modal-overlay" @onclick="() => deleteConfirmId = null">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => deleteConfirmId = null">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="text-align:center;padding:8px 0 20px;">
                <div style="width:56px;height:56px;border-radius:50%;background:var(--danger-light);color:var(--danger);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 16px;">
                    <i class="bi bi-trash3"></i>
                </div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Hapus Draft?</div>
                <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                    Tindakan ini tidak bisa dibatalkan. Draft akan dihapus permanen.
                </div>
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button class="btn btn-outline" @onclick="() => deleteConfirmId = null">Batal</button>
                    <button class="btn btn-danger" @onclick="DeleteAsync">
                        <i class="bi bi-trash3"></i> Ya, Hapus
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BeritaAcaraEntity> drafts = new();
    private bool isLoading = true;
    private int? deleteConfirmId;
    private string deleteMsg = string.Empty;
    private int currentUserId;

    private string sortColumn = "Terakhir Diupdate";
    private bool sortAscending = false;

    private void SortTable(string column)
    {
        if (sortColumn == column) sortAscending = !sortAscending;
        else { sortColumn = column; sortAscending = true; }
    }

    private string GetSortIcon(string column) => sortColumn != column ? "bi-arrow-down-up" : sortAscending ? "bi-arrow-up text-primary" : "bi-arrow-down text-primary";

    private IEnumerable<BeritaAcaraEntity> SortedDrafts => sortColumn switch
    {
        "No. Surat" => sortAscending ? drafts.OrderBy(b => b.NomorSurat) : drafts.OrderByDescending(b => b.NomorSurat),
        "Jenis Berita Acara" => sortAscending ? drafts.OrderBy(b => b.Jenis) : drafts.OrderByDescending(b => b.Jenis),
        "Penanggung Jawab" => sortAscending ? drafts.OrderBy(b => b.Pj?.Nama) : drafts.OrderByDescending(b => b.Pj?.Nama),
        "Terakhir Diupdate" => sortAscending ? drafts.OrderBy(b => b.CreatedAt) : drafts.OrderByDescending(b => b.CreatedAt),
        _ => drafts
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        currentUserId = user!.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        drafts = await DbContext.Set<BeritaAcaraEntity>()
            .Include(b => b.Pj)
            .Where(b => b.CreatedBy == currentUserId && b.Status == "Draft")
            .OrderByDescending(b => b.CreatedAt)
            .ToListAsync();
        isLoading = false;
    }

    private void ConfirmDelete(int id) { deleteConfirmId = id; deleteMsg = string.Empty; }

    private async Task DeleteAsync()
    {
        if (!deleteConfirmId.HasValue) return;
        var ba = await DbContext.Set<BeritaAcaraEntity>().FirstOrDefaultAsync(b => b.Id == deleteConfirmId.Value);
        if (ba is not null)
        {
            DbContext.Set<BeritaAcaraEntity>().Remove(ba);
            await DbContext.SaveChangesAsync();
        }
        deleteConfirmId = null;
        await LoadAsync();
    }

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        _ => "pill-lainnya"
    };
}
