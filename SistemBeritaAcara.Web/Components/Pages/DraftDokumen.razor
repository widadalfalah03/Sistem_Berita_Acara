@page "/draft"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminGudangBarang")]

<PageTitle>Draft Dokumen — Sistem Berita Acara</PageTitle>

<style>
    .action-btn-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        background: var(--surface);
        cursor: pointer;
        transition: all 0.2s;
        color: var(--text-secondary);
    }
    .action-btn-circle:hover {
        background: var(--surface-hover, var(--border-light));
    }
    .action-btn-circle.btn-delete:hover {
        color: var(--danger);
        border-color: var(--danger);
        background: var(--danger-light);
    }
    .draft-row {
        display: flex;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border-light);
        cursor: pointer;
        transition: background 0.15s;
    }
    .draft-row:hover {
        background: var(--bg-secondary);
    }
    .draft-row:last-child {
        border-bottom: none;
    }
</style>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat data...</span></div>
}
else if (!drafts.Any())
{
    <div class="card" style="text-align:center;padding:60px;">
        <i class="bi bi-file-earmark-text" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-bottom:8px;">Belum ada draft</div>
        <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">Buat Berita Acara baru untuk memulai</div>
        <NavLink class="btn btn-primary" href="/buat-ba">
            <i class="bi bi-plus-lg"></i> Buat Berita Acara
        </NavLink>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(deleteMsg))
    {
        <div style="background:var(--danger-light);border:1px solid var(--danger);border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;color:var(--danger);font-size:14px;">
            @deleteMsg
        </div>
    }

    <div style="display:flex;justify-content:flex-end;margin-bottom:24px;">
        <button class="action-btn-circle btn-delete" title="Hapus Semua" @onclick="() => deleteAllConfirm = true">
            <i class="bi bi-trash3"></i>
        </button>
    </div>

    <div style="background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);overflow:hidden;margin-bottom:24px;">
        <!-- List Items -->
        <div>
            @foreach (var ba in PaginatedDrafts)
            {
                <div class="draft-row" @onclick="@(() => EditDraft(ba.Id))">
                    <div style="flex:1;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text-primary);display:flex;align-items:center;gap:6px;">
                        <span style="font-weight:600;">Berita Acara @ba.Jenis</span>
                        <span style="color:var(--text-secondary);">-</span>
                        <span style="color:var(--text-secondary);">@(ba.Pj?.Nama ?? "Tanpa Penanggung Jawab")@(string.IsNullOrEmpty(ba.TiketSscNo) ? "" : $" ({ba.TiketSscNo})")</span>
                    </div>
                    <div style="font-size:12px;font-weight:500;color:var(--text-secondary);flex-shrink:0;margin-right:16px;">
                        @GetRelativeTime(ba.CreatedAt)
                    </div>
                    <div style="width:40px;text-align:right;flex-shrink:0;" @onclick:stopPropagation>
                        <button class="btn-icon" style="color:var(--text-muted);" @onclick="() => ConfirmDelete(ba.Id)" title="Hapus">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        
    </div>

    @if (drafts.Count > 0)
    {
        <SistemBeritaAcara.Web.Components.Shared.Pagination
            CurrentPage="@currentPage"
            TotalItems="@drafts.Count"
            PageSize="@pageSize"
            CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
    }
}

<!-- Confirm delete all modal -->
@if (deleteAllConfirm)
{
    <div class="modal-overlay" @onclick="() => deleteAllConfirm = false">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => deleteAllConfirm = false">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="text-align:center;padding:8px 0 20px;">
                <div style="width:56px;height:56px;border-radius:50%;background:var(--danger-light);color:var(--danger);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 16px;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Hapus Semua Draft?</div>
                <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                    Seluruh <strong>@drafts.Count dokumen</strong> akan dihapus permanen. Tindakan ini tidak bisa dibatalkan.
                </div>
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button class="btn btn-danger" @onclick="DeleteAllAsync">
                        <i class="bi bi-trash3"></i> Ya, Hapus Semua
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Confirm delete modal -->
@if (deleteConfirmId.HasValue)
{
    <div class="modal-overlay" @onclick="() => deleteConfirmId = null">
        <div class="modal-content" @onclick:stopPropagation>
            <button class="modal-close" @onclick="() => deleteConfirmId = null">
                <i class="bi bi-x-lg"></i>
            </button>
            <div style="text-align:center;padding:8px 0 20px;">
                <div style="width:56px;height:56px;border-radius:50%;background:var(--danger-light);color:var(--danger);display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 16px;">
                    <i class="bi bi-trash3"></i>
                </div>
                <div style="font-size:18px;font-weight:700;margin-bottom:8px;">Hapus Draft?</div>
                <div style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                    Tindakan ini tidak bisa dibatalkan. Draft akan dihapus permanen.
                </div>
                <div style="display:flex;gap:12px;justify-content:center;">
                    <button class="btn btn-danger" @onclick="DeleteAsync">
                        <i class="bi bi-trash3"></i> Ya, Hapus
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BeritaAcaraEntity> drafts = new();
    private bool isLoading = true;
    private int? deleteConfirmId;
    private bool deleteAllConfirm = false;
    private string deleteMsg = string.Empty;
    private int currentUserId;

    private int currentPage = 1;
    private int pageSize = 10;

    private void EditDraft(int id)
    {
        Navigation.NavigateTo($"/buat-ba?edit={id}");
    }

    private IEnumerable<BeritaAcaraEntity> PaginatedDrafts => drafts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        currentUserId = user!.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        drafts = await DbContext.Set<BeritaAcaraEntity>()
            .AsNoTracking()
            .Include(b => b.Pj)
            .Where(b => b.CreatedBy == currentUserId && (b.Status == "Draft" || b.Status == "Rejected"))
            .OrderByDescending(b => b.CreatedAt)
            .ToListAsync();
        isLoading = false;
    }

    private void ConfirmDelete(int id) { deleteConfirmId = id; deleteMsg = string.Empty; }

    private async Task DeleteAllAsync()
    {
        foreach (var ba in drafts.ToList())
        {
            var entity = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.BuktiFotos)
                .FirstOrDefaultAsync(b => b.Id == ba.Id);
            if (entity is null) continue;
            DeleteFileIfExists(entity.DocxPath);
            DeleteFileIfExists(entity.DocxPath?.Replace(".docx", ".pdf"));
            if (entity.BuktiFotos != null)
                foreach (var foto in entity.BuktiFotos)
                    DeleteFileIfExists(foto.FilePath);
            DbContext.Set<BeritaAcaraEntity>().Remove(entity);
        }
        await DbContext.SaveChangesAsync();
        deleteAllConfirm = false;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (!deleteConfirmId.HasValue) return;
        var ba = await DbContext.Set<BeritaAcaraEntity>()
            .Include(b => b.BuktiFotos)
            .FirstOrDefaultAsync(b => b.Id == deleteConfirmId.Value && b.CreatedBy == currentUserId);
        if (ba is not null)
        {
            // Hapus file dokumen (DOCX + PDF) dari disk
            DeleteFileIfExists(ba.DocxPath);
            DeleteFileIfExists(ba.DocxPath?.Replace(".docx", ".pdf"));

            // Hapus semua foto bukti dari disk
            if (ba.BuktiFotos != null)
                foreach (var foto in ba.BuktiFotos)
                    DeleteFileIfExists(foto.FilePath);

            DbContext.Set<BeritaAcaraEntity>().Remove(ba);
            await DbContext.SaveChangesAsync();
        }
        deleteConfirmId = null;
        await LoadAsync();
    }

    private static void DeleteFileIfExists(string? relativePath)
    {
        if (string.IsNullOrEmpty(relativePath)) return;
        try
        {
            var physical = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                relativePath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
            if (File.Exists(physical)) File.Delete(physical);
        }
        catch { /* abaikan jika file sedang dipakai atau sudah tidak ada */ }
    }

    private static string GetRelativeTime(DateTime dt)
    {
        if (dt.Date == DateTime.Today)
        {
            return dt.ToString("HH.mm");
        }
        else
        {
            return dt.ToString("dd MMM yyyy, HH.mm");
        }
    }
}
