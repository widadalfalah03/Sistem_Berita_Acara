@page "/pengguna"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SistemBeritaAcara.Core.Entities
@using SistemBeritaAcara.Infrastructure.Data
@inject AppDbContext DbCtx
@inject UserManager<ApplicationUser> UserManager
@inject SistemBeritaAcara.Core.Interfaces.IEmailService EmailService
@inject IConfiguration Config
@inject NavigationManager Navigation
@rendermode InteractiveServer

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminIT")]
@implements IDisposable

@if (isLoading)
{
    <div class="page-loading">
        <div class="spinner"></div>
    </div>
}
else
{
    <div class="page-header d-flex align-center justify-between">
        <div></div>
        <NavLink class="btn btn-primary" href="/tambah-pengguna">
            <i class="bi bi-plus-lg"></i>
            Tambah Pengguna
        </NavLink>
    </div>

    <div class="stat-cards" style="margin-bottom:24px;grid-template-columns:repeat(4,1fr);">
        <div class="stat-card">
            <div class="stat-card-icon total"><i class="bi bi-people"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total Pengguna</div>
                <div class="stat-card-value">@stats.Total</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon" style="background:color-mix(in srgb,#3b82f6 15%,transparent);color:#3b82f6;"><i class="bi bi-shield-lock"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Admin IT</div>
                <div class="stat-card-value" style="color:#3b82f6;">@stats.AdminIT</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-box-seam"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Admin BA</div>
                <div class="stat-card-value green">@stats.AdminBA</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon progress"><i class="bi bi-person-check"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Reviewer</div>
                <div class="stat-card-value blue">@stats.Reviewer</div>
            </div>
        </div>
    </div>

    <div class="search-bar">
        <div class="search-input" style="max-width:320px;">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Cari nama atau email..."
                   @bind="search" @bind:event="oninput" />
        </div>
        <div style="position:relative;">
            <div @onclick="() => showRoleDropdown = !showRoleDropdown"
                 style="padding:8px 14px;cursor:pointer;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);font-size:14px;display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:180px;">
                <span style="font-weight:500;">@(string.IsNullOrEmpty(roleFilter) ? "Semua Role" : GetRoleLabel(roleFilter))</span>
                <i class="bi bi-chevron-down" style="font-size:11px;color:var(--text-muted);transition:transform 0.2s;@(showRoleDropdown ? "transform:rotate(180deg);" : "")"></i>
            </div>
            @if (showRoleDropdown)
            {
                <div @onclick="() => showRoleDropdown = false" style="position:fixed;inset:0;z-index:99;"></div>
                <div style="position:absolute;top:100%;left:0;z-index:100;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-md);min-width:180px;margin-top:4px;overflow:hidden;">
                    @foreach (var role in new[] { "", "AdminIT", "AdminBA", "Reviewer" })
                    {
                        var label = string.IsNullOrEmpty(role) ? "Semua Role" : GetRoleLabel(role);
                        <div @onclick="@(() => { roleFilter = role; showRoleDropdown = false; })"
                             style="padding:10px 14px;cursor:pointer;font-size:14px;font-weight:@(roleFilter == role ? "600" : "400");background:@(roleFilter == role ? "var(--primary)" : "transparent");color:@(roleFilter == role ? "white" : "var(--text-primary)");"
                             onmouseover="if(this.style.background !== 'var(--primary)') this.style.background='var(--primary-light)'"
                             onmouseout="if(this.style.background !== 'var(--primary)') this.style.background='transparent'">
                            @label
                        </div>
                    }
                </div>
            }
        </div>
        <label class="toggle-wrapper" style="cursor:pointer;display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-secondary);">
            <div class="toggle-switch @(showInactive ? "active" : "")" @onclick="() => showInactive = !showInactive"></div>
            <span>Tampilkan Non-Aktif</span>
        </label>
    </div>

    
    @if (confirmDeleteId is not null)
    {
        <div style="position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.35);">
            <div style="background:var(--surface);border-radius:var(--radius-lg);padding:28px 32px;max-width:400px;width:100%;box-shadow:var(--shadow-xl);">
                <div style="font-size:16px;font-weight:700;margin-bottom:8px;">Hapus Akun Belum Aktivasi?</div>
                <div style="font-size:13px;color:var(--text-secondary);margin-bottom:24px;">
                    Hapus akun <strong>@confirmDeleteEmail</strong>?
                </div>
                <div style="display:flex;gap:12px;justify-content:flex-end;">
                    <button class="btn btn-outline" @onclick="() => { confirmDeleteId = null; confirmDeleteEmail = null; }">Batal</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isProcessing">
                        @if (isProcessing) { <span class="spinner" style="width:14px;height:14px;border-width:2px;margin-right:6px;display:inline-block;vertical-align:middle;"></span> }
                        Hapus
                    </button>
                </div>
            </div>
        </div>
    }

    
    @if (!string.IsNullOrEmpty(toastMsg))
    {
        <div style="position:fixed;bottom:24px;right:24px;z-index:600;background:@(toastIsError ? "var(--danger)" : "#22c55e");color:white;padding:12px 20px;border-radius:8px;font-size:13px;font-weight:500;box-shadow:var(--shadow-lg);max-width:320px;">
            <i class="bi @(toastIsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")" style="margin-right:8px;"></i>@toastMsg
        </div>
    }

    <div class="card">
        @if (!FilteredUsers.Any())
        {
            <div style="text-align:center;padding:48px;color:var(--text-muted);">
                <i class="bi bi-people" style="font-size:36px;display:block;margin-bottom:12px;"></i>
                <div style="font-weight:600;margin-bottom:4px;">Tidak ada pengguna ditemukan</div>
                <div style="font-size:13px;">Coba ubah filter pencarian atau tambah pengguna baru.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nama/No. Pekerja</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in FilteredUsers)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">@u.Nama</div>
                                @if (u.PegawaiId != null)
                                {
                                    <div class="cell-sub">No. Pekerja: @(u.Pegawai?.NoPekerja ?? "-")</div>
                                }
                            </td>
                            <td>@u.Email</td>
                            <td>
                                <span class="pill @GetRolePill(u.Role)">@GetRoleLabel(u.Role)</span>
                            </td>
                            <td>
                                @if (!u.EmailConfirmed)
                                {
                                    <span class="status-dot" style="color:#d97706;">
                                        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#d97706;margin-right:6px;"></span>Belum Aktivasi
                                    </span>
                                }
                                else if (!u.IsDeleted)
                                {
                                    <span class="status-dot active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-dot inactive">Nonaktif</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                @if (!u.EmailConfirmed)
                                {
                                    <div style="display:inline-flex;gap:6px;align-items:center;">
                                        <button title="@(resendCooldowns.TryGetValue(u.Id, out var rcd) && rcd > 0 ? $"Tunggu {rcd}s" : "Kirim Ulang Undangan")"
                                                @onclick="() => ResendInvitationAsync(u)"
                                                disabled="@(resendingId == u.Id || (resendCooldowns.TryGetValue(u.Id, out var btnCd) && btnCd > 0))"
                                                style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:@(resendCooldowns.TryGetValue(u.Id, out var bgCd) && bgCd > 0 ? "var(--bg)" : "var(--primary-light)");color:@(resendCooldowns.TryGetValue(u.Id, out var clrCd) && clrCd > 0 ? "var(--text-muted)" : "var(--primary)");border:none;cursor:@(resendCooldowns.TryGetValue(u.Id, out var curCd) && curCd > 0 ? "not-allowed" : "pointer");transition:all .15s;"
                                                onmouseover="if(!this.disabled){this.style.background='var(--primary)';this.style.color='#fff'}"
                                                onmouseout="if(!this.disabled){this.style.background='var(--primary-light)';this.style.color='var(--primary)'}">
                                            @if (resendingId == u.Id)
                                            {
                                                <span class="spinner" style="width:13px;height:13px;border-width:2px;display:inline-block;"></span>
                                            }
                                            else if (resendCooldowns.TryGetValue(u.Id, out var txtCd) && txtCd > 0)
                                            {
                                                <span style="font-size:11px;font-weight:700;line-height:1;">@txtCd</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-envelope-fill" style="font-size:13px;"></i>
                                            }
                                        </button>
                                        <button title="Hapus Akun"
                                                @onclick="() => { confirmDeleteId = u.Id; confirmDeleteEmail = u.Email; }"
                                                style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:#fef2f2;color:#ef4444;border:none;cursor:pointer;transition:all .15s;"
                                                onmouseover="this.style.background='#ef4444';this.style.color='#fff'"
                                                onmouseout="this.style.background='#fef2f2';this.style.color='#ef4444'">
                                            <i class="bi bi-trash-fill" style="font-size:13px;"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <NavLink href="@($"/edit-pengguna/{u.Id}")" title="Edit"
                                             style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:var(--primary-light);color:var(--primary);text-decoration:none;transition:all .15s;"
                                             onmouseover="this.style.background='var(--primary)';this.style.color='#fff'"
                                             onmouseout="this.style.background='var(--primary-light)';this.style.color='var(--primary)'">
                                        <i class="bi bi-pencil-fill" style="font-size:13px;"></i>
                                    </NavLink>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>

    @if (TotalFilteredItems > 0)
    {
        <SistemBeritaAcara.Web.Components.Shared.Pagination
            CurrentPage="@currentPage"
            TotalItems="@TotalFilteredItems"
            PageSize="@pageSize"
            CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
    }
}

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private List<ApplicationUser> allUsers = new();
    private string roleFilter = "";
    private bool showInactive = false;
    private bool showRoleDropdown = false;

    private int? confirmDeleteId;
    private string? confirmDeleteEmail;
    private int? resendingId;
    private string toastMsg = string.Empty;
    private bool toastIsError = false;
    private System.Threading.Timer? _toastTimer;

    // Cooldown kirim ulang per user (userId → detik tersisa)
    private Dictionary<int, int> resendCooldowns = new();
    private System.Threading.Timer? _cooldownTimer;

    private int currentPage = 1;
    private int pageSize = 10;
    private string _search = string.Empty;
    private string search
    {
        get => _search;
        set { _search = value; currentPage = 1; }
    }

    private (int Total, int AdminIT, int AdminBA, int Reviewer) stats;

    private int TotalFilteredItems => allUsers
        .Where(u => (u.EmailConfirmed && (showInactive || !u.IsDeleted)) || (!u.EmailConfirmed && !u.IsDeleted))
        .Where(u => string.IsNullOrEmpty(roleFilter) || u.Role == roleFilter)
        .Count(u => string.IsNullOrEmpty(search) ||
                    (u.Nama != null && u.Nama.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (u.Email != null && u.Email.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (u.Pegawai != null && u.Pegawai.NoPekerja != null && u.Pegawai.NoPekerja.Contains(search, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<ApplicationUser> FilteredUsers => allUsers
        .Where(u => (u.EmailConfirmed && (showInactive || !u.IsDeleted)) || (!u.EmailConfirmed && !u.IsDeleted))
        .Where(u => string.IsNullOrEmpty(roleFilter) || u.Role == roleFilter)
        .Where(u => string.IsNullOrEmpty(search) ||
                    (u.Nama != null && u.Nama.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (u.Email != null && u.Email.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (u.Pegawai != null && u.Pegawai.NoPekerja != null && u.Pegawai.NoPekerja.Contains(search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(u => u.EmailConfirmed ? 1 : 0) 
        .ThenBy(u => u.Nama)
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        isLoading = false;
    }

    private async Task LoadUsersAsync()
    {
        allUsers = await DbCtx.Users
            .Include(u => u.Pegawai)
            .OrderBy(u => u.Nama)
            .ToListAsync();

        stats.Total    = allUsers.Count(u => u.EmailConfirmed && !u.IsDeleted);
        stats.AdminIT  = allUsers.Count(u => u.EmailConfirmed && u.Role == "AdminIT"  && !u.IsDeleted);
        stats.AdminBA  = allUsers.Count(u => u.EmailConfirmed && u.Role == "AdminBA"  && !u.IsDeleted);
        stats.Reviewer = allUsers.Count(u => u.EmailConfirmed && u.Role == "Reviewer" && !u.IsDeleted);
    }

    private async Task ResendInvitationAsync(ApplicationUser user)
    {
        if (resendCooldowns.TryGetValue(user.Id, out var cd) && cd > 0) return;

        resendingId = user.Id;
        try
        {
            var token   = await UserManager.GeneratePasswordResetTokenAsync(user);
            var baseUrl = Config["App:BaseUrl"] ?? "http://localhost:5000";
            _ = EmailService.SendUserInvitationAsync(user.Email!, user.Nama ?? user.Email!, token, baseUrl);
            ShowToast("Undangan berhasil dikirim ulang ke " + user.Email, isError: false);

            // Mulai cooldown 60 detik untuk user ini
            resendCooldowns[user.Id] = 60;
            if (_cooldownTimer == null)
            {
                _cooldownTimer = new System.Threading.Timer(_ =>
                {
                    var keys = resendCooldowns.Keys.ToList();
                    foreach (var k in keys)
                    {
                        if (resendCooldowns[k] > 0)
                            resendCooldowns[k]--;
                        if (resendCooldowns[k] <= 0)
                            resendCooldowns.Remove(k);
                    }
                    InvokeAsync(StateHasChanged);
                    if (resendCooldowns.Count == 0)
                    {
                        _cooldownTimer?.Dispose();
                        _cooldownTimer = null;
                    }
                }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
            }
        }
        catch
        {
            ShowToast("Gagal mengirim ulang undangan. Coba lagi.", isError: true);
        }
        finally
        {
            resendingId = null;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (confirmDeleteId is null) return;
        isProcessing = true;
        try
        {
            var user = allUsers.FirstOrDefault(u => u.Id == confirmDeleteId);
            if (user != null)
            {
                DbCtx.Users.Remove(user);
                await DbCtx.SaveChangesAsync();
                await LoadUsersAsync();
                ShowToast("Akun berhasil dihapus.", isError: false);
            }
        }
        catch
        {
            ShowToast("Gagal menghapus akun. Coba lagi.", isError: true);
        }
        finally
        {
            isProcessing = false;
            confirmDeleteId = null;
            confirmDeleteEmail = null;
        }
    }

    private void ShowToast(string message, bool isError)
    {
        _toastTimer?.Dispose();
        toastMsg = message;
        toastIsError = isError;
        StateHasChanged();
        _toastTimer = new System.Threading.Timer(_ =>
        {
            toastMsg = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 3500, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        _toastTimer?.Dispose();
        _cooldownTimer?.Dispose();
    }

    private static string GetRolePill(string role) => role switch
    {
        "AdminIT"           => "pill-admin-it",
        "AdminBA" => "pill-admin-gudang",
        "Reviewer"          => "pill-reviewer",
        _                   => "pill-draft"
    };

    private static string GetRoleLabel(string role) => role switch
    {
        "AdminIT"           => "Admin IT",
        "AdminBA" => "Admin BA",
        "Reviewer"          => "Reviewer",
        _                   => role
    };
}
