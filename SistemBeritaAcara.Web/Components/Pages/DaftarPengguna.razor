@page "/pengguna"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SistemBeritaAcara.Core.Entities
@using SistemBeritaAcara.Infrastructure.Data
@inject AppDbContext DbCtx
@inject NavigationManager Navigation

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminIT")]

@if (isLoading)
{
    <div class="page-loading">
        <div class="spinner"></div>
    </div>
}
else
{
    <div class="page-header d-flex align-center justify-between">
        <div>
        </div>
        <NavLink class="btn btn-primary" href="/tambah-pengguna">
            <i class="bi bi-plus-lg"></i>
            Tambah Pengguna
        </NavLink>
    </div>

    <div class="stat-cards" style="margin-bottom:24px;grid-template-columns:repeat(5,1fr);">
        <div class="stat-card">
            <div class="stat-card-icon total"><i class="bi bi-people"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Total Pengguna</div>
                <div class="stat-card-value">@stats.Total</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon total"><i class="bi bi-shield-fill"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Super Admin</div>
                <div class="stat-card-value" style="color:#7c3aed;">@stats.SuperAdmin</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon neutral"><i class="bi bi-shield-lock"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Admin IT</div>
                <div class="stat-card-value">@stats.AdminIT</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon approved"><i class="bi bi-box-seam"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Admin Gudang & Barang</div>
                <div class="stat-card-value green">@stats.AdminGudang</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-icon progress"><i class="bi bi-person-check"></i></div>
            <div class="stat-card-info">
                <div class="stat-card-label">Reviewer</div>
                <div class="stat-card-value blue">@stats.Reviewer</div>
            </div>
        </div>
    </div>

    <div class="search-bar">
        <div class="search-input" style="max-width:320px;">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Cari nama atau email..."
                   @bind="search" @bind:event="oninput" />
        </div>
        <div style="position:relative;">
            <div @onclick="() => showRoleDropdown = !showRoleDropdown"
                 style="padding:8px 14px;cursor:pointer;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);font-size:14px;display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:180px;">
                <span style="font-weight:500;">@(string.IsNullOrEmpty(roleFilter) ? "Semua Role" : GetRoleLabel(roleFilter))</span>
                <i class="bi bi-chevron-down" style="font-size:11px;color:var(--text-muted);transition:transform 0.2s;@(showRoleDropdown ? "transform:rotate(180deg);" : "")"></i>
            </div>
            @if (showRoleDropdown)
            {
                <div @onclick="() => showRoleDropdown = false" style="position:fixed;inset:0;z-index:99;"></div>
                <div style="position:absolute;top:100%;left:0;z-index:100;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-md);min-width:180px;margin-top:4px;overflow:hidden;">
                    @foreach (var role in new[] { "", "AdminIT", "AdminGudangBarang", "Reviewer" })
                    {
                        var label = string.IsNullOrEmpty(role) ? "Semua Role" : GetRoleLabel(role);
                        <div @onclick="@(() => { roleFilter = role; showRoleDropdown = false; })"
                             style="padding:10px 14px;cursor:pointer;font-size:14px;font-weight:@(roleFilter == role ? "600" : "400");background:@(roleFilter == role ? "var(--primary)" : "transparent");color:@(roleFilter == role ? "white" : "var(--text-primary)");"
                             onmouseover="if(this.style.background !== 'var(--primary)') this.style.background='var(--primary-light)'"
                             onmouseout="if(this.style.background !== 'var(--primary)') this.style.background='transparent'">
                            @label
                        </div>
                    }
                </div>
            }
        </div>
        <label class="toggle-wrapper" style="cursor:pointer;display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-secondary);">
            <div class="toggle-switch @(showInactive ? "active" : "")" @onclick="() => showInactive = !showInactive"></div>
            <span>Tampilkan Non-Aktif</span>
        </label>
    </div>

    <div class="card">
        @if (!FilteredUsers.Any())
        {
            <div style="text-align:center;padding:48px;color:var(--text-muted);">
                <i class="bi bi-people" style="font-size:36px;display:block;margin-bottom:12px;"></i>
                <div style="font-weight:600;margin-bottom:4px;">Tidak ada pengguna ditemukan</div>
                <div style="font-size:13px;">Coba ubah filter pencarian atau tambah pengguna baru.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nama/No. Pekerja</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in FilteredUsers)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">@u.Nama</div>
                                <div class="cell-sub">No. Pekerja: @(u.Pegawai?.NoPekerja ?? "-")</div>
                            </td>
                            <td>@u.Email</td>
                            <td>
                                @if (u.IsSuperAdmin)
                                {
                                    <span class="pill" style="background:#7c3aed;color:white;">Super Admin</span>
                                }
                                else
                                {
                                    <span class="pill @GetRolePill(u.Role)">@GetRoleLabel(u.Role)</span>
                                }
                            </td>

                            <td>
                                @if (!u.IsDeleted)
                                {
                                    <span class="status-dot active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-dot inactive">Nonaktif</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <NavLink href="@($"/edit-pengguna/{u.Id}")" title="Edit"
                                         style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:8px;background:var(--primary-light);color:var(--primary);text-decoration:none;transition:all .15s;"
                                         onmouseover="this.style.background='var(--primary)';this.style.color='#fff'"
                                         onmouseout="this.style.background='var(--primary-light)';this.style.color='var(--primary)'">
                                    <i class="bi bi-pencil-fill" style="font-size:13px;"></i>
                                </NavLink>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>

    @if (TotalFilteredItems > 0)
    {
        <SistemBeritaAcara.Web.Components.Shared.Pagination
            CurrentPage="@currentPage"
            TotalItems="@TotalFilteredItems"
            PageSize="@pageSize"
            CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
    }
}

@code {
    private bool isLoading = true;
    private List<ApplicationUser> allUsers = new();
    private string roleFilter = "";
    private bool showInactive = false;
    private bool showRoleDropdown = false;
    private string errorMsg = string.Empty;
    private (int Total, int SuperAdmin, int AdminIT, int AdminGudang, int Reviewer) stats;

    private int currentPage = 1;
    private int pageSize = 10;
    private string _search = string.Empty;
    private string search 
    {
        get => _search;
        set 
        {
            _search = value;
            currentPage = 1; // reset page saat pencarian berubah
        }
    }

    private int TotalFilteredItems => allUsers
        .Where(u => u.EmailConfirmed)
        .Where(u => showInactive || !u.IsDeleted)
        .Where(u => string.IsNullOrEmpty(roleFilter) || u.Role == roleFilter)
        .Count(u => string.IsNullOrEmpty(search) ||
                    (u.Nama != null && u.Nama.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (u.Email != null && u.Email.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                    (u.Pegawai != null && u.Pegawai.NoPekerja != null && u.Pegawai.NoPekerja.Contains(search, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<ApplicationUser> FilteredUsers
    {
        get
        {
            var query = allUsers
                .Where(u => u.EmailConfirmed)
                .Where(u => showInactive || !u.IsDeleted)
                .Where(u => string.IsNullOrEmpty(roleFilter) || u.Role == roleFilter)
                .Where(u => string.IsNullOrEmpty(search) ||
                            (u.Nama != null && u.Nama.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                            (u.Email != null && u.Email.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                            (u.Pegawai != null && u.Pegawai.NoPekerja != null && u.Pegawai.NoPekerja.Contains(search, StringComparison.OrdinalIgnoreCase)));

            return query.OrderBy(u => u.Nama).Skip((currentPage - 1) * pageSize).Take(pageSize);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        allUsers = await DbCtx.Users
            .Include(u => u.Pegawai)
            .OrderBy(u => u.Nama)
            .ToListAsync();

        stats.Total      = allUsers.Count(u => u.EmailConfirmed && !u.IsDeleted);
        stats.SuperAdmin = allUsers.Count(u => u.EmailConfirmed && u.IsSuperAdmin && !u.IsDeleted);
        stats.AdminIT    = allUsers.Count(u => u.EmailConfirmed && u.Role == "AdminIT" && !u.IsSuperAdmin && !u.IsDeleted);
        stats.AdminGudang = allUsers.Count(u => u.EmailConfirmed && u.Role == "AdminGudangBarang" && !u.IsDeleted);
        stats.Reviewer   = allUsers.Count(u => u.EmailConfirmed && u.Role == "Reviewer" && !u.IsDeleted);

        isLoading = false;
    }

    private static string GetRolePill(string role) => role switch
    {
        "AdminIT" => "pill-admin-it",
        "AdminGudangBarang" => "pill-admin-gudang",
        "Reviewer" => "pill-reviewer",
        _ => "pill-draft"
    };

    private static string GetRoleLabel(string role) => role switch
    {
        "AdminIT" => "Admin IT",
        "AdminGudangBarang" => "Admin Gudang & Barang",
        "Reviewer" => "Reviewer",
        _ => role
    };
}
