@page "/archive"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IExcelService ExcelService
@inject IJSRuntime JS

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable

<PageTitle>Archive — Sistem Berita Acara</PageTitle>

@if ((currentRole == "AdminGudangBarang" || currentRole == "Reviewer") && !isLoading && allBA.Count > 0)
{
    <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
        <button class="btn btn-primary btn-sm @(isExporting ? "btn-loading" : "")"
                @onclick="ExportExcelAsync" disabled="@isExporting"
                style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
            <span>Export ke Excel</span>
        </button>
    </div>
}

<div class="card" style="margin-bottom:16px;overflow:visible;padding:0;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr auto;align-items:start;">

        <div style="border-right:1px solid var(--border-light);padding:10px 14px;">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;">No. Surat</div>
            <div style="display:flex;align-items:center;gap:8px;height:36px;box-sizing:border-box;border:1px solid var(--border);border-radius:var(--radius);padding:0 10px;background:var(--surface);">
                <input type="text" placeholder="Cari nomor..."
                       style="border:none;outline:none;background:transparent;width:100%;font-size:13px;color:var(--text-primary);padding:0;font-family:inherit;"
                       @bind="search" @bind:event="oninput" />
                <i class="bi bi-search" style="color:var(--text-muted);font-size:12px;flex-shrink:0;"></i>
            </div>
        </div>

        <div style="border-right:1px solid var(--border-light);padding:10px 14px;position:relative;">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;">Pihak Terkait</div>
            <button @onclick="ToggleNamePopover"
                    style="display:flex;align-items:center;gap:8px;height:36px;width:100%;border:1px solid var(--border);border-radius:var(--radius);padding:0 10px;background:var(--surface);cursor:pointer;text-align:left;box-sizing:border-box;font-family:inherit;">
                <span style="font-size:13px;color:@(HasNameFilter ? "var(--text-primary)" : "var(--text-muted)");flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                    @(HasNameFilter ? GetNameFilterSummary() : "Cari nama...")
                </span>
                <i class="bi bi-chevron-@(showNamePopover ? "up" : "down")" style="color:var(--text-muted);font-size:11px;flex-shrink:0;transition:transform .2s;"></i>
            </button>

            @if (showNamePopover)
            {
                <div style="position:fixed;inset:0;z-index:99;" @onclick="() => showNamePopover = false"></div>
                <div style="position:absolute;top:calc(100% + 4px);left:0;min-width:280px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-lg);z-index:100;padding:16px;">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);margin-bottom:12px;text-transform:uppercase;letter-spacing:.05em;">Filter Nama</div>

                    <div style="margin-bottom:12px;">
                        <label style="font-size:12px;color:var(--text-secondary);font-weight:600;display:block;margin-bottom:4px;">
                            Yang Menyerahkan
                        </label>
                        <input type="text" placeholder="" @bind="menyerahkanSearch" @bind:event="oninput"
                               style="width:100%;border:1px solid var(--border);border-radius:var(--radius-sm);padding:7px 10px;font-size:13px;outline:none;background:var(--bg);color:var(--text-primary);box-sizing:border-box;" />
                    </div>

                    <div style="margin-bottom:12px;">
                        <label style="font-size:12px;color:var(--text-secondary);font-weight:600;display:block;margin-bottom:4px;">
                            Yang Mengetahui
                        </label>
                        <input type="text" placeholder="" @bind="mengetahuiSearch" @bind:event="oninput"
                               style="width:100%;border:1px solid var(--border);border-radius:var(--radius-sm);padding:7px 10px;font-size:13px;outline:none;background:var(--bg);color:var(--text-primary);box-sizing:border-box;" />
                    </div>

                    <div>
                        <label style="font-size:12px;color:var(--text-secondary);font-weight:600;display:block;margin-bottom:4px;">
                            Yang Menerima
                        </label>
                        <input type="text" placeholder="" @bind="pjSearch" @bind:event="oninput"
                               style="width:100%;border:1px solid var(--border);border-radius:var(--radius-sm);padding:7px 10px;font-size:13px;outline:none;background:var(--bg);color:var(--text-primary);box-sizing:border-box;" />
                    </div>

                    @if (HasNameFilter)
                    {
                        <button @onclick="ClearNameFilters"
                                style="margin-top:12px;width:100%;background:none;border:1px solid var(--border);border-radius:var(--radius-sm);padding:6px;font-size:12px;color:var(--text-secondary);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px;">
                            <i class="bi bi-x-circle"></i> Hapus Filter Nama
                        </button>
                    }
                </div>
            }
        </div>

        <div style="border-right:1px solid var(--border-light);padding:10px 14px;">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;">Keterangan</div>
            <div style="display:flex;align-items:center;gap:8px;height:36px;box-sizing:border-box;border:1px solid var(--border);border-radius:var(--radius);padding:0 10px;background:var(--surface);">
                <input type="text" placeholder="Cari keterangan/barang..."
                       style="border:none;outline:none;background:transparent;width:100%;font-size:13px;color:var(--text-primary);padding:0;font-family:inherit;"
                       @bind="keteranganSearch" @bind:event="oninput" />
                <i class="bi bi-search" style="color:var(--text-muted);font-size:12px;flex-shrink:0;"></i>
            </div>
        </div>

        <div style="border-right:1px solid var(--border-light);padding:10px 14px;min-width:200px;">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;">Tanggal</div>
            <DatePicker Value="dateFilter"
                        ValueChanged="v => dateFilter = v"
                        Placeholder="Semua tanggal"
                        InputPadding="6px 10px" />
        </div>

        <div style="padding:10px 14px;position:relative;">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;">Jenis Berita Acara</div>
            <div @onclick="() => showJenisDropdown = !showJenisDropdown"
                 style="display:flex;align-items:center;justify-content:space-between;gap:8px;height:36px;box-sizing:border-box;border:1px solid var(--border);border-radius:var(--radius);padding:0 10px;background:var(--surface);cursor:pointer;min-width:150px;white-space:nowrap;">
                <span style="font-size:13px;color:var(--text-primary);">@(string.IsNullOrEmpty(jenisFilter) ? "Semua Jenis" : jenisFilter)</span>
                <i class="bi bi-chevron-down" style="font-size:11px;color:var(--text-muted);transition:transform 0.2s;@(showJenisDropdown ? "transform:rotate(180deg);" : "")"></i>
            </div>
            @if (showJenisDropdown)
            {
                <div @onclick="() => showJenisDropdown = false" style="position:fixed;inset:0;z-index:99;"></div>
                <div style="position:absolute;top:calc(100% + 4px);right:0;z-index:100;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-md);min-width:150px;overflow:hidden;">
                    @foreach (var jenis in new[] { "", "Alokasi", "Peminjaman", "Penarikan", "Lainnya" })
                    {
                        var label = string.IsNullOrEmpty(jenis) ? "Semua Jenis" : jenis;
                        <div @onclick="@(() => { jenisFilter = jenis; showJenisDropdown = false; currentPage = 1; })"
                             style="padding:10px 14px;cursor:pointer;font-size:13px;font-weight:@(jenisFilter == jenis ? "600" : "400");background:@(jenisFilter == jenis ? "var(--primary)" : "transparent");color:@(jenisFilter == jenis ? "white" : "var(--text-primary)");"
                             onmouseover="if(this.style.background !== 'var(--primary)') this.style.background='var(--primary-light)'"
                             onmouseout="if(this.style.background !== 'var(--primary)') this.style.background='transparent'">
                            @label
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (HasActiveFilter)
    {
        <div style="padding:8px 16px;display:flex;align-items:center;justify-content:space-between;background:var(--bg);border-top:1px solid var(--border-light);">
            <span style="font-size:13px;color:var(--text-secondary);">
                <strong>@TotalFilteredItems</strong> dari <strong>@allBA.Count</strong> dokumen
            </span>
            <button @onclick="ClearFilters" style="background:none;border:none;cursor:pointer;font-size:13px;color:var(--primary);font-weight:500;padding:0;display:flex;align-items:center;gap:4px;">
                <i class="bi bi-x-circle"></i> Bersihkan semua
            </button>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else if (!FilteredBA.Any())
{
    <div class="card" style="text-align:center;padding:60px;">
        <i class="bi bi-archive" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;margin-bottom:8px;">
            @(HasActiveFilter ? "Tidak ada hasil yang cocok" : "Belum ada arsip")
        </div>
        <div style="font-size:14px;color:var(--text-secondary);">
            @(HasActiveFilter ? "Coba ubah atau bersihkan filter pencarian." : "Berita Acara yang disetujui akan muncul di sini.")
        </div>
    </div>
}
else
{
    <div class="card" style="overflow:hidden;padding:0;">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nomor Surat</th>
                        <th>Jenis Berita Acara</th>
                        <th>Keterangan</th>
                        <th>Tanggal</th>
                        <th style="width:90px;text-align:center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ba in FilteredBA)
                    {
                        <tr style="cursor:pointer;" @onclick="@(() => Navigation.NavigateTo($"/berita-acara/{ba.Id}?from=archive"))">
                            <td>
                                <div class="cell-main" style="font-weight:600;">@ba.NomorSurat</div>
                            </td>
                            <td>
                                <span class="pill @GetJenisPill(ba.Jenis)">@ba.Jenis</span>
                            </td>
                            <td>
                                <div class="cell-main">
                                    @if (ba.Jenis == "Lainnya")
                                    {
                                        @(ba.Keterangan ?? "—")
                                    }
                                    else
                                    {
                                        @(ba.Perangkat?.FirstOrDefault()?.Barang?.NamaBarang ?? "—")
                                    }
                                </div>
                            </td>
                            <td style="white-space:nowrap;">@ba.Tanggal.ToString("dd MMM yyyy")</td>
                            <td>
                                <div style="display:flex;align-items:center;justify-content:center;gap:6px;" @onclick:stopPropagation>
                                    @if (!string.IsNullOrEmpty(ba.DocxFinalPath) || !string.IsNullOrEmpty(ba.DocxPath))
                                    {
                                        <button class="btn-icon" title="Pratinjau" @onclick="@(() => previewBaId = ba.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a href="/api/ba/@ba.Id/download" download class="btn-icon" title="Unduh">
                                            <i class="bi bi-download"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (TotalFilteredItems > 0)
    {
        <SistemBeritaAcara.Web.Components.Shared.Pagination
            CurrentPage="@currentPage"
            TotalItems="@TotalFilteredItems"
            PageSize="@pageSize"
            CurrentPageChanged="@(p => { currentPage = p; StateHasChanged(); })" />
    }
}

@if (previewBaId.HasValue)
{
    <div class="modal-overlay" @onclick="() => previewBaId = null">
        <div class="modal-content" @onclick:stopPropagation
             style="width:90%;max-width:920px;height:88vh;padding:0;border-radius:var(--radius-lg);overflow:hidden;">
            <iframe src="/api/preview/pdf/@previewBaId#toolbar=1&navpanes=0"
                    style="width:100%;height:100%;border:none;display:block;"
                    title="Pratinjau BA"></iframe>
        </div>
    </div>
}

@code {
    private List<BeritaAcaraEntity> allBA = new();
    private bool isLoading = true;
    private bool isExporting = false;
    private string currentRole = string.Empty;
    private int currentUserId;
    private bool showNamePopover = false;
    private bool showJenisDropdown = false;
    private int? previewBaId;

    private string _search = string.Empty;
    private string search
    {
        get => _search;
        set { _search = value; currentPage = 1; }
    }

    private string _pjSearch = string.Empty;
    private string pjSearch
    {
        get => _pjSearch;
        set { _pjSearch = value; currentPage = 1; }
    }

    private string _menyerahkanSearch = string.Empty;
    private string menyerahkanSearch
    {
        get => _menyerahkanSearch;
        set { _menyerahkanSearch = value; currentPage = 1; }
    }

    private string _mengetahuiSearch = string.Empty;
    private string mengetahuiSearch
    {
        get => _mengetahuiSearch;
        set { _mengetahuiSearch = value; currentPage = 1; }
    }

    private string _jenisFilter = string.Empty;
    private string jenisFilter
    {
        get => _jenisFilter;
        set { _jenisFilter = value; currentPage = 1; }
    }

    private string _keteranganSearch = string.Empty;
    private string keteranganSearch
    {
        get => _keteranganSearch;
        set { _keteranganSearch = value; currentPage = 1; }
    }

    private DateTime? _dateFilter;
    private DateTime? dateFilter
    {
        get => _dateFilter;
        set { _dateFilter = value; currentPage = 1; }
    }

    private int currentPage = 1;
    private int pageSize = 10;

    private bool HasNameFilter =>
        !string.IsNullOrEmpty(pjSearch) ||
        !string.IsNullOrEmpty(menyerahkanSearch) ||
        !string.IsNullOrEmpty(mengetahuiSearch);

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(search) ||
        HasNameFilter ||
        !string.IsNullOrEmpty(jenisFilter) ||
        !string.IsNullOrEmpty(keteranganSearch) ||
        dateFilter.HasValue;

    private string GetNameFilterSummary()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(menyerahkanSearch)) parts.Add(menyerahkanSearch);
        if (!string.IsNullOrEmpty(pjSearch)) parts.Add(pjSearch);
        if (!string.IsNullOrEmpty(mengetahuiSearch)) parts.Add(mengetahuiSearch);
        return string.Join(", ", parts);
    }

    private void ToggleNamePopover() => showNamePopover = !showNamePopover;

    private void ClearNameFilters()
    {
        pjSearch = string.Empty;
        menyerahkanSearch = string.Empty;
        mengetahuiSearch = string.Empty;
        currentPage = 1;
    }

    private IEnumerable<BeritaAcaraEntity> ApplyFilters(IEnumerable<BeritaAcaraEntity> src) => src
        .Where(b => string.IsNullOrEmpty(search) ||
                    (b.NomorSurat ?? "").Contains(search, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(pjSearch) ||
                    (b.Pj?.Nama ?? "").Contains(pjSearch, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(menyerahkanSearch) ||
                    (b.Menyerahkan?.Nama ?? "").Contains(menyerahkanSearch, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(mengetahuiSearch) ||
                    (b.Mengetahui?.Nama ?? "").Contains(mengetahuiSearch, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(jenisFilter) ||
                    b.Jenis.Equals(jenisFilter, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(keteranganSearch) ||
                    (b.Jenis == "Lainnya"
                        ? (b.Keterangan ?? "").Contains(keteranganSearch, StringComparison.OrdinalIgnoreCase)
                        : (b.Perangkat?.FirstOrDefault()?.Barang?.NamaBarang ?? "").Contains(keteranganSearch, StringComparison.OrdinalIgnoreCase)))
        .Where(b => !dateFilter.HasValue || b.Tanggal == DateOnly.FromDateTime(dateFilter.Value));

    private int TotalFilteredItems => ApplyFilters(allBA).Count();

    private IEnumerable<BeritaAcaraEntity> FilteredBA =>
        ApplyFilters(allBA).Skip((currentPage - 1) * pageSize).Take(pageSize);

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        "Penarikan" => "pill-penarikan",
        _ => "pill-lainnya"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var appUser = await UserManager.FindByEmailAsync(auth.User.Identity?.Name ?? "");
            if (appUser is null) { Navigation.NavigateTo("/login", true); return; }
            currentRole = appUser.Role;
            currentUserId = appUser.Id;

            IQueryable<BeritaAcaraEntity> query = DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj)
                .Include(b => b.Menyerahkan)
                .Include(b => b.Mengetahui)
                .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                .Where(b => b.Status == "Approved" || b.Status == "Archived");

            allBA = await query.OrderByDescending(b => b.ApprovedAt).ToListAsync();
            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ArsipBA] OnInitializedAsync error: {ex.Message}");
            isLoading = false;
        }
    }

    private void ClearFilters()
    {
        search = string.Empty;
        pjSearch = string.Empty;
        menyerahkanSearch = string.Empty;
        mengetahuiSearch = string.Empty;
        jenisFilter = string.Empty;
        keteranganSearch = string.Empty;
        dateFilter = null;
        showNamePopover = false;
        showJenisDropdown = false;
        currentPage = 1;
    }

    private async Task ExportExcelAsync()
    {
        isExporting = true;
        try
        {
            var dataToExport = FilteredBA.ToList();
            var bytes = await ExcelService.ExportArsipAsync(dataToExport, Navigation.BaseUri);
            var fileName = $"ArsipBA_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task ReloadArchiveAsync()
    {
        try
        {
            DbContext.ChangeTracker.Clear();
            IQueryable<BeritaAcaraEntity> query = DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj)
                .Include(b => b.Menyerahkan)
                .Include(b => b.Mengetahui)
                .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                .Where(b => b.Status == "Approved" || b.Status == "Archived");
            allBA = await query.OrderByDescending(b => b.ApprovedAt).ToListAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ArsipBA] ReloadArchiveAsync error: {ex.Message}");
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _ = ConnectSignalRAsync();
        return Task.CompletedTask;
    }

    private HubConnection? _hubConnection;

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/ba"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On("BaListUpdated", async () =>
            {
                await InvokeAsync(async () =>
                {
                    await ReloadArchiveAsync();
                    StateHasChanged();
                });
            });

            await _hubConnection.StartAsync();
        }
        catch
        {
            // SignalR gagal connect — halaman tetap berjalan normal tanpa real-time
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.StopAsync();
            await _hubConnection.DisposeAsync();
        }
    }
}
