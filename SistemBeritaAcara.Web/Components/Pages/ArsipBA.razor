@page "/archive"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IExcelService ExcelService
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Archive — Sistem Berita Acara</PageTitle>

@if (currentRole == "AdminGudangBarang" && !isLoading && allBA.Count > 0)
{
    <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
        <button class="btn btn-primary btn-sm @(isExporting ? "btn-loading" : "")"
                @onclick="ExportExcelAsync" disabled="@isExporting"
                style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
            <i class="bi bi-file-earmark-excel"></i>
            <span>Export ke Excel</span>
        </button>
    </div>
}

<!-- Filter Panel -->
<div class="card" style="margin-bottom:16px;overflow:hidden;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;border-bottom:1px solid var(--border-light);">
        <div style="padding:0;border-right:1px solid var(--border-light);">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;padding:10px 16px 6px;">No. Surat</div>
            <div style="display:flex;align-items:center;gap:8px;padding:0 16px 10px;">
                <i class="bi bi-search" style="color:var(--text-muted);font-size:13px;flex-shrink:0;"></i>
                <input type="text" placeholder="Cari nomor surat..."
                       style="border:none;outline:none;background:transparent;width:100%;font-size:14px;color:var(--text-primary);"
                       @bind="search" @bind:event="oninput" />
            </div>
        </div>
        <div style="padding:0;border-right:1px solid var(--border-light);">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;padding:10px 16px 6px;">Penanggung Jawab</div>
            <div style="display:flex;align-items:center;gap:8px;padding:0 16px 10px;">
                <i class="bi bi-person" style="color:var(--text-muted);font-size:13px;flex-shrink:0;"></i>
                <input type="text" placeholder="Nama PJ..."
                       style="border:none;outline:none;background:transparent;width:100%;font-size:14px;color:var(--text-primary);"
                       @bind="pjSearch" @bind:event="oninput" />
            </div>
        </div>
        <div style="padding:0;">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;padding:10px 16px 6px;">Yang Menyerahkan</div>
            <div style="display:flex;align-items:center;gap:8px;padding:0 16px 10px;">
                <i class="bi bi-person-badge" style="color:var(--text-muted);font-size:13px;flex-shrink:0;"></i>
                <input type="text" placeholder="Nama..."
                       style="border:none;outline:none;background:transparent;width:100%;font-size:14px;color:var(--text-primary);"
                       @bind="menyerahkanSearch" @bind:event="oninput" />
            </div>
        </div>
    </div>
    @if (HasActiveFilter)
    {
        <div style="padding:10px 16px;display:flex;align-items:center;justify-content:space-between;background:var(--bg);">
            <span style="font-size:13px;color:var(--text-secondary);">
                <strong>@FilteredBA.Count()</strong> dari <strong>@allBA.Count</strong> dokumen
            </span>
            <button @onclick="ClearFilters" style="background:none;border:none;cursor:pointer;font-size:13px;color:var(--primary);font-weight:500;padding:0;">
                <i class="bi bi-x-circle" style="margin-right:4px;"></i>Bersihkan
            </button>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat arsip...</span></div>
}
else if (!FilteredBA.Any())
{
    <div class="card" style="text-align:center;padding:60px;">
        <i class="bi bi-archive" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;margin-bottom:8px;">
            @(HasActiveFilter ? "Tidak ada hasil yang cocok" : "Belum ada arsip")
        </div>
        <div style="font-size:14px;color:var(--text-secondary);">
            @(HasActiveFilter ? "Coba ubah atau bersihkan filter pencarian." : "Berita Acara yang disetujui akan muncul di sini.")
        </div>
    </div>
}
else
{
    <div class="card" style="overflow:hidden;padding:0;">
        @foreach (var ba in FilteredBA)
        {
            <div class="arsip-row" @onclick="@(() => Navigation.NavigateTo($"/berita-acara/{ba.Id}?from=archive"))">
                <span class="pill pill-approved" style="flex-shrink:0;">DITERIMA</span>
                <span class="arsip-row-number">@ba.NomorSurat</span>
                <span class="arsip-row-jenis">@ba.Jenis</span>
                <div style="margin-left:auto;display:flex;align-items:center;gap:14px;flex-shrink:0;">
                    <span class="arsip-row-date">@ba.Tanggal.ToString("dd MMM yyyy")</span>
                    @if (!string.IsNullOrEmpty(ba.DocxFinalPath))
                    {
                        <a href="/@ba.DocxFinalPath" download
                           class="arsip-row-download"
                           @onclick:stopPropagation="true"
                           title="Unduh dokumen">
                            <i class="bi bi-download"></i>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<BeritaAcaraEntity> allBA = new();
    private bool isLoading = true;
    private bool isExporting = false;
    private string currentRole = string.Empty;
    private int currentUserId;

    private string search = string.Empty;
    private string pjSearch = string.Empty;
    private string menyerahkanSearch = string.Empty;
    private string mengetahuiSearch = string.Empty;

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(search) ||
        !string.IsNullOrEmpty(pjSearch) ||
        !string.IsNullOrEmpty(menyerahkanSearch);

    private IEnumerable<BeritaAcaraEntity> FilteredBA => allBA
        .Where(b => string.IsNullOrEmpty(search) ||
                    (b.NomorSurat ?? "").Contains(search, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(pjSearch) ||
                    (b.Pj?.Nama ?? "").Contains(pjSearch, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(menyerahkanSearch) ||
                    (b.Menyerahkan?.Nama ?? "").Contains(menyerahkanSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        currentRole = appUser!.Role;
        currentUserId = appUser.Id;

        IQueryable<BeritaAcaraEntity> query = DbContext.Set<BeritaAcaraEntity>()
            .Include(b => b.Pj)
            .Include(b => b.Menyerahkan)
            .Include(b => b.Mengetahui)
            .Where(b => b.Status == "Approved");

        if (currentRole == "AdminGudangBarang")
            query = query.Where(b => b.CreatedBy == currentUserId);
        else if (currentRole == "Approver")
            query = query.Where(b => b.MengetahuiId == currentUserId);

        allBA = await query.OrderByDescending(b => b.ApprovedAt).ToListAsync();
        isLoading = false;
    }

    private void ClearFilters()
    {
        search = string.Empty;
        pjSearch = string.Empty;
        menyerahkanSearch = string.Empty;
    }

    private async Task ExportExcelAsync()
    {
        isExporting = true;
        try
        {
            var dataToExport = FilteredBA.ToList();
            var bytes = await ExcelService.ExportArsipAsync(dataToExport);
            var fileName = $"ArsipBA_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        finally
        {
            isExporting = false;
        }
    }
}
