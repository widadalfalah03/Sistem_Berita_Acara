@page "/archive"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IExcelService ExcelService
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Archive — Sistem Berita Acara</PageTitle>

@if (currentRole == "AdminGudangBarang" && !isLoading && allBA.Count > 0)
{
    <div style="display:flex;justify-content:flex-end;margin-bottom:12px;">
        <button class="btn btn-primary btn-sm @(isExporting ? "btn-loading" : "")"
                @onclick="ExportExcelAsync" disabled="@isExporting"
                style="display:flex;align-items:center;gap:8px;">
            <i class="bi bi-file-earmark-excel"></i>
            <span>Export ke Excel</span>
        </button>
    </div>
}

<!-- Search & Filter Panel -->
<div class="card" style="margin-bottom:20px;padding:16px 20px;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px;">
        <!-- No. Surat -->
        <div>
            <label style="font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">No. Surat</label>
            <div class="search-input" style="max-width:100%;">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Cari nomor surat..." @bind="search" @bind:event="oninput" />
            </div>
        </div>

        <!-- Penanggung Jawab -->
        <div>
            <label style="font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">Penanggung Jawab</label>
            <div class="search-input" style="max-width:100%;">
                <i class="bi bi-person"></i>
                <input type="text" placeholder="Nama PJ..." @bind="pjSearch" @bind:event="oninput" />
            </div>
        </div>

        <!-- Yang Menyerahkan -->
        <div>
            <label style="font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">Yang Menyerahkan</label>
            <div class="search-input" style="max-width:100%;">
                <i class="bi bi-person-badge"></i>
                <input type="text" placeholder="Nama..." @bind="menyerahkanSearch" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;align-items:end;">
        <!-- Yang Mengetahui -->
        <div>
            <label style="font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">Yang Mengetahui</label>
            <div class="search-input" style="max-width:100%;">
                <i class="bi bi-person-check"></i>
                <input type="text" placeholder="Nama approver..." @bind="mengetahuiSearch" @bind:event="oninput" />
            </div>
        </div>

        <!-- Jenis BA -->
        <div>
            <label style="font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">Jenis BA</label>
            <select class="filter-select" style="width:100%;" @bind="jenisFilter">
                <option value="">Semua Jenis</option>
                <option value="Alokasi">Alokasi</option>
                <option value="Peminjaman">Peminjaman</option>
            </select>
        </div>

        <!-- Tanggal BA Dari -->
        <div>
            <label style="font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">Tanggal Dari</label>
            <input type="date" class="filter-select" style="width:100%;" @bind="dateFrom" />
        </div>

        <!-- Tanggal BA Sampai -->
        <div>
            <label style="font-size:12px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:6px;">Tanggal Sampai</label>
            <input type="date" class="filter-select" style="width:100%;" @bind="dateTo" />
        </div>
    </div>

    @if (HasActiveFilter)
    {
        <div style="margin-top:12px;display:flex;align-items:center;justify-content:space-between;">
            <span style="font-size:13px;color:var(--text-secondary);">
                Menampilkan <strong>@FilteredBA.Count()</strong> dari <strong>@allBA.Count</strong> dokumen
            </span>
            <button class="btn btn-outline btn-sm" @onclick="ClearFilters" style="display:flex;align-items:center;gap:6px;">
                <i class="bi bi-x-circle"></i> Bersihkan Filter
            </button>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div><span>Memuat arsip...</span></div>
}
else if (!FilteredBA.Any())
{
    <div class="card" style="text-align:center;padding:60px;">
        <i class="bi bi-archive" style="font-size:48px;color:var(--text-muted);display:block;margin-bottom:16px;"></i>
        <div style="font-size:18px;font-weight:700;margin-bottom:8px;">
            @(HasActiveFilter ? "Tidak ada hasil yang cocok" : "Belum ada arsip")
        </div>
        <div style="font-size:14px;color:var(--text-secondary);">
            @(HasActiveFilter ? "Coba ubah atau bersihkan filter pencarian." : "Berita Acara yang disetujui akan muncul di sini.")
        </div>
        @if (HasActiveFilter)
        {
            <button class="btn btn-outline btn-sm" @onclick="ClearFilters" style="margin-top:16px;display:inline-flex;align-items:center;gap:6px;">
                <i class="bi bi-x-circle"></i> Bersihkan Filter
            </button>
        }
    </div>
}
else
{
    @foreach (var ba in FilteredBA)
    {
        var fileName = string.IsNullOrEmpty(ba.DocxFinalPath)
            ? $"BA-{ba.NomorSurat ?? ba.Id.ToString()}.docx"
            : Path.GetFileName(ba.DocxFinalPath);

        <div class="ba-card">
            <div class="ba-card-left">
                <div class="ba-card-badge">
                    <span class="pill pill-approved">DITERIMA</span>
                </div>
                <div class="ba-card-number">@ba.NomorSurat</div>
                <div class="ba-card-title">Berita Acara @ba.Jenis</div>
                <div class="ba-card-jenis">PJ: @ba.Pj?.Nama</div>
                <div class="ba-card-person">
                    <i class="bi bi-person-check-fill"></i>
                    <div>
                        <div class="person-name">@ba.Mengetahui?.Nama</div>
                        <div class="person-role">Approver</div>
                    </div>
                </div>
                <div class="ba-card-date">
                    <i class="bi bi-calendar-check"></i>
                    <span>Disetujui: @ba.ApprovedAt?.ToString("dd MMMM yyyy")</span>
                </div>
            </div>
            <div class="ba-card-right">
                <!-- PDF/DOCX card -->
                <div class="pdf-card">
                    <div class="pdf-icon">
                        @(string.IsNullOrEmpty(ba.DocxFinalPath) ? "DOCX" : "PDF")
                    </div>
                    <div class="pdf-info">
                        <div class="pdf-name">@fileName</div>
                        <div class="pdf-size">Berita Acara Final</div>
                    </div>
                    @if (!string.IsNullOrEmpty(ba.DocxFinalPath))
                    {
                        <a href="/@ba.DocxFinalPath" download class="pdf-download" title="Download">
                            <i class="bi bi-download"></i>
                        </a>
                    }
                </div>

                <div style="display:flex;gap:12px;margin-top:8px;">
                    <NavLink class="btn btn-outline btn-sm" style="flex:1;" href="@($"/berita-acara/{ba.Id}?from=archive")">
                        <i class="bi bi-eye"></i> Pratinjau
                    </NavLink>
                    @if (!string.IsNullOrEmpty(ba.DocxFinalPath))
                    {
                        <a href="/@ba.DocxFinalPath" download class="btn btn-outline-primary btn-sm" style="flex:1;text-align:center;">
                            <i class="bi bi-download"></i> Unduh
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<BeritaAcaraEntity> allBA = new();
    private bool isLoading = true;
    private bool isExporting = false;
    private string currentRole = string.Empty;
    private int currentUserId;

    // Filter state
    private string search = string.Empty;
    private string pjSearch = string.Empty;
    private string menyerahkanSearch = string.Empty;
    private string mengetahuiSearch = string.Empty;
    private string jenisFilter = string.Empty;
    private DateTime? dateFrom;
    private DateTime? dateTo;

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(search) ||
        !string.IsNullOrEmpty(pjSearch) ||
        !string.IsNullOrEmpty(menyerahkanSearch) ||
        !string.IsNullOrEmpty(mengetahuiSearch) ||
        !string.IsNullOrEmpty(jenisFilter) ||
        dateFrom.HasValue ||
        dateTo.HasValue;

    private IEnumerable<BeritaAcaraEntity> FilteredBA => allBA
        .Where(b => string.IsNullOrEmpty(search) ||
                    (b.NomorSurat ?? "").Contains(search, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(pjSearch) ||
                    (b.Pj?.Nama ?? "").Contains(pjSearch, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(menyerahkanSearch) ||
                    (b.Menyerahkan?.Nama ?? "").Contains(menyerahkanSearch, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(mengetahuiSearch) ||
                    (b.Mengetahui?.Nama ?? "").Contains(mengetahuiSearch, StringComparison.OrdinalIgnoreCase))
        .Where(b => string.IsNullOrEmpty(jenisFilter) ||
                    b.Jenis.Equals(jenisFilter, StringComparison.OrdinalIgnoreCase))
        .Where(b => !dateFrom.HasValue || b.Tanggal >= DateOnly.FromDateTime(dateFrom.Value))
        .Where(b => !dateTo.HasValue || b.Tanggal <= DateOnly.FromDateTime(dateTo.Value));

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.FindByEmailAsync(auth.User.Identity!.Name!);
        currentRole = appUser!.Role;
        currentUserId = appUser.Id;

        IQueryable<BeritaAcaraEntity> query = DbContext.Set<BeritaAcaraEntity>()
            .Include(b => b.Pj)
            .Include(b => b.Menyerahkan)
            .Include(b => b.Mengetahui)
            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
            .Where(b => b.Status == "Approved");

        if (currentRole == "AdminGudangBarang")
            query = query.Where(b => b.CreatedBy == currentUserId);
        else if (currentRole == "Approver")
            query = query.Where(b => b.MengetahuiId == currentUserId);

        allBA = await query.OrderByDescending(b => b.ApprovedAt).ToListAsync();
        isLoading = false;
    }

    private void ClearFilters()
    {
        search = string.Empty;
        pjSearch = string.Empty;
        menyerahkanSearch = string.Empty;
        mengetahuiSearch = string.Empty;
        jenisFilter = string.Empty;
        dateFrom = null;
        dateTo = null;
    }

    private async Task ExportExcelAsync()
    {
        isExporting = true;
        try
        {
            var dataToExport = FilteredBA.ToList();
            var bytes = await ExcelService.ExportArsipAsync(dataToExport);
            var fileName = $"ArsipBA_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", bytes);
        }
        finally
        {
            isExporting = false;
        }
    }
}
