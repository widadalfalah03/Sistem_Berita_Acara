@page "/invitation"
@layout EmptyLayout
@using Microsoft.AspNetCore.Identity
@using SistemBeritaAcara.Core.Entities
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IJSRuntime JS
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Setup Akun — Sistem Berita Acara</PageTitle>

<div class="login-page">
    <div class="login-card" style="max-width:480px;width:100%;">
        <div class="login-card-body">
            <!-- Logo only, no text heading -->
            <div class="login-logo" style="display:flex;flex-direction:column;align-items:center;margin-bottom:8px;">
                <img src="/images/simba_logo_final.png" style="height:auto;max-height:280px;width:auto;max-width:100%;object-fit:contain;margin-top:-24px;margin-bottom:-16px;" alt="SIMBA" />
            </div>

            @if (isLoading)
            {
                <div style="text-align:center;padding:24px;">
                    <div class="spinner"></div>
                </div>
            }
            else if (invalidToken)
            {
                <div style="text-align:center;padding:24px;">
                    <i class="bi bi-x-circle-fill" style="font-size:48px;color:var(--danger);margin-bottom:16px;"></i>
                    <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;">Undangan Tidak Valid</h3>
                    <p style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                        Tautan undangan ini tidak valid atau telah kedaluwarsa. Silakan hubungi Administrator IT untuk meminta undangan baru.
                    </p>
                    <a href="/login" class="btn btn-outline" style="width:100%;">Kembali ke Login</a>
                </div>
            }
            else
            {
                @if (step == 1)
                {
                    <h3 style="font-size:16px;font-weight:700;margin-bottom:16px;text-align:center;">Buat Password Baru</h3>
                    <p style="font-size:13px;color:var(--text-secondary);text-align:center;margin-bottom:24px;">Silakan buat password untuk akun Anda sebelum mulai menggunakan sistem.</p>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="login-error" style="margin-bottom:16px;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            @errorMessage
                        </div>
                    }

                    <div class="form-group">
                        <input class="login-input" type="email" value="@email" readonly style="background:transparent; cursor:not-allowed;" placeholder="Email Address" />
                    </div>

                    <div class="form-group">
                        <div class="login-pw-wrap">
                            <input class="login-input" type="@pwType" @bind="newPassword" placeholder="Password Baru (Min. 8 Karakter)" />
                            <button type="button" class="login-pw-toggle" @onclick="TogglePwType" tabindex="-1">
                                <i class="bi @(pwType == "password" ? "bi-eye" : "bi-eye-slash")"></i>
                            </button>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom:24px;">
                        <div class="login-pw-wrap">
                            <input class="login-input" type="@pwType2" @bind="confirmPassword" placeholder="Konfirmasi Password" />
                            <button type="button" class="login-pw-toggle" @onclick="TogglePwType2" tabindex="-1">
                                <i class="bi @(pwType2 == "password" ? "bi-eye" : "bi-eye-slash")"></i>
                            </button>
                        </div>
                    </div>

                    <button class="login-btn" @onclick="ProcessStep1">
                        <span>Selanjutnya <i class="bi bi-arrow-right"></i></span>
                    </button>
                }
                else if (step == 2)
                {
                    <h3 style="font-size:16px;font-weight:700;margin-bottom:8px;text-align:center;">Buat Tanda Tangan</h3>
                    <p style="font-size:13px;color:var(--text-secondary);text-align:center;margin-bottom:16px;">Tanda tangan akan digunakan untuk menandatangani Berita Acara secara otomatis.</p>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="login-error" style="margin-bottom:12px;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            @errorMessage
                        </div>
                    }

                    <!-- Tab bar -->
                    <div style="display:flex;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:14px;">
                        <button @onclick='() => SwitchSetupMode("draw")'
                                style="flex:1;padding:9px 10px;font-size:13px;font-weight:600;border:none;cursor:pointer;transition:all .15s;background:@(setupTtdMode=="draw"?"var(--primary)":"transparent");color:@(setupTtdMode=="draw"?"white":"var(--text-secondary)");">
                            <i class="bi bi-pen-fill" style="margin-right:5px;"></i>Gambar
                        </button>
                        <button @onclick='() => SwitchSetupMode("upload")'
                                style="flex:1;padding:9px 10px;font-size:13px;font-weight:600;border:none;border-left:1px solid var(--border);cursor:pointer;transition:all .15s;background:@(setupTtdMode=="upload"?"var(--primary)":"transparent");color:@(setupTtdMode=="upload"?"white":"var(--text-secondary)");">
                            <i class="bi bi-cloud-upload-fill" style="margin-right:5px;"></i>Upload TTD
                        </button>
                    </div>

                    <!-- MODE: GAMBAR -->
                    <div style="display:@(setupTtdMode == "draw" ? "block" : "none")">
                        <div style="border:2px dashed var(--border);border-radius:var(--radius);background:var(--bg-card);margin-bottom:10px;overflow:hidden;">
                            <canvas id="setup-ttd-canvas" width="400" height="200"
                                    style="width:100%;height:160px;display:block;touch-action:none;cursor:crosshair;"></canvas>
                        </div>
                        <div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
                            <button class="btn btn-outline btn-sm" @onclick="ClearCanvasAsync">
                                <i class="bi bi-eraser"></i> Hapus
                            </button>
                        </div>
                    </div>

                    <!-- MODE: UPLOAD -->
                    <div style="display:@(setupTtdMode == "upload" ? "block" : "none")">
                        <label for="setup-ul-input" style="cursor:pointer;display:block;margin-bottom:10px;">
                            <div style="border:2px dashed var(--border);border-radius:var(--radius);background:var(--bg-card);padding:18px;text-align:center;"
                                 onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border)'">
                                <i class="bi bi-image" style="font-size:26px;color:var(--primary);display:block;margin-bottom:6px;"></i>
                                <div style="font-weight:600;font-size:13px;margin-bottom:2px;">Klik untuk pilih gambar</div>
                                <div style="font-size:11px;color:var(--text-muted);">JPG, PNG, JPEG · Maks. 5MB</div>
                            </div>
                            <input type="file" id="setup-ul-input" accept="image/*" style="display:none"
                                   onchange="ttdUpload.onFileChange('setup-ul-input', 'setup-ul-canvas', 'setup-ul-wrap')" />
                        </label>

                        <div id="setup-ul-wrap" style="display:none;margin-bottom:10px;">
                            <div style="background:white;border-radius:var(--radius);border:2px solid var(--border);padding:6px;min-height:60px;display:flex;align-items:center;justify-content:center;">
                                <canvas id="setup-ul-canvas" style="display:block;max-width:100%;height:auto;"></canvas>
                            </div>
                        </div>
                    </div>

                    <button class="login-btn" @onclick="ProcessStep2" disabled="@isSaving">
                        @if (isSaving)
                        {
                        }
                        else
                        {
                            <span>Selesai & Login <i class="bi bi-box-arrow-in-right"></i></span>
                        }
                    </button>
                }
            }
        </div>
    </div>
</div>


@code {
    [SupplyParameterFromQuery]
    public string email { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string token { get; set; } = string.Empty;

    private int step = 1;
    private bool isLoading = true;
    private bool invalidToken = false;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private ApplicationUser? user;

    private string pwType = "password";
    private string pwType2 = "password";
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool _canvasInitialized = false;
    private bool isDrawingActive = false;
    private string setupTtdMode = "draw"; // "draw" | "upload"

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(token))
        {
            invalidToken = true;
            isLoading = false;
            return;
        }

        user = await UserManager.FindByEmailAsync(email);
        if (user == null || user.IsDeleted)
        {
            invalidToken = true;
            isLoading = false;
            return;
        }

        // We verify the token implicitly by doing nothing. If we want to strictly verify without resetting:
        var isValid = await UserManager.VerifyUserTokenAsync(user, UserManager.Options.Tokens.PasswordResetTokenProvider, "ResetPassword", token);
        if (!isValid)
        {
            invalidToken = true;
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (step == 2 && !_canvasInitialized)
        {
            _canvasInitialized = true;
            try { await JS.InvokeVoidAsync("setupCanvas.init"); } catch { }
        }
    }

    private void TogglePwType()
    {
        pwType = pwType == "password" ? "text" : "password";
    }

    private void TogglePwType2()
    {
        pwType2 = pwType2 == "password" ? "text" : "password";
    }

    private void ProcessStep1()
    {
        errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Password baru wajib diisi.";
            return;
        }
        if (newPassword.Length < 8)
        {
            errorMessage = "Password baru minimal 8 karakter.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            errorMessage = "Konfirmasi password tidak cocok.";
            return;
        }

        step = 2;
    }

    private async Task SwitchSetupMode(string mode)
    {
        setupTtdMode = mode;
        _canvasInitialized = false;
        await Task.Delay(50);
        if (mode == "draw")
        {
            _canvasInitialized = true;
            try { await JS.InvokeVoidAsync("setupCanvas.init"); } catch { }
        }
        else
        {
            try { await JS.InvokeVoidAsync("ttdUpload.reset"); } catch { }
        }
    }

    private async Task ClearCanvasAsync() => await JS.InvokeVoidAsync("setupCanvas.clear");

    private async Task ProcessStep2()
    {
        if (user == null) return;
        errorMessage = string.Empty;

        string? dataUrl;
        if (setupTtdMode == "upload")
        {
            bool hasImg = await JS.InvokeAsync<bool>("ttdUpload.hasImage");
            if (!hasImg) { errorMessage = "Silakan upload TTD terlebih dahulu."; return; }
            dataUrl = await JS.InvokeAsync<string>("ttdUpload.getDataUrl");
        }
        else
        {
            bool isEmpty = await JS.InvokeAsync<bool>("setupCanvas.isEmpty");
            if (isEmpty) { errorMessage = "Tanda tangan tidak boleh kosong."; return; }
            dataUrl = await JS.InvokeAsync<string>("setupCanvas.getDataUrl");
        }
        if (string.IsNullOrEmpty(dataUrl)) { errorMessage = "Gagal membaca data tanda tangan."; return; }

        isSaving = true;
        try
        {
            // Reset Password First
            var resetResult = await UserManager.ResetPasswordAsync(user, token, newPassword);
            if (!resetResult.Succeeded)
            {
                errorMessage = "Gagal memproses undangan: " + string.Join(", ", resetResult.Errors.Select(e => e.Description));
                isSaving = false;
                return;
            }

            // Save Signature — dataUrl already obtained above
            var base64 = dataUrl.Split(',')[1];
            var bytes = Convert.FromBase64String(base64);

            // Validasi magic bytes — tolak file yang bukan PNG atau JPEG
            if (bytes.Length < 4 ||
                !(bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47) && // PNG
                !(bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF)) // JPEG
            {
                errorMessage = "Gagal: File tanda tangan bukan gambar PNG atau JPEG yang valid.";
                isSaving = false;
                return;
            }

            var dir = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "files", "signatures");
            if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);

            var fileName = $"ttd-user-{user.Id}.png";
            var filePath = Path.Combine(dir, fileName);
            await File.WriteAllBytesAsync(filePath, bytes);

            user.TtdPath = $"files/signatures/{fileName}";
            user.EmailConfirmed = true;  // Aktifkan akun setelah setup selesai
            
            var updateResult = await UserManager.UpdateAsync(user);

            // Redirect ke login — user login manual dengan password yang baru dibuat
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Terjadi kesalahan: {ex.Message}";
            isSaving = false;
        }
    }
}
