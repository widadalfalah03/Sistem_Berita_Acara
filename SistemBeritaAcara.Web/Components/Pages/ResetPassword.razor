@page "/reset-password"
@layout EmptyLayout
@using Microsoft.AspNetCore.Identity
@using SistemBeritaAcara.Core.Entities
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Reset Password — Sistem Berita Acara</PageTitle>

<div class="login-page" style="overflow-y:auto;align-items:flex-start;padding:32px 24px;">
    <div class="login-card" style="max-width:400px;width:100%;margin:auto;">
        <div class="login-card-body">
            <div class="login-logo" style="display:flex;flex-direction:column;align-items:center;margin-bottom:8px;">
                <img src="/images/simba_logo_final.png" style="height:auto;max-height:280px;width:auto;max-width:100%;object-fit:contain;margin-top:-24px;margin-bottom:-16px;" alt="SIMBA" />
            </div>

            @if (isLoading)
            {
                <div style="text-align:center;padding:24px;">
                    <div class="spinner"></div>
                </div>
            }
            else if (invalidToken)
            {
                <div style="text-align:center;padding:24px;">
                    <i class="bi bi-x-circle-fill" style="font-size:48px;color:var(--danger);margin-bottom:16px;"></i>
                    <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;">Tautan Tidak Valid</h3>
                    <p style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
                        Tautan reset password ini tidak valid atau telah kedaluwarsa. Silakan ulangi proses lupa password.
                    </p>
                    <a href="/forgot-password" class="btn btn-outline" style="width:100%;">Kembali ke Lupa Password</a>
                </div>
            }
            else
            {
                <h3 style="font-size:18px;font-weight:700;margin-bottom:8px;text-align:center;">Reset Password</h3>
                <p style="font-size:13px;color:var(--text-secondary);text-align:center;margin-bottom:24px;">Silakan buat password baru untuk akun<br/><strong>@email</strong></p>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="login-error" style="margin-bottom:16px;">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        @errorMessage
                    </div>
                }

                <form @onsubmit="ProcessReset" @onsubmit:preventDefault>
                <div class="form-group">
                    <div class="login-pw-wrap">
                        <input class="login-input" type="@pwType" @bind="newPassword" placeholder="Password Baru (Min. 8 Karakter, 1 Huruf Besar, Angka, & Simbol)" />
                        <button type="button" class="login-pw-toggle" @onclick="TogglePwType" tabindex="-1">
                            <i class="bi @(pwType == "password" ? "bi-eye" : "bi-eye-slash")"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom:24px;">
                    <div class="login-pw-wrap">
                        <input class="login-input" type="@pwType2" @bind="confirmPassword" placeholder="Konfirmasi Password" />
                        <button type="button" class="login-pw-toggle" @onclick="TogglePwType2" tabindex="-1">
                            <i class="bi @(pwType2 == "password" ? "bi-eye" : "bi-eye-slash")"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="login-btn" disabled="@isProcessing">
                    Simpan
                </button>
                </form>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string email { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string token { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool invalidToken = false;
    private bool isProcessing = false;
    private string errorMessage = string.Empty;
    private ApplicationUser? user;

    private string pwType = "password";
    private string pwType2 = "password";
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(token))
        {
            invalidToken = true;
            isLoading = false;
            return;
        }

        user = await UserManager.FindByEmailAsync(email);
        if (user == null || user.IsDeleted)
        {
            invalidToken = true;
            isLoading = false;
            return;
        }
        
        var isValid = await UserManager.VerifyUserTokenAsync(user, UserManager.Options.Tokens.PasswordResetTokenProvider, "ResetPassword", token);
        if (!isValid)
        {
            invalidToken = true;
        }

        isLoading = false;
    }

    private void TogglePwType()
    {
        pwType = pwType == "password" ? "text" : "password";
    }

    private void TogglePwType2()
    {
        pwType2 = pwType2 == "password" ? "text" : "password";
    }

    private async Task ProcessReset()
    {
        if (user == null) return;
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Password baru wajib diisi.";
            return;
        }
        if (newPassword.Length < 8 || !newPassword.Any(char.IsUpper) || !newPassword.Any(char.IsDigit) || !newPassword.Any(ch => !char.IsLetterOrDigit(ch)))
        {
            errorMessage = "Password baru minimal 8 karakter, serta mengandung huruf besar, angka, dan simbol.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            errorMessage = "Konfirmasi password tidak cocok.";
            return;
        }

        isProcessing = true;

        try
        {
            var resetResult = await UserManager.ResetPasswordAsync(user, token, newPassword);
            if (!resetResult.Succeeded)
            {
                errorMessage = "Gagal mengubah password: " + string.Join(", ", resetResult.Errors.Select(e => e.Description));
                isProcessing = false;
                return;
            }

            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Terjadi kesalahan: {ex.Message}";
            isProcessing = false;
        }
    }
}
