@page "/editor/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject IBACounterService BACounterService
@inject IEmailService EmailService
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject ILogger<EditorBA> Logger
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminGudangBarang")]
@implements IDisposable

<PageTitle>Editor Berita Acara — Sistem Berita Acara</PageTitle>

@* Fullscreen overlay saat generate/embed dokumen — position:fixed, muncul di atas segalanya *@
@if (isLoading)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(255,255,255,0.93);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
    </div>
}
@if (isSubmitting)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(255,255,255,0.93);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
    </div>
}

@* Konten utama hanya di-render setelah loading selesai, menghindari NRE saat ba masih null *@
@if (!isLoading)
{
    @if (ba is null)
    {
        <div style="text-align:center;padding:60px;color:var(--text-muted);">
            <i class="bi bi-file-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
            <div style="font-size:18px;font-weight:700;">Berita Acara tidak ditemukan</div>
            <NavLink href="/draft" class="btn btn-outline" style="margin-top:16px;">← Kembali ke Draft</NavLink>
        </div>
    }
    else
    {
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; padding-bottom:16px; border-bottom:1px solid var(--border); flex-wrap:wrap; gap:16px;">
        <div style="display:flex; align-items:center; gap:24px;">
            <button class="btn btn-outline" @onclick="GoBack" style="display:flex; align-items:center; gap:8px; border-radius:var(--radius-full); padding:8px 16px;">
                <i class="bi bi-arrow-left"></i> Kembali
            </button>
            <div style="font-weight:700; font-size:14px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em;">Pratinjau Dokumen</div>
        </div>

        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <button @onclick="SubmitForApprovalAsync" disabled="@isSubmitting"
                    style="display:flex;align-items:center;justify-content:center;width:140px;height:42px;border-radius:var(--radius-full);border:1.5px solid var(--primary);background:var(--primary);color:white;font-weight:600;font-size:14px;cursor:pointer;white-space:nowrap;box-sizing:border-box;transition:opacity .2s,transform .15s;"
                    onmouseover="if(!this.disabled){this.style.opacity='.9';this.style.transform='translateY(-1px)';}"
                    onmouseout="this.style.opacity='1';this.style.transform='';">
                @if (isSubmitting)
                {
                    <span class="spinner" style="width:16px;height:16px;border-width:2px;border-color:white;border-top-color:transparent;"></span>
                    <span>Mengirim...</span>
                }
                else if (ba.Jenis == "Lainnya")
                {
                    <span>Simpan</span>
                }
                else
                {
                    <span>Kirim</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background:var(--danger-light);border:1px solid var(--danger);border-radius:var(--radius);padding:14px 20px;margin-bottom:16px;display:flex;align-items:center;gap:10px;color:var(--danger);">
            <i class="bi bi-exclamation-circle-fill" style="font-size:18px;"></i>
            <span>@errorMessage</span>
        </div>
    }

    <div class="review-layout" style="display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start;">

        <div class="pdf-preview-container" style="background:#E8EAF0;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;box-shadow:inset 0 2px 10px rgba(0,0,0,.05);">
            @if (!string.IsNullOrEmpty(ba.DocxPath) && pdfExists)
            {
                <iframe class="hide-on-mobile" @key="pdfVersion" src="/api/preview/pdf/@ba.Id?v=@pdfVersion#toolbar=1&navpanes=0" style="width:100%;height:100%;border:none;border-radius:var(--radius);" title="Pratinjau Dokumen"></iframe>
                <div id="pdf-render-container-editor" class="show-on-mobile" style="width:100%;height:100%;overflow-y:auto;">
                </div>
            }
            else if (!string.IsNullOrEmpty(ba.DocxPath) && !pdfExists)
            {
                <div style="text-align:center;padding:80px 40px;color:var(--text-muted);">
                    <i class="bi bi-file-earmark-pdf" style="font-size:48px;display:block;margin-bottom:16px;color:var(--danger);"></i>
                    <div style="font-size:15px;font-weight:600;margin-bottom:8px;color:var(--text-primary);">Pratinjau PDF tidak tersedia</div>
                    <div style="font-size:13px;">Dokumen berhasil disimpan. PDF akan tersedia setelah proses konversi selesai.</div>
                </div>
            }
            else
            {
                <div style="text-align:center;padding:80px 40px;color:var(--text-muted);">
                    <div class="spinner" style="margin-bottom:16px;"></div>
                </div>
            }
        </div>

        <div>
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><h3 style="font-size:15px;">Ringkasan Dokumen</h3></div>
                <div class="card-body" style="padding:16px;">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);width:45%;">No. Surat</td>
                            <td style="padding:7px 0;font-weight:600;color:var(--primary);">@(ba.NomorSurat ?? (ba.Jenis == "Lainnya" ? "Dibuat otomatis saat disimpan" : "Dibuat otomatis saat dikirim"))</td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);">Jenis Berita Acara</td>
                            <td style="padding:7px 0;"><span class="pill @GetJenisPill(ba.Jenis)" style="font-size:11px;">@ba.Jenis</span></td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);">Tanggal</td>
                            <td style="padding:7px 0;font-weight:600;">@ba.Tanggal.ToString("dd MMM yyyy")</td>
                        </tr>
                        @if (ba.Jenis != "Lainnya")
                        {
                            <tr>
                                <td style="padding:7px 0;color:var(--text-secondary);">Penanggung Jawab</td>
                                <td style="padding:7px 0;font-weight:600;">@ba.Pj?.Nama</td>
                            </tr>
                            <tr>
                                <td style="padding:7px 0;color:var(--text-secondary);">Yang Menyerahkan</td>
                                <td style="padding:7px 0;font-weight:600;">@ba.Menyerahkan?.Nama</td>
                            </tr>
                            <tr>
                                <td style="padding:7px 0;color:var(--text-secondary);">Reviewer</td>
                                <td style="padding:7px 0;font-weight:600;">@ba.Mengetahui?.Nama</td>
                            </tr>
                        }
                        @if (ba.TiketSscNo is not null)
                        {
                            <tr>
                                <td style="padding:7px 0;color:var(--text-secondary);">No. Tiket My SSC</td>
                                <td style="padding:7px 0;font-weight:600;">@ba.TiketSscNo</td>
                            </tr>
                        }
                        @if (ba.Jenis == "Peminjaman")
                        {
                            <tr>
                                <td style="padding:7px 0;color:var(--text-secondary);">Tanggal Kembali</td>
                                <td style="padding:7px 0;font-weight:600;@(ba.TanggalKembali == null ? "color:var(--danger);" : "")">
                                    @(ba.TanggalKembali?.ToString("dd MMM yyyy") ?? "Belum diisi")
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            </div>

            @if (ba.Perangkat?.Any() == true)
            {
                <div class="card" style="margin-bottom:16px;">
                    <div class="card-header"><h3 style="font-size:15px;">Daftar Perangkat</h3></div>
                    <div style="padding:0 16px 8px;">
                        @foreach (var p in ba.Perangkat)
                        {
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border-light);font-size:13px;">
                                <div>
                                    <div style="font-weight:600;">@p.Barang?.NamaBarang</div>
                                    @if (!string.IsNullOrEmpty(p.NoSerial))
                                    {
                                        <div style="font-size:11px;color:var(--text-muted);">S/N: @p.NoSerial</div>
                                    }
                                </div>
                                <div style="color:var(--text-secondary);">@p.Jumlah @p.Satuan</div>
                            </div>
                        }
                    </div>
                </div>
            }


        </div>
    </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "oo")] public string? OoParam { get; set; }

    private BeritaAcaraEntity? ba;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private int _currentUserId;
    private bool _menyerahkanEmbedded = false;
    private long pdfVersion = 0;
    private bool pdfExists = false;
    private int _loadedId = 0; // Id terakhir yang sudah di-load

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            var uri = new Uri(e.Location);
            var path = uri.AbsolutePath.TrimEnd('/');
            var expectedPath = $"/editor/{Id}";
            if (path.Equals(expectedPath, StringComparison.OrdinalIgnoreCase) && _currentUserId != 0)
            {
                await InvokeAsync(async () =>
                {
                    await RefreshBaAsync();
                    StateHasChanged();
                });
            }
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                errorMessage = $"Gagal memuat ulang data: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            int.TryParse(userIdStr, out _currentUserId);

            await LoadBaAsync();

            if (!RendererInfo.IsInteractive) return;

            isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[EditorBA] Unhandled exception in OnInitializedAsync for BA {Id}", Id);
            errorMessage = "Gagal memuat halaman editor. Silakan coba lagi.";
            isLoading = false;
        }
    }

    private async Task LoadBaAsync()
    {
        _loadedId = Id;
        ba = await DbContext.Set<BeritaAcaraEntity>()
            .AsNoTracking()
            .Include(b => b.Pj)
            .Include(b => b.Menyerahkan)
            .Include(b => b.Mengetahui)
            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
            .Include(b => b.BuktiFotos)
            .FirstOrDefaultAsync(b => b.Id == Id && (b.Status == "Draft" || b.Status == "Rejected") && b.CreatedBy == _currentUserId);

        if (ba != null)
        {
            bool skipRegen = OoParam == "1";
            if (!skipRegen) try
            {
                DbContext.ChangeTracker.Clear();

                var trackedBa = await DbContext.Set<BeritaAcaraEntity>().FindAsync(Id);
                if (trackedBa != null)
                {
                    trackedBa.DocxPath = await DocumentService.GenerateDocxAsync(ba);
                    await DbContext.SaveChangesAsync();
                    ba = await DbContext.Set<BeritaAcaraEntity>()
                        .AsNoTracking()
                        .Include(b => b.Pj).Include(b => b.Menyerahkan).Include(b => b.Mengetahui)
                        .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                        .Include(b => b.BuktiFotos)
                        .FirstOrDefaultAsync(b => b.Id == Id);

                    if (ba?.Jenis != "Lainnya" && !string.IsNullOrEmpty(ba?.DocxPath))
                    {
                        var currentUser = await DbContext.Users.FindAsync(_currentUserId);
                        if (currentUser != null && !string.IsNullOrEmpty(currentUser.TtdPath))
                        {
                            var ttdPhysicalPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", currentUser.TtdPath.Replace("/", Path.DirectorySeparatorChar.ToString()));
                            await DocumentService.EmbedTtdMenyerahkanAsync(Id, ttdPhysicalPath);
                            _menyerahkanEmbedded = true;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[EditorBA] Error saat generate/embed dokumen BA {Id}: {ex}");
                errorMessage = "Gagal memuat pratinjau dokumen: " + ex.Message;
            }

            if (ba?.Status == "Rejected" && !string.IsNullOrEmpty(ba.TtdPjPath) && ba.PjSignedAt.HasValue)
            {
                try
                {
                    var ttdPjPhysicalPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot",
                        ba.TtdPjPath.TrimStart('/').Replace("/", Path.DirectorySeparatorChar.ToString()));
                    if (System.IO.File.Exists(ttdPjPhysicalPath))
                    {
                        await DocumentService.EmbedTtdPjAsync(Id, ttdPjPhysicalPath);
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"[EditorBA] Gagal re-embed TTD PJ untuk BA {Id}: {ex.Message}");
                }
            }
        }

        if (!string.IsNullOrEmpty(ba?.DocxPath))
        {
            var pdfPhysicalPath = Path.Combine(
                Directory.GetCurrentDirectory(), "wwwroot",
                ba.DocxPath.TrimStart('/').Replace("/", Path.DirectorySeparatorChar.ToString()).Replace(".docx", ".pdf"));
            pdfExists = File.Exists(pdfPhysicalPath);
            if (!pdfExists && string.IsNullOrEmpty(errorMessage))
                errorMessage = "Pratinjau PDF tidak dapat ditampilkan. Dokumen DOCX berhasil dibuat.";
        }

        pdfVersion = DateTime.UtcNow.Ticks;
    }

    private async Task RefreshBaAsync()
    {
        ba = await DbContext.Set<BeritaAcaraEntity>()
            .AsNoTracking()
            .Include(b => b.Pj)
            .Include(b => b.Menyerahkan)
            .Include(b => b.Mengetahui)
            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
            .Include(b => b.BuktiFotos)
            .FirstOrDefaultAsync(b => b.Id == Id && (b.Status == "Draft" || b.Status == "Rejected") && b.CreatedBy == _currentUserId);

        if (!string.IsNullOrEmpty(ba?.DocxPath))
        {
            var pdfPhysicalPath = Path.Combine(
                Directory.GetCurrentDirectory(), "wwwroot",
                ba.DocxPath.TrimStart('/').Replace("/", Path.DirectorySeparatorChar.ToString()).Replace(".docx", ".pdf"));
            pdfExists = File.Exists(pdfPhysicalPath);
        }

        pdfVersion = DateTime.UtcNow.Ticks;
        errorMessage = string.Empty;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private string _lastRenderedPdfUrl = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("appLoading.hide");

        if (ba != null && !string.IsNullOrEmpty(ba.DocxPath))
        {
            var pdfUrl = $"/api/preview/pdf/{ba.Id}?v={pdfVersion}";
            if (pdfUrl != _lastRenderedPdfUrl)
            {
                _lastRenderedPdfUrl = pdfUrl;
                try 
                {
                    await JSRuntime.InvokeVoidAsync("pdfViewer.renderPdf", "pdf-render-container-editor", pdfUrl);
                } 
                catch (Exception ex)
                {
                    Console.Error.WriteLine("Error invoking pdfViewer: " + ex.Message);
                }
            }
        }
    }

    private async Task SubmitForApprovalAsync()
    {
        if (ba is null) return;
        errorMessage = string.Empty;
        isSubmitting = true;

        try
        {
            ApplicationUser? currentUser = null;
            if (ba.Jenis != "Lainnya")
            {
                currentUser = await DbContext.Users.FindAsync(_currentUserId);
                if (currentUser == null || string.IsNullOrEmpty(currentUser.TtdPath))
                {
                    errorMessage = "Gagal Submit: Anda belum mengunggah Tanda Tangan. Silakan unggah di Profil terlebih dahulu.";
                    isSubmitting = false;
                    return;
                }
            }

            DbContext.ChangeTracker.Clear();
            var trackedBa = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj)
                .Include(b => b.Mengetahui)
                .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                .FirstOrDefaultAsync(b => b.Id == ba.Id && b.CreatedBy == _currentUserId);

            if (trackedBa is null)
            {
                errorMessage = "Gagal submit: Berita Acara tidak ditemukan.";
                isSubmitting = false;
                return;
            }

            if (string.IsNullOrEmpty(trackedBa.DocxPath))
            {
                trackedBa.DocxPath = await DocumentService.GenerateDocxAsync(trackedBa);
                await DbContext.SaveChangesAsync();
            }

            if (trackedBa.Jenis == "Lainnya")
            {
                var (counterValue, nomorSurat) = await BACounterService.GetNextNomorSuratAsync(trackedBa.Tanggal, trackedBa.Jenis);
                trackedBa.NomorSurat = nomorSurat;
                trackedBa.CounterValue = counterValue;
                trackedBa.Status = "Approved";
                trackedBa.SubmittedAt = DateTime.Now;
                trackedBa.ApprovedAt = DateTime.Now;
                trackedBa.PjSignedAt = DateTime.Now;
                await DbContext.SaveChangesAsync();
                await DocumentService.PatchNomorSuratAsync(trackedBa.Id, nomorSurat);
                Navigation.NavigateTo("/archive");
            }
            else
            {
                var ttdPhysicalPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", currentUser!.TtdPath!.Replace("/", Path.DirectorySeparatorChar.ToString()));
                if (!_menyerahkanEmbedded)
                {
                    await DocumentService.EmbedTtdMenyerahkanAsync(trackedBa.Id, ttdPhysicalPath);
                }
                _menyerahkanEmbedded = false;

                trackedBa.Status = "WaitingApproval";
                trackedBa.SubmittedAt = DateTime.Now;
                trackedBa.AlasanReject = null; 
                await DbContext.SaveChangesAsync();

                await NotificationService.SendAsync(
                    trackedBa.MengetahuiId.Value,
                    "WAITING_APPROVAL",
                    $"Berita Acara {trackedBa.Jenis} {(trackedBa.NomorSurat ?? "")} telah diajukan dan membutuhkan persetujuan Anda.".Replace("  ", " ").Trim(),
                    trackedBa.Id
                );
                
                await NotificationService.SendAsync(
                    _currentUserId,
                    "WAITING_APPROVAL",
                    $"Berita Acara {trackedBa.Jenis} telah diajukan. Menunggu persetujuan Reviewer.",
                    trackedBa.Id
                );

                var baseUrlReviewer = (Configuration["App:PublicUrl"] ?? Configuration["App:BaseUrl"] ?? Navigation.BaseUri.TrimEnd('/')).TrimEnd('/');
                var barangListReviewer = trackedBa.Perangkat
                    .Select(p => {
                        string nama = p.Barang?.NamaBarang ?? "Perangkat";
                        string detail = $"{p.Jumlah} {p.Satuan}";
                        if (!string.IsNullOrEmpty(p.NoSerial)) detail += $" — S/N: {p.NoSerial}";
                        if (!string.IsNullOrEmpty(p.Keterangan)) detail += $" ({p.Keterangan})";
                        return $"{nama} — {detail}";
                    }).ToList();
                
                if (!string.IsNullOrEmpty(trackedBa.Mengetahui?.Email))
                {
                    await EmailService.SendApprovalRequestAsync(
                        trackedBa.Mengetahui.Email,
                        trackedBa.Mengetahui.Nama ?? "Reviewer",
                        baseUrlReviewer,
                        trackedBa.Id,
                        trackedBa.Jenis ?? "Berita Acara",
                        barangListReviewer
                    );
                }
                Navigation.NavigateTo("/progress");
            }
        }
        catch (Exception ex)
        {
            DbContext.ChangeTracker.Clear();
            errorMessage = $"Gagal submit: {ex.Message}";
        }
        finally { isSubmitting = false; }
    }

    private void GoBack() => Navigation.NavigateTo($"/buat-ba?edit={Id}");

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        "Penarikan" => "pill-penarikan",
        _ => "pill-lainnya"
    };
}
