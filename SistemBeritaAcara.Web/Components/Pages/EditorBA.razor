@page "/editor/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using BeritaAcaraEntity = SistemBeritaAcara.Core.Entities.BeritaAcara
@inject AppDbContext DbContext
@inject IDocumentService DocumentService
@inject IEmailService EmailService
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdminGudangBarang")]
@implements IDisposable

<PageTitle>Editor Berita Acara — Sistem Berita Acara</PageTitle>

@* Fullscreen overlay saat generate/embed dokumen — position:fixed, muncul di atas segalanya *@
@if (isLoading)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(255,255,255,0.93);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
        <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-top:4px;">Menyiapkan dokumen...</div>
        <div style="font-size:13px;color:var(--text-muted);">Sedang mengkonversi ke PDF, harap tunggu</div>
    </div>
}
@if (isSubmitting)
{
    <div style="position:fixed;inset:0;z-index:10000;background:rgba(255,255,255,0.93);backdrop-filter:blur(6px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
        <div class="spinner" style="width:56px;height:56px;border-width:5px;border-color:var(--primary);border-top-color:transparent;"></div>
        <div style="font-size:18px;font-weight:700;color:var(--text-primary);margin-top:4px;">Mengirim untuk persetujuan...</div>
        <div style="font-size:13px;color:var(--text-muted);">Menyematkan tanda tangan dan mengirim notifikasi ke PJ</div>
    </div>
}

@* Konten utama hanya di-render setelah loading selesai, menghindari NRE saat ba masih null *@
@if (!isLoading)
{
    @if (ba is null)
    {
        <div style="text-align:center;padding:60px;color:var(--text-muted);">
            <i class="bi bi-file-x" style="font-size:48px;display:block;margin-bottom:16px;"></i>
            <div style="font-size:18px;font-weight:700;">Berita Acara tidak ditemukan</div>
            <NavLink href="/draft" class="btn btn-outline" style="margin-top:16px;">← Kembali ke Draft</NavLink>
        </div>
    }
    else
    {
    <!-- ── Topbar Editor ── -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 0;margin-bottom:16px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:16px;">
            <button class="btn btn-outline btn-sm" @onclick="GoBack" style="display:flex;align-items:center;gap:6px;">
                <i class="bi bi-arrow-left"></i> Kembali
            </button>
            <div>
                @if (!string.IsNullOrEmpty(ba.NomorSurat))
                {
                    <div style="font-weight:700;font-size:16px;">@ba.NomorSurat</div>
                }
                <div style="font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">PRATINJAU DOKUMEN</div>
            </div>
        </div>

        <div style="display:flex;align-items:center;gap:12px;">
            <div style="display:flex;align-items:center;gap:6px;font-size:13px;color:#16A34A;background:#F0FDF4;border:1px solid #BBF7D0;border-radius:20px;padding:5px 12px;">
                <i class="bi bi-check-circle-fill"></i>
                <span>Draft tersimpan</span>
            </div>
            @if (!string.IsNullOrEmpty(ba.DocxPath))
            {
                <NavLink href="@($"/onlyoffice-editor/{ba.Id}")" class="btn btn-outline" style="display:flex;align-items:center;gap:8px;background:#fff;border-width:2px;border-radius:var(--radius-full);">
                    <i class="bi bi-pencil"></i>
                    <span>Edit Manual</span>
                </NavLink>
            }
            <button class="btn btn-primary" @onclick="SubmitForApprovalAsync" disabled="@isSubmitting"
                    style="display:flex;align-items:center;gap:8px;">
                @if (isSubmitting)
                {
                    <span class="spinner" style="width:16px;height:16px;border-width:2px;border-color:white;border-top-color:transparent;"></span>
                    <span>Mengirim...</span>
                }
                else
                {
                    <i class="bi bi-send-fill"></i>
                    <span>Kirim untuk Persetujuan</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background:var(--danger-light);border:1px solid var(--danger);border-radius:var(--radius);padding:14px 20px;margin-bottom:16px;display:flex;align-items:center;gap:10px;color:var(--danger);">
            <i class="bi bi-exclamation-circle-fill" style="font-size:18px;"></i>
            <span>@errorMessage</span>
        </div>
    }

    <!-- ── Layout: Area Editor kiri + Panel Ringkasan kanan ── -->
    <div style="display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start;">

        <!-- ── Area Dokumen / Editor ── -->
        <div style="background:#E8EAF0;border-radius:var(--radius);height:842px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;box-shadow:inset 0 2px 10px rgba(0,0,0,.05);">
            @if (!string.IsNullOrEmpty(ba.DocxPath))
            {
                <iframe @key="pdfVersion" src="/api/preview/pdf/@ba.Id?v=@pdfVersion#toolbar=1&navpanes=0" style="width:100%;height:100%;border:none;border-radius:var(--radius);" title="Pratinjau Dokumen"></iframe>
            }
            else
            {
                <div style="text-align:center;padding:80px 40px;color:var(--text-muted);">
                    <div class="spinner" style="margin-bottom:16px;"></div>
                    <div>Memproses dokumen...</div>
                </div>
            }
        </div>

        <!-- ── Panel Ringkasan BA ── -->
        <div>
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><h3 style="font-size:15px;">Ringkasan Dokumen</h3></div>
                <div class="card-body" style="padding:16px;">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);width:45%;">No. Surat</td>
                            <td style="padding:7px 0;font-weight:600;color:var(--primary);">@(ba.NomorSurat ?? "Dibuat otomatis saat dikirim")</td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);">Jenis BA</td>
                            <td style="padding:7px 0;"><span class="pill @GetJenisPill(ba.Jenis)" style="font-size:11px;">@ba.Jenis</span></td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);">Tanggal</td>
                            <td style="padding:7px 0;font-weight:600;">@ba.Tanggal.ToString("dd MMM yyyy")</td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);">Penanggung Jawab</td>
                            <td style="padding:7px 0;font-weight:600;">@ba.Pj?.Nama</td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);">Yang Menyerahkan</td>
                            <td style="padding:7px 0;font-weight:600;">@ba.Menyerahkan?.Nama</td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0;color:var(--text-secondary);">Approver</td>
                            <td style="padding:7px 0;font-weight:600;">@ba.Mengetahui?.Nama</td>
                        </tr>
                        @if (ba.TiketSscNo is not null)
                        {
                            <tr>
                                <td style="padding:7px 0;color:var(--text-secondary);">Tiket SSC</td>
                                <td style="padding:7px 0;font-weight:600;">@ba.TiketSscNo</td>
                            </tr>
                        }
                        @if (ba.Jenis == "Peminjaman")
                        {
                            <tr>
                                <td style="padding:7px 0;color:var(--text-secondary);">Tanggal Kembali</td>
                                <td style="padding:7px 0;font-weight:600;@(ba.TanggalKembali == null ? "color:var(--danger);" : "")">
                                    @(ba.TanggalKembali?.ToString("dd MMM yyyy") ?? "Belum diisi")
                                </td>
                            </tr>
                        }
                    </table>
                </div>
            </div>

            @if (ba.Perangkat?.Any() == true)
            {
                <div class="card" style="margin-bottom:16px;">
                    <div class="card-header"><h3 style="font-size:15px;">Daftar Perangkat</h3></div>
                    <div style="padding:0 16px 8px;">
                        @foreach (var p in ba.Perangkat)
                        {
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border-light);font-size:13px;">
                                <div>
                                    <div style="font-weight:600;">@p.Barang?.NamaBarang</div>
                                    @if (!string.IsNullOrEmpty(p.NoSerial))
                                    {
                                        <div style="font-size:11px;color:var(--text-muted);">S/N: @p.NoSerial</div>
                                    }
                                </div>
                                <div style="color:var(--text-secondary);">@p.Jumlah @p.Satuan</div>
                            </div>
                        }
                    </div>
                </div>
            }


        </div>
    </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private BeritaAcaraEntity? ba;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private int _currentUserId;
    // pdfVersion hanya naik saat kita sengaja refresh data dari DB.
    // Digunakan sebagai @key pada iframe sehingga browser memuat ulang PDF
    // tepat satu kali setiap kali kita kembali dari ONLYOFFICE editor.
    private long pdfVersion = 0;
    private int _loadedId = 0; // Id terakhir yang sudah di-load

    protected override void OnInitialized()
    {
        // Subscribe ke LocationChanged agar saat Blazor navigasi kembali ke
        // halaman ini dari OnlyOfficeEditor, kita bisa refresh data & PDF.
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Periksa apakah URL saat ini cocok dengan halaman ini
        var uri = new Uri(e.Location);
        var path = uri.AbsolutePath.TrimEnd('/');
        var expectedPath = $"/editor/{Id}";
        if (path.Equals(expectedPath, StringComparison.OrdinalIgnoreCase) && _currentUserId != 0)
        {
            await InvokeAsync(async () =>
            {
                await RefreshBaAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        int.TryParse(userIdStr, out _currentUserId);

        await LoadBaAsync();

        // Guard prerender: jangan set isLoading=false saat static render agar prerender
        // menampilkan spinner, bukan iframe dengan PDF lama.
        if (!RendererInfo.IsInteractive) return;

        isLoading = false;
    }

    private async Task LoadBaAsync()
    {
        _loadedId = Id;
        ba = await DbContext.Set<BeritaAcaraEntity>()
            .AsNoTracking()
            .Include(b => b.Pj)
            .Include(b => b.Menyerahkan)
            .Include(b => b.Mengetahui)
            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
            .Include(b => b.BuktiFotos)
            .FirstOrDefaultAsync(b => b.Id == Id && (b.Status == "Draft" || b.Status == "Rejected") && b.CreatedBy == _currentUserId);

        if (ba != null)
        {
            // Hanya generate jika belum ada sama sekali (BA baru pertama kali dibuka)
            if (string.IsNullOrEmpty(ba.DocxPath))
            {
                try
                {
                    // Perlu tracked entity untuk SaveChanges
                    var trackedBa = await DbContext.Set<BeritaAcaraEntity>().FindAsync(Id);
                    if (trackedBa != null)
                    {
                        trackedBa.DocxPath = await DocumentService.GenerateDocxAsync(ba);
                        await DbContext.SaveChangesAsync();
                        ba = await DbContext.Set<BeritaAcaraEntity>()
                            .AsNoTracking()
                            .Include(b => b.Pj).Include(b => b.Menyerahkan).Include(b => b.Mengetahui)
                            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
                            .Include(b => b.BuktiFotos)
                            .FirstOrDefaultAsync(b => b.Id == Id);
                    }

                    var currentUser = await DbContext.Users.FindAsync(_currentUserId);
                    if (currentUser != null && !string.IsNullOrEmpty(currentUser.TtdPath))
                    {
                        var ttdPhysicalPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", currentUser.TtdPath.Replace("/", Path.DirectorySeparatorChar.ToString()));
                        await DocumentService.EmbedTtdMenyerahkanAsync(Id, ttdPhysicalPath);
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"[EditorBA] Error saat generate/embed dokumen BA {Id}: {ex}");
                    errorMessage = "Gagal memuat pratinjau dokumen: " + ex.Message;
                }
            }
        }

        // Naikkan versi agar iframe di-recreate oleh Blazor
        pdfVersion = DateTime.UtcNow.Ticks;
    }

    // Dipanggil saat kembali dari OnlyOfficeEditor — refresh data segar dari DB
    private async Task RefreshBaAsync()
    {
        // Buat DbContext context baru agar tidak ada entity tracking lama
        ba = await DbContext.Set<BeritaAcaraEntity>()
            .AsNoTracking()
            .Include(b => b.Pj)
            .Include(b => b.Menyerahkan)
            .Include(b => b.Mengetahui)
            .Include(b => b.Perangkat).ThenInclude(p => p.Barang)
            .Include(b => b.BuktiFotos)
            .FirstOrDefaultAsync(b => b.Id == Id && (b.Status == "Draft" || b.Status == "Rejected") && b.CreatedBy == _currentUserId);

        // Naikkan versi agar iframe di-recreate oleh Blazor (memuat PDF baru)
        pdfVersion = DateTime.UtcNow.Ticks;
        errorMessage = string.Empty;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JSRuntime hanya tersedia setelah render pertama — tidak boleh dipanggil saat prerender.
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("appLoading.hide");
    }

    private async Task SubmitForApprovalAsync()
    {
        if (ba is null) return;
        errorMessage = string.Empty;
        isSubmitting = true;

        try
        {
            var currentUser = await DbContext.Users.FindAsync(_currentUserId);
            if (currentUser == null || string.IsNullOrEmpty(currentUser.TtdPath))
            {
                errorMessage = "Gagal Submit: Anda belum mengunggah Tanda Tangan. Silakan unggah di Profil terlebih dahulu.";
                isSubmitting = false;
                return;
            }

            // Muat ulang entity BA dengan tracking agar EF bisa melacak perubahan.
            // ba di state komponen ini adalah AsNoTracking — tidak bisa dipakai langsung untuk SaveChanges.
            var trackedBa = await DbContext.Set<BeritaAcaraEntity>()
                .Include(b => b.Pj)
                .FirstOrDefaultAsync(b => b.Id == ba.Id);

            if (trackedBa is null)
            {
                errorMessage = "Gagal submit: Berita Acara tidak ditemukan.";
                isSubmitting = false;
                return;
            }

            // 1. Buat ApprovalToken untuk magic link PJ
            // Gunakan BeritaAcara = trackedBa agar EF Core bisa memetakan shadow FK BeritaAcaraId
            // dengan benar. trackedBa adalah entity yang sudah dilacak, sehingga tidak ada konflik.
            var tokenValue = Guid.NewGuid().ToString("N");
            DbContext.ApprovalToken.Add(new ApprovalToken
            {
                BaId = trackedBa.Id,
                BeritaAcara = trackedBa,
                Token = tokenValue,
                TokenType = "PJ_SIGNATURE",
                ExpiresAt = DateTime.Now.AddDays(7),
                CreatedAt = DateTime.Now
            });

            // Generate dokumen hanya jika belum ada
            if (string.IsNullOrEmpty(trackedBa.DocxPath))
            {
                trackedBa.DocxPath = await DocumentService.GenerateDocxAsync(trackedBa);
                await DbContext.SaveChangesAsync();
            }

            // Embed tanda tangan Admin Gudang (Yang Menyerahkan)
            var ttdPhysicalPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", currentUser.TtdPath.Replace("/", Path.DirectorySeparatorChar.ToString()));
            await DocumentService.EmbedTtdMenyerahkanAsync(trackedBa.Id, ttdPhysicalPath);

            // Update status → WaitingPJSign
            trackedBa.Status = "WaitingPJSign";
            trackedBa.SubmittedAt = DateTime.Now;
            await DbContext.SaveChangesAsync();

            // Kirim email magic link ke PJ
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            await EmailService.SendMagicLinkAsync(
                trackedBa.Pj!.Email ?? string.Empty,
                trackedBa.Pj.Nama,
                trackedBa.Id,
                tokenValue,
                baseUrl
            );

            // Kirim notifikasi in-app ke AdminGudangBarang
            await NotificationService.SendAsync(
                _currentUserId,
                "WAITING_PJ_SIGN",
                $"Draft BA telah diajukan. Menunggu tanda tangan PJ ({trackedBa.Pj.Nama}).",
                trackedBa.Id
            );

            Navigation.NavigateTo("/progress");
        }
        catch (Exception ex)
        {
            // Bersihkan change tracker agar entitas yang pending (misal ApprovalToken)
            // tidak ikut disimpan saat SaveChanges berikutnya dari halaman lain.
            DbContext.ChangeTracker.Clear();
            errorMessage = $"Gagal submit: {ex.Message}";
        }
        finally { isSubmitting = false; }
    }

    private void GoBack() => Navigation.NavigateTo($"/buat-ba?edit={Id}");

    private static string GetJenisPill(string jenis) => jenis switch
    {
        "Alokasi" => "pill-alokasi",
        "Peminjaman" => "pill-peminjaman",
        _ => "pill-lainnya"
    };
}
